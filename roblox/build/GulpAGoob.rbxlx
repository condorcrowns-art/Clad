<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX000041"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="Lighting" referent="RBX000042"><Properties><string name="Name">Lighting</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX000043"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000018"><Properties><string name="Name">GoobShared</string></Properties><Item class="ModuleScript" referent="RBX000001"><Properties><string name="Name">Ascension</string><ProtectedString name="Source"><![CDATA[--!strict
-- Ascension.luau — the terminus.
--
-- Numbers that only ever rise have no end, so nothing is ever an achievement.
-- At Colossal you may Ascend: the Goob is consumed — permanently, on the same
-- rule as every other sink in this game — and you keep a Crest.
--
-- This is not a reset, it is the scoreboard. Crests are worn on the nameplate
-- where the whole server can read them, and each one permanently multiplies how
-- much mass you get from food, so every run after the first is shorter.

local Config = require(script.Parent.Config)

local Ascension = {}

Ascension.BONUS_PER_CREST = 0.18   -- +18% food value per crest, compounding
Ascension.MAX_CRESTS = 25          -- bounds the compounding; ~55x at the cap
Ascension.ALTAR_RANGE = 34

-- Compounding, not additive: additive stops mattering by crest 10, and the
-- whole point of a prestige loop is that each run is meaningfully faster.
function Ascension.foodMultiplier(crests: number): number
    local n = math.clamp(crests or 0, 0, Ascension.MAX_CRESTS)
    return (1 + Ascension.BONUS_PER_CREST) ^ n
end

function Ascension.canAscend(goob: any, crests: number): (boolean, string?)
    if not goob then return false, "No Goob." end
    if (crests or 0) >= Ascension.MAX_CRESTS then
        return false, "You've earned every Crest there is."
    end
    if goob.mass < Config.COLOSSAL_MASS then
        return false, "Your Goob must reach COLOSSAL first."
    end
    return true
end

-- What the player is about to trade away, spelled out. Ascension is
-- irreversible and destroys the thing they spent days on, so the confirmation
-- has to state the loss in plain words, not just the gain.
function Ascension.preview(goob: any, crests: number)
    local next_ = math.min((crests or 0) + 1, Ascension.MAX_CRESTS)
    return {
        losing = goob and goob.nickname or "?",
        losingMass = goob and goob.mass or 0,
        losingAge = goob and ((goob.bornAt and (os.time() - goob.bornAt)) or 0) + (goob and goob.inheritedAge or 0),
        crestsAfter = next_,
        multiplierBefore = Ascension.foodMultiplier(crests or 0),
        multiplierAfter = Ascension.foodMultiplier(next_),
    }
end

return Ascension
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000002"><Properties><string name="Name">Blob</string><ProtectedString name="Source"><![CDATA[--!strict
-- Blob.luau — the arena core. Eat, melt, bank, pop.
--
-- Two curves decide whether this game is fun, and they are the only two that
-- matter:
--
--   harvest(mass)  how much mass a blob can pick up per second
--   leak(mass)     how much mass a blob drips per second
--
-- harvest is LOGARITHMIC in mass. leak is SUPER-LINEAR in mass. They therefore
-- cross, exactly once, at a mass no amount of skill can pass. That crossing is
-- called the ceiling, and it is the entire design:
--
--   * nobody camps at the top, because the top is a net loss
--   * runs end themselves in 1-3 minutes with no round timer anywhere
--   * standing still is negative income, so AFK farming is impossible
--   * a leader's drip is a real food supply for everyone smaller
--
-- harvest is logarithmic because it is derived physically rather than picked:
-- a blob sweeps a corridor 2*radius wide at its own top speed, through pellets
-- at a fixed density. radius is logarithmic in mass and speed FALLS with mass,
-- so the corridor widens far slower than the body grows. That is agar.io's
-- actual geometry, written down honestly instead of curve-fitted.

local Config = require(script.Parent.Config)

local Blob = {}

-- ── Body ───────────────────────────────────────────────────────────────────

-- Logarithmic, matching GoobMath.size's reasoning: constant visual growth per
-- order of magnitude, so a 10x gain is always a visible step. Arena numbers
-- are small (tens to low thousands) so the constant is tuned for that band.
-- A CUBE ROOT, not a logarithm. See Config.BLOB_RADIUS_EXP for the full
-- reasoning; the short version is that a blob is a volume, so radius goes as
-- mass^(1/3), and the log curve it replaced moved so little across a round's
-- mass band that swallowing somebody your own size was invisible.
--
-- Clamped at SIZE_MAX for sanity only. At the exponent above that is not
-- reached until roughly 1.4 million mass, which no round produces.
function Blob.radius(mass: number): number
    local m = math.max(Config.STARTING_MASS, mass)
    local r = Config.BLOB_RADIUS_BASE
        * (m / Config.STARTING_MASS) ^ Config.BLOB_RADIUS_EXP
    return math.min(Config.SIZE_MAX, r)
end

-- Bigger is SLOWER. This is the one place the arena deliberately contradicts
-- Movement.luau, which keeps top speed near-flat so that progression never
-- locks you out of terrain. In here there is no terrain to lock you out of —
-- there is a predator — and a chase is only a chase if the fat one can be
-- outrun. Movement's acceleration and braking curves still layer on top, so a
-- heavy blob is slow AND clumsy, not merely slow.
function Blob.speed(mass: number): number
    local ratio = Config.STARTING_MASS / math.max(Config.STARTING_MASS, mass)
    local v = Config.BLOB_BASE_SPEED * ratio ^ Config.BLOB_SPEED_DECAY
    return math.max(Config.BLOB_MIN_SPEED, v)
end

-- ── The two curves ─────────────────────────────────────────────────────────

function Blob.harvestPerSecond(mass: number): number
    local corridor = 2 * Blob.radius(mass)
    return Config.PELLET_DENSITY
        * corridor
        * Blob.speed(mass)
        * Config.PELLET_VALUE
end

function Blob.leakPerSecond(mass: number): number
    local over = mass - Config.LEAK_GRACE
    if over <= 0 then
        return 0
    end
    return Config.LEAK_SCALE * over ^ Config.LEAK_EXPONENT
end

-- Net growth for a player harvesting at `efficiency` of the theoretical rate.
-- efficiency 1.0 is a player sweeping perfectly through dense pellets and
-- never backtracking; real play sits nearer 0.6-0.8.
function Blob.netPerSecond(mass: number, efficiency: number?): number
    local eff = efficiency or 1
    return Blob.harvestPerSecond(mass) * eff - Blob.leakPerSecond(mass)
end

-- The mass at which net growth hits zero. Found by bisection rather than
-- algebra because the curves are allowed to be retuned independently, and a
-- closed form would quietly become a lie the moment someone changed one.
function Blob.ceiling(efficiency: number?): number
    local lo, hi = Config.LEAK_GRACE, Config.LEAK_GRACE
    -- expand until we bracket the crossing
    for _ = 1, 60 do
        hi *= 1.5
        if Blob.netPerSecond(hi, efficiency) <= 0 then
            break
        end
        lo = hi
    end
    for _ = 1, 80 do
        local mid = (lo + hi) / 2
        if Blob.netPerSecond(mid, efficiency) > 0 then
            lo = mid
        else
            hi = mid
        end
    end
    return (lo + hi) / 2
end

-- ── Eating ─────────────────────────────────────────────────────────────────

-- You must be meaningfully bigger, not a rounding error bigger. Near-equal
-- blobs bounce off each other, which is what turns a crowd into a standoff
-- instead of a coin flip.
function Blob.canEat(mine: number, theirs: number): boolean
    return mine >= theirs * Config.EAT_RATIO
end

function Blob.eatGain(mine: number, theirs: number): number
    return theirs * Config.EAT_TRANSFER
end

-- ── Popping ────────────────────────────────────────────────────────────────
-- A pop splits the dead blob three ways:
--   scatter  -> pellets on the floor, immediately edible by anyone
--   congeal  -> a permanent lump of terrain, the island's memory
--   burned   -> deleted from the world forever
--
-- The burn is not an accident. It is the same sink that has kept total mass in
-- this game convergent since the first design pass: every transfer of value
-- destroys some of it, so the world cannot inflate no matter how long a server
-- runs or how many players farm it.
export type PopSplit = { kept: number, scatter: number, congeal: number, burned: number }

function Blob.popSplit(mass: number, keepFraction: number?): PopSplit
    local kept = mass * math.clamp(keepFraction or 0, 0, Config.POP_KEEP_MAX)
    local rest = mass - kept
    local scatter = rest * Config.POP_SCATTER
    local congeal = rest * Config.POP_CONGEAL
    return {
        kept = kept,
        scatter = scatter,
        congeal = congeal,
        burned = rest - scatter - congeal,
    }
end

-- ── Banking ────────────────────────────────────────────────────────────────
-- Slightly super-linear, so a player who holds on for one more dangerous lap
-- is paid for the risk. It is safe to be super-linear here precisely because
-- mass itself is capped by the ceiling: the exponent cannot run away, because
-- its input cannot.
function Blob.bankValue(mass: number): number
    if mass <= 0 then
        return 0
    end
    return math.floor(mass ^ Config.BANK_EXPONENT * Config.BANK_SCALE)
end

function Blob.bankSeconds(trinketSpeed: number?): number
    return Config.BANK_SECONDS / (1 + (trinketSpeed or 0))
end

-- ── Lumps ──────────────────────────────────────────────────────────────────
-- Congealed shells are terrain, but not forever-terrain: they melt slowly, so
-- an eight-hour server ends up interesting rather than solid.
function Blob.lumpRadius(mass: number): number
    return math.clamp(
        Config.LUMP_RADIUS_K * mass ^ 0.4,
        Config.LUMP_RADIUS_MIN,
        Config.LUMP_RADIUS_MAX
    )
end

function Blob.lumpDecay(mass: number, dt: number): number
    return math.max(0, mass - mass * Config.LUMP_DECAY_PER_SEC * dt)
end

return Blob
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Config.luau — every tunable number in GULP A GOOB lives here.
-- Design rule: no magic numbers anywhere else in the codebase. If you want to
-- rebalance the game, you should only ever have to open this file.

local Config = {}

Config.GAME_NAME = "GULP A GOOB"
Config.DATASTORE_KEY = "GoobProfile_v1"
Config.CENSUS_STORE = "GoobCensus_v1"

-- ── Core economy ───────────────────────────────────────────────────────────
-- Currency is "Glob" 💧. It is produced passively by digestion, NOT by selling
-- Goobs. Selling is deliberately impossible: the only way a Goob leaves the
-- world is by being fed to another Goob. That is the entire scarcity engine.
Config.STARTING_GLOB = 250
Config.STARTING_MASS = 10

-- Passive income: glob/sec = MASS ^ INCOME_EXPONENT * INCOME_SCALE
-- Sub-linear on purpose, so a 1000x bigger Goob earns ~63x more, not 1000x.
-- This keeps day-1 players inside the same order of magnitude as whales.
Config.INCOME_EXPONENT = 0.60
Config.INCOME_SCALE = 0.35

-- Offline earnings are capped so logging in daily beats hoarding a week.
Config.OFFLINE_CAP_SECONDS = 8 * 60 * 60
Config.OFFLINE_EFFICIENCY = 0.55 -- you earn 55% rate while away

-- ── Size / power scale ─────────────────────────────────────────────────────
-- Physical size is LOGARITHMIC in mass, not a cube root.
--
-- A cube root sounds right and is wrong: it saturates. With a cube root and a
-- 180-stud clamp, every Goob past ~1e6 mass renders at exactly the same size,
-- which is reached within a few hours of play. From then on the entire
-- "you can see how strong someone is" promise is dead, and a 1e6 Goob is
-- visually indistinguishable from a 1e20 one.
--
-- A log curve instead gives roughly constant visual growth per ORDER OF
-- MAGNITUDE, so every tenfold gain is a visible step forever. The clamp is
-- still there, but it is not reached until ~1e24, which no player will see.
Config.SIZE_BASE = 4          -- studs, at STARTING_MASS
Config.SIZE_LOG_K = 0.78      -- studs of growth per natural-log unit of mass
Config.SIZE_MAX = 180         -- hard clamp, for sanity only
Config.COLOSSAL_MASS = 5e6    -- mass at which the Colossal crown unlocks

-- Why 5e6: it is 20x the largest single drop in the game, which is what keeps
-- one lucky catch from skipping the whole progression. At the measured ~73
-- mass per catch and a catch every ~4 seconds that is roughly 75 hours of pure
-- active play — but gulping and trading shortcut it enormously, which is the
-- point. Colossal should be a TRADING milestone, not a grinding one.

-- Feeding: the Goob does not gain mass instantly. Food enters the STOMACH and
-- digests over time — this is the offline hook, and it is also the anti-bot
-- measure (you cannot burst-feed 10,000 items into a number).
Config.DIGEST_RATE = 0.08     -- fraction of stomach converted to mass per second
Config.STOMACH_SOFT_CAP = 40  -- items; beyond this digestion slows
Config.STOMACH_OVERFULL_PENALTY = 0.45

-- ── Age: the unfarmable rarity axis ────────────────────────────────────────
-- Age is measured in REAL seconds since the Goob was first hatched, and it
-- travels with the Goob through trades. You cannot bot it, dupe it, or buy it.
-- It is the only stat in the game with a genuinely fixed supply curve.
Config.AGE_TIERS = {
    { name = "Fresh",    seconds = 0,                 mult = 1.00, color = Color3.fromRGB(180, 255, 190), emoji = "🌱" },
    { name = "Ripe",     seconds = 60 * 60 * 24,      mult = 1.25, color = Color3.fromRGB(160, 235, 255), emoji = "💧" },
    { name = "Seasoned", seconds = 60 * 60 * 24 * 3,  mult = 1.60, color = Color3.fromRGB(170, 190, 255), emoji = "🔷" },
    { name = "Ancient",  seconds = 60 * 60 * 24 * 7,  mult = 2.20, color = Color3.fromRGB(215, 165, 255), emoji = "🔮" },
    { name = "Fossil",   seconds = 60 * 60 * 24 * 30, mult = 3.50, color = Color3.fromRGB(255, 195, 120), emoji = "🦴" },
    { name = "Mythic",   seconds = 60 * 60 * 24 * 90, mult = 6.00, color = Color3.fromRGB(255, 140, 150), emoji = "👑" },
    { name = "Eternal",  seconds = 60 * 60 * 24 * 365,mult = 12.0, color = Color3.fromRGB(255, 240, 140), emoji = "⭐" },
}

-- ── Gulping (the sink) ─────────────────────────────────────────────────────
-- Feeding Goob B to Goob A destroys B forever and transfers a fraction of its
-- mass. The transfer is < 100% on purpose: every gulp BURNS mass out of the
-- world economy. Combined with fixed spawn rates this makes the total mass in
-- existence self-limiting instead of exponential.
Config.GULP_MASS_TRANSFER = 0.75
Config.GULP_AGE_TRANSFER = 0.35   -- you inherit 35% of the eaten Goob's age
Config.GULP_MIN_MASS_RATIO = 0.02 -- can't gulp something >50x your size

-- ── How your Goob is fed now ───────────────────────────────────────────────
--
-- WHAT THIS REPLACED, AND WHY. There used to be three separate ways to put
-- mass into a Goob: a Snack Stand that spent idle income on feedstock rolls,
-- an Egg Stand that sold you empty vessels, and physical critters that roamed
-- the island to be chased down. All three predate the arena. They were built
-- for a game where you stood on a plot and watched a number rise, and they
-- survived the rework only because nothing ever forced them to justify
-- themselves.
--
-- Keeping them was not free. Critters spawned junk into the ROUND — a "RARE
-- Anvil" bobbing past two players mid-chase, belonging to a loop that no
-- longer exists. The Snack Stand needed a shop panel, and that panel was the
-- thing overlapping the season track on screen. Two visible bugs, one root
-- cause: dead systems still running.
--
-- So feeding now hangs off the only loop there is. A round pays out Glob AND
-- feeds your Goob, scaled by what you actually did out there, and eggs hatch
-- on a count of rounds finished rather than being bought. There is exactly one
-- source of mass in the world again, and it is playing.
Config.ROUND_FEED_PER_GLOB = 1 / 420   -- payout -> number of feedstock rolls
Config.ROUND_FEED_MIN = 1
Config.ROUND_FEED_MAX = 26
-- Luck by finishing place. Winning buys a better table, not just more of the
-- same one, because "more rolls" stops reading as a prize very quickly.
Config.ROUND_FEED_LUCK = { 4, 2.5, 1.8 }
Config.ROUND_FEED_LUCK_DEFAULT = 1

-- ── How you ever get a SECOND Goob ─────────────────────────────────────────
--
-- An egg is a SLOT — somewhere to keep something you traded for. Gating it on
-- rounds finished means a stable is evidence that you played, which is the one
-- thing in the game that cannot be bought, botted or transferred.
Config.EGG_EVERY_ROUNDS = 5
Config.MAX_GOOBS = 8            -- hard cap; also bounds the DataStore payload

-- ── Trading ────────────────────────────────────────────────────────────────
Config.TRADE_RANGE = 24
Config.TRADE_CONFIRM_LOCK = 3   -- seconds both sides must hold confirm (anti scam)
Config.TRADE_MAX_SLOTS = 4

-- ── Sound ─────────────────────────────────────────────────────────────────
--
-- EMPTY BY DEFAULT, ON PURPOSE. These were shipped as marketplace asset ids
-- picked without being able to verify them, and at least one was wrong:
--
--   Failed to load sound rbxassetid://9125600534:
--   Asset type does not match requested type
--
-- An id that cannot be verified from here should not be baked into the game —
-- a broken one spams the Output window on every play and looks like the game
-- is falling apart. An empty id plays nothing and says nothing.
--
-- TO ADD SOUND: find ids on the Creator Store (Audio), paste them below, and
-- make sure each is actually an Audio asset rather than a model containing one.
-- WHY rbxasset:// AND NOT rbxassetid://
--
-- These are files that ship INSIDE the Roblox client. They are not catalog
-- uploads, so there is no owner, no moderation queue, no licence question and
-- no chance of one being taken down and silently breaking the game — which is
-- exactly what happened the first time this table held a catalog id and the
-- client threw "Asset type does not match requested type" on every pickup.
--
-- A path that does not exist in some future client version fails to load
-- SILENTLY rather than erroring, which is the failure mode you want for audio.
-- Juice checks them at boot and warns once per bad id rather than per play.
--
-- Every one of these has shipped with Roblox for years as a default Humanoid
-- or Studio sound. They should be verified once in Studio all the same: the
-- harness has no audio engine and cannot confirm a file exists.
local BUILTIN = "rbxasset://sounds/"

Config.SOUNDS = {
    -- Pickups and progress
    catch  = BUILTIN .. "electronicpingshort.wav",  -- a pellet
    rare   = BUILTIN .. "bass.wav",                 -- Legendary and above
    bank   = BUILTIN .. "bass.wav",                 -- mass becomes Glob
    unlock = BUILTIN .. "electronicpingshort.wav",  -- a crate, a power

    -- Bodies meeting bodies
    gulp   = BUILTIN .. "uuhhh.mp3",                -- you ate somebody
    pop    = BUILTIN .. "uuhhh.mp3",                -- somebody ate you
    thud   = BUILTIN .. "hit.wav",                  -- a shove in the Standoff

    -- Powers. One per feel, not one per power: twelve distinct stings is noise
    -- on a phone speaker, and players read the SHAPE of a sound long before
    -- they learn which of twelve it was.
    whoosh = BUILTIN .. "action_falling.mp3",       -- dash, blink, split
    slam   = BUILTIN .. "metal.ogg",                -- slam, hook
    shield = BUILTIN .. "action_get_up.mp3",        -- bubble, spike, beacon
    drip   = BUILTIN .. "impact_water.mp3",         -- slick, decoy, siphon
    click  = BUILTIN .. "clickfast.wav",            -- UI
}

-- Which sound each power plays. A power with no entry falls back to "whoosh".
Config.POWER_SOUND = {
    dash = "whoosh", blink = "whoosh", split = "whoosh",
    slam = "slam", hook = "slam",
    bubble = "shield", spike = "shield", beacon = "shield",
    slick = "drip", decoy = "drip", siphon = "drip",
    magnet = "click",
}

-- ── Misc ───────────────────────────────────────────────────────────────────
Config.AUTOSAVE_INTERVAL = 90
Config.PLOT_COUNT = 8
Config.PLOT_SIZE = 90
Config.PLOT_SPACING = 130

-- ═══════════════════════════════════════════════════════════════════════════
-- ARENA — the agar.io layer. See GOOP.md.
-- ═══════════════════════════════════════════════════════════════════════════

-- ── Body ───────────────────────────────────────────────────────────────────
-- Arena masses live in the tens-to-low-thousands band, not the billions, so
-- these constants are tuned for readability at that scale. A fresh blob is 5
-- studs across and a blob at the ceiling is about 15 — a 3x visual difference,
-- which is the largest range that still lets both fit on one screen during a
-- chase. Any wider and the camera has to choose who to show.
-- ── HOW BIG EATING SOMEBODY MAKES YOU ─────────────────────────────────────
--
-- This was a LOG curve: radius = BASE + K * ln(mass / STARTING). It was chosen
-- when a run could reach 1e24 and every tenfold gain had to stay a visible
-- step forever, and at that job it was correct.
--
-- It is wrong for a round. A round lasts three and a half minutes and tops out
-- in the low thousands, and across that band a log curve barely moves:
-- swallowing a blob your own size DOUBLES your mass and adds one and a half
-- studs to your radius. The number on the HUD leaps and the thing on screen
-- does not, which is exactly the complaint — you eat somebody and nothing
-- happens.
--
-- A power law fixes it, and it is also the physically honest one: a blob is a
-- volume, volume is proportional to mass, so radius goes as the CUBE ROOT.
-- Doubling your mass now makes you 26% wider, which reads instantly, and the
-- old saturation problem does not come back because nothing in a round gets
-- near the clamp.
--
--   mass    10 ->  5.0 studs
--          100 -> 10.8
--        1,000 -> 23.2
--       10,000 -> 50.0
--      100,000 -> 107.7
Config.BLOB_RADIUS_BASE = 5
Config.BLOB_RADIUS_EXP = 1 / 3
-- Kept because the harvest curve and its tests are written against it and the
-- log form is the thing to reach for if the power law turns out to make the
-- late round unreadable. Unused while BLOB_RADIUS_EXP is set.
Config.BLOB_RADIUS_K = 2.2

-- Bigger is slower, agar-style. A fresh blob (42) outruns a ceiling blob (~24)
-- by 1.75x, which is enough for a chase to be losable but not hopeless.
Config.BLOB_BASE_SPEED = 42
Config.BLOB_SPEED_DECAY = 0.11
Config.BLOB_MIN_SPEED = 20

-- ── Pellets ────────────────────────────────────────────────────────────────
-- Density is pellets per square stud on the Flats. With a 250-stud-radius ring
-- that is about 430 live pellets, which Roblox streams comfortably as a single
-- pooled folder of unanchored-but-sleeping parts.
Config.PELLET_DENSITY = 0.0022
Config.PELLET_VALUE = 9
-- PELLET_TARGET IS DERIVED, NOT CHOSEN, and this is load-bearing.
--
-- Blob.harvestPerSecond models a blob sweeping a corridor through pellets at
-- PELLET_DENSITY. That density is an input to the curve that decides the
-- ceiling, the run length, and therefore the whole game. If the island is
-- resized and the pellet COUNT stays put, the realised density silently stops
-- matching the model the curves were tuned against — the ceiling moves, runs
-- get longer or shorter, and nothing anywhere reports a problem.
--
-- So the count is computed from the area it has to cover. Resize the island
-- and the food supply follows automatically. tools/arena.luau asserts the two
-- agree to within a couple of percent.
-- RAISED WITH THE BODIES. Blobs are physically bigger than they were — radius
-- went from a logarithm to a cube root so that eating somebody is visible —
-- and a wider body sweeps a wider corridor, so the same twelve contenders now
-- clear the floor noticeably faster. Holding the old 36/s would have meant the
-- change quietly starved the mid-round.
--
-- 48/s keeps the floor ahead of a full field up to about 2.5K mass each, which
-- is past where a round's middle sits. Beyond that it deliberately falls
-- behind: the back half of a round is supposed to turn from farming into
-- hunting, and a floor that never thins is what stops that happening.
Config.PELLET_RESPAWN_PER_SEC = 48
Config.GOLDEN_CRUMB_MULT = 5

-- ── Melting ────────────────────────────────────────────────────────────────
-- leak = LEAK_SCALE * (mass - GRACE) ^ EXPONENT
--
-- The exponent is the single most important number in the game. Below 1.0 the
-- curves never cross and the biggest blob wins forever. At 1.15 the crossing
-- lands around 1.2K mass, which a good player reaches in roughly three
-- minutes and a great one milks for about twenty percent more.
--
-- GRACE exists so that a newly-spawned blob never melts. A player's first
-- thirty seconds must be pure, uncomplicated growth or the game reads as
-- broken rather than tense.
Config.LEAK_GRACE = 60
Config.LEAK_SCALE = 0.00433
Config.LEAK_EXPONENT = 1.15
Config.LEAK_PELLET_MASS = 6   -- leaked goop lands in chunks of this size

-- ── Eating ─────────────────────────────────────────────────────────────────
Config.EAT_RATIO = 1.15       -- must be 15% bigger to swallow
Config.EAT_TRANSFER = 0.80    -- and you only keep 80% of them

-- ── Popping ────────────────────────────────────────────────────────────────
-- Splits the dead blob: scatter as food, congeal as terrain, burn the rest.
-- The burn is the same sink that keeps total world mass convergent.
Config.POP_SCATTER = 0.55
Config.POP_CONGEAL = 0.25
Config.POP_KEEP_MAX = 0.25    -- ceiling on what any trinket can rescue

-- ── Lumps (the island's memory) ────────────────────────────────────────────
Config.LUMP_RADIUS_K = 1.15
Config.LUMP_RADIUS_MIN = 4
Config.LUMP_RADIUS_MAX = 26
Config.LUMP_DECAY_PER_SEC = 1 / (60 * 45)  -- a lump half-lives in ~30 minutes
-- Scaled with the island: the cap exists so terrain cannot wall the Vault off,
-- and a cap tuned for a 300-stud island leaves a 480-stud one looking empty.
Config.LUMP_MAX_COUNT = 300

-- ── Banking ────────────────────────────────────────────────────────────────
-- Super-linear on purpose: one more dangerous lap should pay for itself. Safe
-- to be super-linear only because the ceiling caps its input.
Config.BANK_EXPONENT = 1.12
Config.BANK_SCALE = 0.9
Config.BANK_SECONDS = 3.0     -- the most dangerous three seconds in the game
Config.BANK_RESET_MASS = 25   -- you come out of the Vault slightly fed

-- ── The island ─────────────────────────────────────────────────────────────
-- ── Scale ──────────────────────────────────────────────────────────────────
-- Sized for 16-24 players, not for 4.
--
-- At 480 studs the Flats hold about 490,000 square studs, which is roughly
-- 24,000 each with a full server — a 155-stud square per player. Below about
-- 400 a full lobby is a scrum where nobody can build a run; much above 560 and
-- you stop being able to see anybody, which kills the thing the whole design
-- rests on: always being able to see somebody bigger and somebody smaller.
Config.ISLAND_RADIUS = 480
Config.SHALLOWS_INNER = 395   -- outside this radius is the rim
Config.VAULT_RADIUS = 48

-- ── WHY THERE IS NOW FOOD OUT AT THE EDGE ──────────────────────────────────
--
-- There was not, and it was deliberate, and it was wrong.
--
-- Pellets used to stop at SHALLOWS_INNER - 8, because the rim outside it is a
-- no-PvP ring and food in a place nothing can touch you is not a strategy, it
-- is an exploit that beats the whole game: stand still, eat forever, win. So
-- the rim was left bare. What that actually produced was a 93-stud dead band
-- around the entire island — over a THIRD of its area — with nothing in it and
-- no reason to walk there. The island read as smaller than it is, and the
-- outer third of a map built for 16+ players was decoration.
--
-- The fix is not "spawn food there anyway". It is to stop the rim being a
-- place you can live. Safety out there is now a BUDGET, not a property of the
-- ground: see SHALLOWS_GRACE below. Once you have spent it you are edible on
-- the rim like anywhere else, so food can be scattered right out to the
-- shoreline and the edge becomes the most exposed ground on the map instead of
-- the safest. Which is what an edge should be.
Config.PELLET_OUTER = Config.ISLAND_RADIUS - 26   -- 454: out to the shoreline

-- ── Safety is a budget ─────────────────────────────────────────────────────
--
-- Standing on the rim buys you SHALLOWS_GRACE seconds of being untouchable.
-- The meter drains while you are out there and refills at RECHARGE seconds of
-- real time per second of grace, only while you are inside the Flats. So the
-- rim is a fire escape — duck out, breathe, get back in — and never a home.
--
-- A fresh spawn is handed a full meter, which is what makes spawning out here
-- still the right answer for a new player: you get a real look at the island
-- before anything is allowed to touch you.
Config.SHALLOWS_GRACE = 12        -- seconds of protection per full meter
Config.SHALLOWS_RECHARGE = 3.0    -- seconds in the Flats per second refunded
-- ═══════════════════════════════════════════════════════════════════════════
-- ROUNDS
-- ═══════════════════════════════════════════════════════════════════════════
-- The game is round-based now. A round is a clean slate: everybody starts the
-- same size, grows without limit, and the round ends. Between rounds everyone
-- sits in a lobby where nothing can eat them and the shops are open.
--
-- WHY THIS REPLACED THE MELT CEILING. The old design capped growth with a leak
-- curve, so nobody could run away with it. Rounds make that unnecessary — a
-- runaway leader only owns the board until the clock runs out — and it makes
-- the cap actively unwanted, because the fantasy is getting ENORMOUS. The job
-- the melt used to do is now done by other players: abilities DEFLATE, so a
-- leader is brought down by people ganging up rather than by arithmetic.
Config.ROUND_SECONDS = 210
Config.INTERMISSION_SECONDS = 35
Config.ROUND_END_HOLD = 8       -- results on screen before the lobby teleport

-- Leak is off during a round. The curve itself is kept and still tested,
-- because it is the thing to reach for if deflation turns out to be too weak
-- a brake in playtesting — flipping this back on is a one-line change.
Config.LEAK_IN_ROUND = false

-- Round-end payout. Your final mass is the score; placement is a bonus on top
-- so that second place is still worth playing for.
Config.ROUND_PAYOUT_EXPONENT = 1.05
Config.ROUND_PAYOUT_SCALE = 0.55
Config.ROUND_PLACE_BONUS = { 3.0, 1.8, 1.3 }   -- 1st, 2nd, 3rd multipliers

-- ── The lobby ──────────────────────────────────────────────────────────────
-- A separate platform, well clear of the island, with a rim so nobody falls
-- off it. Deliberately NOT a building: it is a floor, a rail and some signs.
Config.LOBBY_CENTRE = Vector3.new(0, 420, 0)
Config.LOBBY_RADIUS = 120

-- ── SPLIT, TETHERS AND PODS — the part that is not agar.io ────────────────
--
-- SPLIT alone is the genre's signature move and copying it outright would make
-- this a worse agar with extra menus. So it is copied and then given one twist
-- that changes what the move is FOR.
--
-- WHAT SPLIT DOES. You throw three globlets forward. They are not a second
-- body you steer — that needs a second controller and a camera that can hold
-- two things, and it is the reason most agar clones feel awful on a phone.
-- They fly out, hoover up pellets, and come home. You stay one blob.
--
-- WHAT MAKES IT OURS: THE TETHER. Every globlet stays joined to you by a
-- visible strand of goo, and ANY blob that crosses a strand is deflated and
-- slowed. So a split is not just a lunge — it is three lines drawn across the
-- floor that other players have to go around. Splitting past somebody fences
-- them in. Splitting while running lays a wire behind you. Splitting into a
-- crowd hits everyone in it at once.
--
-- That turns the genre's "commit half of yourself to reach something" into
-- "commit part of yourself to CONTROL SPACE", which is a different decision
-- and, as far as I can find, not a thing any blob game does.
Config.SPLIT_PIECES = 3
Config.SPLIT_SPREAD = 0.42        -- radians between the outer pieces
Config.SPLIT_SPEED = 96           -- studs/sec outward
Config.SPLIT_RANGE = 88           -- how far a globlet gets before it turns back
Config.SPLIT_RETURN_FRACTION = 0.85  -- of what you threw, how much comes home
Config.GLOBLET_PICKUP = 9         -- pellet reach of one globlet

-- The tether. Deliberately weak per touch and generous on cooldown: it is
-- area denial, not a damage engine. A blob that walks the length of one strand
-- loses a noticeable slice; a blob that clips the end of one barely notices.
Config.TETHER_WIDTH = 4.5         -- studs either side of the line
Config.TETHER_DEFLATE = 0.045     -- fraction of the victim's own mass, per touch
Config.TETHER_SLOW = 0.55         -- speed multiplier while snagged
Config.TETHER_SLOW_TIME = 1.1     -- seconds the snag lasts
Config.TETHER_COOLDOWN = 0.8      -- per victim, so a strand cannot chain-hit

-- ── SPORE PODS ────────────────────────────────────────────────────────────
--
-- Standing hazards on the island. Touch one while you are big and it bursts
-- you into a whole web of tethered globlets at once — you lose no mass to the
-- pod itself, but for a few seconds you are a spread-out, obvious, tangled
-- mess with your pieces scattered.
--
-- Agar's viruses punish the big by splitting them into edible chunks. Ours
-- does not make you edible, it makes you COMMITTED: your tethers are suddenly
-- everywhere, which is dangerous for everyone near you including the person
-- who herded you into it. Being popped by a pod is as often an opportunity as
-- a punishment, which is the difference between a hazard and a tax.
--
-- Only blobs over POD_MIN_MASS trigger them, so a small player can hide inside
-- a pod field where the big ones dare not follow. That is the whole reason the
-- things are on the map.
Config.POD_COUNT = 14
Config.POD_MIN_MASS = 140         -- below this you pass straight through
Config.POD_RADIUS = 11
Config.POD_PIECES = 7             -- how many globlets a burst throws
Config.POD_RESPAWN = 25           -- seconds before a spent pod regrows

-- ── Deflation ──────────────────────────────────────────────────────────────
-- The catch-up mechanism, and the reason a leader cannot simply sit on the
-- lead. Every deflating ability takes a FRACTION OF THE TARGET'S OWN MASS, so
-- the bigger somebody is the more there is to take — the leader is always the
-- most rewarding thing on the island to hit.
--
-- What comes off does not vanish: it hits the floor as pellets, so deflating
-- the leader literally feeds everyone standing nearby. That is the whole
-- catch-up loop in one sentence.
Config.DEFLATE_RETURN_AS_FOOD = 0.8
Config.DEFLATE = {
    slam   = 0.10,   -- everyone caught in the shockwave
    hook   = 0.06,   -- the blob you reel
    siphon = 0.14,   -- stolen rather than scattered: the thief keeps it
    spike  = 0.35,   -- whoever tries to eat you, and it is meant to hurt
    blink  = 0.0,
}

-- ── Biomes ─────────────────────────────────────────────────────────────────
-- The four old zones are gone as places, but not as ideas. Their characters
-- survive as patches ON the one island, which is the version of "keep it to
-- one island" that loses nothing: you still get slick lines, ramp play and a
-- rich dangerous basin, without four separate maps to build, populate, and
-- split a server across.
--
-- Each patch trades safety for yield, so where you feed is a decision:
--   SLICK   fast lines, no brakes           pellets x1.15
--   SCRAP   ramps, cover, broken sightlines pellets x1.00, best for hiding
--   BASIN   sunken, richest, one way out    pellets x1.55
-- Five patches on the bigger island, spread so that no two are visible from
-- the same standing spot. Each trades safety for yield, so where you feed is a
-- decision rather than a detail.
Config.BIOMES = {
    { id = "slick",  name = "The Slick",     centre = Vector3.new(232, 0, -186),
      radius = 118, pelletMult = 1.15, friction = 0.03 },
    { id = "scrap",  name = "The Scrapyard", centre = Vector3.new(-196, 0, -238),
      radius = 126, pelletMult = 1.00, friction = 0.45 },
    { id = "basin",  name = "The Basin",     centre = Vector3.new(168, -11, 232),
      radius = 110, pelletMult = 1.55, friction = 0.35 },
    -- New with the bigger island. The Bloom is the safest good ground and the
    -- Ashfield is the most dangerous: open, no cover, and the best pellets
    -- outside the Basin.
    { id = "bloom",  name = "The Bloom",     centre = Vector3.new(-268, 0, 96),
      radius = 104, pelletMult = 1.08, friction = 0.55 },
    { id = "ash",    name = "The Ashfield",  centre = Vector3.new(24, 0, -318),
      radius = 122, pelletMult = 1.34, friction = 0.30 },
}

Config.VAULT_HEIGHT = 7
-- WHERE A FRESH BLOB APPEARS.
--
-- This was 438, and the scenery scatter ran from 407 to 466 — so spawn points
-- sat in the dead centre of the rock band and a player could, and did,
-- materialise inside a boulder. Scenery is now kept out of a ring around the
-- spawns entirely, and the spawns themselves moved inboard. Two independent
-- guarantees, because spawning stuck is the single worst first impression a
-- game can make.
-- Back out in the SHALLOWS, which is where a new player belongs anyway: it is
-- the no-PvP ring. Moving spawns inboard to dodge the rocks put them inside
-- the biome furniture instead — basin walls, ramps, scrap and signposts — so
-- the fix was trading one obstacle for five. Out here the only thing that gets
-- placed is scattered rock, and that now respects SPAWN_CLEARANCE.
Config.SPAWN_RING = 435
Config.SPAWN_CLEARANCE = 46    -- no scenery may be placed within this of a spawn
Config.SPAWN_POINTS = 20       -- enough that a full server does not stack up

-- ═══════════════════════════════════════════════════════════════════════════
-- BOTS
-- ═══════════════════════════════════════════════════════════════════════════
-- An arena game with three people in it is not a small version of the game.
-- It is a different, worse game: nobody to run from, nobody to gang up on, and
-- a leader who is never brought down because deflation needs a crowd. Every
-- system in GOOP — the catch-up loop, the board, the 1v1s — assumes a FIELD.
--
-- So the field is guaranteed. Every round is played by ROUND_FIELD_SIZE
-- contenders and bots make up whatever the humans do not: twelve humans means
-- no bots, one human means eleven, and nobody at all still runs a real round
-- with a real board. A player joining mid-round does not push anyone out —
-- the bot count is recomputed at the top of each round, so the field size is
-- exact at the start and only ever grows during play.
--
-- Bots are NOT a scoreboard prop. They eat pellets, they eat each other, they
-- eat you, you eat them, and they are deflated by your abilities on exactly
-- the same terms as a player, because a bot that cannot be beaten the normal
-- way teaches the wrong thing about the game.
Config.ROUND_FIELD_SIZE = 12
Config.BOTS_ENABLED = true

-- Bots are deliberately beatable. A bot re-decides what it is doing every
-- THINK seconds rather than every frame, which is what gives a human the
-- opening to cut one off — a perfect-information chaser reacting at 60Hz is
-- unloseable and reads as cheating.
Config.BOT_THINK = 0.45
Config.BOT_SIGHT = 170          -- studs; it cannot act on what it cannot see
Config.BOT_PELLET_SIGHT = 90
-- Fear and greed. A bot runs from anything EAT_RATIO * FEAR times its size and
-- chases anything under GREED of it. Below 1.0 greed means it only commits to
-- prey it can comfortably swallow, which leaves room for a human to bait one.
Config.BOT_FEAR = 1.0
Config.BOT_GREED = 0.86
Config.BOT_SPEED_MULT = 0.94    -- a shade slower than a player of equal size
Config.BOT_WANDER = 0.35        -- share of decisions that are just wandering

-- Bots do not all play the same. Skill scales the three things that actually
-- decide a chase: how far they see, how often they think, and how willing they
-- are to commit. A field of identical bots is legible within one round.
Config.BOT_SKILLS = {
    { id = "dozy",   name = "dozy",   sight = 0.62, think = 1.9,  greed = 0.70, weight = 26 },
    { id = "plain",  name = "plain",  sight = 1.00, think = 1.0,  greed = 0.86, weight = 46 },
    { id = "sharp",  name = "sharp",  sight = 1.28, think = 0.65, greed = 0.95, weight = 22 },
    { id = "feral",  name = "feral",  sight = 1.45, think = 0.45, greed = 1.05, weight = 6 },
}

-- ── BOT NAMES ─────────────────────────────────────────────────────────────
--
-- Generated to look like Roblox usernames, because that is what they are
-- standing in for.
--
-- The first version used cute blob words — Gloop, Mochi, Squelch — and tagged
-- every one with a robot emoji on the assumption that pretending otherwise was
-- a lie the player would catch and resent. That was the wrong call twice over.
-- A board reading "Gloop 🤖, Pudge 🤖, Custard 🤖" does not read as honesty, it
-- reads as an EMPTY SERVER, which is precisely the feeling bots exist to
-- prevent — and no blob game in the genre labels its fill, so the tag was
-- announcing a weakness nobody else admits to.
--
-- A name like Kai8842 is not a lie about a person; it is the same shape as
-- every other name on a Roblox leaderboard, and the player's honest reaction
-- to it is "there are eleven other blobs here", which is true.
Config.BOT_FIRST = {
    "Kai", "Milo", "Zane", "Finn", "Rhys", "Theo", "Jax", "Cole", "Ash", "Reid",
    "John", "Leo", "Max", "Nico", "Owen", "Ravi", "Sam", "Toby", "Vic", "Wren",
    "Blaze", "Cypher", "Drift", "Echo", "Frost", "Ghost", "Hex", "Iris", "Jet",
    "Koda", "Luna", "Mika", "Nova", "Onyx", "Pixel", "Quill", "Rune", "Sky",
}
Config.BOT_SUFFIX_MIN = 11
Config.BOT_SUFFIX_MAX = 9987


-- Derived last, because it depends on the radius above.
-- The food field is the disc out to PELLET_OUTER, not to SHALLOWS_INNER. That
-- is a 35% larger area than it used to be, so the count rises with it: if the
-- count had stayed put, opening the rim up would have made the WHOLE island
-- thinner rather than making the edge worth walking to.
Config.PELLET_TARGET = math.floor(
    Config.PELLET_DENSITY * math.pi * Config.PELLET_OUTER ^ 2)


return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[--!strict
-- Cosmetics.luau — what you wear, and where it can come from.
--
-- THE HARD RULE, enforced by the `source` field on every entry:
-- cosmetics may be BOUGHT, but power, mass, age and Secrets may never be. The
-- moment Robux touches the economy, the trading market dies — the balance sim
-- already caught that failure once arriving through the shop, and a cash
-- register is the same failure wearing a different hat.
--
-- So everything here is visual. Nothing in this file changes a number.

local Cosmetics = {}

export type Item = {
    id: string,
    name: string,
    kind: string,        -- skin | trail | eyes | crown
    rarity: string,
    source: string,      -- starter | season | shop | ascend | achievement
                         -- | crate_goop | crate_deep | beta
    tier: number?,       -- season tier that grants it
    premium: boolean?,   -- season premium track only
    beta: boolean?,      -- BETA SEASON exclusive, retired when Season 0 closes
    colour: Color3?,
    material: Enum.Material?,
    -- Rare and above get one. Named rather than described so the catalogue
    -- stays data and RollService stays the only place that knows how to build
    -- a ParticleEmitter — see RollService.applyCosmetics.
    particle: string?,
    emoji: string?,
}

Cosmetics.KINDS = { "skin", "trail", "eyes", "crown" }

Cosmetics.RARITY_COLOUR = {
    Common    = Color3.fromRGB(190, 195, 205),
    Uncommon  = Color3.fromRGB(121, 224, 141),
    Rare      = Color3.fromRGB(121, 169, 224),
    Epic      = Color3.fromRGB(171, 121, 224),
    Legendary = Color3.fromRGB(224, 188, 121),
    Mythic    = Color3.fromRGB(224, 121, 145),
}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

Cosmetics.ITEMS = {
    -- ── Skins: the body itself ─────────────────────────────────────────────
    --
    -- NEON, AND LOUD ON PURPOSE. The whole interface is greyscale now — black
    -- panels, white text, colour reserved for meaning — and that was done for
    -- this: the blobs are the only saturated thing in the world, so a skin has
    -- nothing to compete with and reads from across the island.
    --
    -- `glow` sets how hard a skin emits. `particle` names a shape that
    -- RollService attaches at Rare and above, so the difference between a
    -- Common and a Legendary is visible in motion and not only in a menu — a
    -- rare skin that just sits there is a rare skin nobody can tell you own.
    { id = "skin_default", name = "Classic Goo",   kind = "skin", rarity = "Common",
      source = "starter", material = Enum.Material.Glass },
    { id = "skin_jelly",   name = "Jelly",         kind = "skin", rarity = "Common",
      source = "season", tier = 3, material = Enum.Material.Neon, colour = rgb(255, 92, 168) },
    { id = "skin_slime",   name = "Toxic Slime",   kind = "skin", rarity = "Common",
      source = "crate_goop", material = Enum.Material.Neon, colour = rgb(148, 255, 64) },
    { id = "skin_bubble",  name = "Soap Bubble",   kind = "skin", rarity = "Uncommon",
      source = "season", tier = 8, material = Enum.Material.ForceField, colour = rgb(120, 232, 255) },
    { id = "skin_magma",   name = "Magma",         kind = "skin", rarity = "Uncommon",
      source = "shop", material = Enum.Material.Neon, colour = rgb(255, 122, 26),
      particle = "ember" },
    { id = "skin_chrome",  name = "Chrome",        kind = "skin", rarity = "Rare",
      source = "season", tier = 18, material = Enum.Material.Metal, colour = rgb(226, 232, 240),
      particle = "spark" },
    { id = "skin_cyber",   name = "Cyber Grid",    kind = "skin", rarity = "Rare",
      source = "crate_goop", material = Enum.Material.Neon, colour = rgb(0, 255, 214),
      particle = "grid" },
    { id = "skin_lava",    name = "Molten",        kind = "skin", rarity = "Epic",
      source = "season", tier = 28, premium = true, material = Enum.Material.Neon,
      colour = rgb(255, 74, 46), particle = "ember" },
    { id = "skin_void",    name = "Void",          kind = "skin", rarity = "Epic",
      source = "shop", material = Enum.Material.Neon, colour = rgb(88, 24, 214),
      particle = "void" },
    { id = "skin_plasma",  name = "Plasma",        kind = "skin", rarity = "Epic",
      source = "crate_deep", material = Enum.Material.Neon, colour = rgb(196, 64, 255),
      particle = "spark" },
    { id = "skin_prism",   name = "Prism",         kind = "skin", rarity = "Legendary",
      source = "season", tier = 45, premium = true, material = Enum.Material.Glass,
      colour = rgb(120, 200, 255), particle = "prism" },
    { id = "skin_ancient", name = "Ancient Amber", kind = "skin", rarity = "Legendary",
      source = "ascend", material = Enum.Material.Neon, colour = rgb(255, 186, 48),
      particle = "ember" },
    { id = "skin_ultra",   name = "Ultraviolet",   kind = "skin", rarity = "Legendary",
      source = "crate_deep", material = Enum.Material.Neon, colour = rgb(150, 40, 255),
      particle = "void" },
    { id = "skin_goldleaf",name = "Gold Leaf",     kind = "skin", rarity = "Mythic",
      source = "achievement", material = Enum.Material.Neon, colour = rgb(255, 214, 92),
      particle = "prism" },
    { id = "skin_singular",name = "Event Horizon", kind = "skin", rarity = "Mythic",
      source = "beta", beta = true, material = Enum.Material.Neon, colour = rgb(12, 12, 16),
      particle = "void" },

    -- ── Trails ─────────────────────────────────────────────────────────────
    { id = "trail_none",   name = "No Trail",      kind = "trail", rarity = "Common", source = "starter" },
    { id = "trail_dust",   name = "Dust Puff",     kind = "trail", rarity = "Common",
      source = "season", tier = 2, colour = rgb(220, 210, 190) },
    { id = "trail_spark",  name = "Sparks",        kind = "trail", rarity = "Uncommon",
      source = "season", tier = 11, colour = rgb(224, 194, 121) },
    { id = "trail_frost",  name = "Frost",         kind = "trail", rarity = "Rare",
      source = "shop", colour = rgb(141, 202, 224) },
    { id = "trail_flame",  name = "Flame",         kind = "trail", rarity = "Epic",
      source = "season", tier = 33, premium = true, colour = rgb(224, 156, 121) },
    { id = "trail_rainbow",name = "Rainbow",       kind = "trail", rarity = "Legendary",
      source = "season", tier = 50, premium = true, colour = rgb(224, 224, 224) },
    { id = "trail_crest",  name = "Crest Wake",    kind = "trail", rarity = "Mythic",
      source = "ascend", colour = rgb(224, 211, 150) },

    -- ── Eyes ───────────────────────────────────────────────────────────────
    { id = "eyes_default", name = "Googly",        kind = "eyes", rarity = "Common", source = "starter", emoji = "👀" },
    { id = "eyes_sleepy",  name = "Sleepy",        kind = "eyes", rarity = "Common",
      source = "season", tier = 5, emoji = "😴" },
    { id = "eyes_angry",   name = "Cross",         kind = "eyes", rarity = "Uncommon",
      source = "season", tier = 14, emoji = "😠" },
    { id = "eyes_star",    name = "Starstruck",    kind = "eyes", rarity = "Rare",
      source = "shop", emoji = "🤩" },
    { id = "eyes_cyber",   name = "Visor",         kind = "eyes", rarity = "Epic",
      source = "season", tier = 24, premium = true, emoji = "🕶️" },
    { id = "eyes_ghost",   name = "Hollow",        kind = "eyes", rarity = "Legendary",
      source = "achievement", emoji = "👻" },

    -- ── Crowns: worn above the nameplate ──────────────────────────────────
    { id = "crown_none",   name = "Bare Head",     kind = "crown", rarity = "Common", source = "starter", emoji = "" },
    { id = "crown_party",  name = "Party Hat",     kind = "crown", rarity = "Common",
      source = "season", tier = 6, emoji = "🎉" },
    { id = "crown_cap",    name = "Cap",           kind = "crown", rarity = "Common",
      source = "shop", emoji = "🧢" },
    { id = "crown_horns",  name = "Horns",         kind = "crown", rarity = "Uncommon",
      source = "season", tier = 16, emoji = "😈" },
    { id = "crown_halo",   name = "Halo",          kind = "crown", rarity = "Rare",
      source = "season", tier = 22, emoji = "😇" },
    { id = "crown_pit",    name = "Pit Champion",  kind = "crown", rarity = "Epic",
      source = "achievement", emoji = "🥇" },
    { id = "crown_gold",   name = "Ascendant",     kind = "crown", rarity = "Legendary",
      source = "ascend", emoji = "👑" },

    -- ── Crate pools ────────────────────────────────────────────────────────
    -- source "crate_goop" and "crate_deep" are bought with EARNED Glob. There
    -- is deliberately no Robux path into either pool: the moment a crate you
    -- can only buy with money holds something a crate you can earn does not,
    -- the game has a wall in it, and this one does not have walls.
    { id = "skin_moss",    name = "Mossback",      kind = "skin", rarity = "Common",
      source = "crate_goop", material = Enum.Material.Grass, colour = rgb(132, 150, 118) },
    { id = "skin_clay",    name = "Wet Clay",      kind = "skin", rarity = "Common",
      source = "crate_goop", material = Enum.Material.Sand, colour = rgb(178, 150, 132) },
    { id = "skin_ink",     name = "Ink Drop",      kind = "skin", rarity = "Uncommon",
      source = "crate_goop", material = Enum.Material.Glass, colour = rgb( 62,  66,  82) },
    { id = "trail_bubbles",name = "Bubble Wake",   kind = "trail", rarity = "Common",
      source = "crate_goop", colour = rgb(186, 206, 214) },
    { id = "trail_crumbs", name = "Crumb Trail",   kind = "trail", rarity = "Uncommon",
      source = "crate_goop", colour = rgb(206, 186, 148) },
    { id = "eyes_dizzy",   name = "Dizzy",         kind = "eyes", rarity = "Common",
      source = "crate_goop", emoji = "😵" },
    -- The cheap crate needs a real jackpot or it is a vending machine. This is
    -- it: 1-in-250, and the only Legendary anybody can reach on day one.
    { id = "skin_pearl",   name = "Pearl",         kind = "skin", rarity = "Legendary",
      source = "crate_goop", material = Enum.Material.Marble, colour = rgb(214, 208, 196) },

    { id = "skin_marble",  name = "Marble",        kind = "skin", rarity = "Rare",
      source = "crate_deep", material = Enum.Material.Marble, colour = rgb(206, 202, 194) },
    { id = "skin_tide",    name = "Tidepool",      kind = "skin", rarity = "Epic",
      source = "crate_deep", material = Enum.Material.Glass, colour = rgb(118, 156, 162) },
    { id = "skin_fossil",  name = "Fossilised",    kind = "skin", rarity = "Legendary",
      source = "crate_deep", material = Enum.Material.Slate, colour = rgb(176, 162, 134) },
    { id = "trail_static", name = "Static",        kind = "trail", rarity = "Rare",
      source = "crate_deep", colour = rgb(176, 186, 206) },
    { id = "crown_antenna",name = "Antenna",       kind = "crown", rarity = "Rare",
      source = "crate_deep", emoji = "📡" },
    { id = "eyes_shades",  name = "Shades",        kind = "eyes", rarity = "Epic",
      source = "crate_deep", emoji = "😎" },
    { id = "crown_deep",   name = "Deepcrown",     kind = "crown", rarity = "Mythic",
      source = "crate_deep", emoji = "🐚" },

    -- ── BETA SEASON exclusives ─────────────────────────────────────────────
    -- Retired forever when Season 0 closes. This is the only scarcity claim
    -- in the game and it costs nothing to honour, so it will be honoured.
    { id = "skin_beta",    name = "Beta Goo",      kind = "skin", rarity = "Epic",
      source = "beta", beta = true, material = Enum.Material.ForceField, colour = rgb(150, 186, 206) },
    { id = "skin_blueprint",name = "Blueprint",    kind = "skin", rarity = "Legendary",
      source = "beta", beta = true, material = Enum.Material.SmoothPlastic, colour = rgb(104, 132, 170) },
    { id = "trail_beta",   name = "Build Number",  kind = "trail", rarity = "Rare",
      source = "beta", beta = true, colour = rgb(158, 190, 206) },
    { id = "crown_beta",   name = "Founder's Tag", kind = "crown", rarity = "Mythic",
      source = "beta", beta = true, emoji = "🏷️" },
    { id = "eyes_beta",    name = "Test Pattern",  kind = "eyes", rarity = "Rare",
      source = "beta", beta = true, emoji = "🎛️" },

    -- ── The wider wardrobe ─────────────────────────────────────────────────
    -- A skin is the only thing in this game a player can choose purely because
    -- they like it, so the catalogue has to be wide enough that two people in
    -- the same server rarely match. Every one of these reads at a distance:
    -- the body is a 10-to-35-stud ball seen across an arena, so a skin is a
    -- MATERIAL and a HUE, never a texture nobody will ever be close enough
    -- to see.
    { id = "skin_frost",   name = "Frostbite",     kind = "skin", rarity = "Common",
      source = "crate_goop", material = Enum.Material.Ice, colour = rgb(186, 206, 214) },
    { id = "skin_rust",    name = "Rustbucket",    kind = "skin", rarity = "Common",
      source = "crate_goop", material = Enum.Material.CorrodedMetal, colour = rgb(170, 124, 96) },
    { id = "skin_bark",    name = "Old Bark",      kind = "skin", rarity = "Common",
      source = "crate_goop", material = Enum.Material.Wood, colour = rgb(146, 122, 96) },
    { id = "skin_tar",     name = "Tar",           kind = "skin", rarity = "Uncommon",
      source = "crate_goop", material = Enum.Material.Glass, colour = rgb( 54,  52,  58) },
    { id = "skin_sea",     name = "Seaglass",      kind = "skin", rarity = "Uncommon",
      source = "crate_goop", material = Enum.Material.Glass, colour = rgb(136, 176, 168) },
    { id = "skin_brass",   name = "Brasswork",     kind = "skin", rarity = "Rare",
      source = "crate_deep", material = Enum.Material.Foil, colour = rgb(186, 158, 108) },
    { id = "skin_slate",   name = "Slate",         kind = "skin", rarity = "Rare",
      source = "crate_deep", material = Enum.Material.Slate, colour = rgb(118, 120, 124) },
    { id = "skin_ember",   name = "Ember",         kind = "skin", rarity = "Epic",
      source = "crate_deep", material = Enum.Material.Neon, colour = rgb(196, 138, 108) },
    { id = "skin_aurora",  name = "Aurora",        kind = "skin", rarity = "Epic",
      source = "season", tier = 38, premium = true, material = Enum.Material.ForceField,
      colour = rgb(140, 178, 190) },
    { id = "skin_obsidian",name = "Obsidian",      kind = "skin", rarity = "Legendary",
      source = "season", tier = 41, material = Enum.Material.Glass, colour = rgb( 48,  44,  56) },
    { id = "skin_bone",    name = "Bonework",      kind = "skin", rarity = "Rare",
      source = "season", tier = 26, material = Enum.Material.Sand, colour = rgb(208, 198, 172) },
    { id = "skin_copper",  name = "Verdigris",     kind = "skin", rarity = "Uncommon",
      source = "season", tier = 12, material = Enum.Material.Metal, colour = rgb(132, 168, 152) },

    { id = "trail_ash",    name = "Ash Cloud",     kind = "trail", rarity = "Uncommon",
      source = "crate_goop", colour = rgb(158, 152, 148) },
    { id = "trail_ink",    name = "Ink Wake",      kind = "trail", rarity = "Rare",
      source = "crate_deep", colour = rgb( 78,  82,  96) },
    { id = "trail_bloom",  name = "Pollen",        kind = "trail", rarity = "Uncommon",
      source = "season", tier = 20, colour = rgb(196, 190, 138) },
    { id = "trail_tide",   name = "Tidewash",      kind = "trail", rarity = "Epic",
      source = "season", tier = 36, premium = true, colour = rgb(140, 174, 178) },

    { id = "eyes_wide",    name = "Wide Awake",    kind = "eyes", rarity = "Common",
      source = "crate_goop", emoji = "😳" },
    { id = "eyes_smug",    name = "Smug",          kind = "eyes", rarity = "Uncommon",
      source = "season", tier = 9, emoji = "😏" },
    { id = "eyes_money",   name = "Payday",        kind = "eyes", rarity = "Rare",
      source = "crate_deep", emoji = "🤑" },

    { id = "crown_flower", name = "Flower Crown",  kind = "crown", rarity = "Common",
      source = "crate_goop", emoji = "🌸" },
    { id = "crown_chef",   name = "Chef's Hat",    kind = "crown", rarity = "Uncommon",
      source = "crate_goop", emoji = "👨‍🍳" },
    { id = "crown_top",    name = "Top Hat",       kind = "crown", rarity = "Rare",
      source = "season", tier = 30, emoji = "🎩" },
    { id = "crown_banker", name = "The Banker",    kind = "crown", rarity = "Legendary",
      source = "achievement", emoji = "🏦" },
}

local byId: { [string]: Item } = {}
for _, item in ipairs(Cosmetics.ITEMS) do byId[item.id] = item end

function Cosmetics.get(id: string): Item?
    return byId[id]
end

function Cosmetics.ofKind(kind: string): { Item }
    local out = {}
    for _, item in ipairs(Cosmetics.ITEMS) do
        if item.kind == kind then table.insert(out, item) end
    end
    return out
end

-- Everything a brand-new player starts with. There is always at least one
-- option per slot so the wardrobe is never an empty room.
function Cosmetics.starterLoadout(): { [string]: string }
    return { skin = "skin_default", trail = "trail_none", eyes = "eyes_default", crown = "crown_none" }
end

function Cosmetics.starterOwned(): { [string]: boolean }
    local owned = {}
    for _, item in ipairs(Cosmetics.ITEMS) do
        if item.source == "starter" then owned[item.id] = true end
    end
    return owned
end

-- Equip validation. Returns the corrected loadout rather than erroring, so a
-- profile that references a cosmetic removed in a later patch still loads.
function Cosmetics.sanitise(loadout: { [string]: string }?, owned: { [string]: boolean }?)
    local starter = Cosmetics.starterLoadout()
    local out = {}
    for _, kind in ipairs(Cosmetics.KINDS) do
        local wanted = loadout and loadout[kind]
        local item = wanted and byId[wanted]
        if item and item.kind == kind and owned and owned[wanted] then
            out[kind] = wanted
        else
            out[kind] = starter[kind]
        end
    end
    return out
end

function Cosmetics.owns(owned: { [string]: boolean }?, id: string): boolean
    return owned ~= nil and owned[id] == true
end

-- Rewards granted by reaching an ascension count / achievement, so the flexiest
-- items in the game are earned rather than bought.
Cosmetics.ASCEND_REWARDS = {
    [1]  = "crown_gold",
    [3]  = "trail_crest",
    [6]  = "skin_ancient",
}

Cosmetics.ACHIEVEMENTS = {
    { id = "pitwins5",   cosmetic = "crown_pit",     label = "Win 5 Sumo Pit matches" },
    { id = "secret1",    cosmetic = "eyes_ghost",    label = "Catch a Secret" },
    { id = "colossal3",  cosmetic = "skin_goldleaf", label = "Reach Colossal 3 times" },
}

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000005"><Properties><string name="Name">Crates</string><ProtectedString name="Source"><![CDATA[--!strict
-- Crates.luau — the gacha, with the two things gacha usually gets wrong
-- deliberately fixed.
--
-- WRONG THING 1: paid crates holding what free crates do not.
-- Every crate in this game is bought with Glob, which is earned by banking.
-- Robux buys the Beta Pass and skins off the shop shelf directly; it does not
-- buy a roll, and it does not buy a better table. A kid with no money and an
-- hour has the same access as a kid with fifty dollars and ten minutes.
--
-- WRONG THING 2: the invisible cliff.
-- Every crate has hard pity. The counter is shown on the button. A player can
-- always answer "how far am I from the good one", which is the difference
-- between anticipation and being farmed.

local Cosmetics = require(script.Parent.Cosmetics)
local Trinkets = require(script.Parent.Trinkets)

local Crates = {}

export type Reward = {
    kind: string,      -- cosmetic | trinket | glob
    id: string,
    name: string,
    rarity: string,
    amount: number?,   -- for glob
}

export type Crate = {
    id: string,
    name: string,
    blurb: string,
    price: number,         -- in Glob. There is no other currency here.
    sources: { string },   -- Cosmetics.source values this crate draws from
    trinkets: boolean,     -- may it roll trinkets
    weights: { [string]: number },
    pity: number,          -- rolls until a guaranteed Rare-or-better
    pityFloor: string,
    dupeGlob: { [string]: number },
}

-- Weights are per-rarity, not per-item: adding a new Epic skin later must not
-- silently make Epics more common. The roll picks a rarity first, then picks
-- uniformly inside it.
Crates.LIST = {
    {
        id = "goop", name = "Goop Crate",
        blurb = "The everyday one. Mostly skins and trails.",
        price = 1000,
        sources = { "crate_goop" },
        trinkets = true,
        weights = { Common = 62, Uncommon = 26, Rare = 9, Epic = 2.6, Legendary = 0.4 },
        pity = 12, pityFloor = "Rare",
        dupeGlob = { Common = 120, Uncommon = 300, Rare = 900, Epic = 2600, Legendary = 7000, Mythic = 15000 },
    },
    {
        id = "deep", name = "Deep Crate",
        blurb = "Costs a real session. Holds the trinkets.",
        price = 9000,
        sources = { "crate_deep", "crate_goop" },
        trinkets = true,
        weights = { Common = 18, Uncommon = 34, Rare = 31, Epic = 13, Legendary = 3.4, Mythic = 0.6 },
        pity = 8, pityFloor = "Epic",
        dupeGlob = { Common = 400, Uncommon = 900, Rare = 2200, Epic = 5500, Legendary = 14000, Mythic = 30000 },
    },
    {
        id = "beta", name = "Beta Crate",
        blurb = "Season 0 only. Never printed again.",
        price = 0,   -- earned from Beta Season tiers, not sold
        sources = { "beta" },
        trinkets = false,
        weights = { Rare = 52, Epic = 33, Legendary = 12, Mythic = 3 },
        pity = 4, pityFloor = "Epic",
        dupeGlob = { Rare = 3000, Epic = 7000, Legendary = 18000, Mythic = 40000 },
    },
} :: { Crate }

local byId: { [string]: Crate } = {}
for _, c in ipairs(Crates.LIST) do
    byId[c.id] = c
end

function Crates.get(id: string): Crate?
    return byId[id]
end

-- Everything a crate can possibly produce, grouped by rarity. Built lazily and
-- cached, because it is read on every roll and the catalogue never changes at
-- runtime.
local poolCache: { [string]: { [string]: { Reward } } } = {}

local function pool(crate: Crate): { [string]: { Reward } }
    local cached = poolCache[crate.id]
    if cached then
        return cached
    end
    local byRarity: { [string]: { Reward } } = {}
    local function add(r: Reward)
        local bucket = byRarity[r.rarity]
        if not bucket then
            bucket = {}
            byRarity[r.rarity] = bucket
        end
        bucket[#bucket + 1] = r
    end
    for _, item in ipairs(Cosmetics.ITEMS) do
        for _, src in ipairs(crate.sources) do
            if item.source == src then
                add({ kind = "cosmetic", id = item.id, name = item.name, rarity = item.rarity })
                break
            end
        end
    end
    if crate.trinkets then
        for _, t in ipairs(Trinkets.LIST) do
            add({ kind = "trinket", id = t.id, name = t.name, rarity = t.rarity })
        end
    end
    poolCache[crate.id] = byRarity
    return byRarity
end

Crates.RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }

local rank: { [string]: number } = {}
for i, r in ipairs(Crates.RARITY_ORDER) do
    rank[r] = i
end

function Crates.atLeast(rarity: string, floor: string): boolean
    return (rank[rarity] or 0) >= (rank[floor] or 99)
end

-- Roll one crate.
--
-- `sinceGood` is how many rolls the player has made on this crate without
-- hitting the pity floor. When it reaches the pity count the rarity roll is
-- restricted to the floor and above — which is why the counter can be shown
-- honestly on the button instead of hinted at.
--
-- Returns the reward and the new sinceGood.
function Crates.roll(crateId: string, rng: Random, sinceGood: number): (Reward?, number)
    local crate = byId[crateId]
    if not crate then
        return nil, sinceGood
    end
    local byRarity = pool(crate)
    local forced = sinceGood + 1 >= crate.pity

    local total, acc = 0, {}
    for rarity, weight in pairs(crate.weights) do
        local bucket = byRarity[rarity]
        if bucket and #bucket > 0 then
            if not forced or Crates.atLeast(rarity, crate.pityFloor) then
                total += weight
                acc[#acc + 1] = { rarity = rarity, acc = total }
            end
        end
    end
    if total <= 0 then
        return nil, sinceGood
    end
    -- Sort for determinism: pairs() order over a hash table is not stable, and
    -- a gacha whose outcome depends on table iteration order is a gacha that
    -- cannot be tested or audited.
    table.sort(acc, function(a, b)
        return (rank[a.rarity] or 0) < (rank[b.rarity] or 0)
    end)
    local running = 0
    for _, e in ipairs(acc) do
        running += crate.weights[e.rarity]
        e.acc = running
    end

    local pick = rng:NextNumber() * total
    local chosen = acc[#acc].rarity
    for _, e in ipairs(acc) do
        if pick <= e.acc then
            chosen = e.rarity
            break
        end
    end

    local bucket = byRarity[chosen]
    local reward = bucket[rng:NextInteger(1, #bucket)]

    local nextSince = if Crates.atLeast(chosen, crate.pityFloor) then 0 else sinceGood + 1
    return reward, nextSince
end

-- Duplicates convert to Glob rather than vanishing. A duplicate that gives
-- nothing is the single fastest way to teach a player that opening crates is
-- a waste of time.
function Crates.dupeValue(crateId: string, rarity: string): number
    local crate = byId[crateId]
    if not crate then
        return 0
    end
    return crate.dupeGlob[rarity] or 0
end

function Crates.rollsUntilPity(crateId: string, sinceGood: number): number
    local crate = byId[crateId]
    if not crate then
        return 0
    end
    return math.max(0, crate.pity - sinceGood)
end

return Crates
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000006"><Properties><string name="Name">Crew</string><ProtectedString name="Source"><![CDATA[--!strict
-- Crew.luau — lightweight crews.
--
-- I argued against this in DESIGN.md and the argument was: guilds solve
-- COORDINATION, and the game had nothing to coordinate. A crew system then
-- would have been a roster, a chat tab and a name tag — surface area with no
-- payoff.
--
-- The Sumo Pit changes that. There is now a shared, repeatable objective worth
-- pursuing together, so a crew gets a weekly target that no one person can hit
-- alone and everybody's contribution is visible.
--
-- It stays deliberately small: no ranks, no permissions tree, no bank, no crew
-- vs crew war. Those are answers to problems this game does not have yet.

local Crew = {}

Crew.MAX_MEMBERS = 20
Crew.TAG_LENGTH = 4
Crew.CREATE_COST_SECONDS = 600   -- ten minutes of your income

-- One weekly target that rotates, so a crew always has a current answer to
-- "what are we doing". Each is reachable by a handful of active members.
Crew.GOALS = {
    { id = "catches", label = "Catch %s things",       target = 4000,  metric = "catches" },
    { id = "gulps",   label = "Gulp %s Goobs",          target = 120,   metric = "gulps" },
    { id = "pit",     label = "Win %s Pit matches",     target = 45,    metric = "pitWins" },
    { id = "trades",  label = "Complete %s trades",     target = 150,   metric = "trades" },
    { id = "ascend",  label = "Ascend %s times",        target = 12,    metric = "ascensions" },
}

Crew.REWARD_GLOB_SECONDS = 1800  -- half an hour of income, each

function Crew.goalForWeek(week: number)
    return Crew.GOALS[(week % #Crew.GOALS) + 1]
end

function Crew.currentWeek(now: number?): number
    return math.floor((now or os.time()) / (7 * 86400))
end

-- Tags are what appear on a nameplate, so they must be short, loud and free of
-- anything that reads as impersonation or an insult once filtered.
function Crew.sanitiseTag(raw: string): string?
    if typeof(raw) ~= "string" then return nil end
    local t = raw:upper():gsub("[^A-Z0-9]", "")
    if #t < 2 or #t > Crew.TAG_LENGTH then return nil end
    return t
end

function Crew.sanitiseName(raw: string): string?
    if typeof(raw) ~= "string" then return nil end
    local n = raw:match("^%s*(.-)%s*$") or ""
    if #n < 3 or #n > 20 then return nil end
    if n:match("[^%w%s'%-!]") then return nil end
    return n
end

function Crew.blank(id: string, name: string, tag: string, ownerId: number, week: number)
    return {
        id = id,
        name = name,
        tag = tag,
        ownerId = ownerId,
        members = { [tostring(ownerId)] = { name = "", joined = os.time(), contributed = 0 } },
        week = week,
        progress = 0,
        claimed = {} :: { [string]: boolean },
    }
end

function Crew.memberCount(crew: any): number
    local n = 0
    for _ in pairs(crew.members or {}) do n += 1 end
    return n
end

function Crew.isFull(crew: any): boolean
    return Crew.memberCount(crew) >= Crew.MAX_MEMBERS
end

-- Reset progress when the week rolls, but never wipe membership.
function Crew.rollWeek(crew: any, week: number): boolean
    if crew.week == week then return false end
    crew.week = week
    crew.progress = 0
    crew.claimed = {}
    for _, m in pairs(crew.members or {}) do m.contributed = 0 end
    return true
end

function Crew.contribute(crew: any, userId: number, metric: string, amount: number, week: number): boolean
    Crew.rollWeek(crew, week)
    local goal = Crew.goalForWeek(week)
    if goal.metric ~= metric then return false end
    crew.progress = math.min(goal.target, (crew.progress or 0) + amount)
    local m = crew.members and crew.members[tostring(userId)]
    if m then m.contributed = (m.contributed or 0) + amount end
    return crew.progress >= goal.target
end

function Crew.isComplete(crew: any, week: number): boolean
    return (crew.progress or 0) >= Crew.goalForWeek(week).target
end

function Crew.hasClaimed(crew: any, userId: number): boolean
    return (crew.claimed or {})[tostring(userId)] == true
end

function Crew.markClaimed(crew: any, userId: number)
    crew.claimed = crew.claimed or {}
    crew.claimed[tostring(userId)] = true
end

return Crew
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">Feedstock</string><ProtectedString name="Source"><![CDATA[--!strict
-- Feedstock.luau — the catalogue of everything a Goob can swallow.
--
-- DESIGN NOTE: the contents of a Goob are VISIBLE through its translucent
-- body. That means this list is not just loot-table data, it is the art of the
-- game. A Goob stuffed with 300 rubber ducks looks completely different from
-- one stuffed with 300 traffic cones, and that visual difference is the
-- player's entire flex. So every entry needs a distinct silhouette and colour.

export type Item = {
    id: string,
    name: string,
    mass: number,          -- how much mass it contributes once digested
    rarity: string,
    weight: number,        -- relative spawn chance among critters
    color: Color3,
    shape: string,         -- Ball | Block | Cylinder | Wedge  (visible inside the Goob)
    scale: Vector3,
}

-- PALETTE RULE: nothing in this table goes above ~46% saturation or ~88%
-- value. Thirty objects at full neon, suspended inside a translucent shell,
-- read as visual noise rather than as a collection. Hues are unchanged, so a
-- traffic cone is still orange and a rubber duck still yellow — they are just
-- pulled back far enough to sit in a muted world.
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local Feedstock = {}

Feedstock.RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

Feedstock.RARITY_COLOR = {
    Common    = rgb(176, 178, 178),
    Uncommon  = rgb(140, 178, 138),
    Rare      = rgb(132, 168, 206),
    Epic      = rgb(162, 142, 190),
    Legendary = rgb(206, 176, 114),
    Mythic    = rgb(196, 130, 148),
    Secret    = rgb(224, 221, 211),
}

-- BALANCE NOTE (measured, not guessed — see roblox/tools/balance.luau)
--
-- The first pass had Secret items at 0.9M-4M mass. Simulating 300 players
-- showed that one Pocket Singularity accounted for 69-93% of a player's
-- ENTIRE progression to Colossal, and Secret items alone were 48% of all value
-- in the game. That makes the game a slot machine: twenty hours of play gets
-- erased by one drop, and there is nothing left worth trading because a single
-- Secret outweighs everything a player could offer for it.
--
-- So the top of the ladder is deliberately compressed. The rule now is:
-- NO SINGLE DROP MAY EXCEED ~5% OF THE COLOSSAL MILESTONE.
--
-- Secrets are still the rarest things in the game (1 in ~20,000), they still
-- sit visibly inside your Goob forever, and they are still what people will
-- trade for. They are COLLECTIBLES, not power spikes. That distinction is what
-- keeps the economy liquid: if the rarest item were also the most powerful,
-- nobody would ever part with one and the market would seize.
Feedstock.ITEMS = {
    -- Common ────────────────────────────────────────────────────────────────
    { id = "sock",     name = "Lost Sock",       mass = 1,     rarity = "Common",    weight = 100, color = rgb(220, 220, 224), shape = "Block",    scale = Vector3.new(0.5, 0.9, 0.3) },
    { id = "pebble",   name = "Pebble",          mass = 1,     rarity = "Common",    weight = 100, color = rgb(150, 148, 140), shape = "Ball",     scale = Vector3.new(0.5, 0.5, 0.5) },
    { id = "acorn",    name = "Acorn",           mass = 2,     rarity = "Common",    weight =  85, color = rgb(150, 117,  81), shape = "Ball",     scale = Vector3.new(0.45, 0.6, 0.45) },
    { id = "can",      name = "Dented Can",      mass = 3,     rarity = "Common",    weight =  70, color = rgb(195, 200, 210), shape = "Cylinder", scale = Vector3.new(0.7, 0.55, 0.55) },
    { id = "cone",     name = "Traffic Cone",    mass = 4,     rarity = "Common",    weight =  60, color = rgb(224, 155, 121), shape = "Wedge",    scale = Vector3.new(0.7, 0.9, 0.7) },

    -- Uncommon ──────────────────────────────────────────────────────────────
    { id = "duck",     name = "Rubber Duck",     mass = 12,    rarity = "Uncommon",  weight = 42, color = rgb(224, 203, 121), shape = "Ball",     scale = Vector3.new(0.8, 0.7, 1.0) },
    { id = "pizza",    name = "Cold Pizza",      mass = 15,    rarity = "Uncommon",  weight = 38, color = rgb(224, 179, 121), shape = "Wedge",    scale = Vector3.new(1.1, 0.2, 1.1) },
    { id = "boot",     name = "Big Boot",        mass = 18,    rarity = "Uncommon",  weight = 32, color = rgb(105,  74,  57), shape = "Block",    scale = Vector3.new(0.7, 0.8, 1.2) },
    { id = "toaster",  name = "Toaster",         mass = 24,    rarity = "Uncommon",  weight = 26, color = rgb(210, 215, 224), shape = "Block",    scale = Vector3.new(1.0, 0.8, 0.7) },

    -- Rare ──────────────────────────────────────────────────────────────────
    { id = "anvil",    name = "Anvil",           mass = 90,    rarity = "Rare",      weight = 17, color = rgb( 85,  88,  95), shape = "Block",    scale = Vector3.new(1.2, 0.8, 0.7) },
    { id = "piano",    name = "Tiny Piano",      mass = 120,   rarity = "Rare",      weight = 13, color = rgb( 40,  40,  46), shape = "Block",    scale = Vector3.new(1.4, 0.9, 1.0) },
    { id = "globe",    name = "Globe",           mass = 150,   rarity = "Rare",      weight = 11, color = rgb(113, 165, 210), shape = "Ball",     scale = Vector3.new(1.1, 1.1, 1.1) },

    -- Epic ──────────────────────────────────────────────────────────────────
    { id = "meteor",   name = "Warm Meteor",     mass = 600,   rarity = "Epic",      weight = 6.0, color = rgb(120,  78,  65), shape = "Ball",     scale = Vector3.new(1.4, 1.4, 1.4) },
    { id = "statue",   name = "Marble Statue",   mass = 820,   rarity = "Epic",      weight = 4.5, color = rgb(224, 223, 215), shape = "Block",    scale = Vector3.new(0.9, 2.0, 0.9) },
    { id = "safe",     name = "Bank Safe",       mass = 1100,  rarity = "Epic",      weight = 3.2, color = rgb( 60,  75,  70), shape = "Block",    scale = Vector3.new(1.3, 1.5, 1.3) },

    -- Legendary ─────────────────────────────────────────────────────────────
    { id = "car",      name = "Rusty Car",       mass = 4500,  rarity = "Legendary", weight = 1.4, color = rgb(190, 106, 103), shape = "Block",    scale = Vector3.new(1.2, 0.9, 2.6) },
    { id = "bell",     name = "Cathedral Bell",  mass = 6200,  rarity = "Legendary", weight = 0.9, color = rgb(205, 177, 111), shape = "Cylinder", scale = Vector3.new(1.8, 1.8, 1.8) },

    -- Mythic ────────────────────────────────────────────────────────────────
    { id = "moon",     name = "Chunk of Moon",   mass = 20000, rarity = "Mythic",    weight = 0.22, color = rgb(210, 213, 224), shape = "Ball",    scale = Vector3.new(2.4, 2.4, 2.4) },
    { id = "blackbox", name = "The Black Box",   mass = 30000, rarity = "Mythic",    weight = 0.14, color = rgb( 32,  32,  41), shape = "Block",   scale = Vector3.new(1.6, 1.6, 1.6) },

    -- Secret ────────────────────────────────────────────────────────────────
    -- Deliberately absurd odds. These exist to be screenshotted and traded,
    -- not to be farmed. ~1 in 40,000 catches.
    { id = "goobfsl",  name = "Goob Fossil",     mass = 120000, rarity = "Secret", weight = 0.020, color = rgb(224, 220, 180), shape = "Ball",  scale = Vector3.new(2.0, 2.0, 2.0) },
    { id = "singular", name = "Pocket Singularity", mass = 250000, rarity = "Secret", weight = 0.006, color = rgb( 29,  29,  41), shape = "Ball", scale = Vector3.new(1.5, 1.5, 1.5) },
}

local byId: { [string]: Item } = {}
local totalWeight = 0
for _, item in ipairs(Feedstock.ITEMS) do
    byId[item.id] = item
    totalWeight += item.weight
end

Feedstock.TOTAL_WEIGHT = totalWeight

function Feedstock.get(id: string): Item?
    return byId[id]
end

-- Weighted roll.
--
-- `luck` > 1 shifts the roll toward better items. `allowSecret` defaults to
-- true; the Snack Stand passes FALSE, and that is a deliberate design rule:
--
--   ⭐ SECRETS CANNOT BE BOUGHT. THEY ONLY COME FROM WILD CATCHES. ⭐
--
-- Why it exists: simulation showed a 40-roll Banquet at luck x4 put Secret
-- odds at 1 in ~104 per purchase. On a brand-new Goob one such purchase
-- yielded 292,000 mass — 19x the average and 6% of the entire Colossal
-- milestone, bought with 27 minutes of AFK income on day one. That is the
-- slot-machine failure mode all over again, and worse, it lets money buy the
-- collectibles the whole trading economy is built on.
--
-- Locking Secrets to the wild loop fixes both at once: the active loop gets a
-- reward the idle loop can NEVER provide, and the rarest items in the game
-- stay earned rather than purchased.
--
-- Luck is also capped per tier rather than applied flat, so a high-luck roll
-- reliably improves the MIDDLE of the table (where steady progression lives)
-- instead of buying lottery tickets at the top.
local LUCK_CAP = {
    Common    = 0,    -- luck only ever reduces these
    Uncommon  = 0,
    Rare      = 3.0,
    Epic      = 3.0,
    Legendary = 2.0,
    Mythic    = 1.5,  -- deliberately weak; Mythics should still feel like luck
    Secret    = 1.0,  -- never boosted, even on a wild catch
}

function Feedstock.roll(rng: Random, luck: number?, allowSecret: boolean?): Item
    local l = math.max(1, luck or 1)
    local permitSecret = allowSecret ~= false

    local sum = 0
    local acc = {}
    for _, item in ipairs(Feedstock.ITEMS) do
        if item.rarity == "Secret" and not permitSecret then
            continue
        end
        local w = item.weight
        if l > 1 then
            local cap = LUCK_CAP[item.rarity] or 1
            if cap <= 0 then
                w /= l              -- commons get rarer as luck rises
            else
                w *= math.min(l, cap)
            end
        end
        sum += w
        table.insert(acc, { item = item, acc = sum })
    end

    local pick = rng:NextNumber() * sum
    for _, entry in ipairs(acc) do
        if pick <= entry.acc then return entry.item end
    end
    return acc[#acc] and acc[#acc].item or Feedstock.ITEMS[1]
end

return Feedstock
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[--!strict
-- Format.luau — number formatting for a genuinely huge power scale.
-- Goob mass is expected to reach 1e30+. Roblox's default tostring() gives you
-- "1e+30" which means nothing to a nine-year-old, so we ladder suffixes.

local Format = {}

local SUFFIXES = {
    "", "K", "M", "B", "T",
    "Qa", "Qi", "Sx", "Sp", "Oc", "No",
    "Dc", "UDc", "DDc", "TDc", "QaDc", "QiDc", "SxDc", "SpDc", "OcDc", "NoDc",
    "Vg", "UVg", "DVg", "TVg", "QaVg", "QiVg", "SxVg", "SpVg", "OcVg", "NoVg",
    "Tg",
}

-- 1234 -> "1.23K" ; 1e15 -> "1Qa" ; 999 -> "999"
--
-- Two bugs lived here, both found by a property sweep rather than by anyone
-- thinking to test the specific value:
--
--   1. Trailing-zero trimming ran even with no decimal point, so it ate
--      significant digits: 100000 -> "1K", 340000000 -> "34M". Always
--      UNDER-reporting, and worst at exactly the round milestones players watch.
--   2. The sub-1000 path floored instead of rounding, so 11.98 -> "11".
--
-- The invariant now enforced by the suite: parsing the output back must land
-- within 1% of the input, at every magnitude.
function Format.short(n: number): string
    if n ~= n then return "0" end                 -- NaN guard
    if n == math.huge then return "∞" end
    local neg = n < 0
    n = math.abs(n)

    local function sign(str: string): string
        return (neg and "-" or "") .. str
    end

    if n < 1000 then
        -- One decimal below 10 so small values stay informative.
        if n < 10 and n % 1 ~= 0 then
            local s = string.format("%.1f", n)
            if s:find(".", 1, true) then
                s = s:gsub("0+$", ""):gsub("%.$", "")
            end
            return sign(s)
        end
        local rounded = math.round(n)
        if rounded < 1000 then
            return sign(string.format("%d", rounded))
        end
        -- Rounding tipped it into the next tier; fall through and let the
        -- suffix path handle it rather than printing "1000".
    end

    local tier = math.floor(math.log(n, 1000))
    tier = math.clamp(tier, 1, #SUFFIXES - 1)
    local scaled = n / (1000 ^ tier)

    -- Rounding can push the mantissa to 1000 (999.8K -> "1000K"); promote it.
    if scaled >= 999.5 and tier < #SUFFIXES - 1 then
        tier += 1
        scaled = n / (1000 ^ tier)
    end

    local s
    if scaled >= 100 then s = string.format("%.0f", scaled)
    elseif scaled >= 10 then s = string.format("%.1f", scaled)
    else s = string.format("%.2f", scaled) end

    -- Trim trailing zeros ONLY past a decimal point.
    if s:find(".", 1, true) then
        s = s:gsub("0+$", ""):gsub("%.$", "")
    end
    return sign(s .. SUFFIXES[tier + 1])
end

-- 4821 -> "4,821" (used where exactness matters, e.g. census counts)
function Format.comma(n: number): string
    local s = tostring(math.floor(n))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

-- 93784 -> "1d 2h" — used for Goob age, which is the whole rarity axis.
function Format.duration(sec: number): string
    sec = math.max(0, math.floor(sec))
    local d = math.floor(sec / 86400)
    local h = math.floor((sec % 86400) / 3600)
    local m = math.floor((sec % 3600) / 60)
    if d > 0 then return string.format("%dd %dh", d, h) end
    if h > 0 then return string.format("%dh %dm", h, m) end
    if m > 0 then return string.format("%dm", m) end
    return string.format("%ds", sec)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">GoobMath</string><ProtectedString name="Source"><![CDATA[--!strict
-- GoobMath.luau — the single source of truth for how a Goob's numbers work.
-- Shared between server (authority) and client (prediction/display) so the HUD
-- never disagrees with the server about how big your Goob is.

local Config = require(script.Parent.Config)

local GoobMath = {}

export type Goob = {
    id: string,
    nickname: string,
    hue: number,            -- 0-1, the body tint
    mass: number,
    stomach: { { id: string, mass: number } },
    bornAt: number,         -- os.time() at hatch; NEVER reset, travels via trade
    inheritedAge: number,   -- extra seconds absorbed from gulped Goobs
    lineage: { string },    -- nicknames of every Goob this one has eaten
    contents: { [string]: number }, -- itemId -> count, for the visible interior
}

-- Real age in seconds, including age inherited from gulped Goobs.
function GoobMath.ageSeconds(goob: Goob, now: number?): number
    return math.max(0, (now or os.time()) - goob.bornAt) + (goob.inheritedAge or 0)
end

function GoobMath.ageTier(goob: Goob, now: number?)
    local age = GoobMath.ageSeconds(goob, now)
    local best = Config.AGE_TIERS[1]
    for _, tier in ipairs(Config.AGE_TIERS) do
        if age >= tier.seconds then best = tier else break end
    end
    return best
end

function GoobMath.ageMultiplier(goob: Goob, now: number?): number
    return GoobMath.ageTier(goob, now).mult
end

-- POWER is the headline number. It is mass scaled by the age multiplier, so an
-- old Goob genuinely outclasses a freshly-farmed one of the same size. This is
-- the whole anti-inflation thesis expressed in one line.
function GoobMath.power(goob: Goob, now: number?): number
    return goob.mass * GoobMath.ageMultiplier(goob, now)
end

-- Physical radius in studs.
--
-- Logarithmic, so each ORDER OF MAGNITUDE of mass is a roughly equal visible
-- step. See the long note in Config about why a cube root is the wrong curve
-- here — it saturates inside the first few hours of play and then every Goob
-- in the server looks the same.
function GoobMath.size(goob: Goob): number
    local ratio = math.max(1, goob.mass / Config.STARTING_MASS)
    local s = Config.SIZE_BASE * (1 + Config.SIZE_LOG_K * math.log(ratio))
    return math.min(s, Config.SIZE_MAX)
end

function GoobMath.isColossal(goob: Goob): boolean
    return goob.mass >= Config.COLOSSAL_MASS
end

-- Glob per second. Sub-linear so newcomers are never hopelessly behind.
function GoobMath.incomePerSecond(goob: Goob, now: number?): number
    local p = GoobMath.power(goob, now)
    return (p ^ Config.INCOME_EXPONENT) * Config.INCOME_SCALE
end

-- How much stomach mass converts to body mass this frame.
function GoobMath.digestStep(goob: Goob, dt: number): number
    local pending = 0
    for _, entry in ipairs(goob.stomach) do pending += entry.mass end
    if pending <= 0 then return 0 end

    local rate = Config.DIGEST_RATE
    if #goob.stomach > Config.STOMACH_SOFT_CAP then
        rate *= Config.STOMACH_OVERFULL_PENALTY
    end
    return pending * math.min(1, rate * dt)
end

-- Can goob A swallow goob B? Guards against a level-1 Goob eating a whale's
-- Goob in a scam trade, and against eating something so tiny it's pointless.
function GoobMath.canGulp(a: Goob, b: Goob): (boolean, string?)
    if a.id == b.id then return false, "A Goob can't gulp itself." end
    if b.mass > a.mass / Config.GULP_MIN_MASS_RATIO then
        return false, "That Goob is far too big for yours to swallow."
    end
    return true
end

-- Perform the gulp. Returns a NEW mass/age for A. B is destroyed by the caller.
-- Note the transfer is lossy on purpose: mass is permanently burned out of the
-- world every time this runs. That is the deflation engine.
function GoobMath.applyGulp(a: Goob, b: Goob, now: number?): ()
    local n = now or os.time()
    a.mass += b.mass * Config.GULP_MASS_TRANSFER
    a.inheritedAge = (a.inheritedAge or 0) + GoobMath.ageSeconds(b, n) * Config.GULP_AGE_TRANSFER

    -- Absorb the visible contents so the interior tells the full story.
    for itemId, count in pairs(b.contents) do
        a.contents[itemId] = (a.contents[itemId] or 0) + count
    end

    -- Lineage: the eaten Goob's name, and everything IT ever ate, is recorded.
    table.insert(a.lineage, b.nickname)
    for _, ancestor in ipairs(b.lineage) do
        table.insert(a.lineage, ancestor)
    end
    -- Cap the stored lineage so a 10,000-generation Goob doesn't blow the
    -- DataStore 4MB limit. We keep the most recent 60 names.
    while #a.lineage > 60 do table.remove(a.lineage, 1) end
end

-- Price of a snack tier, in Glob, for this Goob right now.
--
-- Expressed as "N seconds of your own income", so the stand stays exactly as
-- affordable at 1e12 mass as it was at 100. Shared with the client so the
-- price on the button is always the price the server charges.
-- WHAT USED TO BE HERE. `snackPrice` and `eggPrice` both priced a purchase in
-- SECONDS OF THE OWNER'S INCOME, so a snack cost roughly the same amount of
-- waiting at every scale. It was a good idea for the game it was written for
-- and it has no customer left: the Snack Stand and the Egg Stand are gone, and
-- feeding and eggs both come out of finishing rounds now. Deleting them rather
-- than leaving them unreferenced, because an unreferenced pricing function is
-- an invitation to reintroduce the shop it priced.
--
-- The replacement rules live in Config: ROUND_FEED_PER_GLOB scales a payout
-- into feedstock rolls, ROUND_FEED_LUCK makes first place a better table, and
-- EGG_EVERY_ROUNDS hatches the slot. None of them need an income curve,
-- because none of them are bought.

function GoobMath.generation(goob: Goob): number
    return #goob.lineage + 1
end

return GoobMath
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">Monetisation</string><ProtectedString name="Source"><![CDATA[--!strict
-- Monetisation.luau — what may be sold, and the wall around the economy.
--
-- THE WALL: Robux may buy expression and convenience. It may never buy mass,
-- age, luck, Secrets, or a trading advantage. The balance simulation already
-- caught the failure where money reached the collectibles through the snack
-- shop; a cash register is the same failure in a different coat.
--
-- Every product below is checked against that rule by the test suite, so
-- adding a pay-to-win item is a build failure rather than a judgement call.

local Monetisation = {}

-- Replace the zeros with real IDs from the Creator Dashboard. They are kept
-- here rather than inline so there is exactly one place to edit, and so the
-- suite can assert that nothing unconfigured is ever shown for sale.
Monetisation.GAMEPASSES = {
    {
        id = "premium_pass",
        assetId = 0,
        name = "Season Pass — Premium",
        blurb = "Unlocks the second reward column on tiers you have already earned.",
        grants = "season_premium",
        affects = "cosmetic",
    },
    {
        id = "extra_slots",
        assetId = 0,
        name = "+4 Goob Slots",
        blurb = "Room for twelve Goobs instead of eight. Slots hold; they do not generate.",
        grants = "goob_slots_4",
        affects = "convenience",
    },
    {
        id = "double_glob",
        assetId = 0,
        name = "2× Glob",
        blurb = "Doubles passive income. Glob only buys snacks and eggs, both deliberately weak.",
        grants = "glob_2x",
        affects = "convenience",
    },
}

Monetisation.PRODUCTS = {
    { id = "skin_void",  assetId = 0, name = "Void Skin",   cosmetic = "skin_void",   affects = "cosmetic" },
    -- Was "skin_stone", a grey Boulder, which no longer exists: the skin
    -- catalogue went neon so that the greyscale interface has something to
    -- frame. Magma replaces it on the shelf. The check in systems.luau caught
    -- this the moment the catalogue changed, which is exactly what a shelf
    -- pointing at a missing item should do — an unconfigured purchase prompt
    -- fails silently in Studio and reads to the player as a scam.
    { id = "skin_magma", assetId = 0, name = "Magma Skin",  cosmetic = "skin_magma",  affects = "cosmetic" },
    { id = "trail_frost",assetId = 0, name = "Frost Trail", cosmetic = "trail_frost", affects = "cosmetic" },
    { id = "eyes_star",  assetId = 0, name = "Starstruck",  cosmetic = "eyes_star",   affects = "cosmetic" },
    { id = "crown_cap",  assetId = 0, name = "Cap",         cosmetic = "crown_cap",   affects = "cosmetic" },
}

-- The allowed categories. Anything else is pay-to-win by definition.
Monetisation.ALLOWED_EFFECTS = { cosmetic = true, convenience = true }

-- Things that must NEVER appear as a purchasable grant, named explicitly so the
-- rule is testable rather than aspirational.
Monetisation.FORBIDDEN_GRANTS = {
    "mass", "power", "age", "crest", "secret", "luck", "drop_rate",
    "trade_fee", "market", "goob", "ascend",
}

function Monetisation.isConfigured(entry: any): boolean
    return (entry.assetId or 0) > 0
end

-- Only offer what has a real asset id behind it. Showing an unconfigured
-- product is a purchase prompt that silently fails, which reads as a scam.
function Monetisation.purchasable(list: { any }): { any }
    local out = {}
    for _, e in ipairs(list) do
        if Monetisation.isConfigured(e) then table.insert(out, e) end
    end
    return out
end

function Monetisation.violations(): { string }
    local bad = {}
    local function scan(list, label)
        for _, e in ipairs(list) do
            if not Monetisation.ALLOWED_EFFECTS[e.affects or ""] then
                table.insert(bad, ("%s/%s has affects=%q"):format(label, e.id, tostring(e.affects)))
            end
            local grant = tostring(e.grants or e.cosmetic or "")
            for _, forbidden in ipairs(Monetisation.FORBIDDEN_GRANTS) do
                -- "goob_slots_4" is a slot, not a Goob; match whole words only.
                if grant == forbidden or grant:match("^" .. forbidden .. "$") then
                    table.insert(bad, ("%s/%s grants %q"):format(label, e.id, grant))
                end
            end
        end
    end
    scan(Monetisation.GAMEPASSES, "gamepass")
    scan(Monetisation.PRODUCTS, "product")

    -- ── THE PREMIUM SEASON TRACK IS PURCHASABLE, SO IT IS INSIDE THE WALL ──
    --
    -- This was a hole. The wall scanned gamepasses and products and stopped,
    -- but the premium season track is bought with Robux too — so a power
    -- placed on it would have been money buying a button nobody else has, and
    -- nothing here would have said a word.
    --
    -- It is now structurally hard to do (Season.powerAt takes no premium
    -- argument, so there is nowhere to put one) and checked anyway. Structure
    -- stops the accident; this stops somebody deciding to add the argument.
    local okSeason, Season = pcall(function()
        return require(script.Parent.Season)
    end)
    local okPowers, Powers = pcall(function()
        return require(script.Parent.Powers)
    end)
    if okSeason and okPowers and Season and Powers then
        local isPower = {}
        for _, pool in ipairs({ Powers.FIXED, Powers.LIST, Powers.SEASON }) do
            for _, power in ipairs(pool or {}) do isPower[power.id] = true end
        end
        for tier = 1, (Season.TIERS or 0) do
            local paid = Season.rewardAt(tier, true)
            if paid and isPower[paid] then
                table.insert(bad,
                    ("season/premium tier %d grants the power %q"):format(tier, paid))
            end
        end
    end

    return bad
end

return Monetisation
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[--!strict
-- Movement.luau — mass IS handling.
--
-- THE WHOLE POINT: in Grow a Garden your number is a label on a crop. Here your
-- number is how you move. A 10x bigger Goob doesn't just read bigger — it takes
-- longer to get going, can't stop, hits harder, and reaches places a small one
-- cannot. Every value below exists to make that legible through the controller
-- rather than through a HUD.
--
-- Curves are logarithmic in mass, matching GoobMath.size, so each ORDER OF
-- MAGNITUDE is a felt step rather than the first thousand mass being everything.

local Config = require(script.Parent.Config)

local Movement = {}

-- ── Tunables ───────────────────────────────────────────────────────────────
Movement.BASE_SPEED = 34        -- studs/sec at starting mass
Movement.SPEED_PER_TIER = 4.2   -- per order of magnitude of mass
Movement.MAX_SPEED = 82

Movement.BASE_ACCEL = 95        -- studs/sec^2 at starting mass
Movement.ACCEL_FALLOFF = 0.34   -- higher = heavier Goobs labour more

Movement.BASE_BRAKE = 70
Movement.BRAKE_FALLOFF = 0.42   -- stopping degrades faster than starting

Movement.JUMP_SPEED = 52
-- Near-constant on purpose. If jump height fell with mass, every gap tuned for
-- a small Goob would become impassable later — progression would lock you OUT
-- of content for getting stronger. Weight is expressed through acceleration,
-- braking and momentum instead, where it reads as power rather than punishment.
Movement.JUMP_FALLOFF = 0.03

-- Dash is the skill layer and the reason the map can have gaps at all.
Movement.DASH_SPEED = 96
Movement.DASH_TIME = 0.22
Movement.DASH_CHARGES = 3
Movement.DASH_REFILL = 2.6      -- seconds per charge
Movement.AIR_DASHES = 1         -- exactly one. A correction, not flight.

Movement.GRAVITY_BOOST = 1.35   -- falls faster than default; arcade, not floaty

-- ── Curves ─────────────────────────────────────────────────────────────────

-- 0 at starting mass, 1 per 10x. This is the only input every curve uses.
function Movement.tier(mass: number): number
    return math.max(0, math.log10(math.max(1, mass / Config.STARTING_MASS)))
end

function Movement.topSpeed(mass: number): number
    return math.min(Movement.MAX_SPEED,
        Movement.BASE_SPEED + Movement.SPEED_PER_TIER * Movement.tier(mass))
end

function Movement.acceleration(mass: number): number
    return Movement.BASE_ACCEL / (1 + Movement.ACCEL_FALLOFF * Movement.tier(mass))
end

function Movement.braking(mass: number): number
    return Movement.BASE_BRAKE / (1 + Movement.BRAKE_FALLOFF * Movement.tier(mass))
end

function Movement.jumpSpeed(mass: number): number
    return Movement.JUMP_SPEED / (1 + Movement.JUMP_FALLOFF * Movement.tier(mass))
end

-- How far you travel after releasing the stick at top speed. This is the number
-- that actually communicates weight to the player, so the suite asserts on it.
function Movement.stoppingDistance(mass: number): number
    local v = Movement.topSpeed(mass)
    return (v * v) / (2 * Movement.braking(mass))
end

function Movement.timeToTopSpeed(mass: number): number
    return Movement.topSpeed(mass) / Movement.acceleration(mass)
end

-- Shove strength in the Sumo Pit: momentum, so heavy wins the exchange but
-- pays for it by being unable to stop before the edge.
function Movement.momentum(mass: number, speed: number): number
    return math.sqrt(math.max(1, mass / Config.STARTING_MASS)) * speed
end

-- The server's cheat ceiling. Generous — network jitter and dash stacking are
-- legitimate — but a teleport is many times this.
function Movement.maxPlausibleSpeed(mass: number): number
    return math.max(Movement.topSpeed(mass), Movement.DASH_SPEED) * 1.9
end

return Movement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">Names</string><ProtectedString name="Source"><![CDATA[--!strict
-- Names.luau — every Goob is auto-named at hatch. Names are silly, readable,
-- and pronounceable by a seven-year-old, because the name is what gets shouted
-- across a trading server.

local Names = {}

local FIRST = {
    "Gob", "Blorp", "Squish", "Mun", "Pib", "Wobble", "Drool", "Chomp", "Glug",
    "Nub", "Splat", "Thonk", "Bimble", "Gurp", "Snorf", "Plop", "Yeet", "Crumb",
    "Zorp", "Mopp", "Bap", "Flub", "Gnash", "Slurm", "Quib", "Doof", "Hork",
}

local SECOND = {
    "kin", "ling", "ster", "bo", "zo", "ers", "us", "ito", "ington", "azoid",
    "omatic", "erson", "amus", "ini", "oid", "opolis", "whack", "nugget",
}

local TITLE = {
    "the Damp", "the Round", "Jr.", "Sr.", "the Third", "the Hungry",
    "Esq.", "the Wide", "the Unbothered", "the Enormous", "the Soggy",
    "the Loud", "the Brave", "the Confused", "of the Deep", "the Elder",
}

function Names.random(rng: Random): string
    local name = FIRST[rng:NextInteger(1, #FIRST)] .. SECOND[rng:NextInteger(1, #SECOND)]
    if rng:NextNumber() < 0.30 then
        name ..= " " .. TITLE[rng:NextInteger(1, #TITLE)]
    end
    return name
end

-- Players can rename their Goob. We allow letters, digits, spaces and a couple
-- of punctuation marks only — Roblox's own TextService filter runs on top of
-- this server-side, this is just the cheap structural pass.
function Names.sanitize(raw: string): string?
    if typeof(raw) ~= "string" then return nil end
    local trimmed = raw:match("^%s*(.-)%s*$") or ""
    if #trimmed < 2 or #trimmed > 22 then return nil end
    if trimmed:match("[^%w%s'%.%-!]") then return nil end
    return trimmed
end

return Names
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000013"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
-- Net.luau — one manifest of every RemoteEvent/RemoteFunction in the game.
-- The server creates them; the client waits for them. Neither side hardcodes a
-- string anywhere else, so a typo becomes a Luau error instead of a silent
-- "nothing happens when I click the button" bug.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.EVENTS = {
    "StateSync",      -- S->C  full/partial profile push
    "Notify",         -- S->C  toast message
    "FeedGoob",       -- C->S  push stomach items (auto, but kept explicit)
    "RenameGoob",     -- C->S
    "SetActiveGoob",  -- C->S  choose which Goob sits on your plot
    "Ascend",         -- C->S  consume a Colossal Goob for a permanent Crest
    "Dashed",         -- C->S  cosmetic: tell the server a dash happened
    "EquipCosmetic",  -- C->S  wear something you own
    "ClaimSeason",    -- C->S  take an earned season reward
    "PitJoin",        -- C->S  enter the Sumo Pit queue
    "PitLeave",       -- C->S  leave it
    "PitSync",        -- S->C  live arena state
    "CrewCreate",     -- C->S
    "CrewJoin",       -- C->S
    "CrewLeave",      -- C->S
    "CrewClaim",      -- C->S  take the weekly crew reward
    "CrewSync",       -- S->C
    "BuyProduct",     -- C->S  prompt a Robux purchase
    "Effect",         -- S->C  cosmetic feedback: catch, gulp, ascend, shove
    "GulpGoob",       -- C->S  feed one of my Goobs to another
    "TradeRequest",   -- C->S
    "TradeRespond",   -- C->S
    "TradeOffer",     -- C->S  put/remove a Goob in a slot
    "TradeConfirm",   -- C->S
    "TradeCancel",    -- C->S
    "TradeSync",      -- S->C  live state of the open trade window
    "LeaderboardSync",-- S->C
    -- ── Arena ──────────────────────────────────────────────────────────────
    "ArenaSync",      -- S->C  live run state: mass, leak, bank progress, power
    "UsePower",       -- C->S  press the one button
    "SetPower",       -- C->S  choose which power you carry
    "EquipTrinket",   -- C->S  slot a trinket
    "OpenCrate",      -- C->S  spend Glob on a roll
    "CrateResult",    -- S->C  what came out
    "RoundSync",      -- S->C  phase, clock and the last round's results
}

Net.FUNCTIONS = {
    "RequestProfile", -- C->S  initial load
    "RequestGoob",    -- C->S  inspect another player's Goob (for trade vetting)
}

local folder: Folder

function Net.init(): Folder
    assert(RunService:IsServer(), "Net.init must run on the server")
    folder = Instance.new("Folder")
    folder.Name = "GoobNet"
    for _, name in ipairs(Net.EVENTS) do
        local r = Instance.new("RemoteEvent")
        r.Name = name
        r.Parent = folder
    end
    for _, name in ipairs(Net.FUNCTIONS) do
        local r = Instance.new("RemoteFunction")
        r.Name = name
        r.Parent = folder
    end
    folder.Parent = ReplicatedStorage
    return folder
end

function Net.get(name: string): any
    if not folder then
        folder = ReplicatedStorage:WaitForChild("GoobNet") :: Folder
    end
    return folder:WaitForChild(name)
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000014"><Properties><string name="Name">Pit</string><ProtectedString name="Source"><![CDATA[--!strict
-- Pit.luau — rules for the Sumo Pit.
--
-- TWO RULES THAT ARE NOT NEGOTIABLE, and the reason PvP exists at all here:
--
--   1. It is OPT-IN. You roll in. Nothing drags you there, and nothing outside
--      the ring can be taken from you. Grow a Garden became a comfort game for
--      millions precisely because no one can touch your things.
--   2. You stake GLOB, never Goobs. A nine-year-old who loses a week-old Goob
--      to a stranger does not come back — and a Goob that can be taken by force
--      is a Goob nobody will ever trade.
--
-- Mass is an advantage AND a liability: heavy wins the exchange but cannot stop
-- before the edge, so a small Goob wins by baiting an overcommit.

local Movement = require(script.Parent.Movement)

local Pit = {}

Pit.CENTRE = Vector3.new(0, 6, 660)
Pit.START_RADIUS = 96
Pit.MIN_RADIUS = 18
Pit.FLOOR_Y = 6

Pit.MIN_PLAYERS = 2
Pit.MAX_PLAYERS = 8
Pit.LOBBY_SECONDS = 20
Pit.MATCH_SECONDS = 120
Pit.SHRINK_START = 15          -- grace before the ring closes
Pit.ELIMINATION_DROP = 24      -- studs below the floor before you're out

-- Entry is a flat, small stake rather than a percentage, so a whale cannot buy
-- a lopsided pot and a newcomer is never priced out of trying it.
Pit.STAKE_SECONDS = 45         -- expressed as seconds of your own income
Pit.HOUSE_CUT = 0              -- no rake: this is a player-vs-player pot

function Pit.radiusAt(elapsed: number): number
    if elapsed <= Pit.SHRINK_START then return Pit.START_RADIUS end
    local span = math.max(1, Pit.MATCH_SECONDS - Pit.SHRINK_START)
    local t = math.clamp((elapsed - Pit.SHRINK_START) / span, 0, 1)
    -- Ease in: the ring barely moves early and closes hard at the end, so
    -- matches resolve instead of stalemating.
    local eased = t * t
    return Pit.START_RADIUS + (Pit.MIN_RADIUS - Pit.START_RADIUS) * eased
end

function Pit.isInside(position: Vector3, elapsed: number): boolean
    if position.Y < Pit.FLOOR_Y - Pit.ELIMINATION_DROP then return false end
    local flat = Vector3.new(position.X - Pit.CENTRE.X, 0, position.Z - Pit.CENTRE.Z)
    return flat.Magnitude <= Pit.radiusAt(elapsed)
end

-- Collision response. The shove each side receives is proportional to the
-- OTHER's momentum, so being heavy is only an advantage while you are moving.
function Pit.shove(massA: number, velA: Vector3, massB: number, velB: Vector3)
    local pA = Movement.momentum(massA, velA.Magnitude)
    local pB = Movement.momentum(massB, velB.Magnitude)
    local total = math.max(1, pA + pB)
    -- Each side keeps a share of the exchange inversely to its own contribution.
    return (pB / total), (pA / total)
end

Pit.SHOVE_IMPULSE = 140        -- studs/sec at a full-share exchange

-- Staked against what you have BANKED, not against a Goob's idle income.
--
-- The old formula was written when idling was the earner, and it survived the
-- rework unnoticed: it meant a player who had never idled — which, after the
-- rework, is everybody — staked the floor of 10 Glob no matter how rich they
-- were, and the Standoff had no stakes at all. It is sub-linear so that a
-- veteran and a newcomer can meet in the same ring without either of them
-- risking something the other would find absurd.
Pit.STAKE_EXPONENT = 0.55
Pit.STAKE_SCALE = 0.8
Pit.STAKE_MIN = 120
Pit.STAKE_MAX_FRACTION = 0.15   -- never more than this share of your purse

function Pit.stakeFor(lifetimeBanked: number, purse: number?): number
    local want = math.max(Pit.STAKE_MIN,
        math.max(0, lifetimeBanked) ^ Pit.STAKE_EXPONENT * Pit.STAKE_SCALE)
    if purse then
        want = math.min(want, math.max(Pit.STAKE_MIN, purse * Pit.STAKE_MAX_FRACTION))
    end
    return math.floor(want)
end

-- Winner takes the pot. With no rake, everything staked comes back out, which
-- keeps the Pit economy-neutral: it moves Glob between players rather than
-- printing or burning it.
function Pit.payout(stakes: { number }): number
    local total = 0
    for _, s in ipairs(stakes) do total += s end
    return total * (1 - Pit.HOUSE_CUT)
end

return Pit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000015"><Properties><string name="Name">Powers</string><ProtectedString name="Source"><![CDATA[--!strict
-- Powers.luau — one button, one big decision.
--
-- Every blob carries exactly ONE power. Not a bar of six, not a combo: one.
-- A nine-year-old on a phone has one thumb free, and the difference between
-- a good player and a bad one should be WHEN they press it, not whether they
-- memorised a rotation.
--
-- Every power costs a slice of your own mass. That is the whole balance model:
-- there is no cooldown-only power, because a cooldown-only power is free, and
-- a free power gets spammed until it is wallpaper. Paying in the same currency
-- you are trying to protect makes every press a real question.
--
-- NOTHING HERE IS FOR SALE. Powers are earned by playing. Monetisation.violations()
-- treats a paid item carrying a power id as a build failure.

local Powers = {}

export type Power = {
    id: string,
    name: string,
    blurb: string,       -- what a kid reads on the button
    cost: number,        -- fraction of current mass, spent on use
    cooldown: number,    -- seconds
    duration: number,    -- seconds of effect, 0 for instant
    unlockBanked: number,-- lifetime banked glob needed to own it
    fixed: boolean?,     -- always in the hotbar; not a choice
    season: boolean?,    -- granted by the season's free track, never by banking
    color: Color3,
}

-- ── THE TWO YOU ALWAYS HAVE ───────────────────────────────────────────────
--
-- DASH and SPLIT are not choices, they are verbs the game is built out of. A
-- game in this shape needs a lunge and a way to throw part of yourself at
-- something out of reach; without both, half the situations on the island have
-- no answer at all.
--
-- They used to sit in the same pool as everything else, competing for the one
-- carried slot — and SPLIT was pinned near the top of the unlock ladder, which
-- meant the mechanic the whole genre is named for was invisible for the first
-- ten hours. Now they are slots 1 and 2, owned from the first second, and the
-- chosen power is slot 3.
--
-- They still cost mass like everything else. That is the balance model and it
-- does not get an exception: a free button is a button that gets held down.
Powers.FIXED = {
    {
        id = "dash", name = "DASH",
        blurb = "Shove yourself forward, fast.",
        cost = 0.05, cooldown = 3.0, duration = 0.22,
        unlockBanked = 0, fixed = true,
        color = Color3.fromRGB(210, 210, 214),
    },
    {
        id = "split", name = "SPLIT",
        blurb = "Throw three pieces of yourself forward, tethered to you.",
        -- Cheaper and far quicker than the old one-shot 50% lunge. SPLIT is
        -- meant to be a move you make several times a round — to reach food,
        -- to fence somebody off, to commit to a kill — not a once-a-minute
        -- gamble with half your body.
        cost = 0.22, cooldown = 9, duration = 6,
        unlockBanked = 0, fixed = true,
        color = Color3.fromRGB(180, 180, 186),
    },
} :: { Power }

-- ── THE ONE YOU CHOOSE ────────────────────────────────────────────────────
--
-- ORDERED BY UNLOCK, and it must stay that way: nextLocked() walks this array
-- and returns the first thing the player cannot afford, so an out-of-order
-- entry points them at a target that is not actually next. Four powers were
-- appended to the end of this list when they were written and it did exactly
-- that until a test caught it.
--
-- Roughly ordered by how much thinking each one asks for, too.
Powers.LIST = {
    {
        id = "magnet", name = "MAGNET",
        blurb = "Yank every loose pellet nearby straight into you.",
        cost = 0.05, cooldown = 12, duration = 4,
        unlockBanked = 3000,
        color = Color3.fromRGB(170, 190, 215),
    },
    {
        id = "slick", name = "SLICK",
        blurb = "Drop a puddle. Whoever's chasing you loses the wheel.",
        cost = 0.06, cooldown = 10, duration = 2,
        unlockBanked = 9000,
        color = Color3.fromRGB(160, 175, 150),
    },
    {
        id = "decoy", name = "DECOY",
        blurb = "Leave a fake you. Whoever bites it gets nothing.",
        cost = 0.14, cooldown = 16, duration = 7,
        unlockBanked = 20000,
        color = Color3.fromRGB(180, 176, 190),
    },
    {
        id = "slam", name = "SLAM",
        blurb = "Jump and crash. Everyone nearby gets thrown, lumps shatter.",
        cost = 0.12, cooldown = 14, duration = 0,
        unlockBanked = 34000,
        color = Color3.fromRGB(205, 170, 140),
    },
    {
        id = "beacon", name = "BEACON",
        blurb = "Light yourself up. Food is worth 45% more — and everyone can see you.",
        cost = 0.06, cooldown = 22, duration = 8,
        unlockBanked = 52000,
        color = Color3.fromRGB(206, 186, 132),
    },
        {
        id = "siphon", name = "SIPHON",
        blurb = "Drain the nearest blob bigger than you.",
        cost = 0.09, cooldown = 19, duration = 3,
        unlockBanked = 100000,
        color = Color3.fromRGB(160, 190, 172),
    },
    {
        id = "bubble", name = "BUBBLE",
        blurb = "Nothing can eat you. You can't eat either.",
        cost = 0.15, cooldown = 20, duration = 3,
        unlockBanked = 132000,
        color = Color3.fromRGB(175, 200, 200),
    },
    {
        id = "blink", name = "BLINK",
        blurb = "Vanish and reappear ahead. Straight through anything.",
        cost = 0.18, cooldown = 17, duration = 0,
        unlockBanked = 215000,
        color = Color3.fromRGB(186, 170, 206),
    },
    } :: { Power }

-- ── EARNED FROM THE BETA SEASON, NOT FROM BANKING ─────────────────────────
--
-- These are not on the ladder and no amount of Glob reaches them. The only way
-- in is playing far enough into the season's FREE track (Season.POWER_AT), and
-- that is deliberate on two counts.
--
-- It makes the season pass worth finishing with something a skin cannot be:
-- a button nobody who skipped the season has. And it keeps the monetisation
-- wall intact, because the free track is the one thing in this game that
-- cannot be bought at any price — `Monetisation.violations()` fails the build
-- if a purchasable item carries a gameplay number, and a power is the most
-- gameplay-carrying thing there is.
--
-- They are kept OUT of Powers.LIST so that `nextLocked` never points a player
-- at a target no amount of play on the banking ladder will reach.
Powers.SEASON = {
    {
        id = "hook", name = "HOOK",
        blurb = "Grab the nearest blob and reel. Bigger pulls, smaller gets pulled.",
        cost = 0.10, cooldown = 13, duration = 1.2,
        unlockBanked = math.huge, season = true,
        color = Color3.fromRGB(214, 214, 218),
    },
    {
        id = "spike", name = "SPIKE",
        blurb = "For three seconds, anything that eats you pops instead.",
        cost = 0.20, cooldown = 24, duration = 3,
        unlockBanked = math.huge, season = true,
        color = Color3.fromRGB(226, 106, 106),
    },
} :: { Power }

-- THE UNLOCK LADDER is paced against banking, which is the only earner: a
-- good run banks roughly 1.2K, and an active hour is somewhere near 25K. So
-- the first four powers arrive inside an hour, the middle four over a week of
-- casual play, and SPIKE sits at about eleven hours of it. The old ladder was
-- written before banking existed and put half the list past any realistic
-- session.
--
-- SPIKE is last and dearest on purpose. It is the tool that lets the smallest
-- blob on the island delete the biggest, which is the single best story this
-- game can produce — and a story stops being a story if it happens every lap.

-- ── Mastery ────────────────────────────────────────────────────────────────
-- Using a power makes you better with THAT power. Not with all of them — the
-- point is to reward committing to one, which is the choice the single slot
-- was already asking you to make. The numbers are deliberately small: three
-- tiers, and a fully mastered power is about 15% quicker and 12% cheaper. It
-- is a reason to keep carrying your favourite, never a reason a newer player
-- cannot beat you.
-- ORDERED BY UNLOCK, and it must stay that way: nextLocked() walks the array
-- and returns the first thing the player cannot afford, so an out-of-order
-- entry points them at a target that is not actually next. Four powers were
-- appended to the end of this list when they were written and it did exactly
-- that until a test caught it.
Powers.MASTERY_TIERS = { 25, 100, 300 }
Powers.MASTERY_COOLDOWN_PER_TIER = 0.05
Powers.MASTERY_COST_PER_TIER = 0.04
Powers.MASTERY_MAX_TIER = 3

function Powers.masteryTier(uses: number?): number
    local n = uses or 0
    local tier = 0
    for _, need in ipairs(-- ORDERED BY UNLOCK, and it must stay that way: nextLocked() walks the array
-- and returns the first thing the player cannot afford, so an out-of-order
-- entry points them at a target that is not actually next. Four powers were
-- appended to the end of this list when they were written and it did exactly
-- that until a test caught it.
Powers.MASTERY_TIERS) do
        if n >= need then tier += 1 end
    end
    return tier
end

-- Uses still to go before the next tier, and what that tier is. nil when the
-- power is fully mastered — a progress bar that never fills is worse than no
-- progress bar.
function Powers.masteryNext(uses: number?): (number?, number?)
    local n = uses or 0
    for i, need in ipairs(Powers.MASTERY_TIERS) do
        if n < need then return i, need - n end
    end
    return nil, nil
end

-- Both pools, by id. FIXED first so that if a power ever appeared in both by
-- mistake the fixed definition is the one that loses — a duplicate should show
-- up as the CHOSEN version being unreachable, which is visible, rather than as
-- the hotbar quietly using different numbers from the wardrobe.
local byId: { [string]: Power } = {}
for _, p in ipairs(Powers.FIXED) do
    byId[p.id] = p
end
for _, p in ipairs(Powers.SEASON) do
    byId[p.id] = p
end
for _, p in ipairs(Powers.LIST) do
    byId[p.id] = p
end

-- The default CHOSEN power — slot 3. Not dash: dash is slot 1 and always has
-- been since the hotbar existed, so defaulting the choice to it would hand a
-- new player a duplicate and an empty-feeling third button.
Powers.DEFAULT = "magnet"

--- What is in each hotbar slot, given what the player owns and what they chose.
--- ONE function, server and client both read it, so "what is in slot 3" cannot
--- have two answers.
function Powers.hotbar(chosenId: string?, lifetimeBanked: number,
    granted: { [string]: boolean }?): { Power }
    local out = { Powers.FIXED[1], Powers.FIXED[2] }
    local chosen = byId[chosenId or ""]
    -- A chosen power that is fixed, unknown, or not yet unlocked falls back to
    -- the default rather than leaving a hole: an empty slot reads as a bug,
    -- and this happens legitimately every time the ladder is rebalanced under
    -- a saved profile.
    local haveIt = chosen ~= nil
        and (lifetimeBanked >= chosen.unlockBanked
            or (granted ~= nil and granted[chosen.id] == true))
    if not chosen or chosen.fixed or not haveIt then
        chosen = byId[Powers.DEFAULT]
    end
    if chosen then
        out[3] = chosen
    end
    return out
end

function Powers.get(id: string): Power?
    return byId[id]
end

-- TWO WAYS TO OWN A POWER, and `granted` is the second one.
--
-- Most are earned on the banking ladder. Two are not on that ladder at all and
-- arrive from the BETA SEASON's free track instead — see Season.POWER_AT. They
-- live in `profile.powersGranted`, and the important property is that there is
-- no third way in: the season's paid track cannot reach them, because
-- Season.powerAt takes no premium argument.
function Powers.owned(lifetimeBanked: number, granted: { [string]: boolean }?): { Power }
    local out = {}
    for _, p in ipairs(Powers.LIST) do
        if lifetimeBanked >= p.unlockBanked or (granted and granted[p.id]) then
            out[#out + 1] = p
        end
    end
    for _, p in ipairs(Powers.SEASON) do
        if granted and granted[p.id] then
            out[#out + 1] = p
        end
    end
    return out
end

--- Every power a player could ever choose from, owned or not — the wardrobe
--- needs to show the locked ones or nobody learns they exist.
function Powers.catalogue(): { Power }
    local out = {}
    for _, p in ipairs(Powers.LIST) do out[#out + 1] = p end
    for _, p in ipairs(Powers.SEASON) do out[#out + 1] = p end
    return out
end

function Powers.isOwned(id: string, lifetimeBanked: number,
    granted: { [string]: boolean }?): boolean
    local p = byId[id]
    if not p then return false end
    if granted and granted[id] then return true end
    return lifetimeBanked >= p.unlockBanked
end

-- What using it actually costs right now, in mass. Floored at a flat minimum
-- so that a tiny blob cannot dash for free and kite the whole server.
function Powers.massCost(id: string, mass: number, uses: number?): number
    local p = byId[id]
    if not p then
        return 0
    end
    local relief = math.min(Powers.MASTERY_MAX_TIER, Powers.masteryTier(uses))
        * Powers.MASTERY_COST_PER_TIER
    return math.max(Powers.MIN_COST, mass * p.cost * (1 - relief))
end

Powers.MIN_COST = 3

function Powers.cooldown(id: string, trinketHaste: number?, uses: number?): number
    local p = byId[id]
    if not p then
        return 0
    end
    local mastery = math.min(Powers.MASTERY_MAX_TIER, Powers.masteryTier(uses))
        * Powers.MASTERY_COOLDOWN_PER_TIER
    -- Clamped TOGETHER, not separately. Trinket haste caps at 35% and mastery
    -- at 15%; without a joint clamp a stacked player could reach half, and a
    -- power on a half cooldown stops being a decision.
    local total = math.clamp((trinketHaste or 0) + mastery, 0, 0.45)
    return p.cooldown * (1 - total)
end

-- The next power a player is working towards, for the HUD's progress line.
-- Returning the goal AND the gap is what makes a locked item feel like a
-- target rather than a wall.
function Powers.nextLocked(lifetimeBanked: number): (Power?, number)
    for _, p in ipairs(Powers.LIST) do
        if lifetimeBanked < p.unlockBanked then
            return p, p.unlockBanked - lifetimeBanked
        end
    end
    return nil, 0
end

return Powers
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000016"><Properties><string name="Name">Season</string><ProtectedString name="Source"><![CDATA[--!strict
-- Season.luau — the retention track.
--
-- XP comes from PLAYING, never from paying. The premium track unlocks a second
-- reward column on tiers you have already earned; it does not sell tiers, and
-- it does not sell anything that touches mass, age, luck or Secrets.
--
-- Seasons also rotate which Secrets can spawn. That is not a cosmetic detail —
-- it is the scarcity thesis expressed as a calendar. Last season's Secrets can
-- never be produced again, so a two-season-old Secret is genuinely finite in a
-- way no drop rate can fake.

local Cosmetics = require(script.Parent.Cosmetics)

local Season = {}

Season.CURRENT = 1
Season.NAME = "Season 1 · First Roll"
Season.TIERS = 50
-- Paced so that a dedicated player hitting the daily cap finishes in ~40 days,
-- i.e. a season takes a season. An earlier pass had the whole 50-tier track
-- completing in EIGHT days, which would have left the most engaged players with
-- nothing to chase for five weeks out of six. The suite now asserts the
-- completion window rather than trusting the constants to stay sane.
Season.XP_PER_TIER = 5600

-- What each action is worth. Deliberately weighted so the track rewards the
-- whole game rather than whichever loop is most afk-able.
Season.XP = {
    catch      = 4,
    secret     = 800,
    -- `snack` is gone with the Snack Stand it paid for. `egg` survives, but
    -- it is now earned by finishing rounds rather than bought, so it fires
    -- roughly once every five rounds instead of whenever somebody has spare
    -- Glob — which makes it worth considerably more than 150 was tuned for.
    egg        = 150,
    gulp       = 110,
    trade      = 90,
    ascend     = 3200,
    pitEnter   = 30,
    pitWin     = 300,
    crewGoal   = 1100,
    -- Banking is the arena's core loop, so it is the arena's core XP source.
    -- 55 a bank and a ~90-second bank puts the daily cap about three hours
    -- out, which is the same shape the rest of the track was paced to.
    bank       = 55,
    round      = 220,   -- finishing a round at all
    deflate    = 8,
    bigBank    = 260,   -- a run taken past 60% of the ceiling before cashing
    pop        = 15,    -- you get something for dying; it is still play
}

-- Daily cap on grindable XP, so the track takes a season rather than a weekend
-- and nobody feels obliged to play eight hours a day. Big one-off events
-- (ascend, pit wins) are exempt — those are achievements, not grinding.
-- ~1750 catches, or about two hours of engaged play, to cap out for the day.
Season.DAILY_CAP = 7000
Season.UNCAPPED = { ascend = true, pitWin = true, secret = true, crewGoal = true }

function Season.blank()
    return {
        id = Season.CURRENT,
        xp = 0,
        premium = false,
        claimedFree = {} :: { [string]: boolean },
        claimedPremium = {} :: { [string]: boolean },
        dailyXp = 0,
        dailyStamp = 0,
    }
end

function Season.tierOf(xp: number): number
    return math.clamp(math.floor(xp / Season.XP_PER_TIER) + 1, 1, Season.TIERS)
end

function Season.progressInTier(xp: number): number
    return (xp % Season.XP_PER_TIER) / Season.XP_PER_TIER
end

-- The reward table, derived from the cosmetics catalogue rather than duplicated
-- so the two can never disagree about which tier grants what.
local rewardCache: { [number]: { free: string?, premium: string? } }? = nil

function Season.rewards(): { [number]: { free: string?, premium: string? } }
    if rewardCache then return rewardCache end
    local out = {}
    for i = 1, Season.TIERS do out[i] = {} end
    for _, item in ipairs(Cosmetics.ITEMS) do
        if item.source == "season" and item.tier then
            local slot = out[item.tier]
            if slot then
                if item.premium then slot.premium = item.id else slot.free = item.id end
            end
        end
    end
    rewardCache = out
    return out
end

-- ── POWERS ON THE SEASON TRACK ────────────────────────────────────────────
--
-- The player asked for rare skills to come out of the Beta Pass. They do — but
-- only on the FREE track, and that is not a detail, it is the monetisation
-- wall.
--
-- The premium track is bought with Robux. `Monetisation.violations()` fails
-- the build if anything purchasable carries a gameplay number, and a POWER is
-- the most gameplay-carrying thing in the game. Putting one on the paid side
-- would mean money buying a button nobody else has, which is the exact failure
-- every rule in that file exists to prevent.
--
-- On the free side it is the opposite: a power that cannot be bought at any
-- price and only arrives by playing far enough into the season. That is a
-- better prize than a skin precisely BECAUSE it cannot be bought, and it is
-- the only way into these two powers — neither is on the banking ladder.
Season.POWER_AT = {
    [22] = "hook",
    [40] = "spike",
}

--- Which power, if any, tier `t` grants. Free track only, by construction:
--- this function does not take a `premium` argument, so there is nowhere to
--- put a paid one even by accident.
function Season.powerAt(tier: number): string?
    return Season.POWER_AT[tier]
end

function Season.rewardAt(tier: number, premium: boolean): string?
    local row = Season.rewards()[tier]
    if not row then return nil end
    return premium and row.premium or row.free
end

-- Award XP, honouring the daily cap and the new-day reset.
function Season.award(state: any, source: string, now: number?): (number, boolean)
    if not state then return 0, false end
    local amount = Season.XP[source]
    if not amount then return 0, false end

    local day = math.floor((now or os.time()) / 86400)
    if state.dailyStamp ~= day then
        state.dailyStamp = day
        state.dailyXp = 0
    end

    if not Season.UNCAPPED[source] then
        local room = math.max(0, Season.DAILY_CAP - (state.dailyXp or 0))
        amount = math.min(amount, room)
        if amount <= 0 then return 0, false end
        state.dailyXp = (state.dailyXp or 0) + amount
    end

    local before = Season.tierOf(state.xp)
    state.xp += amount
    local after = Season.tierOf(state.xp)
    return amount, after > before
end

-- Which tiers are earned but unclaimed, per track.
function Season.claimable(state: any): { any }
    local out = {}
    if not state then return out end
    local tier = Season.tierOf(state.xp)
    for t = 1, tier do
        local key = tostring(t)
        local free = Season.rewardAt(t, false)
        local freePower = Season.powerAt(t)
        if (free or freePower) and not (state.claimedFree or {})[key] then
            table.insert(out, {
                tier = t, premium = false, cosmetic = free, power = freePower,
            })
        end
        if state.premium then
            local prem = Season.rewardAt(t, true)
            if prem and not (state.claimedPremium or {})[key] then
                table.insert(out, { tier = t, premium = true, cosmetic = prem })
            end
        end
    end
    return out
end

function Season.markClaimed(state: any, tier: number, premium: boolean)
    local key = tostring(tier)
    if premium then
        state.claimedPremium = state.claimedPremium or {}
        state.claimedPremium[key] = true
    else
        state.claimedFree = state.claimedFree or {}
        state.claimedFree[key] = true
    end
end

-- Rolling a season wipes progress but NOT owned cosmetics. Losing what you
-- earned would be the one thing that makes a battle pass feel like a scam.
function Season.rollIfNeeded(state: any): boolean
    if not state or state.id == Season.CURRENT then return false end
    local fresh = Season.blank()
    fresh.premium = false
    for k, v in pairs(fresh) do state[k] = v end
    return true
end

return Season
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000017"><Properties><string name="Name">Trinkets</string><ProtectedString name="Source"><![CDATA[--!strict
-- Trinkets.luau — three slots, small numbers, real choices.
--
-- The design rule, and the reason this file has a test that enforces it:
-- a fully-kitted player must be roughly 20% better than a bare one, never
-- 200%. Trinkets are meant to say something about HOW you play, not to
-- decide WHETHER you can play.
--
-- They also pull against each other. Wax Coat wants a long greedy run;
-- Featherweight only works while you are small and therefore wants short
-- aggressive ones. You cannot build for both, so a loadout is a statement.
--
-- Earned only. Deep Crates cost earned Glob, season tiers cost play. There is
-- no Robux path to any number in this file, and Monetisation.violations()
-- fails the build if one appears.

local Trinkets = {}

export type Effect =
    "leakMult"        -- multiplies leak per second
    | "bankHaste"     -- fraction faster to bank
    | "pelletMult"    -- multiplies pellet value
    | "knockbackMult" -- multiplies knockback taken
    | "powerHaste"    -- fraction off power cooldowns
    | "crumbChance"   -- chance a pellet becomes a Golden Crumb
    | "smallSpeed"    -- top speed bonus while under SMALL_THRESHOLD
    | "popKeep"       -- fraction of mass kept through a pop

export type Trinket = {
    id: string,
    name: string,
    blurb: string,
    effect: Effect,
    value: number,
    rarity: string,
}

Trinkets.SLOTS = 3
Trinkets.SMALL_THRESHOLD = 500

Trinkets.LIST = {
    { id = "waxcoat",   name = "Wax Coat",      blurb = "You melt 12% slower.",
      effect = "leakMult",      value = 0.88, rarity = "Common" },
    { id = "snorkel",   name = "Snorkel",       blurb = "Bank 30% faster.",
      effect = "bankHaste",     value = 0.30, rarity = "Common" },
    { id = "tongue",    name = "Greedy Tongue", blurb = "Pellets are worth 10% more.",
      effect = "pelletMult",    value = 1.10, rarity = "Common" },
    { id = "ballast",   name = "Ballast",       blurb = "Take 15% less knockback.",
      effect = "knockbackMult", value = 0.85, rarity = "Uncommon" },
    { id = "trigger",   name = "Hair Trigger",  blurb = "Powers recharge 18% sooner.",
      effect = "powerHaste",    value = 0.18, rarity = "Uncommon" },
    { id = "crumb",     name = "Lucky Crumb",   blurb = "1 pellet in 20 is golden.",
      effect = "crumbChance",   value = 0.05, rarity = "Rare" },
    { id = "feather",   name = "Featherweight", blurb = "+10% speed while you're small.",
      effect = "smallSpeed",    value = 0.10, rarity = "Rare" },
    { id = "secondskin",name = "Second Skin",   blurb = "Keep 15% of yourself when you pop.",
      effect = "popKeep",       value = 0.15, rarity = "Epic" },
} :: { Trinket }

local byId: { [string]: Trinket } = {}
for _, t in ipairs(Trinkets.LIST) do
    byId[t.id] = t
end

function Trinkets.get(id: string): Trinket?
    return byId[id]
end

-- Resolve an equipped loadout into a flat table of effects.
--
-- Multiplicative effects (leak, pellets, knockback) start at 1 and multiply;
-- additive ones (haste, chance, keep) start at 0 and add.
--
-- DUPLICATES DO NOT STACK, and this is load-bearing rather than tidy. When
-- they did, the strongest loadout in the game was three Wax Coats — a 47%
-- edge, and no decision at all, because the answer was always "three of
-- whichever is best". Requiring three DIFFERENT trinkets is what turns the
-- slots into a build. It also caps the damage any one trinket can do to the
-- balance at exactly its own number.
export type Resolved = {
    leakMult: number, bankHaste: number, pelletMult: number,
    knockbackMult: number, powerHaste: number, crumbChance: number,
    smallSpeed: number, popKeep: number,
}

function Trinkets.resolve(equipped: { string }): Resolved
    local r: Resolved = {
        leakMult = 1, bankHaste = 0, pelletMult = 1, knockbackMult = 1,
        powerHaste = 0, crumbChance = 0, smallSpeed = 0, popKeep = 0,
    }
    local used = 0
    local already: { [string]: boolean } = {}
    for _, id in ipairs(equipped) do
        if used >= Trinkets.SLOTS then
            break
        end
        local t = byId[id]
        if t and not already[id] then
            already[id] = true
            used += 1
            if t.effect == "leakMult" then r.leakMult *= t.value
            elseif t.effect == "pelletMult" then r.pelletMult *= t.value
            elseif t.effect == "knockbackMult" then r.knockbackMult *= t.value
            elseif t.effect == "bankHaste" then r.bankHaste += t.value
            elseif t.effect == "powerHaste" then r.powerHaste += t.value
            elseif t.effect == "crumbChance" then r.crumbChance += t.value
            elseif t.effect == "smallSpeed" then r.smallSpeed += t.value
            elseif t.effect == "popKeep" then r.popKeep += t.value
            end
        end
    end
    -- Hard clamps. These are not expected to bind with three slots; they are
    -- here so that a future trinket, or a future slot, cannot quietly turn
    -- this file into a pay-to-win surface by arithmetic.
    r.leakMult = math.max(0.6, r.leakMult)
    r.pelletMult = math.min(1.5, r.pelletMult)
    r.knockbackMult = math.max(0.5, r.knockbackMult)
    r.bankHaste = math.min(0.75, r.bankHaste)
    r.powerHaste = math.min(0.35, r.powerHaste)
    r.crumbChance = math.min(0.25, r.crumbChance)
    r.smallSpeed = math.min(0.20, r.smallSpeed)
    r.popKeep = math.min(0.25, r.popKeep)
    return r
end

-- A rough relative-power index, used by the balance test to prove no trinket
-- is dead weight and no loadout runs away from the field.
--
-- READ THIS BEFORE TRUSTING THE NUMBER. The absolute value it returns means
-- nothing — the weights below are judgement calls, not measurements, and the
-- first version of this function happily reported that the strongest build in
-- the game was "three Wax Coats" because duplicates stacked. Only the SPREAD
-- between loadouts is meaningful, which is why the test asserts on ratios and
-- never on a magnitude.
--
-- The weights say what each axis is worth in a fight:
--   bankHaste  0.40  the bank window is where runs actually die
--   powerHaste 0.45  the power is the skill layer; more presses is more skill
--   crumbChance 2.0  a Golden Crumb is 5x, so a 5% chance is a 20% food swing
--   popKeep    0.80  surviving a pop with a quarter of yourself is most of a
--                    free restart, which is worth far more than it looks
Trinkets.WEIGHTS = {
    bankHaste = 0.40, powerHaste = 0.45, crumbChance = 2.0, popKeep = 0.80,
}

function Trinkets.advantage(r: Resolved): number
    local w = Trinkets.WEIGHTS
    return (1 / r.leakMult - 1)
        + (r.pelletMult - 1)
        + (1 / r.knockbackMult - 1) * 0.5
        + r.smallSpeed
        + r.bankHaste * w.bankHaste
        + r.powerHaste * w.powerHaste
        + r.crumbChance * w.crumbChance
        + r.popKeep * w.popKeep
end

-- The ground truth the proxy above cannot give: how far any single trinket
-- moves its OWN axis, in that axis's own units. These are the numbers a
-- reviewer should argue about, and the test holds each to its own cap.
Trinkets.AXIS_CAP = {
    leakMult = 0.15, pelletMult = 0.15, knockbackMult = 0.15, smallSpeed = 0.12,
    bankHaste = 0.35, powerHaste = 0.20, crumbChance = 0.06, popKeep = 0.15,
}

function Trinkets.axisMagnitude(t: Trinket): number
    if t.effect == "leakMult" or t.effect == "knockbackMult" then
        return 1 - t.value
    elseif t.effect == "pelletMult" then
        return t.value - 1
    end
    return t.value
end

return Trinkets
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX000044"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX000030"><Properties><string name="Name">GoobServer</string><ProtectedString name="Source"><![CDATA[--!strict
-- init.server.luau — the single entry point. Wires every service together and
-- owns all the RemoteEvent handlers, so there is exactly one file to read to
-- understand what the client is allowed to ask the server to do.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TextService = game:GetService("TextService")

local Shared = game.ReplicatedStorage.GoobShared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local GoobMath = require(Shared.GoobMath)
local Format = require(Shared.Format)
local Names = require(Shared.Names)
local Feedstock = require(Shared.Feedstock)
local Ascension = require(Shared.Ascension)
local Movement = require(Shared.Movement)
local Cosmetics = require(Shared.Cosmetics)
local Season = require(Shared.Season)
local Pit = require(Shared.Pit)
local Crew = require(Shared.Crew)
local Blob = require(Shared.Blob)
local Powers = require(Shared.Powers)
local Trinkets = require(Shared.Trinkets)
local Crates = require(Shared.Crates)
local Monetisation = require(Shared.Monetisation)

local Data = require(script.Data)
local WorldBuilder = require(script.WorldBuilder)
local GoobService = require(script.GoobService)
local TradeService = require(script.TradeService)
local RollService = require(script.RollService)
local PitService = require(script.PitService)
local CrewStore = require(script.CrewStore)
local CensusService = require(script.CensusService)
local ArenaService = require(script.ArenaService)

print(("[%s] booting…"):format(Config.GAME_NAME))

Net.init()
WorldBuilder.build()
GoobService.start()

local function activeGoobOf(player: Player)
    local profile = Data.get(player)
    return profile and GoobService.activeGoob(profile) or nil
end

-- Reach and catch validation both key off the rolling body.

RollService.start(activeGoobOf)
CensusService.start()

local Notify = Net.get("Notify")
local StateSync = Net.get("StateSync")
local TradeSync = Net.get("TradeSync")
local LeaderboardSync = Net.get("LeaderboardSync")
local Effect = Net.get("Effect")

local function notify(player: Player, msg: string, kind: string?)
    Notify:FireClient(player, msg, kind or "info")
end

-- ── State push ─────────────────────────────────────────────────────────────
-- We send a compact, display-ready snapshot rather than the raw profile. The
-- client never needs the stomach contents or DataStore metadata, and not
-- sending them keeps bandwidth low with 30 players on a server.

local function snapshot(player: Player)
    local profile = Data.get(player)
    if not profile then return nil end
    local active = GoobService.activeGoob(profile)

    local goobs = {}
    for _, g in ipairs(profile.goobs) do
        local tier = GoobMath.ageTier(g)
        table.insert(goobs, {
            id = g.id,
            nickname = g.nickname,
            hue = g.hue,
            mass = g.mass,
            massText = Format.short(g.mass),
            power = GoobMath.power(g),
            powerText = Format.short(GoobMath.power(g)),
            ageSeconds = GoobMath.ageSeconds(g),
            ageText = Format.duration(GoobMath.ageSeconds(g)),
            ageTier = tier.name,
            ageEmoji = tier.emoji,
            ageColor = tier.color,
            ageMult = tier.mult,
            generation = GoobMath.generation(g),
            stomachCount = #g.stomach,
            lineage = g.lineage,
            contents = g.contents,
            isActive = active ~= nil and g.id == active.id,
        })
    end

    local crests = profile.crests or 0
    local canAsc, ascReason = false, nil
    if active then canAsc, ascReason = Ascension.canAscend(active, crests) end

    return {
        glob = profile.glob,
        globText = Format.short(profile.glob),
        -- `snacks`, `eggPrice` and friends used to live here, feeding a shop
        -- panel that has been deleted along with the shops. What replaced them
        -- is the pair below: how many rounds until the next egg, and whether
        -- the stable is full. Those are the only two numbers the wardrobe
        -- still has to answer, and they come from play rather than from a till.
        roundsPlayed = profile.roundsPlayed or 0,
        roundsToEgg = (#profile.goobs >= Config.MAX_GOOBS) and -1
            or (Config.EGG_EVERY_ROUNDS
                - ((profile.roundsPlayed or 0) % Config.EGG_EVERY_ROUNDS)),
        eggCapped = #profile.goobs >= Config.MAX_GOOBS,
        maxGoobs = Config.MAX_GOOBS,
        income = active and GoobMath.incomePerSecond(active) or 0,
        incomeText = active and Format.short(GoobMath.incomePerSecond(active)) or "0",
        goobs = goobs,
        activeGoobId = profile.activeGoobId,
        stats = profile.stats,
        discovered = profile.discovered,
        crests = crests,
        foodMultiplier = Ascension.foodMultiplier(crests),
        canAscend = canAsc,
        ascendReason = ascReason,
        ascendPreview = (active and canAsc) and Ascension.preview(active, crests) or nil,
        colossalMass = Config.COLOSSAL_MASS,
        -- READ BY THE POWERS PANEL, so it has to be here. A power owned via
        -- the season track is owned for no reason the client could derive from
        -- lifetimeBanked, so without this the panel shows HOOK and SPIKE
        -- locked to a player who has them — a screen that renders perfectly
        -- and lies.
        powersGranted = profile.powersGranted or {},
        pitWins = profile.pitWins or 0,
        cosmeticsOwned = profile.cosmeticsOwned,
        loadout = profile.loadout,
        season = {
            id = profile.season.id,
            name = Season.NAME,
            xp = profile.season.xp,
            tier = Season.tierOf(profile.season.xp),
            tiers = Season.TIERS,
            progress = Season.progressInTier(profile.season.xp),
            premium = profile.season.premium == true,
            claimable = Season.claimable(profile.season),
            dailyXp = profile.season.dailyXp or 0,
            dailyCap = Season.DAILY_CAP,
        },
        achievements = profile.achievements,
        crewId = profile.crewId,
        moveTopSpeed = active and Movement.topSpeed(active.mass) or 0,
        moveStopDistance = active and Movement.stoppingDistance(active.mass) or 0,
        datastore = Data.isEnabled(),

        -- ── Arena ──────────────────────────────────────────────────────────
        -- These were missing, and their absence made THREE dock tabs dead.
        -- The Powers tab reads lifetimeBanked to decide what is unlocked, the
        -- Trinkets tab reads trinketsOwned, the Wardrobe reads loadout against
        -- cosmeticsOwned — so with these unsent every power and every trinket
        -- rendered permanently locked, the CARRY and EQUIP buttons never
        -- appeared, and the crate pity counter always read full.
        --
        -- Nothing errored. The UI drew perfectly and was simply always wrong,
        -- which is why the geometry audit could not see it and why the client
        -- test, which only checks that panels build, did not either.
        lifetimeBanked = profile.lifetimeBanked or 0,
        bestBank = profile.bestBank or 0,
        powerId = profile.powerId or Powers.DEFAULT,
        powerUses = profile.powerUses or {},
        trinketsOwned = profile.trinketsOwned or {},
        trinketSlots = profile.trinketSlots or {},
        cratePity = profile.cratePity or {},
        streak = profile.streak or 0,
    }
end

-- WHAT `teach` WAS.
--
-- The first-run tutorial is gone — five coached steps, a banner across the top
-- of the screen, and a per-profile record of which step you were on. It was
-- removed because it did not earn its space: the game is "eat the little ones,
-- run from the big ones", which a player understands from one round without
-- being told, and on a landscape phone the banner was competing for the only
-- free band on the screen with the round clock.
--
-- `teach` is kept as a no-op rather than deleted outright ONLY because
-- ArenaService calls it from a dozen places in its hot loop and threading a
-- nil-check through all of them buys nothing. It is an empty function, and the
-- deps entry below is the single line to change if a coached mode ever comes
-- back. It costs one dead call per event and nothing else.
local function teach(_player: Player, _event: string) end

local function push(player: Player)
    local snap = snapshot(player)
    if snap then StateSync:FireClient(player, snap) end
end

-- NOTE ON PLACEMENT: everything below must come AFTER notify, push and the
-- remote handles. `local function` only enters scope from its declaration
-- onward, so an earlier draft had this block sitting above them and every call
-- to notify/push/Net resolved to a nil GLOBAL — the server booted fine and then
-- errored the moment a player joined or ascended.

-- ── Season XP, achievements and crew contributions ─────────────────────────
-- One funnel, so every gameplay event feeds the progression systems without
-- each handler having to remember four different calls.

local function grantCosmetic(player: Player, id: string, why: string)
    local profile = Data.get(player)
    if not profile or not id then return end
    if profile.cosmeticsOwned[id] then return end
    local item = Cosmetics.get(id)
    if not item then return end
    profile.cosmeticsOwned[id] = true
    notify(player, ("🎁 Unlocked %s (%s) — %s"):format(item.name, item.rarity, why), "good")
end

local function checkAchievements(player: Player)
    local profile = Data.get(player)
    if not profile then return end
    local function earn(id: string, cosmetic: string, label: string)
        if profile.achievements[id] then return end
        profile.achievements[id] = true
        grantCosmetic(player, cosmetic, label)
    end
    if (profile.pitWins or 0) >= 5 then earn("pitwins5", "crown_pit", "5 Pit wins") end
    if (profile.totalAscensions or 0) >= 3 then earn("colossal3", "skin_goldleaf", "3 ascensions") end
    for id in pairs(profile.discovered or {}) do
        local item = Feedstock.get(id)
        if item and item.rarity == "Secret" then
            earn("secret1", "eyes_ghost", "caught a Secret")
            break
        end
    end
    -- Ascension crowns.
    for count, cosmetic in pairs(Cosmetics.ASCEND_REWARDS) do
        if (profile.totalAscensions or 0) >= count then
            grantCosmetic(player, cosmetic, ("Crest %d"):format(count))
        end
    end
end

local CREW_METRIC_FOR = {
    catch = "catches", gulp = "gulps", pitWin = "pitWins",
    trade = "trades", ascend = "ascensions",
}

local function progress(player: Player, source: string, amount: number?)
    local profile = Data.get(player)
    if not profile then return end

    local gained, tierUp = Season.award(profile.season, source)
    if tierUp then
        local tier = Season.tierOf(profile.season.xp)
        notify(player, ("⭐ Season tier %d!"):format(tier), "good")
    end

    local metric = CREW_METRIC_FOR[source]
    if metric and profile.crewId then
        local week = Crew.currentWeek()
        CrewStore.update(profile.crewId, function(crew)
            Crew.contribute(crew, player.UserId, metric, amount or 1, week)
            return crew
        end)
    end
    checkAchievements(player)
end

-- Defined here rather than beside the crew remotes: `local function` only
-- enters scope from its declaration onward, so defining it further down left
-- onJoin resolving `syncCrew` to a nil GLOBAL and every player join erroring.
local function syncCrew(player: Player)
    local profile = Data.get(player)
    if not profile then return end
    local crew = profile.crewId and CrewStore.get(profile.crewId) or nil
    if not crew then
        Net.get("CrewSync"):FireClient(player, nil)
        return
    end
    local week = Crew.currentWeek()
    Crew.rollWeek(crew, week)
    local goal = Crew.goalForWeek(week)
    local members = {}
    for idStr, m in pairs(crew.members or {}) do
        table.insert(members, { name = m.name, contributed = m.contributed or 0,
                                owner = tostring(crew.ownerId) == idStr })
    end
    table.sort(members, function(a, b) return a.contributed > b.contributed end)
    Net.get("CrewSync"):FireClient(player, {
        id = crew.id, name = crew.name, tag = crew.tag,
        members = members, memberCount = Crew.memberCount(crew),
        maxMembers = Crew.MAX_MEMBERS,
        goalLabel = goal.label:format(Format.comma(goal.target)),
        progress = crew.progress or 0,
        target = goal.target,
        complete = Crew.isComplete(crew, week),
        claimed = Crew.hasClaimed(crew, player.UserId),
    })
end

-- ── Sumo Pit wiring ────────────────────────────────────────────────────────
PitService.getProfile = function(p) return Data.get(p) end
PitService.getGoob = activeGoobOf
PitService.getBall = function(p) return RollService.ballFor(p) end
PitService.teleport = function(p, pos) RollService.teleport(p, pos) end
PitService.onEffect = function(p, kind, a, b) Effect:FireClient(p, kind, a, b) end
PitService.awardXp = function(p, source) progress(p, source) end
PitService.start()

PitService.onNotify.Event:Connect(function(player, msg, kind)
    notify(player, msg, kind)
end)
PitService.onSync.Event:Connect(function(state)
    Net.get("PitSync"):FireAllClients(state)
end)
PitService.onResult.Event:Connect(function(winner)
    local profile = Data.get(winner)
    if profile then checkAchievements(winner) end
    push(winner)
end)


-- Steady HUD refresh. 2Hz is plenty — glob ticks up smoothly on the client via
-- local interpolation, so we only need to correct it twice a second.
task.spawn(function()
    while true do
        task.wait(0.5)
        for _, player in ipairs(Players:GetPlayers()) do
            push(player)
        end
    end
end)

-- ── Leaderboard ────────────────────────────────────────────────────────────

-- The Archive board.
task.spawn(function()
    local world = Workspace:WaitForChild("GoobWorld")
    local archive = world:WaitForChild("Archive")
    local entries = archive:WaitForChild("Board"):WaitForChild("Entries") :: TextLabel
    local function render(rows)
        local text = "📜 THE ARCHIVE\nhow many still exist, worldwide\n\n"
        for _, row in ipairs(rows) do
            local odds = row.weight > 0
                and ("1 in " .. Format.comma(math.floor(Feedstock.TOTAL_WEIGHT / row.weight)))
                or "?"
            text ..= ("%s\n   %s alive   ·   %s found   ·   %s eaten\n   %s\n\n")
                :format(row.name, Format.comma(row.alive), Format.comma(row.caught),
                        Format.comma(row.destroyed), odds)
        end
        if #rows == 0 then text ..= "nothing rare has been found yet." end
        text ..= "\nAscending destroys everything in a Goob's belly."
        entries.Text = text
    end
    render(CensusService.snapshot())
    CensusService.onUpdate.Event:Connect(render)
    while true do
        task.wait(20)
        render(CensusService.snapshot())
    end
end)

task.spawn(function()
    local pillar = Workspace:WaitForChild("GoobWorld"):WaitForChild("Leaderboard")
    local entries = pillar:WaitForChild("Board"):WaitForChild("Entries") :: TextLabel
    while true do
        -- Ranked on LIFETIME BANKED, which is the answer to "what is the
        -- point of this game". Ranking on current mass would reward whoever
        -- happened to be mid-run when the board refreshed, and would tell a
        -- new player that the goal is to hold mass — the exact instinct the
        -- melt is designed to punish.
        local rows = {}
        for _, player in ipairs(Players:GetPlayers()) do
            local profile = Data.get(player)
            if profile then
                table.insert(rows, {
                    name = player.DisplayName,
                    banked = profile.lifetimeBanked or 0,
                    best = profile.bestBank or 0,
                    holding = ArenaService.massOf(player),
                })
            end
        end
        table.sort(rows, function(x, y) return x.banked > y.banked end)

        local text = "🏦 TOP BANKERS\n\n"
        for i = 1, math.min(10, #rows) do
            local r = rows[i]
            text ..= string.format("%d. %s\n    💧%s banked · best run 💧%s · holding %s\n",
                i, r.name, Format.short(r.banked), Format.short(r.best), Format.short(r.holding))
        end
        if #rows == 0 then text ..= "nobody yet — be the first!" end
        entries.Text = text
        LeaderboardSync:FireAllClients(rows)
        task.wait(4)
    end
end)


-- ═══════════════════════════════════════════════════════════════════════════
-- THE ARENA
-- ═══════════════════════════════════════════════════════════════════════════
-- ArenaService owns the run; this file owns the profile. The two are wired
-- through an injected table rather than by requiring each other, so the arena
-- never touches the datastore and there stays exactly one place where Glob is
-- created.

local ArenaSync = Net.get("ArenaSync")
local CrateResult = Net.get("CrateResult")

ArenaService.start({
    award = function(player, glob, _xp, reason)
        local profile = Data.get(player)
        if not profile then return end
        profile.glob += glob
        if reason == "round" then
            profile.lifetimeBanked += glob
            if glob > (profile.bestBank or 0) then
                profile.bestBank = glob
            end
            progress(player, "round")
            for _, power in ipairs(Powers.LIST) do
                if power.unlockBanked > 0
                    and profile.lifetimeBanked >= power.unlockBanked
                    and profile.lifetimeBanked - glob < power.unlockBanked then
                    notify(player, ("🔓 New power: %s — %s"):format(power.name, power.blurb), "good")
                end
            end
        elseif reason == "bank" then
            profile.lifetimeBanked += glob
            if glob > (profile.bestBank or 0) then
                profile.bestBank = glob
            end
            progress(player, "bank")
            -- A run taken past 60% of the ceiling is a real decision to stay
            -- out while melting, and it gets paid for separately.
            local run = ArenaService.runFor(player)
            if run and run.bestMass > Blob.ceiling(0.8) * 0.6 then
                progress(player, "bigBank")
            end
            -- Powers unlock on lifetime banked, so a bank can hand one over.
            for _, power in ipairs(Powers.LIST) do
                if power.unlockBanked > 0
                    and profile.lifetimeBanked >= power.unlockBanked
                    and profile.lifetimeBanked - glob < power.unlockBanked then
                    notify(player, ("🔓 New power: %s — %s"):format(power.name, power.blurb), "good")
                end
            end
        end
        push(player)
    end,

    notify = notify,
    effect = function(player, kind, data) Effect:FireClient(player, kind, data) end,

    loadout = function(player)
        local profile = Data.get(player)
        if not profile then return {}, Powers.DEFAULT end
        return profile.trinketSlots or {}, profile.powerId or Powers.DEFAULT
    end,

    sync = function(player, state) ArenaSync:FireClient(player, state) end,
    teach = teach,

    -- EVERYTHING A FINISHED ROUND OWES THE PROFILE.
    --
    -- This is what the Snack Stand and the Egg Stand became. Both used to sell
    -- progress for idle income, which made the arena — the actual game — the
    -- one thing that could not feed your Goob. Now it is the only thing that
    -- can: a round pays Glob through `award` and pays MASS through here,
    -- scaled by the same payout, with the finishing place buying a luckier
    -- table rather than simply more rolls.
    roundResult = function(player, place, _mass, payout)
        local profile = Data.get(player)
        if not profile then return end

        profile.roundsPlayed = (profile.roundsPlayed or 0) + 1

        local goob = GoobService.activeGoob(profile)
        if goob then
            local rolls = math.clamp(
                math.floor(payout * Config.ROUND_FEED_PER_GLOB),
                Config.ROUND_FEED_MIN, Config.ROUND_FEED_MAX)
            local luck = Config.ROUND_FEED_LUCK[place] or Config.ROUND_FEED_LUCK_DEFAULT
            local rng = Random.new(os.clock() * 1e6 + player.UserId)
            local best, bestRank = nil, 0
            local rank = {}
            for i, r in ipairs(Feedstock.RARITY_ORDER) do rank[r] = i end
            for _ = 1, rolls do
                -- `false`: no Secrets from a round payout, same rule the shop
                -- had. A Secret must be found, never handed out on a timer.
                local item = Feedstock.roll(rng, luck, false)
                GoobService.feed(player, item.id)
                CensusService.recordCaught(item.id)
                if (rank[item.rarity] or 0) > bestRank then
                    best, bestRank = item, rank[item.rarity] or 0
                end
            end
            if best then
                notify(player, ("🍽️ %s ate %d things — best was %s (%s)")
                    :format(goob.nickname, rolls, best.name, best.rarity),
                    bestRank >= 5 and "good" or "info")
                -- ONE effect for the best thing in the haul, not one per roll.
                -- Twenty-six particle bursts and twenty-six sound stings in the
                -- same frame is not feedback, it is a crash on a phone — and
                -- the player only cares about the best one anyway, which is the
                -- same reason the notification names it.
                Effect:FireClient(player, "catch", best.id)
            end
        end

        -- An egg every EGG_EVERY_ROUNDS rounds finished, up to the cap. This
        -- is the only source of new Goobs in the game now, and it cannot be
        -- bought, rushed or idled into.
        if profile.roundsPlayed % Config.EGG_EVERY_ROUNDS == 0
            and #profile.goobs < Config.MAX_GOOBS then
            local egg = Data.newGoob(Random.new(os.clock() * 1e6 + player.UserId * 7))
            table.insert(profile.goobs, egg)
            progress(player, "egg")
            notify(player, ("🥚 %d rounds — a new Goob hatched: %s!")
                :format(profile.roundsPlayed, egg.nickname), "good")
        end
        push(player)
    end,

    banked = function(player)
        local profile = Data.get(player)
        return (profile and profile.lifetimeBanked) or 0
    end,

    granted = function(player)
        local profile = Data.get(player)
        return (profile and profile.powersGranted) or {}
    end,

    powerUses = function(player)
        local profile = Data.get(player)
        return (profile and profile.powerUses) or {}
    end,

    notePowerUse = function(player, id)
        local profile = Data.get(player)
        if not profile then return end
        profile.powerUses = profile.powerUses or {}
        local before = profile.powerUses[id] or 0
        profile.powerUses[id] = before + 1
        -- Announce a mastery tier the moment it lands. A stat that improves
        -- silently is a stat the player never learns they have.
        local was, now = Powers.masteryTier(before), Powers.masteryTier(before + 1)
        if now > was then
            local power = Powers.get(id)
            notify(player, ("✨ %s mastery %d — quicker and cheaper.")
                :format(power and power.name or id, now), "good")
            push(player)
        end
    end,
})

-- One button. The client sends where it is aiming; the server decides
-- everything else, including whether the player can afford the press.
Net.get("UsePower").OnServerEvent:Connect(function(player, slot, aim)
    -- The client sends WHICH SLOT and where it is aiming. It does not send
    -- which power that slot holds — slot 3's contents depend on what the
    -- profile has unlocked, and letting the client name a power is letting it
    -- name any power.
    local index = tonumber(slot)
    local dir = typeof(aim) == "Vector3" and aim or nil
    -- Never trust a client vector's magnitude: a 10,000-stud "aim" is a
    -- teleport request wearing a direction's clothes.
    if dir then
        local flat = Vector3.new(dir.X, 0, dir.Z)
        dir = flat.Magnitude > 0.01 and flat.Unit or nil
    end
    local ok, reason = ArenaService.usePower(player, index, dir)
    if not ok and reason then
        notify(player, reason, "warn")
    end
end)

Net.get("SetPower").OnServerEvent:Connect(function(player, id)
    local profile = Data.get(player)
    if not profile or typeof(id) ~= "string" then return end
    -- DASH and SPLIT are slots 1 and 2, not choices. Accepting one here would
    -- hand the player a hotbar with a duplicate and an empty third button, and
    -- the fallback in Powers.hotbar would silently give them the default
    -- instead — a setting that appears to take and then does not.
    local wanted = Powers.get(id)
    if wanted and wanted.fixed then
        notify(player, ("%s is always in your hotbar — slot 3 is the choice.")
            :format(wanted.name), "warn")
        return
    end
    if not Powers.isOwned(id, profile.lifetimeBanked or 0, profile.powersGranted) then
        local power = Powers.get(id)
        notify(player, power
            and ("🔒 %s unlocks at 💧%s banked."):format(power.name, Format.short(power.unlockBanked))
            or "That power doesn't exist.", "warn")
        return
    end
    profile.powerId = id
    ArenaService.refreshLoadout(player)
    local power = Powers.get(id)
    notify(player, ("Carrying %s."):format(power and power.name or id), "good")
    push(player)
end)

Net.get("EquipTrinket").OnServerEvent:Connect(function(player, id, slot)
    local profile = Data.get(player)
    if not profile or typeof(slot) ~= "number" then return end
    slot = math.clamp(math.floor(slot), 1, Trinkets.SLOTS)
    profile.trinketSlots = profile.trinketSlots or {}

    if id == nil or id == "" then
        table.remove(profile.trinketSlots, slot)
    else
        if typeof(id) ~= "string" or not Trinkets.get(id) then return end
        if not (profile.trinketsOwned or {})[id] then
            notify(player, "You don't own that trinket.", "warn")
            return
        end
        -- Duplicates do nothing, so silently equipping one would read as a
        -- bug. Refuse it and say why.
        for i, existing in ipairs(profile.trinketSlots) do
            if existing == id and i ~= slot then
                notify(player, "That one's already equipped — duplicates do nothing.", "warn")
                return
            end
        end
        profile.trinketSlots[slot] = id
    end

    ArenaService.refreshLoadout(player)
    push(player)
end)

Net.get("OpenCrate").OnServerEvent:Connect(function(player, crateId)
    local profile = Data.get(player)
    if not profile or typeof(crateId) ~= "string" then return end
    local crate = Crates.get(crateId)
    if not crate then return end

    if crate.price <= 0 then
        notify(player, "That crate isn't for sale — it comes from Beta Season.", "warn")
        return
    end
    if profile.glob < crate.price then
        notify(player, ("Need 💧%s for a %s."):format(Format.short(crate.price), crate.name), "warn")
        return
    end

    profile.glob -= crate.price
    profile.cratePity = profile.cratePity or {}
    local pity = profile.cratePity[crateId] or 0
    local reward, nextPity = Crates.roll(crateId, Random.new(os.clock() * 1e6 // 1 + player.UserId), pity)
    profile.cratePity[crateId] = nextPity
    if not reward then
        profile.glob += crate.price   -- refund rather than eat the payment
        notify(player, "That crate is empty right now. Refunded.", "warn")
        push(player)
        return
    end

    local duplicate = false
    if reward.kind == "cosmetic" then
        duplicate = Cosmetics.owns(profile.cosmeticsOwned, reward.id)
        profile.cosmeticsOwned[reward.id] = true
    else
        profile.trinketsOwned = profile.trinketsOwned or {}
        duplicate = profile.trinketsOwned[reward.id] == true
        profile.trinketsOwned[reward.id] = true
    end

    local refund = 0
    if duplicate then
        refund = Crates.dupeValue(crateId, reward.rarity)
        profile.glob += refund
    end

    CrateResult:FireClient(player, {
        crate = crateId,
        reward = reward,
        duplicate = duplicate,
        refund = refund,
        pity = Crates.rollsUntilPity(crateId, nextPity),
    })
    push(player)
end)

-- ── The daily streak ───────────────────────────────────────────────────────
-- The smallest honest retention hook there is: come back tomorrow, get a
-- little more than you got today. It pays GLOB, never mass and never a power,
-- so missing a week costs you some spending money and nothing you can be
-- beaten with. A streak that gates power is a streak that punishes having a
-- life.
local STREAK_BASE = 900
local STREAK_STEP = 450
local STREAK_CAP = 7

local function claimDaily(player: Player)
    local profile = Data.get(player)
    if not profile then return end
    local today = math.floor(os.time() / 86400)
    if profile.streakDay == today then
        return                      -- already collected
    end
    -- Consecutive if yesterday; otherwise the streak restarts at one. Nothing
    -- in between, and no grace period: a "you nearly kept it" message is worse
    -- than a clean reset.
    profile.streak = (profile.streakDay == today - 1) and (profile.streak + 1) or 1
    profile.streakDay = today

    local day = math.min(profile.streak, STREAK_CAP)
    local reward = STREAK_BASE + STREAK_STEP * (day - 1)
    profile.glob += reward

    notify(player, ("📅 Day %d streak — 💧%s%s"):format(
        profile.streak, Format.short(reward),
        profile.streak >= STREAK_CAP and "  (max)" or ""), "good")
    push(player)
end

-- ── Player lifecycle ───────────────────────────────────────────────────────

local function onJoin(player: Player)
    local profile = Data.load(player)
    if not profile then return end   -- Data.load kicks on a real load failure

    WorldBuilder.claimPlot(player)

    local earned = GoobService.applyOffline(player)
    if earned > 1 then
        notify(player, ("💤 While you were gone your Goob digested and earned 💧%s")
            :format(Format.short(earned)), "good")
    end

    player.CharacterAdded:Connect(function()
        task.wait(0.4)
        GoobService.spawnFor(player)
    end)

    GoobService.spawnFor(player)
    ArenaService.enter(player)
    claimDaily(player)
    RollService.applyCosmetics(player, profile.loadout)
    syncCrew(player)
    checkAchievements(player)
    push(player)

    notify(player, "Welcome! Eat. You melt as you grow — bank it at the Vault before you lose it. 🫧", "good")
end

local function onLeave(player: Player)
    ArenaService.leave(player)
    PitService.cleanup(player)
    TradeService.cleanup(player)
    GoobService.despawnFor(player)
    WorldBuilder.releasePlot(player)
    Data.save(player, true)
end

Players.PlayerAdded:Connect(onJoin)
Players.PlayerRemoving:Connect(onLeave)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onJoin, p) end

task.spawn(function()
    while true do
        task.wait(Config.AUTOSAVE_INTERVAL)
        Data.saveAll()
    end
end)

game:BindToClose(function()
    for _, player in ipairs(Players:GetPlayers()) do
        Data.save(player, false)
    end
    task.wait(1.5)
end)

-- ── Remote handlers ────────────────────────────────────────────────────────

Net.get("RequestProfile").OnServerInvoke = function(player: Player)
    -- Wait briefly in case the player fired this before Data.load finished.
    local deadline = os.clock() + 8
    while not Data.get(player) and os.clock() < deadline do task.wait(0.1) end
    return snapshot(player)
end

Net.get("RenameGoob").OnServerEvent:Connect(function(player: Player, goobId: string, raw: string)
    local profile = Data.get(player)
    if not profile then return end
    local clean = Names.sanitize(raw)
    if not clean then
        notify(player, "That name won't work — 2 to 22 letters, no symbols.", "warn")
        return
    end
    -- Roblox requires a real filter pass on anything a player typed that other
    -- players will see. This is a policy requirement, not an optional nicety.
    local ok, filtered = pcall(function()
        local res = TextService:FilterStringAsync(clean, player.UserId, Enum.TextFilterContext.PublicChat)
        return res:GetNonChatStringForBroadcastAsync()
    end)
    if not ok then
        notify(player, "Couldn't check that name right now, try again.", "warn")
        return
    end

    for _, g in ipairs(profile.goobs) do
        if g.id == goobId then
            g.nickname = filtered
            if g.id == profile.activeGoobId then GoobService.refreshModel(player, g) end
            push(player)
            return
        end
    end
end)

Net.get("Ascend").OnServerEvent:Connect(function(player: Player)
    local profile = Data.get(player)
    if not profile then return end
    local goob = GoobService.activeGoob(profile)
    local crests = profile.crests or 0

    local ok, reason = Ascension.canAscend(goob, crests)
    if not ok then
        notify(player, reason or "Not yet.", "warn")
        return
    end

    -- Must physically be at the altar. Ascension is the biggest moment in the
    -- game; making it a place you travel to is most of what makes it feel like
    -- one, and it keeps the action off a menu the client could spam.
    local ball = RollService.ballFor(player)
    local pos = ball and ball.Position
        or (player.Character and (player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?)
            and (player.Character.HumanoidRootPart :: BasePart).Position)
    if not pos then return end
    if (pos - WorldBuilder.altarPosition()).Magnitude > Ascension.ALTAR_RANGE + (ball and ball.Size.X / 2 or 0) then
        notify(player, "Roll to the 👑 ASCEND altar at the hub first.", "warn")
        return
    end

    local name = goob.nickname
    local wasMass = goob.mass
    -- Everything in its belly goes with it. This is what makes old Secrets
    -- genuinely rarer over time rather than just slower to find.
    CensusService.recordDestroyed(goob.contents)

    -- Consume it. Same rule as every other sink in this game.
    for i, g in ipairs(profile.goobs) do
        if g.id == goob.id then table.remove(profile.goobs, i) break end
    end
    profile.crests = crests + 1
    profile.totalAscensions = (profile.totalAscensions or 0) + 1

    -- Always leave them with something to play.
    if #profile.goobs == 0 then
        table.insert(profile.goobs, Data.newGoob(Random.new(os.clock() * 1e6 + player.UserId)))
    end
    profile.activeGoobId = profile.goobs[1].id

    Effect:FireClient(player, "ascend")
    GoobService.spawnFor(player)
    progress(player, "ascend")
    checkAchievements(player)
    Data.save(player)
    push(player)

    notify(player, ("👑 ASCENDED! %s (⚡%s) is gone. Crest %d earned — all food is now worth %.0f%% more.")
        :format(name, Format.short(wasMass), profile.crests,
                Ascension.foodMultiplier(profile.crests) * 100), "good")
    Notify:FireAllClients(("👑 %s just ASCENDED for Crest %d!")
        :format(player.DisplayName, profile.crests), "secret")
end)

-- Purely cosmetic: lets other clients see a dash trail.
Net.get("EquipCosmetic").OnServerEvent:Connect(function(player: Player, kind: string, id: string)
    local profile = Data.get(player)
    if not profile or typeof(kind) ~= "string" or typeof(id) ~= "string" then return end
    local item = Cosmetics.get(id)
    if not item or item.kind ~= kind then return end
    if not Cosmetics.owns(profile.cosmeticsOwned, id) then
        notify(player, "You don't own that yet.", "warn")
        return
    end
    profile.loadout[kind] = id
    profile.loadout = Cosmetics.sanitise(profile.loadout, profile.cosmeticsOwned)
    RollService.applyCosmetics(player, profile.loadout)
    push(player)
end)

Net.get("ClaimSeason").OnServerEvent:Connect(function(player: Player, tier: number, premium: boolean)
    local profile = Data.get(player)
    if not profile or typeof(tier) ~= "number" then return end
    premium = premium == true
    if premium and not profile.season.premium then
        notify(player, "That reward needs the Premium pass.", "warn")
        return
    end
    -- Re-derive what is claimable server-side; the client sends only which row
    -- it pressed, never whether it has earned it.
    for _, entry in ipairs(Season.claimable(profile.season)) do
        if entry.tier == tier and entry.premium == premium then
            Season.markClaimed(profile.season, tier, premium)
            if entry.cosmetic then
                grantCosmetic(player, entry.cosmetic, ("Season tier %d"):format(tier))
            end
            -- A POWER, on the free track only. Season.powerAt has no premium
            -- argument at all, so there is nowhere for a paid one to go even
            -- by accident — see the wall in Monetisation.luau.
            if entry.power then
                profile.powersGranted = profile.powersGranted or {}
                if not profile.powersGranted[entry.power] then
                    profile.powersGranted[entry.power] = true
                    local power = Powers.get(entry.power)
                    notify(player, ("\u{2B50} BETA SEASON tier %d: %s unlocked. It is not on the banking ladder and it cannot be bought.")
                        :format(tier, power and power.name or entry.power), "good")
                end
            end
            push(player)
            return
        end
    end
    notify(player, "Nothing to claim there.", "warn")
end)

Net.get("PitJoin").OnServerEvent:Connect(function(player: Player)
    PitService.join(player)
    push(player)
end)
Net.get("PitLeave").OnServerEvent:Connect(function(player: Player)
    PitService.leave(player)
    push(player)
end)

-- ── Crews ──────────────────────────────────────────────────────────────────


Net.get("CrewCreate").OnServerEvent:Connect(function(player: Player, name: string, tag: string)
    local profile = Data.get(player)
    if not profile then return end
    if profile.crewId then notify(player, "You're already in a crew.", "warn") return end

    local cleanName = Crew.sanitiseName(name)
    local cleanTag = Crew.sanitiseTag(tag)
    if not cleanName or not cleanTag then
        notify(player, "Name 3-20 letters, tag 2-4 letters.", "warn")
        return
    end

    local goob = GoobService.activeGoob(profile)
    local cost = goob and GoobMath.incomePerSecond(goob) * Crew.CREATE_COST_SECONDS or 1000
    if profile.glob < cost then
        notify(player, ("Founding a crew costs 💧%s."):format(Format.short(cost)), "warn")
        return
    end

    -- Filter anything other players will read, exactly as for Goob names.
    local ok, filteredName = pcall(function()
        local res = TextService:FilterStringAsync(cleanName, player.UserId,
            Enum.TextFilterContext.PublicChat)
        return res:GetNonChatStringForBroadcastAsync()
    end)
    if not ok then notify(player, "Couldn't check that name, try again.", "warn") return end

    local crew = CrewStore.create(filteredName, cleanTag, player.UserId, player.DisplayName)
    if not crew then
        notify(player, "That tag is taken — pick another.", "warn")
        return
    end
    profile.glob -= cost
    profile.crewId = crew.id
    notify(player, ("🛡️ Founded [%s] %s!"):format(crew.tag, crew.name), "good")
    syncCrew(player); push(player)
end)

Net.get("CrewJoin").OnServerEvent:Connect(function(player: Player, tag: string)
    local profile = Data.get(player)
    if not profile then return end
    if profile.crewId then notify(player, "Leave your crew first.", "warn") return end
    local cleanTag = Crew.sanitiseTag(tag)
    if not cleanTag then notify(player, "That's not a valid tag.", "warn") return end

    local crew = CrewStore.findByTag(cleanTag)
    if not crew then notify(player, "No crew with that tag.", "warn") return end
    if Crew.isFull(crew) then notify(player, "That crew is full.", "warn") return end

    CrewStore.update(crew.id, function(c)
        c.members = c.members or {}
        c.members[tostring(player.UserId)] = {
            name = player.DisplayName, joined = os.time(), contributed = 0,
        }
        return c
    end)
    profile.crewId = crew.id
    notify(player, ("🛡️ Joined [%s] %s!"):format(crew.tag, crew.name), "good")
    syncCrew(player); push(player)
end)

Net.get("CrewLeave").OnServerEvent:Connect(function(player: Player)
    local profile = Data.get(player)
    if not profile or not profile.crewId then return end
    local id = profile.crewId
    CrewStore.update(id, function(c)
        if c.members then c.members[tostring(player.UserId)] = nil end
        return c
    end)
    profile.crewId = nil
    notify(player, "Left your crew.", "info")
    syncCrew(player); push(player)
end)

Net.get("CrewClaim").OnServerEvent:Connect(function(player: Player)
    local profile = Data.get(player)
    if not profile or not profile.crewId then return end
    local week = Crew.currentWeek()
    local crew = CrewStore.get(profile.crewId)
    if not crew or not Crew.isComplete(crew, week) then
        notify(player, "The weekly goal isn't finished yet.", "warn")
        return
    end
    if Crew.hasClaimed(crew, player.UserId) then
        notify(player, "You've already claimed this week.", "warn")
        return
    end
    local goob = GoobService.activeGoob(profile)
    local reward = goob and GoobMath.incomePerSecond(goob) * Crew.REWARD_GLOB_SECONDS or 500
    profile.glob += reward
    CrewStore.update(crew.id, function(c) Crew.markClaimed(c, player.UserId) return c end)
    progress(player, "crewGoal")
    notify(player, ("🛡️ Crew goal reward: +💧%s"):format(Format.short(reward)), "good")
    syncCrew(player); push(player)
end)

Net.get("BuyProduct").OnServerEvent:Connect(function(player: Player, id: string)
    -- Purchases are prompted client-side via MarketplaceService; this handler
    -- exists so the client can ask what is actually for sale, and so an
    -- unconfigured product says so plainly instead of failing silently.
    if typeof(id) ~= "string" then return end
    for _, list in ipairs({ Monetisation.GAMEPASSES, Monetisation.PRODUCTS }) do
        for _, entry in ipairs(list) do
            if entry.id == id then
                if not Monetisation.isConfigured(entry) then
                    notify(player, "That isn't on sale yet.", "warn")
                end
                return
            end
        end
    end
end)

Net.get("Dashed").OnServerEvent:Connect(function(player: Player)
    local ball = RollService.ballFor(player)
    if not ball then return end
    ball:SetAttribute("DashAt", os.clock())
end)

Net.get("SetActiveGoob").OnServerEvent:Connect(function(player: Player, goobId: string)
    local profile = Data.get(player)
    if not profile or typeof(goobId) ~= "string" then return end
    for _, g in ipairs(profile.goobs) do
        if g.id == goobId then
            profile.activeGoobId = goobId
            GoobService.spawnFor(player)
            push(player)
            notify(player, "Now displaying " .. g.nickname .. ".", "info")
            return
        end
    end
end)

Net.get("GulpGoob").OnServerEvent:Connect(function(player: Player, eaterId: string, eatenId: string)
    local ok, reason = GoobService.gulp(player, eaterId, eatenId)
    if ok then
        notify(player, "😋 GULP! Your Goob swallowed another one.", "good")
        Effect:FireClient(player, "gulp")
        teach(player, "gulp")
        progress(player, "gulp")
        push(player)
    elseif reason then
        notify(player, reason, "warn")
    end
end)

Net.get("TradeRequest").OnServerEvent:Connect(function(player, targetName)
    if typeof(targetName) == "string" then TradeService.request(player, targetName) end
end)
Net.get("TradeRespond").OnServerEvent:Connect(function(player, accept)
    TradeService.respond(player, accept == true)
end)
Net.get("TradeOffer").OnServerEvent:Connect(function(player, goobId, add)
    if typeof(goobId) == "string" then TradeService.offer(player, goobId, add == true) end
end)
Net.get("TradeConfirm").OnServerEvent:Connect(function(player, holding)
    TradeService.confirm(player, holding == true)
end)
Net.get("TradeCancel").OnServerEvent:Connect(function(player)
    TradeService.cancel(player)
end)

TradeService.onSync.Event:Connect(function(player, state)
    TradeSync:FireClient(player, state)
    push(player)
end)
TradeService.onNotify.Event:Connect(function(player, msg, kind)
    notify(player, msg, kind)
end)

print(("[%s] ready. one island, %d pellets, %d powers, %d trinkets, %d crates.")
    :format(Config.GAME_NAME, Config.PELLET_TARGET,
        #Powers.FIXED + #Powers.LIST + #Powers.SEASON,
        #Trinkets.LIST, #Crates.LIST))
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX000019"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ArenaService.luau — the island, running.
--
-- Everything the player feels happens in one fixed-step loop: eat, melt, bank,
-- pop. The curves it drives are in Blob.luau and are separately simulated; this
-- file is the part that has to be FAST, because it runs over every player and
-- every pellet several times a second on a Roblox server that is also doing
-- physics for thirty rolling balls.
--
-- THE ONE PERFORMANCE DECISION THAT MATTERS: pellets live in a spatial hash,
-- not a list. The naive version checks every player against every pellet —
-- 30 x 430 = 12,900 distance tests per tick, 190,000 a second, which is enough
-- Luau to visibly cost frames. The grid turns that into "look in the nine
-- cells around me", which is a couple of dozen tests regardless of how many
-- pellets the island is holding.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game.ReplicatedStorage.GoobShared
local Config = require(Shared.Config)
local Blob = require(Shared.Blob)
local Powers = require(Shared.Powers)
local Trinkets = require(Shared.Trinkets)
local Format = require(Shared.Format)

local RollService = require(script.Parent.RollService)
local WorldBuilder = require(script.Parent.WorldBuilder)
local BotService = require(script.Parent.BotService)
local GoopService = require(script.Parent.GoopService)

local ArenaService = {}

-- ── Tuning that belongs to the loop, not the design ────────────────────────
local TICK = 1 / 12              -- the arena's own step, independent of render
local CELL = 40                  -- stud size of one spatial-hash cell
local PICKUP_SLACK = 1.6         -- studs of forgiveness on a pellet grab
local EAT_OVERLAP = 0.55         -- how far in you must be to swallow someone
local BANK_MAX_SPEED = 14        -- you must actually stop to bank
local POP_INVULN = 2.0           -- seconds of grace after respawning
local SLAM_AIRTIME = 0.85        -- how long a SLAM hangs before it lands
local SLAM_RADIUS = 46
local SLAM_IMPULSE = 120
local HOOK_RANGE = 90
local HOOK_PULL = 96
local SPLIT_RETURN = 0.55        -- of the thrown half, how much comes back
local BLINK_DISTANCE = 74
local SIPHON_RANGE = 82
local SIPHON_FRACTION = 0.10
local BEACON_BONUS = 0.45
local DECOY_LIFETIME = 7

export type Run = {
    mass: number,
    powerId: string,
    -- ONE COOLDOWN PER SLOT, not one for the blob. The hotbar is three
    -- buttons; a shared cooldown would make pressing DASH disable SPLIT, which
    -- is not a trade anybody would choose to make and reads as a bug.
    slotReadyAt: { number },
    globlets: { any },      -- live SPLIT pieces, each tethered back to the body
    snagUntil: number,      -- slowed by somebody's tether
    powerReadyAt: number,
    powerUntil: number,
    activeEffect: string?,
    slamUntil: number,      -- airborne on a SLAM; the shockwave lands when it ends
    splitOwed: number,      -- mass thrown by SPLIT, part of which returns
    banking: number,
    leakBuffer: number,
    safeUntil: number,
    rimGrace: number,       -- seconds of rim protection left in the meter
    committed: boolean,     -- has this blob ever left the rim for the Flats
    trinkets: Trinkets.Resolved,
    bestMass: number,
    peakThisRound: number,
    lastPos: Vector3,
    startedAt: number,      -- for the run summary
    ateThisRun: number,
}

-- ── The round ──────────────────────────────────────────────────────────────
-- LOBBY -> PLAYING -> RESULTS -> LOBBY, forever. The phase is the single piece
-- of state that decides whether anything in this file is allowed to happen:
-- no eating, no pellets and no deflation outside PLAYING.
local phase = "LOBBY"
local phaseEndsAt = 0
local roundNumber = 0
local lastResults: { any } = {}

local runs: { [number]: Run } = {}
local rng = Random.new(os.clock() * 1e6 // 1)

-- `owner` and `ownerUntil` exist because of a bug that silently deleted the
-- entire game. Leaked goop was spawned inside the leaking blob's own pickup
-- radius, so a big blob vacuumed its own drips straight back up and its net
-- melt was ZERO — the ceiling vanished, AFK became viable again, and the food
-- a big player is supposed to be feeding the island never reached the floor.
-- A dropped pellet is now untouchable BY ITS DROPPER for a few seconds, and
-- lands outside their body as well. Belt and braces, because this one is not
-- allowed to come back.
-- TWO owners, not one. The second is the blob that CAUSED the drop.
--
-- Deflation scatters what it knocks off, and the whole point of that is to
-- feed whoever is standing nearby — but the blob standing nearest is always
-- the one that just landed the hit, and once bodies got physically bigger
-- (radius went from a logarithm to a cube root) its pickup reach covered the
-- entire scatter ring. The attacker vacuumed up its own deflation before
-- anybody else could move, which turns a comeback mechanic into a feeding
-- mechanic for whoever is already winning.
--
-- Same shape as the original fix for a blob eating its own drips: the food is
-- real, it is on the floor, and for a few seconds it belongs to everybody
-- except the two blobs that produced it.
type Pellet = { part: BasePart, value: number, key: string,
    owner: number?, owner2: number?, ownerUntil: number }
local pellets: { [BasePart]: Pellet } = {}
local grid: { [string]: { [BasePart]: Pellet } } = {}
local pelletCount = 0

type Lump = { part: BasePart, mass: number }
local lumps: { Lump } = {}

-- Injected by init.server so this file never reaches into the profile store.
-- It keeps the arena testable in isolation and keeps one owner for Glob.
type Deps = {
    award: (player: Player, glob: number, xp: number, reason: string) -> (),
    notify: (player: Player, text: string, kind: string?) -> (),
    effect: (player: Player, kind: string, data: any?) -> (),
    loadout: (player: Player) -> ({ string }, string),   -- trinket ids, power id
    sync: (player: Player, state: any) -> (),
    teach: (player: Player, event: string) -> (),
    -- Lifetime banked Glob, which is what decides whether the power in slot 3
    -- is actually unlocked. Read through deps rather than cached on the run:
    -- it can cross an unlock threshold mid-round, and a hotbar that only
    -- refreshed on respawn would show a power the server then refuses.
    banked: (player: Player) -> number,
    -- Powers handed over by the BETA SEASON's free track rather than earned on
    -- the banking ladder. A second way to own a power, and the only way into
    -- the two that are not on the ladder at all.
    granted: (player: Player) -> { [string]: boolean },
    powerUses: (player: Player) -> { [string]: number },
    notePowerUse: (player: Player, id: string) -> (),
    -- Everything a finished round owes the PROFILE rather than the wallet:
    -- feeding your Goob, counting rounds towards an egg. Separate from
    -- `award` because award has exactly one job — creating Glob — and this
    -- needs the finishing place, which Glob does not care about.
    roundResult: (player: Player, place: number, mass: number, payout: number) -> (),
}
local deps: Deps

-- ── Spatial hash ───────────────────────────────────────────────────────────

local function cellKey(x: number, z: number): string
    return (math.floor(x / CELL)) .. ":" .. (math.floor(z / CELL))
end

local function gridAdd(p: Pellet)
    local bucket = grid[p.key]
    if not bucket then
        bucket = {}
        grid[p.key] = bucket
    end
    bucket[p.part] = p
end

local function gridRemove(p: Pellet)
    local bucket = grid[p.key]
    if bucket then
        bucket[p.part] = nil
    end
end

-- ── Pellets ────────────────────────────────────────────────────────────────

-- Seconds a dropper cannot re-eat what it just shed.
local OWNER_LOCKOUT = 4

local function spawnPellet(at: Vector3?, value: number?, golden: boolean?,
    owner: number?, owner2: number?)
    if pelletCount >= Config.PELLET_TARGET + 260 then
        return -- the floor is already carpeted; dropping more helps nobody
    end
    local folder = WorldBuilder.arenaFolder()
    if not folder then
        return
    end
    local pos = at or WorldBuilder.randomSurfacePoint(rng)
    local biome = WorldBuilder.biomeAt(pos)
    local worth = (value or Config.PELLET_VALUE) * (biome and biome.pelletMult or 1)
    if golden then
        worth *= Config.GOLDEN_CRUMB_MULT
    end

    local part = Instance.new("Part")
    part.Name = golden and "Crumb" or "Pellet"
    part.Shape = Enum.PartType.Ball
    part.Size = Vector3.new(1, 1, 1) * (golden and 3.4 or 2.2)
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Material = golden and Enum.Material.Foil or Enum.Material.SmoothPlastic
    part.Color = golden and Color3.fromRGB(206, 180, 118)
        or Color3.fromHSV(rng:NextNumber(0.18, 0.55), 0.34, 0.86)
    part.Position = pos + Vector3.new(0, 1.6, 0)
    part.Parent = folder

    local p: Pellet = {
        part = part,
        value = worth,
        key = cellKey(pos.X, pos.Z),
        owner = owner,
        owner2 = owner2,
        ownerUntil = (owner or owner2) and (os.clock() + OWNER_LOCKOUT) or 0,
    }
    pellets[part] = p
    gridAdd(p)
    pelletCount += 1
end

local function removePellet(p: Pellet)
    gridRemove(p)
    pellets[p.part] = nil
    pelletCount -= 1
    p.part:Destroy()
end

-- ── What the bots are allowed to ask the island ────────────────────────────
--
-- Bots do not own pellets, do not own mass, and do not get their own copy of
-- either rule. They get these two questions and nothing else, which is what
-- keeps "how does eating work" a single answer for every contender on the map.

--- Where is the nearest pellet, if any, within `radius`? Walks the same
--- spatial hash the players use rather than the whole pellet list: at 1,400
--- pellets and twelve bots re-asking every think, the naive version is 17,000
--- distance tests a second for nothing.
local function nearestPelletPos(from: Vector3, radius: number): Vector3?
    local best, bestD = nil, radius
    local span = math.max(1, math.ceil(radius / CELL))
    local cx, cz = math.floor(from.X / CELL), math.floor(from.Z / CELL)
    for gx = cx - span, cx + span do
        for gz = cz - span, cz + span do
            local bucket = grid[gx .. ":" .. gz]
            if bucket then
                for part, _ in pairs(bucket) do
                    if part.Parent then
                        local d = (part.Position - from).Magnitude
                        if d < bestD then
                            best, bestD = part.Position, d
                        end
                    end
                end
            end
        end
    end
    return best
end

--- Eat every pellet within `reach` of a point, returning the mass taken. The
--- same nine-cell sweep tickPlayer does, minus the trinkets and teaching a
--- bot has no use for.
local function harvestAt(from: Vector3, reach: number): number
    local gained = 0
    local cx, cz = math.floor(from.X / CELL), math.floor(from.Z / CELL)
    for gx = cx - 1, cx + 1 do
        for gz = cz - 1, cz + 1 do
            local bucket = grid[gx .. ":" .. gz]
            if bucket then
                for part, pellet in pairs(bucket) do
                    if part.Parent then
                        if (part.Position - from).Magnitude <= reach then
                            gained += pellet.value
                            removePellet(pellet)
                        end
                    else
                        removePellet(pellet)
                    end
                end
            end
        end
    end
    return gained
end

-- CAN THIS PLAYER BE TOUCHED BY SOMEONE ELSE'S POWER?
--
-- This existed only inside the eating check, which meant SIPHON, HOOK and SLAM
-- all reached straight into the no-PvP Shallows and into the two seconds of
-- grace a player gets after respawning. A player could be drained, yanked and
-- blasted while standing in the one place the game promises is safe — and the
-- promise is load-bearing, because the Shallows is where new players spawn and
-- where the tutorial runs.
--
-- Every power that affects another player goes through here. BUBBLE is not
-- included: it is a self-buff against being EATEN specifically, and a shield
-- that also blocked a shove would make it strictly better than everything.
local function protected(player: Player, run: Run?, now: number): boolean
    if not run then
        return true
    end
    local ball = RollService.ballFor(player)
    if not ball or not ball.Parent then
        return true
    end
    -- THE RIM IS A FIRE ESCAPE, NOT A HOUSE.
    --
    -- Standing in the Shallows used to be unconditional immunity, which is why
    -- no food could be spawned out there: a player could stand in the one
    -- place nothing could reach them, and if there had been anything to eat,
    -- standing still would have been the winning strategy.
    --
    -- Now the ground does not protect you; a METER does, and being on the rim
    -- is what spends it (tickPlayer drains it). Duck out to shake a chaser and
    -- you are fine. Try to live out there and you run dry in about twelve
    -- seconds, at which point the edge is simply the most exposed ground on the
    -- island — which is exactly what it should be, and what finally lets food
    -- grow all the way to the shoreline.
    if now < run.safeUntil then
        return true
    end
    return WorldBuilder.isSafe(ball.Position) and run.rimGrace > 0
end

-- How many times this player has used a power.
--
-- Read through deps every time rather than cached on the run. The cached copy
-- was the SAME TABLE as profile.powerUses, so incrementing it here and calling
-- notePowerUse counted every press TWICE: mastery accrued at double rate and
-- the tier-up announcement compared a number that had already moved. One
-- owner — the profile — and no alias to fall out of sync with it.
local function usesOf(player: Player, id: string): number
    return (deps.powerUses(player) or {})[id] or 0
end

-- DEFLATE A BLOB.
--
-- Takes a fraction of the TARGET'S OWN mass, which is what makes this a
-- catch-up mechanism rather than a flat nerf: the bigger somebody is, the more
-- there is to take, so the leader is always the most rewarding thing on the
-- island to hit. What comes off does not vanish — most of it lands as pellets
-- right where it happened, so deflating the leader literally feeds whoever is
-- standing nearby. That is the entire comeback loop in one function.
--
-- Returns how much was removed, so a thief (SIPHON) can keep it instead.
local function deflate(target: Player, targetRun: Run, fraction: number,
    scatterIt: boolean, byUserId: number?): number
    if fraction <= 0 then
        return 0
    end
    local before = targetRun.mass
    local taken = math.max(0, before - Config.STARTING_MASS) * fraction
    if taken <= 0 then
        return 0
    end
    targetRun.mass = math.max(Config.STARTING_MASS, before - taken)

    if scatterIt then
        local ball = RollService.ballFor(target)
        local at = ball and ball.Position or Vector3.zero
        local food = taken * Config.DEFLATE_RETURN_AS_FOOD
        local n = math.clamp(math.floor(food / Config.LEAK_PELLET_MASS), 1, 30)
        local radius = Blob.radius(before)
        for i = 1, n do
            local a = math.rad((360 / n) * i + rng:NextNumber(-12, 12))
            local d = radius * 1.6 + rng:NextNumber(3, 18)
            spawnPellet(Vector3.new(at.X + math.cos(a) * d, at.Y, at.Z + math.sin(a) * d),
                food / n, false, target.UserId, byUserId)
        end
    end

    deps.effect(target, "deflated", { amount = taken })
    return taken
end

--- The same deflation, applied to a bot.
---
--- Separate function, identical rule. A bot has no Player, no trinkets and no
--- notifications, so sharing the body of `deflate` would mean threading nil
--- through four call sites for the privilege of one shared line of arithmetic.
--- What must NOT diverge is the fraction and the fact that what comes off
--- lands as food — both come straight from Config here, same as for a player,
--- so deflating the leader feeds the island whether the leader is human or not.
local function deflateBot(bot: any, fraction: number, scatterIt: boolean,
    byUserId: number?): number
    local taken = bot.mass * math.clamp(fraction, 0, 0.9)
    if taken <= 0 then
        return 0
    end
    bot.mass = math.max(Config.STARTING_MASS, bot.mass - taken)
    if scatterIt then
        local back = taken * Config.DEFLATE_RETURN_AS_FOOD
        local drops = math.clamp(math.floor(back / Config.LEAK_PELLET_MASS), 1, 14)
        local r = Blob.radius(bot.mass)
        for i = 1, drops do
            local a = math.rad((360 / drops) * i) + rng:NextNumber(-0.3, 0.3)
            local d = r * 1.8 + rng:NextNumber(3, 14)
            spawnPellet(Vector3.new(bot.pos.X + math.cos(a) * d, 2,
                bot.pos.Z + math.sin(a) * d), back / drops, false, nil, byUserId)
        end
    end
    return taken
end

--- Is this bot currently untouchable? Same two reasons a player is: it is on
--- the rim with meter left, or it is mid-respawn.
local function botProtected(bot: any): boolean
    return bot.respawnAt ~= 0 or (WorldBuilder.isSafe(bot.pos) and bot.rimGrace > 0)
end

-- ── Decoys ─────────────────────────────────────────────────────────────────
-- A fake body at your current size, in your colour, that anyone may try to
-- eat and that gives nothing when they do. It is the only power in the game
-- that costs the VICTIM something — the seconds they spend committing to a
-- meal that was never there — which is a completely different kind of threat
-- from every other power, all of which are about speed or mass.
local function spawnDecoy(player: Player, run: Run, at: Vector3)
    local folder = WorldBuilder.arenaFolder()
    local real = RollService.ballFor(player)
    if not folder or not real then
        return
    end
    local fake = Instance.new("Part")
    fake.Name = "Decoy"
    fake.Shape = Enum.PartType.Ball
    fake.Size = real.Size
    fake.Anchored = true
    fake.CanCollide = false
    fake.CanTouch = false
    fake.CanQuery = false
    fake.Material = real.Material
    fake.Color = real.Color
    fake.Transparency = real.Transparency
    fake.Position = at + Vector3.new(0, real.Size.X * 0.1, 0)
    fake.Parent = folder
    -- task.delay rather than Debris: one fewer service to reach for, and the
    -- decoy has to disappear on the same clock everything else in the arena
    -- runs on.
    task.delay(DECOY_LIFETIME, function()
        if fake.Parent then fake:Destroy() end
    end)
end

-- DECLARED ABOVE ArenaService.enter, which calls them. A `local function` only
-- enters scope from its declaration downward, so with these left next to the
-- rest of the round machine — which sits near the bottom of the file — the
-- call inside enter() resolved to a nil GLOBAL and the server died on the
-- first join. Fifth time in this project. tools/scopecheck.py now fails the
-- build on it rather than waiting for a play-test to find it.
local function sendToLobby(player: Player, index: number)
    local run = runs[player.UserId]
    if run then
        run.mass = Config.STARTING_MASS
        run.banking = 0
        run.leakBuffer = 0
        run.slamUntil = 0
        run.splitOwed = 0
        run.activeEffect = nil
        run.powerUntil = 0
        run.safeUntil = os.clock() + 3600   -- untouchable for the whole lobby
        RollService.setRadius(player, Blob.radius(run.mass))
    end
    RollService.teleport(player, WorldBuilder.lobbyPoint(index))
end

local function sendToArena(player: Player, index: number)
    local run = runs[player.UserId]
    if run then
        run.mass = Config.STARTING_MASS
        run.bestMass = Config.STARTING_MASS
        run.peakThisRound = Config.STARTING_MASS
        run.banking = 0
        run.leakBuffer = 0
        run.slamUntil = 0
        run.splitOwed = 0
        run.activeEffect = nil
        run.powerUntil = 0
        run.ateThisRun = 0
        run.snagUntil = 0
        run.slotReadyAt = { 0, 0, 0 }
        run.startedAt = os.clock()
        run.safeUntil = os.clock() + POP_INVULN
        RollService.setRadius(player, Blob.radius(run.mass))
    end
    RollService.teleport(player, WorldBuilder.spawnPoint(index))
end


-- ── Run state ──────────────────────────────────────────────────────────────

local function newRun(player: Player): Run
    local ids, powerId = deps.loadout(player)
    return {
        mass = Config.STARTING_MASS,
        powerId = Powers.get(powerId) and powerId or Powers.DEFAULT,
        slotReadyAt = { 0, 0, 0 },
        globlets = {},
        snagUntil = 0,
        powerReadyAt = 0,
        powerUntil = 0,
        activeEffect = nil,
        slamUntil = 0,
        splitOwed = 0,
        banking = 0,
        leakBuffer = 0,
        safeUntil = os.clock() + POP_INVULN,
        -- Full meter on arrival. A fresh blob gets a real look at the island
        -- before anything is allowed to touch it, which is what makes spawning
        -- out on the rim the right answer for a new player rather than a trap.
        rimGrace = Config.SHALLOWS_GRACE,
        -- The meter does not start running until you have actually gone in.
        -- Spawns sit ON the rim (SPAWN_RING is outside SHALLOWS_INNER), so a
        -- meter that drained from the first tick would leave every player in
        -- the round with twelve seconds gone before they had done anything —
        -- and a brand-new player, who stands still and reads the tutorial,
        -- would spend the entire meter learning the controls. The rim is meant
        -- to stop you LIVING out there, not to punish you for arriving.
        committed = false,
        trinkets = Trinkets.resolve(ids),
        bestMass = Config.STARTING_MASS,
        peakThisRound = Config.STARTING_MASS,
        lastPos = Vector3.zero,
        startedAt = os.clock(),
        ateThisRun = 0,
    }
end

function ArenaService.runFor(player: Player): Run?
    return runs[player.UserId]
end

function ArenaService.massOf(player: Player): number
    local r = runs[player.UserId]
    return r and r.mass or 0
end

-- Re-read a player's equipped trinkets and power without disturbing their run.
function ArenaService.refreshLoadout(player: Player)
    local r = runs[player.UserId]
    if not r then
        return
    end
    local ids, powerId = deps.loadout(player)
    r.trinkets = Trinkets.resolve(ids)
    if Powers.get(powerId) then
        r.powerId = powerId
    end
end

function ArenaService.enter(player: Player)
    runs[player.UserId] = newRun(player)
    -- Arrive into whatever is happening. Joining mid-round puts you on the
    -- island small and late, which is the honest version of walking in halfway
    -- through — and joining during a lobby puts you where everyone else is.
    local n = #Players:GetPlayers()
    if phase == "PLAYING" then
        sendToArena(player, n)
    else
        sendToLobby(player, n)
    end
end

function ArenaService.leave(player: Player)
    runs[player.UserId] = nil
end

-- ── Lumps: the island's memory ─────────────────────────────────────────────

local function congeal(at: Vector3, mass: number)
    local folder = WorldBuilder.arenaFolder()
    if not folder or mass <= 0 then
        return
    end
    -- Oldest lump goes first when the island is full. A cap exists because
    -- terrain that only ever grows eventually walls the Vault off, and the
    -- Vault being reachable is not negotiable.
    if #lumps >= Config.LUMP_MAX_COUNT then
        local oldest = table.remove(lumps, 1)
        if oldest then
            oldest.part:Destroy()
        end
    end

    local radius = Blob.lumpRadius(mass)

    -- NEVER ON THE VAULT. Lumps are solid terrain that lasts most of an hour,
    -- and one congealed on the dish would physically wall off the only place
    -- in the game where mass can be made safe. Pops near the centre are pushed
    -- out past the ramps instead of being dropped where they happened.
    local flat = Vector3.new(at.X, 0, at.Z)
    local keepOut = Config.VAULT_RADIUS + 34 + radius
    if flat.Magnitude < keepOut then
        local dir = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, 1)
        at = Vector3.new(dir.X * keepOut, at.Y, dir.Z * keepOut)
    end

    local part = Instance.new("Part")
    part.Name = "Lump"
    part.Shape = Enum.PartType.Ball
    part.Size = Vector3.new(radius, radius * 0.7, radius) * 2
    part.Anchored = true
    part.CanCollide = true
    part.Material = Enum.Material.Sand
    part.Color = Color3.fromRGB(128, 122, 108)
    part.Position = Vector3.new(at.X, at.Y - radius * 0.45, at.Z)
    part.Parent = folder

    table.insert(lumps, { part = part, mass = mass })
end

local function decayLumps(dt: number)
    for i = #lumps, 1, -1 do
        local lump = lumps[i]
        lump.mass = Blob.lumpDecay(lump.mass, dt)
        if lump.mass < 12 then
            lump.part:Destroy()
            table.remove(lumps, i)
        else
            local radius = Blob.lumpRadius(lump.mass)
            lump.part.Size = Vector3.new(radius, radius * 0.7, radius) * 2
        end
    end
end

-- What a run was. Sent on every bank and every pop, because a loop this short
-- needs to close.
--
-- DECLARED HERE, ABOVE pop(), and that is not tidiness. A `local function`
-- only enters scope from its declaration downward: with this defined next to
-- bank() — which sits below pop() — the call inside pop() resolved to a nil
-- GLOBAL, the server booted perfectly, and the whole arena loop died the first
-- time anybody was eaten. The same trap has now taken down three builds of
-- this game.
--
-- The original note said the loop needs to close: without it a run just stops, and the player is left to
-- reconstruct what happened from a number that already changed.
local function summary(run: Run, ended: string, payout: number?)
    return {
        ended = ended,
        seconds = os.clock() - run.startedAt,
        peak = run.bestMass,
        ate = run.ateThisRun,
        payout = payout or 0,
    }
end

-- ── Popping ────────────────────────────────────────────────────────────────

local function pop(player: Player, at: Vector3, killer: Player?)
    -- Your tethers die with you. A fence still standing after its builder has
    -- been eaten is a wire to nowhere, and it would let a dead player keep
    -- shaping the fight from the respawn queue.
    GoopService.clearOwner(player.UserId)
    local run = runs[player.UserId]
    if not run then
        return
    end
    local split = Blob.popSplit(run.mass, run.trinkets.popKeep)

    -- Scatter. One pellet per LEAK_PELLET_MASS of scattered goop, thrown in a
    -- ring so the kill site is visibly a meal rather than a puff of dust.
    local n = math.clamp(math.floor(split.scatter / Config.LEAK_PELLET_MASS), 1, 40)
    for i = 1, n do
        local a = math.rad((360 / n) * i + rng:NextNumber(-14, 14))
        local d = rng:NextNumber(4, 16)
        spawnPellet(at + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d),
            split.scatter / n, false)
    end

    congeal(at, split.congeal)

    if deps then
        deps.effect(player, "runEnd", summary(run, "popped", 0))
        deps.effect(player, "pop", { mass = run.mass })
        if killer then
            deps.notify(killer, ("🫧 Popped %s. +%s mass.")
                :format(player.DisplayName, Format.short(Blob.eatGain(0, run.mass))), "good")
        end
        deps.notify(player, split.kept > 0
            and ("💥 Popped — but you kept %s."):format(Format.short(split.kept))
            or "💥 Popped. Start again.", "bad")
    end

    -- Clear anything mid-flight. A SLAM launched a moment before being eaten
    -- would otherwise land its shockwave wherever the player respawned, and a
    -- SPLIT owed to the old run would pay into the new one.
    run.slamUntil = 0
    run.splitOwed = 0
    run.activeEffect = nil
    run.powerUntil = 0

    run.mass = math.max(Config.STARTING_MASS, split.kept)
    run.startedAt = os.clock()
    run.ateThisRun = 0
    run.bestMass = run.mass
    run.banking = 0
    run.leakBuffer = 0
    run.safeUntil = os.clock() + POP_INVULN

    local a = rng:NextNumber(0, math.pi * 2)
    RollService.teleport(player, Vector3.new(
        math.cos(a) * Config.SPAWN_RING, 8, math.sin(a) * Config.SPAWN_RING))
end

-- ── Banking ────────────────────────────────────────────────────────────────

local function bank(player: Player, run: Run)
    local glob = Blob.bankValue(run.mass)
    local xp = math.floor(run.mass * 0.9)
    deps.award(player, glob, xp, "bank")
    deps.effect(player, "bank", { glob = glob, mass = run.mass })
    deps.notify(player, ("🏦 Banked %s mass → 💧%s"):format(
        Format.short(run.mass), Format.short(glob)), "good")
    deps.effect(player, "runEnd", summary(run, "banked", glob))
    deps.teach(player, "bank")
    run.slamUntil = 0
    run.splitOwed = 0
    run.activeEffect = nil
    run.powerUntil = 0
    run.startedAt = os.clock()
    run.ateThisRun = 0
    run.bestMass = Config.BANK_RESET_MASS
    run.mass = Config.BANK_RESET_MASS
    run.banking = 0
    run.leakBuffer = 0
end

-- ── Powers ─────────────────────────────────────────────────────────────────

--- THE HOTBAR, resolved. Slot 1 is DASH, slot 2 is SPLIT, slot 3 is the power
--- the player chose. One function, so "what is in slot 3" has a single answer
--- on the server and the client reads the same one off the snapshot.
function ArenaService.hotbarFor(player: Player): { any }
    local run = runs[player.UserId]
    return Powers.hotbar(run and run.powerId, deps.banked(player), deps.granted(player))
end

function ArenaService.usePower(player: Player, slot: number?, aim: Vector3?): (boolean, string?)
    local run = runs[player.UserId]
    if not run then
        return false, "You're not in the arena."
    end
    if phase ~= "PLAYING" then
        return false, "Wait for the round to start."
    end
    -- Defaulting to slot 1 rather than rejecting a missing slot: an old client
    -- that has not been reloaded still sends the one-button shape, and having
    -- its DASH silently stop working would be a much worse failure than having
    -- it press the first slot.
    local index = math.clamp(math.floor(tonumber(slot) or 1), 1, 3)
    local bar = Powers.hotbar(run.powerId, deps.banked(player), deps.granted(player))
    local power = bar[index]
    if not power then
        return false, "Nothing in that slot."
    end

    local now = os.clock()
    run.slotReadyAt = run.slotReadyAt or { 0, 0, 0 }
    if now < (run.slotReadyAt[index] or 0) then
        return false, ("%.1fs"):format(run.slotReadyAt[index] - now)
    end

    local uses = usesOf(player, power.id)
    local cost = Powers.massCost(power.id, run.mass, uses)
    if run.mass - cost < Config.STARTING_MASS * 0.5 then
        return false, "Too small to pay for that."
    end
    local ball = RollService.ballFor(player)
    if not ball then
        return false, "No body."
    end

    run.mass -= cost
    run.slotReadyAt[index] = now + Powers.cooldown(power.id, run.trinkets.powerHaste, uses)
    deps.notePowerUse(player, power.id)
    -- `activePower` is what the rest of this function branches on. It used to
    -- read run.powerId directly, which was correct when the blob carried one
    -- power and is wrong now: pressing DASH would have run the chosen power's
    -- effect while charging DASH's cooldown.
    local activePower = power.id
    -- Settle any outstanding SPLIT first. activeEffect is overwritten below,
    -- so without this the thrown half is orphaned the moment you press any
    -- other power and its mass is silently deleted — you pay half of yourself
    -- and get nothing back.
    if run.splitOwed > 0 then
        run.mass += run.splitOwed * SPLIT_RETURN
        run.splitOwed = 0
    end

    run.powerUntil = now + math.max(0.05, power.duration)
    run.activeEffect = activePower

    -- The mass you spend is not deleted: it lands on the floor as food. Powers
    -- feeding the island is what stops a lobby full of dashing from starving
    -- the pellet supply, and it makes a spammed power visibly generous.
    local radius = Blob.radius(run.mass)
    local away = (aim or ball.CFrame.LookVector)
    away = Vector3.new(away.X, 0, away.Z)
    away = away.Magnitude > 0.01 and away.Unit or Vector3.new(0, 0, 1)
    local behind = ball.Position - away * (radius * 1.9 + 4)
    local drops = math.clamp(math.floor(cost / Config.LEAK_PELLET_MASS), 1, 8)
    for i = 1, drops do
        spawnPellet(behind + Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6)),
            cost / drops, false, player.UserId)
    end

    local dir = (aim or ball.CFrame.LookVector)
    dir = Vector3.new(dir.X, 0, dir.Z)
    dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 0, 1)

    if activePower == "dash" then
        ball.AssemblyLinearVelocity = dir * 110 + Vector3.new(0, 8, 0)
    elseif activePower == "slam" then
        ball.AssemblyLinearVelocity = Vector3.new(0, 74, 0) + dir * 24
        -- The impact is not instant: it lands when you do. tickPlayer watches
        -- slamUntil and fires the shockwave at the bottom of the arc, which is
        -- the only timing that reads as a slam rather than a shrug.
        run.slamUntil = now + SLAM_AIRTIME
    elseif activePower == "split" then
        -- THROW, don't lunge. The old SPLIT shoved your whole body forward at
        -- 128 studs/sec and booked half your mass to be refunded later, which
        -- is a dash with a bill attached — it looked like nothing had split.
        -- Now it actually splits: pieces leave the body, fly out on their own,
        -- eat, and come back, each one trailing a tether that other blobs have
        -- to respect.
        local each = math.max(Config.LEAK_PELLET_MASS, run.mass * 0.06)
        local thrown = GoopService.split(player.UserId, ball.Position, dir,
            each, Config.SPLIT_PIECES, ball.Color, false)
        run.mass = math.max(Config.STARTING_MASS, run.mass - thrown)
        ball.AssemblyLinearVelocity = dir * 42 + Vector3.new(0, 6, 0)
        deps.effect(player, "split", { pieces = Config.SPLIT_PIECES })
    elseif activePower == "hook" then
        -- Reel. Bigger drags smaller toward it; smaller drags ITSELF toward
        -- bigger, which is what makes HOOK a chase tool for the hunter and an
        -- escape-the-open-ground tool for the hunted with the same button.
        local target, best = nil, HOOK_RANGE
        for _, other in ipairs(Players:GetPlayers()) do
            local orun = runs[other.UserId]
            if other ~= player and orun and not protected(other, orun, now) then
                local ob = RollService.ballFor(other)
                if ob and ob.Parent then
                    local d = (ob.Position - ball.Position).Magnitude
                    if d < best then target, best = other, d end
                end
            end
        end
        local hookBot = nil
        for _, bot in ipairs(BotService.living()) do
            if not botProtected(bot) then
                local d = (bot.pos - ball.Position).Magnitude
                if d < best then hookBot, best = bot, d end
            end
        end
        if hookBot then
            -- Same rule as against a player: bigger drags smaller, smaller
            -- drags itself. A bot cannot be shoved by physics here because it
            -- is kinematic, so the reel is applied to its position directly.
            local toward = Vector3.new(ball.Position.X - hookBot.pos.X, 0,
                ball.Position.Z - hookBot.pos.Z)
            if toward.Magnitude > 0.01 then
                toward = toward.Unit
                if run.mass >= hookBot.mass then
                    hookBot.pos += toward * math.min(HOOK_PULL * 0.5, best - 4)
                    hookBot.goal = hookBot.pos
                else
                    ball.AssemblyLinearVelocity = -toward * HOOK_PULL + Vector3.new(0, 12, 0)
                end
                deflateBot(hookBot, Config.DEFLATE.hook, true, player.UserId)
                deps.teach(player, "deflate")
                deps.effect(player, "hook", { to = hookBot.name })
            end
        elseif target then
            local tb = RollService.ballFor(target)
            local tr = runs[target.UserId]
            if tb and tr then
                local toward = (ball.Position - tb.Position)
                toward = Vector3.new(toward.X, 0, toward.Z)
                if toward.Magnitude > 0.01 then
                    toward = toward.Unit
                    if run.mass >= tr.mass then
                        tb.AssemblyLinearVelocity = toward * HOOK_PULL * tr.trinkets.knockbackMult
                            + Vector3.new(0, 12, 0)
                    else
                        ball.AssemblyLinearVelocity = -toward * HOOK_PULL + Vector3.new(0, 12, 0)
                    end
                    deflate(target, tr, Config.DEFLATE.hook, true, player.UserId)
                    deps.teach(player, "deflate")
                    deps.effect(player, "hook", { to = target.DisplayName })
                end
            end
        end
    elseif activePower == "blink" then
        -- A teleport, not a shove. It goes THROUGH blobs and lumps, which is
        -- the only thing DASH cannot do, and is why it costs more than twice
        -- as much. Routed through RollService.teleport so the anti-cheat is
        -- told this one was the server's idea.
        local to = ball.Position + dir * BLINK_DISTANCE
        local flat = Vector3.new(to.X, 0, to.Z)
        -- Never off the island. A power that can drop you in the sea is a
        -- power nobody presses twice.
        if flat.Magnitude > Config.ISLAND_RADIUS - 20 then
            to = flat.Unit * (Config.ISLAND_RADIUS - 20) + Vector3.new(0, ball.Position.Y, 0)
        end
        RollService.teleport(player, to + Vector3.new(0, 4, 0))

    elseif activePower == "decoy" then
        spawnDecoy(player, run, ball.Position - dir * (radius * 2.2))

    elseif activePower == "siphon" then
        -- Drains the nearest blob BIGGER than you. The only power in the game
        -- that works exclusively upward: it is the comeback tool, so it has to
        -- be useless to whoever is already winning.
        local target, best = nil, SIPHON_RANGE
        for _, other in ipairs(Players:GetPlayers()) do
            local orun = other ~= player and runs[other.UserId]
            local ob = orun and RollService.ballFor(other)
            if ob and ob.Parent and orun.mass > run.mass
                and not protected(other, orun, now) then
                local d = (ob.Position - ball.Position).Magnitude
                if d < best then target, best = other, d end
            end
        end
        -- A bigger BOT is a legitimate siphon target and has to be: SIPHON is
        -- the comeback tool, and on a field of eleven bots the thing that is
        -- running away with the round is usually one of them.
        local botTarget = nil
        for _, bot in ipairs(BotService.living()) do
            if bot.mass > run.mass and not botProtected(bot) then
                local d = (bot.pos - ball.Position).Magnitude
                if d < best then botTarget, best = bot, d end
            end
        end
        if botTarget then
            local drained = deflateBot(botTarget, Config.DEFLATE.siphon, false)
            run.mass += drained
            deps.teach(player, "deflate")
            deps.effect(player, "siphon", { from = botTarget.name, amount = drained })
        elseif target then
            local trun = runs[target.UserId]
            -- Stolen, not scattered: SIPHON is the one deflating power whose
            -- take goes straight into the caster. It is also the only power
            -- that works exclusively upward, so the trade is fair.
            local drained = deflate(target, trun, Config.DEFLATE.siphon, false)
            run.mass += drained
            deps.teach(player, "deflate")
            deps.notify(target, ("🩸 %s siphoned %s off you.")
                :format(player.DisplayName, Format.short(drained)), "bad")
            deps.effect(player, "siphon", { from = target.DisplayName, amount = drained })
            -- The victim needs to see it too. Watching your number fall with
            -- no visible cause reads as a bug, not as an attack.
            deps.effect(target, "siphoned", { by = player.DisplayName, amount = drained })
        end

    elseif activePower == "magnet" or activePower == "beacon" then
        -- handled in tick while powerUntil holds
    end

    deps.effect(player, "power", { id = activePower, cost = cost, slot = index })
    deps.teach(player, "power")
    return true, nil
end

-- ── The loop ───────────────────────────────────────────────────────────────

local function tickPlayer(player: Player, run: Run, dt: number, now: number)
    local ball = RollService.ballFor(player)
    if not ball or not ball.Parent then
        return
    end
    local pos = ball.Position
    local radius = Blob.radius(run.mass)

    -- THE RIM METER. Drains in real time while you are out on the Shallows and
    -- refills only while you are back inside the Flats, at SHALLOWS_RECHARGE
    -- seconds spent per second refunded. Clamped at both ends so a long round
    -- in the middle cannot bank an unlimited escape.
    if not WorldBuilder.isSafe(pos) then
        run.committed = true
        if run.rimGrace < Config.SHALLOWS_GRACE then
            run.rimGrace = math.min(Config.SHALLOWS_GRACE,
                run.rimGrace + dt / Config.SHALLOWS_RECHARGE)
        end
    elseif run.committed then
        run.rimGrace = math.max(0, run.rimGrace - dt)
    end

    -- MELT. The one mechanic the whole game is built on: everything above the
    -- grace mass drips, and what drips becomes real food on the floor rather
    -- than a number going down. A big blob is a moving buffet, and everyone
    -- can see the trail.
    -- MELT IS OFF IN ROUND MODE. The whole fantasy is getting enormous, and a
    -- leak curve that caps growth is directly at odds with it. The job melt
    -- used to do — stopping a runaway leader — belongs to other players now:
    -- abilities deflate, so a leader is brought down by being ganged up on.
    -- The curve is kept and still tested; Config.LEAK_IN_ROUND turns it back
    -- on in one line if deflation proves too weak a brake.
    local leak = 0
    if Config.LEAK_IN_ROUND then
        leak = Blob.leakPerSecond(run.mass) * run.trinkets.leakMult * dt
    end
    if leak > 0 then
        deps.teach(player, "melt")
        run.mass = math.max(Config.STARTING_MASS, run.mass - leak)
        run.leakBuffer += leak
        while run.leakBuffer >= Config.LEAK_PELLET_MASS do
            run.leakBuffer -= Config.LEAK_PELLET_MASS
            -- Outside the body, in a ring, so it reads as a trail rather than
            -- a puddle you are standing in.
            local a = rng:NextNumber(0, math.pi * 2)
            local d = radius * 1.9 + rng:NextNumber(2, 9)
            spawnPellet(
                Vector3.new(pos.X + math.cos(a) * d, pos.Y - radius * 0.5, pos.Z + math.sin(a) * d),
                Config.LEAK_PELLET_MASS, false, player.UserId)
        end
    end

    -- EAT. Only the nine cells around the blob are considered.
    local magnetising = run.activeEffect == "magnet" and now < run.powerUntil
    local reach = radius + PICKUP_SLACK + (magnetising and 40 or 0)
    local cx, cz = math.floor(pos.X / CELL), math.floor(pos.Z / CELL)
    local span = magnetising and 2 or 1
    for gx = cx - span, cx + span do
        for gz = cz - span, cz + span do
            local bucket = grid[gx .. ":" .. gz]
            if bucket then
                for part, pellet in pairs(bucket) do
                    if part.Parent then
                        local mine = now < pellet.ownerUntil
                            and (pellet.owner == player.UserId
                                or pellet.owner2 == player.UserId)
                        local d = (part.Position - pos)
                        if not mine and d.Magnitude <= reach then
                            local worth = pellet.value * run.trinkets.pelletMult
                            if run.activeEffect == "beacon" and now < run.powerUntil then
                                worth *= 1 + BEACON_BONUS
                            end
                            run.mass += worth
                            run.ateThisRun += 1
                            if run.mass > Config.STARTING_MASS * 4 then
                                deps.teach(player, "grow")
                            end
                            removePellet(pellet)
                            deps.teach(player, "eat")
                        end
                    else
                        removePellet(pellet)
                    end
                end
            end
        end
    end

    -- NO MID-ROUND BANKING. It used to convert your mass to Glob and reset you
    -- to 25, which is in direct conflict with the point of a round: get as
    -- enormous as you can before the clock runs out. The round end is the
    -- bank now, and it pays on the size you finish with. The Vault survives as
    -- the island's landmark — it is what the whole map orients on — and the
    -- code below is kept for the same reason Config.LEAK_IN_ROUND is: turning
    -- a cash-out back on is a small change, not an archaeology project.

    if run.mass > run.bestMass then
        run.bestMass = run.mass
    end

    -- SLAM lands. Everything nearby is thrown outward, and every lump inside
    -- the blast shatters into pellets — which is the real job: an island that
    -- has silted up with an hour of congealed shells needs something that can
    -- break it open again, or the Vault eventually walls itself in.
    if run.slamUntil > 0 and now >= run.slamUntil then
        run.slamUntil = 0
        local hits = 0
        for _, other in ipairs(Players:GetPlayers()) do
            local orun = runs[other.UserId]
            local ob = other ~= player and orun and RollService.ballFor(other)
            if ob and ob.Parent and not protected(other, orun, now) then
                local away = ob.Position - pos
                local flat = Vector3.new(away.X, 0, away.Z)
                if flat.Magnitude < SLAM_RADIUS and flat.Magnitude > 0.01 then
                    local falloff = 1 - (flat.Magnitude / SLAM_RADIUS)
                    ob.AssemblyLinearVelocity = flat.Unit
                            * (SLAM_IMPULSE * falloff * orun.trinkets.knockbackMult)
                        + Vector3.new(0, 26 * falloff, 0)
                    -- Scaled by how central the hit was, so a clean slam on
                    -- the leader is worth lining up.
                    deflate(other, orun, Config.DEFLATE.slam * falloff, true, player.UserId)
                    deps.teach(player, "deflate")
                    hits += 1
                end
            end
        end
        -- Bots are in the blast. A shockwave that passed through eleven of
        -- the twelve things on the island would make SLAM feel broken in
        -- exactly the games where the field is mostly bots — which is every
        -- game on day one.
        for _, bot in ipairs(BotService.living()) do
            if not botProtected(bot) then
                local flat = Vector3.new(bot.pos.X - pos.X, 0, bot.pos.Z - pos.Z)
                if flat.Magnitude < SLAM_RADIUS and flat.Magnitude > 0.01 then
                    local falloff = 1 - (flat.Magnitude / SLAM_RADIUS)
                    bot.pos += flat.Unit * (SLAM_RADIUS * 0.5 * falloff)
                    bot.goal = bot.pos
                    deflateBot(bot, Config.DEFLATE.slam * falloff, true, player.UserId)
                    hits += 1
                end
            end
        end
        for i = #lumps, 1, -1 do
            local lump = lumps[i]
            if (lump.part.Position - pos).Magnitude < SLAM_RADIUS then
                local n = math.clamp(math.floor(lump.mass / Config.LEAK_PELLET_MASS), 1, 12)
                for k = 1, n do
                    local a = math.rad((360 / n) * k)
                    spawnPellet(lump.part.Position
                        + Vector3.new(math.cos(a) * 8, 2, math.sin(a) * 8),
                        lump.mass / n, false)
                end
                lump.part:Destroy()
                table.remove(lumps, i)
            end
        end
        deps.effect(player, "slam", { hits = hits })
    end

    -- SPLIT comes back. The thrown half is not a second body you steer — that
    -- needs a whole second controller and a camera that can hold two things —
    -- it is a committed lunge that returns less than it cost. Which is the
    -- honest version of the same decision: gamble half of yourself on reaching
    -- something, and eat well or come back smaller.
    if run.activeEffect == "split" and now >= run.powerUntil and run.splitOwed > 0 then
        run.mass += run.splitOwed * SPLIT_RETURN
        run.splitOwed = 0
        run.activeEffect = nil
        deps.notify(player, "🫧 Your other half came back.", "info")
    end

    RollService.setRadius(player, radius)
    run.lastPos = pos
end

-- Blob versus blob. N^2 over players only, which is at most ~1,600 tests for a
-- full Roblox server and costs nothing next to the pellet pass.
local function tickCombat(list: { Player }, now: number)
    for i = 1, #list do
        for j = i + 1, #list do
            local a, b = list[i], list[j]
            local ra, rb = runs[a.UserId], runs[b.UserId]
            local ba, bb = RollService.ballFor(a), RollService.ballFor(b)
            if ra and rb and ba and bb and ba.Parent and bb.Parent then
                -- Same helper every power uses, so there is one answer to
                -- "can this player be touched" rather than two that drift.
                if not protected(a, ra, now) and not protected(b, rb, now) then
                    local radA, radB = Blob.radius(ra.mass), Blob.radius(rb.mass)
                    local dist = (ba.Position - bb.Position).Magnitude
                    if dist < (radA + radB) - math.min(radA, radB) * EAT_OVERLAP then
                        -- BUBBLE refuses the exchange in both directions: you
                        -- cannot be eaten and you cannot eat. A shield that let
                        -- you keep hunting would just be a better SPIKE.
                        local aBubbled = ra.activeEffect == "bubble" and now < ra.powerUntil
                        local bBubbled = rb.activeEffect == "bubble" and now < rb.powerUntil
                        if not aBubbled and not bBubbled then
                            local aSpiked = ra.activeEffect == "spike" and now < ra.powerUntil
                            local bSpiked = rb.activeEffect == "spike" and now < rb.powerUntil
                            local eater, prey
                            if Blob.canEat(ra.mass, rb.mass) then
                                eater, prey = a, b
                            elseif Blob.canEat(rb.mass, ra.mass) then
                                eater, prey = b, a
                            end
                            -- SPIKE inverts it. This is the only way the
                            -- smallest blob on the island deletes the biggest,
                            -- and it costs a fifth of yourself to try.
                            if eater and prey then
                                local preySpiked = (prey == a and aSpiked) or (prey == b and bSpiked)
                                if preySpiked then
                                    -- Biting a spiked blob does not swap the
                                    -- meal round, it COSTS you. Deflating the
                                    -- biter by a third of themselves is how
                                    -- the smallest blob on the island punishes
                                    -- the biggest without having to swallow it.
                                    local biter = eater
                                    local biterRun = runs[biter.UserId]
                                    if biterRun then
                                        deflate(biter, biterRun, Config.DEFLATE.spike, true)
                                        deps.notify(biter, "🌵 Spiked. That cost you.", "bad")
                                    end
                                    eater, prey = nil, nil
                                end
                                local re = eater and runs[eater.UserId]
                                local rp = prey and runs[prey.UserId]
                                local bp = prey and RollService.ballFor(prey)
                                if re and rp and bp then
                                    re.mass += Blob.eatGain(re.mass, rp.mass)
                                    pop(prey, bp.Position, eater)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

-- ── Goop: globlets, tethers and pods ──────────────────────────────────────

--- Where a given owner's body is, for GoopService to reel its pieces home.
--- Negative ids are bots; positive are players. One function so the tether
--- system never has to know which it is dealing with.
local function bodyPosFor(ownerId: number): Vector3?
    if ownerId < 0 then
        for _, bot in ipairs(BotService.living()) do
            if -bot.id == ownerId then
                return bot.pos
            end
        end
        return nil
    end
    local player = Players:GetPlayerByUserId(ownerId)
    local run = player and runs[player.UserId]
    local ball = run and RollService.ballFor(player)
    return (ball and ball.Parent) and ball.Position or nil
end

--- Pay a returning globlet's mass back to whoever threw it.
local function payBack(ownerId: number, mass: number)
    local back = mass * Config.SPLIT_RETURN_FRACTION
    if ownerId < 0 then
        for _, bot in ipairs(BotService.living()) do
            if -bot.id == ownerId then
                bot.mass += back
                return
            end
        end
        return
    end
    local player = Players:GetPlayerByUserId(ownerId)
    local run = player and runs[player.UserId]
    if run then
        run.mass += back
    end
end

--- Everything the goop layer does in one tick: move the pieces, let them eat,
--- bite anybody crossing a strand, and burst anybody big who walked into a pod.
---
--- ALL the mass rules live here rather than in GoopService, for the same
--- reason they live here rather than in BotService: "how much does this take
--- off you" must have exactly one answer for players and bots alike.
local function tickGoop(dt: number, now: number, list: { Player })
    -- Pieces move, then eat off the floor at their own small reach.
    local returned = GoopService.step(dt, now, bodyPosFor)
    for _, g in ipairs(returned) do
        payBack(g.ownerId, g.mass)
    end
    for _, g in ipairs(GoopService.list()) do
        g.mass += harvestAt(g.pos, Config.GLOBLET_PICKUP + Blob.radius(g.mass) * 0.5)
    end

    -- ── Tethers ───────────────────────────────────────────────────────────
    --
    -- Deliberately weak per touch and on a per-victim cooldown: this is area
    -- denial, not a damage engine. Walking the length of a strand costs you a
    -- noticeable slice; clipping the end of one barely registers.
    local live = GoopService.list()
    if #live > 0 then
        for _, g in ipairs(live) do
            local home = bodyPosFor(g.ownerId)
            if home then
                for _, player in ipairs(list) do
                    local run = runs[player.UserId]
                    local ball = run and RollService.ballFor(player)
                    -- NEVER YOUR OWN. A fence that cut its own builder would
                    -- make splitting strictly self-harming, which is the one
                    -- way to guarantee nobody ever presses the button.
                    if run and ball and ball.Parent and g.ownerId ~= player.UserId
                        and not protected(player, run, now) then
                        local d = GoopService.distanceToStrand(g, home, ball.Position)
                        if d <= Config.TETHER_WIDTH + Blob.radius(run.mass)
                            and GoopService.canHit(g, "p" .. player.UserId, now) then
                            deflate(player, run, Config.TETHER_DEFLATE, true,
                                g.ownerId > 0 and g.ownerId or nil)
                            run.snagUntil = now + Config.TETHER_SLOW_TIME
                            deps.effect(player, "snagged", {})
                        end
                    end
                end
                for _, bot in ipairs(BotService.living()) do
                    if g.ownerId ~= -bot.id and not botProtected(bot) then
                        local d = GoopService.distanceToStrand(g, home, bot.pos)
                        if d <= Config.TETHER_WIDTH + Blob.radius(bot.mass)
                            and GoopService.canHit(g, "b" .. bot.id, now) then
                            deflateBot(bot, Config.TETHER_DEFLATE, true,
                                g.ownerId > 0 and g.ownerId or nil)
                            bot.snagUntil = now + Config.TETHER_SLOW_TIME
                        end
                    end
                end
            end
        end
    end

    -- ── Spore pods ────────────────────────────────────────────────────────
    --
    -- Only blobs over POD_MIN_MASS set one off, which is the whole reason the
    -- things are on the map: a pod field is ground a small player can hide in
    -- and a big one cannot follow into.
    GoopService.regrowPods(now)
    for _, pod in ipairs(GoopService.pods()) do
        if pod.readyAt == 0 then
            for _, player in ipairs(list) do
                local run = runs[player.UserId]
                local ball = run and RollService.ballFor(player)
                if run and ball and ball.Parent and run.mass >= Config.POD_MIN_MASS then
                    local flat = Vector3.new(ball.Position.X - pod.pos.X, 0,
                        ball.Position.Z - pod.pos.Z)
                    if flat.Magnitude <= Config.POD_RADIUS + Blob.radius(run.mass) then
                        -- A BURST, NOT A TAX. The mass is not destroyed and it
                        -- is not handed to anybody — it leaves as globlets and
                        -- comes back. What the pod costs you is CONTROL: for a
                        -- few seconds your tethers are everywhere at once,
                        -- which is dangerous for everyone nearby, including
                        -- whoever herded you into it.
                        local each = math.max(Config.LEAK_PELLET_MASS,
                            run.mass * 0.05)
                        local thrown = GoopService.split(player.UserId, ball.Position,
                            ball.CFrame.LookVector, each, Config.POD_PIECES,
                            ball.Color, true)
                        run.mass = math.max(Config.STARTING_MASS, run.mass - thrown)
                        -- SHOVED CLEAR. Without this a blob that stops on a
                        -- pod re-bursts the instant it regrows, forever: the
                        -- pod is permanently useless to everybody else and the
                        -- blob is permanently scattered. The shove is outward
                        -- from the pod along the approach, which also reads
                        -- correctly — the thing exploded underneath you.
                        local away = flat.Magnitude > 0.01 and flat.Unit
                            or Vector3.new(0, 0, 1)
                        ball.AssemblyLinearVelocity = away * 70 + Vector3.new(0, 26, 0)
                        GoopService.spendPod(pod, now)
                        deps.effect(player, "podBurst", { pieces = Config.POD_PIECES })
                        deps.notify(player, "\u{1F4A5} A spore pod burst you open!", "warn")
                        break
                    end
                end
            end
        end
    end
end

-- ── Bots ───────────────────────────────────────────────────────────────────

--- Everybody on the island, players and bots alike, in one shape.
---
--- The brain is handed this and cannot tell which rows are human. That is the
--- point: the moment a bot knows, it starts playing two different games and
--- the difficulty you feel stops being the difficulty that was tuned.
local function contenders(list: { Player }, now: number): { any }
    local field = {}
    for _, player in ipairs(list) do
        local run = runs[player.UserId]
        local ball = run and RollService.ballFor(player)
        if run and ball and ball.Parent then
            table.insert(field, {
                key = "player:" .. player.UserId,
                mass = run.mass,
                pos = ball.Position,
                safe = protected(player, run, now),
            })
        end
    end
    for _, bot in ipairs(BotService.list()) do
        if bot.respawnAt == 0 then
            table.insert(field, {
                key = "bot:" .. bot.id,
                mass = bot.mass,
                pos = bot.pos,
                safe = botProtected(bot),
            })
        end
    end
    return field
end

--- Move the bots, then let them eat off the floor.
---
--- Feeding is done HERE rather than inside BotService because the pellets are
--- this file's state. A bot sweeps the same corridor a player does at the same
--- radius, so a bot and a player standing in the same field grow at the same
--- rate — which is the only version of this that can be called fair.
local function tickBots(dt: number, now: number, list: { Player })
    if BotService.count() == 0 then
        return
    end
    BotService.step(dt, now, contenders(list, now), nearestPelletPos)
    for _, bot in ipairs(BotService.list()) do
        if bot.respawnAt == 0 then
            bot.mass += harvestAt(bot.pos, Blob.radius(bot.mass) + PICKUP_SLACK)
        end
    end
end

--- Blob versus blob, across the species line.
---
--- Deliberately the same test tickCombat uses — overlap, then Blob.canEat —
--- because "can I eat that" must have exactly one answer no matter what is
--- standing in front of you. A bot that ate on different terms would teach the
--- player a rule that then fails them against a human, which is worse than
--- having no bots at all.
local function tickBotCombat(list: { Player }, now: number)
    local live = BotService.living()
    if #live == 0 then
        return
    end

    -- Bot vs player.
    for _, player in ipairs(list) do
        local run = runs[player.UserId]
        local ball = run and RollService.ballFor(player)
        if run and ball and ball.Parent and not protected(player, run, now) then
            local bubbled = run.activeEffect == "bubble" and now < run.powerUntil
            local spiked = run.activeEffect == "spike" and now < run.powerUntil
            for _, bot in ipairs(live) do
                if bot.respawnAt == 0 and not botProtected(bot) and not bubbled then
                    local rp, rb = Blob.radius(run.mass), Blob.radius(bot.mass)
                    local dist = (ball.Position - bot.pos).Magnitude
                    if dist < (rp + rb) - math.min(rp, rb) * EAT_OVERLAP then
                        if Blob.canEat(run.mass, bot.mass) then
                            run.mass += Blob.eatGain(run.mass, bot.mass)
                            deps.effect(player, "ate", { name = bot.name, bot = true })
                            deps.teach(player, "eatBlob")
                            BotService.kill(bot, now)
                        elseif Blob.canEat(bot.mass, run.mass) then
                            if spiked then
                                -- SPIKE works on bots too, and it has to: it
                                -- is the smallest blob's only answer to the
                                -- biggest, and a field of bots is exactly
                                -- where a new player meets that problem.
                                deflateBot(bot, Config.DEFLATE.spike, true)
                                deps.notify(player, ("🌵 %s bit a spike."):format(bot.name), "good")
                            else
                                bot.mass += Blob.eatGain(bot.mass, run.mass)
                                pop(player, ball.Position, nil)
                                deps.notify(player, ("😵 %s swallowed you."):format(bot.name), "bad")
                            end
                            break
                        end
                    end
                end
            end
        end
    end

    -- Bot vs bot. The island has to look busy from across the map even when
    -- the player is nowhere near it, and a field where only the player ever
    -- causes anything to happen reads as a stage set.
    for i = 1, #live do
        for j = i + 1, #live do
            local a, b = live[i], live[j]
            if a.respawnAt == 0 and b.respawnAt == 0
                and not botProtected(a) and not botProtected(b) then
                local ra, rb = Blob.radius(a.mass), Blob.radius(b.mass)
                local dist = (a.pos - b.pos).Magnitude
                if dist < (ra + rb) - math.min(ra, rb) * EAT_OVERLAP then
                    if Blob.canEat(a.mass, b.mass) then
                        a.mass += Blob.eatGain(a.mass, b.mass)
                        BotService.kill(b, now)
                    elseif Blob.canEat(b.mass, a.mass) then
                        b.mass += Blob.eatGain(b.mass, a.mass)
                        BotService.kill(a, now)
                    end
                end
            end
        end
    end
end

local function topUpPellets(dt: number)
    local deficit = Config.PELLET_TARGET - pelletCount
    if deficit <= 0 then
        return
    end
    local budget = Config.PELLET_RESPAWN_PER_SEC * dt
    -- Fractional budget accumulates rather than rounding to zero every tick,
    -- which at 12Hz would otherwise spawn nothing at all below 12/sec.
    ArenaService._pelletDebt = (ArenaService._pelletDebt or 0) + budget
    while ArenaService._pelletDebt >= 1 and pelletCount < Config.PELLET_TARGET do
        ArenaService._pelletDebt -= 1
        spawnPellet(nil, nil, rng:NextNumber() < 0.012)
    end
end

-- Hand mass to a player directly. Used by the tutorial to make the first
-- growth step instant, and by the tests to reach a size without simulating
-- four minutes of eating.
function ArenaService.grant(player: Player, mass: number)
    local run = runs[player.UserId]
    if not run then
        return
    end
    run.mass = math.max(Config.STARTING_MASS, run.mass + mass)
    if run.mass > run.bestMass then
        run.bestMass = run.mass
    end
    RollService.setRadius(player, Blob.radius(run.mass))
end

-- ── The round machine ──────────────────────────────────────────────────────

function ArenaService.phase(): (string, number, number)
    return phase, math.max(0, phaseEndsAt - os.clock()), roundNumber
end

function ArenaService.inRound(): boolean
    return phase == "PLAYING"
end

local function beginLobby()
    -- The island empties between rounds. Leaving bots wandering an arena
    -- nobody is in costs a Heartbeat's worth of work per bot for an empty
    -- stage, and it makes the lobby's "round starts in" clock read as a lie.
    BotService.clear()
    -- Strands with nothing on either end of them, and a hazard field nobody is
    -- standing in. Both go with the round.
    GoopService.clear()
    GoopService.clearPods()
    phase = "LOBBY"
    phaseEndsAt = os.clock() + Config.INTERMISSION_SECONDS
    local i = 0
    for _, player in ipairs(Players:GetPlayers()) do
        sendToLobby(player, i)
        i += 1
    end
    -- Clear the floor. Pellets left lying around the island during a lobby are
    -- just instance count nobody can reach.
    for _, pellet in pairs(pellets) do
        removePellet(pellet)
    end
end

local function beginRound()
    phase = "PLAYING"
    roundNumber += 1
    phaseEndsAt = os.clock() + Config.ROUND_SECONDS

    for i = #lumps, 1, -1 do
        lumps[i].part:Destroy()
        table.remove(lumps, i)
    end
    for _, pellet in pairs(pellets) do
        removePellet(pellet)
    end
    for _ = 1, Config.PELLET_TARGET do
        spawnPellet(nil, nil, rng:NextNumber() < 0.012)
    end
    -- Pods are re-scattered every round rather than placed once at boot: their
    -- positions are most of a round's terrain knowledge, and a map whose
    -- hazards never move is one where the regulars always know where the small
    -- players are hiding.
    GoopService.clear()
    GoopService.seedPods()

    local humans = #Players:GetPlayers()

    -- FILL THE FIELD. Recomputed at the top of every round and only here: a
    -- player joining mid-round is an extra contender rather than a reason to
    -- delete a bot that is already out there being chased by somebody.
    BotService.fill(Config.ROUND_FIELD_SIZE - humans)

    local i = 0
    for _, player in ipairs(Players:GetPlayers()) do
        sendToArena(player, i)
        local filled = BotService.count()
        deps.notify(player, filled > 0
            and ("🫧 ROUND %d — %d players, %d bots. Grow as big as you can.")
                :format(roundNumber, humans, filled)
            or ("🫧 ROUND %d — grow as big as you can."):format(roundNumber), "good")
        i += 1
    end
end

local function endRound()
    phase = "RESULTS"
    phaseEndsAt = os.clock() + Config.ROUND_END_HOLD

    -- ONE BOARD, both species. A bot that grew all round and then vanished
    -- from the results would make second place a lie — the player would have
    -- spent three minutes losing to something the scoreboard says was never
    -- there. Bots place, bots are named, bots are tagged, and they take no
    -- payout because there is nobody to pay.
    local board = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local run = runs[player.UserId]
        if run then
            table.insert(board, {
                player = player, name = player.DisplayName,
                mass = run.mass, peak = run.peakThisRound,
            })
        end
    end
    for _, bot in ipairs(BotService.list()) do
        table.insert(board, {
            player = nil, name = bot.name, bot = true,
            mass = bot.mass, peak = bot.peak,
        })
    end
    table.sort(board, function(x, y) return x.mass > y.mass end)

    lastResults = {}
    for place, row in ipairs(board) do
        -- Your final size is the score. Placement is a bonus on top, so second
        -- is still worth playing for rather than being worth nothing.
        local base = row.mass ^ Config.ROUND_PAYOUT_EXPONENT * Config.ROUND_PAYOUT_SCALE
        local bonus = Config.ROUND_PLACE_BONUS[place] or 1
        local payout = math.floor(base * bonus)
        if row.player then
            deps.award(row.player, payout, 0, "round")
            deps.roundResult(row.player, place, row.mass, payout)
            deps.notify(row.player, ("🏁 #%d of %d with %s — 💧%s"):format(
                place, #board, Format.short(row.mass), Format.short(payout)),
                place == 1 and "good" or "info")
        else
            payout = 0
        end
        table.insert(lastResults, {
            name = row.name, place = place, bot = row.bot == true,
            mass = row.mass, peak = row.peak, payout = payout,
        })
    end
    for _, player in ipairs(Players:GetPlayers()) do
        deps.effect(player, "roundEnd", { round = roundNumber, board = lastResults })
    end
end

function ArenaService.results()
    return lastResults
end

function ArenaService.start(injected: Deps)
    deps = injected
    -- From here on the arena is the only thing that resizes a body.
    RollService.sizeOwnedByArena = true

    RollService.rescuePoint = function(player)
        if phase == "PLAYING" then
            return WorldBuilder.spawnPoint(player.UserId)
        end
        return WorldBuilder.lobbyPoint(player.UserId)
    end

    phase = "LOBBY"
    phaseEndsAt = os.clock() + Config.INTERMISSION_SECONDS

    task.spawn(function()
        local last = os.clock()
        while true do
            task.wait(TICK)
            local now = os.clock()
            local dt = math.min(0.5, now - last)
            last = now

            -- Advance the machine first, so a phase change takes effect on
            -- the same tick rather than leaving one frame of the old rules.
            if now >= phaseEndsAt then
                if phase == "LOBBY" then beginRound()
                elseif phase == "PLAYING" then endRound()
                else beginLobby() end
            end

            local playing = phase == "PLAYING"
            local active: { Player } = {}
            for _, player in ipairs(Players:GetPlayers()) do
                local run = runs[player.UserId]
                if run then
                    if playing then
                        tickPlayer(player, run, dt, now)
                        if run.mass > run.peakThisRound then
                            run.peakThisRound = run.mass
                        end
                    end
                    table.insert(active, player)
                    deps.sync(player, ArenaService.snapshot(player, run, now))
                end
            end

            -- Nothing eats anybody outside a round, and the floor is only
            -- stocked while there is somebody to eat off it.
            if playing then
                -- Bots move BEFORE combat is resolved, so a bot that just
                -- walked into you is eaten on the tick it arrives rather than
                -- appearing to phase through and get you on the next one.
                tickBots(dt, now, active)
                -- Goop before combat: a globlet that just arrived should bite
                -- on the tick it lands, not the one after.
                tickGoop(dt, now, active)
                tickCombat(active, now)
                tickBotCombat(active, now)
                topUpPellets(dt)
                decayLumps(dt)
            end
        end
    end)
end

-- What the HUD needs, and nothing else. Sent every tick, so it stays small.
function ArenaService.snapshot(player: Player, run: Run, now: number)
    local ball = RollService.ballFor(player)
    local pos = ball and ball.Position or Vector3.zero
    return {
        mass = run.mass,
        radius = Blob.radius(run.mass),
        -- The leak ACTUALLY APPLIED, not the curve's value. Reporting the
        -- curve while Config.LEAK_IN_ROUND is off would put a melt rate on the
        -- HUD that nothing is subtracting — a readout describing a different
        -- game to the one being played.
        leak = Config.LEAK_IN_ROUND
            and (Blob.leakPerSecond(run.mass) * run.trinkets.leakMult) or 0,
        harvest = Blob.harvestPerSecond(run.mass) * run.trinkets.pelletMult,
        worth = Blob.bankValue(run.mass),
        banking = run.banking,
        bankNeeds = Blob.bankSeconds(run.trinkets.bankHaste),
        powerId = run.powerId,
        -- ── THE HOTBAR ────────────────────────────────────────────────────
        -- Three slots, resolved server-side. The client draws exactly what is
        -- in here and decides nothing: the third slot depends on what the
        -- player owns, and a button that offers something the server will
        -- refuse is the worst kind of control.
        slots = (function()
            local bar = Powers.hotbar(run.powerId, deps.banked(player), deps.granted(player))
            local out = {}
            for i, power in ipairs(bar) do
                local uses = usesOf(player, power.id)
                table.insert(out, {
                    id = power.id,
                    name = power.name,
                    cost = Powers.massCost(power.id, run.mass, uses),
                    cooldown = math.max(0, (run.slotReadyAt[i] or 0) - now),
                    cooldownMax = Powers.cooldown(power.id, run.trinkets.powerHaste, uses),
                    mastery = Powers.masteryTier(uses),
                    locked = false,
                })
            end
            return out
        end)(),
        globlets = GoopService.countFor(player.UserId),
        snagged = now < run.snagUntil,
        -- KEPT, and now derived from slot 3 rather than from a field nothing
        -- writes. `run.powerReadyAt` stopped being set when cooldowns moved
        -- per-slot, so this quietly reported "always ready" for the chosen
        -- power to anything still reading it.
        powerCooldown = math.max(0, (run.slotReadyAt[3] or 0) - now),
        powerCost = Powers.massCost(run.powerId, run.mass, usesOf(player, run.powerId)),
        mastery = Powers.masteryTier(usesOf(player, run.powerId)),
        lit = run.activeEffect == "beacon" and now < run.powerUntil,
        -- `safe` is what the HUD colours the ring readout with, so it has to
        -- agree with `protected` exactly. It used to be "am I on the rim",
        -- which is now only half the answer: the rim protects you while the
        -- meter lasts and not one second longer, and a HUD still saying SAFE
        -- while somebody eats you is worse than no HUD at all.
        safe = (now < run.safeUntil) or (WorldBuilder.isSafe(pos) and run.rimGrace > 0),
        -- The meter itself, so the player can watch it run out instead of
        -- discovering it did.
        rimGrace = run.rimGrace,
        rimGraceMax = Config.SHALLOWS_GRACE,
        onRim = WorldBuilder.isSafe(pos),
        ring = WorldBuilder.ringAt(pos),
        biome = (WorldBuilder.biomeAt(pos) or {}).name,
        best = run.bestMass,
        peak = run.peakThisRound,
        phase = phase,
        phaseLeft = math.max(0, phaseEndsAt - now),
        round = roundNumber,
        ceiling = Blob.ceiling(0.8),
        -- How big the field actually is, and how much of it is bots. Shown on
        -- the HUD rather than hidden: a player who works out for themselves
        -- that half the island is bots feels tricked, and a player who was
        -- told feels like the game is full.
        field = #Players:GetPlayers() + BotService.count(),
        bots = BotService.count(),
    }
end

--- Who a crumb is locked against, and until when.
---
--- Exposed because the lock is invisible from outside and therefore untestable
--- from outside: deflation drops belong to nobody for a few seconds except the
--- two blobs that made them, and the only way to tell one of those crumbs from
--- the fourteen hundred ambient pellets on the floor is to ask. A test that
--- guessed — "the newest part near the victim is probably a drop" — would be
--- wrong roughly as often as the respawn rate, which is forty-eight a second.
---
--- Read-only, and it returns nothing for a part that is not a live pellet.
function ArenaService.pelletLock(part: BasePart): (number?, number?, number)
    local p = pellets[part]
    if not p then
        return nil, nil, 0
    end
    return p.owner, p.owner2, p.ownerUntil
end

-- Exposed for tests: the island's live contents.
function ArenaService.stats()
    return {
        pellets = pelletCount,
        lumps = #lumps,
        bots = BotService.count(),
        botsAlive = #BotService.living(),
    }
end

return ArenaService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000020"><Properties><string name="Name">BotService</string><ProtectedString name="Source"><![CDATA[--!strict
-- BotService.luau — the rest of the field.
--
-- WHY THIS EXISTS. An arena game with three people in it is not a small
-- version of GOOP, it is a different and much worse one. Every system here
-- assumes a crowd: deflation is a catch-up tool that needs somebody to gang up
-- on a leader, the board needs places worth placing in, and the core loop —
-- always being able to see somebody bigger and somebody smaller — is simply
-- absent below about six contenders. A new game has three players in it for
-- weeks. Without bots, the first hour of this game's life is the version of it
-- that does not work, shown to exactly the people deciding whether to stay.
--
-- So a round always has Config.ROUND_FIELD_SIZE contenders and bots make up
-- the difference. Twelve humans, no bots. One human, eleven bots. Nobody at
-- all and the island still runs a real round with a real board, which is also
-- what makes the game demoable and testable end to end.
--
-- ── WHAT THIS MODULE OWNS AND WHAT IT DOES NOT ────────────────────────────
--
-- It owns bot BODIES and bot DECISIONS: where each one is, where it wants to
-- be, and the part you see. It does not own a single rule about mass. Eating,
-- deflation, popping and the board all stay in ArenaService, which resolves
-- bots and players through the same code paths. That split is deliberate and
-- load-bearing: the moment a bot gets its own eating rule, "can I beat that
-- thing" stops having one answer, and bots start being either free food or
-- unbeatable depending on which copy of the rule drifted.
--
-- Movement is KINEMATIC — a position integrated by hand, not a physics body.
-- Twelve unanchored balls being network-owned by the server is a genuine cost
-- on a Roblox server that is already simulating the players' bodies, and a bot
-- does not need momentum to be convincing. It needs to be in the right place
-- at the wrong time for you.

local Shared = game.ReplicatedStorage.GoobShared
local Config = require(Shared.Config)
local Blob = require(Shared.Blob)

local WorldBuilder = require(script.Parent.WorldBuilder)

local BotService = {}

export type Bot = {
    id: number,
    name: string,
    skill: any,
    mass: number,
    peak: number,
    pos: Vector3,
    heading: Vector3,
    goal: Vector3,
    mode: string,          -- feed | hunt | flee | wander
    nextThink: number,
    respawnAt: number,     -- 0 when alive
    rimGrace: number,
    snagUntil: number,     -- slowed by somebody's tether; see GoopService
    committed: boolean,    -- has it ever left the rim; see Config.SHALLOWS_GRACE
    part: BasePart?,
    label: TextLabel?,
}

-- A contender as the brain sees it. Players and bots are handed in through the
-- same shape on purpose: a bot must not be able to tell which is which, or it
-- will play differently against humans and the difficulty stops being honest.
export type Contender = {
    key: string,
    mass: number,
    pos: Vector3,
    safe: boolean,         -- currently untouchable; not worth chasing
}

local bots: { Bot } = {}
local nextId = 1
local rng = Random.new(os.clock() * 1e6 // 1 + 7)
local folder: Folder?

local RESPAWN_DELAY = 3.5

-- ── Bodies ─────────────────────────────────────────────────────────────────

-- SIBLING OF THE ARENA FOLDER, NOT A CHILD OF IT.
--
-- The Arena folder is the pellet pool and several things treat it as exactly
-- that — "how much food is on the island" is `#arena:GetChildren()`, and the
-- harness walks it taking `child.Position` off every entry. Parenting bots
-- inside it put a Folder in that list, which has no Position, and turned an
-- honest pellet sweep into a crash. A pool should hold one kind of thing.
local function ensureFolder(): Folder?
    if folder and folder.Parent then
        return folder
    end
    local arena = WorldBuilder.arenaFolder()
    local world = arena and arena.Parent
    if not world then
        return nil
    end
    local f = Instance.new("Folder")
    f.Name = "Bots"
    f.Parent = world
    folder = f
    return f
end

local function makeBody(bot: Bot)
    local parent = ensureFolder()
    if not parent then
        return
    end
    local p = Instance.new("Part")
    p.Name = "Bot_" .. bot.name
    p.Shape = Enum.PartType.Ball
    p.Anchored = true
    -- CanCollide false and CanQuery false: a bot is resolved by distance in
    -- ArenaService, never by a touch event. A bot you could physically shove
    -- would be a second, contradictory answer to "what happens when we meet".
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Material = Enum.Material.SmoothPlastic
    p.Color = Color3.fromHSV(rng:NextNumber(), 0.52, 0.92)
    local r = Blob.radius(bot.mass)
    p.Size = Vector3.new(1, 1, 1) * (r * 2)
    p.Position = bot.pos
    p.Parent = parent

    -- Just the name, the same way a player's nameplate reads. The robot tag
    -- that used to hang here made a full island look like an empty one — see
    -- Config.BOT_FIRST.
    local gui = Instance.new("BillboardGui")
    gui.Name = "Tag"
    gui.Size = UDim2.fromScale(9, 2)
    gui.StudsOffset = Vector3.new(0, r + 3, 0)
    gui.AlwaysOnTop = false
    gui.MaxDistance = 320
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.fromScale(1, 1)
    tl.BackgroundTransparency = 1
    tl.Font = Enum.Font.FredokaOne
    tl.TextScaled = true
    tl.TextStrokeTransparency = 0.35
    tl.TextColor3 = Color3.fromRGB(226, 232, 240)
    tl.Text = bot.name
    tl.Parent = gui
    gui.Parent = p

    bot.part = p
    bot.label = tl
end

local function destroyBody(bot: Bot)
    if bot.part then
        bot.part:Destroy()
        bot.part = nil
        bot.label = nil
    end
end

-- ── Spawning ───────────────────────────────────────────────────────────────

local function pickSkill()
    local total = 0
    for _, s in ipairs(Config.BOT_SKILLS) do
        total += s.weight
    end
    local roll = rng:NextNumber() * total
    for _, s in ipairs(Config.BOT_SKILLS) do
        roll -= s.weight
        if roll <= 0 then
            return s
        end
    end
    return Config.BOT_SKILLS[1]
end

-- Names must be unique within a round. A board with two identical rows on it
-- looks like a bug even when it is not, and the player cannot tell which one
-- just ate them.
--
-- Shaped like a Roblox username — a name and some digits — rather than like a
-- blob pet. See Config.BOT_FIRST for why the cute names and the robot tags
-- both went.
local function pickName(): string
    local taken: { [string]: boolean } = {}
    for _, b in ipairs(bots) do
        taken[b.name] = true
    end
    for _ = 1, 40 do
        local stem = Config.BOT_FIRST[rng:NextInteger(1, #Config.BOT_FIRST)]
        local n = stem .. tostring(rng:NextInteger(
            Config.BOT_SUFFIX_MIN, Config.BOT_SUFFIX_MAX))
        if not taken[n] then
            return n
        end
    end
    -- Forty collisions against a pool of tens of thousands means the generator
    -- is broken, not unlucky. A guaranteed-unique fallback beats a loop that
    -- could spin forever on a server that has been up for a week.
    return "Blob" .. nextId
end

local function spawnPos(): Vector3
    local i = rng:NextInteger(1, Config.SPAWN_POINTS)
    return WorldBuilder.spawnPoint(i)
end

local function newBot(): Bot
    local skill = pickSkill()
    local pos = spawnPos()
    local bot: Bot = {
        id = nextId,
        name = pickName(),
        skill = skill,
        mass = Config.STARTING_MASS,
        peak = Config.STARTING_MASS,
        pos = pos,
        heading = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit,
        goal = pos,
        mode = "wander",
        nextThink = 0,
        respawnAt = 0,
        rimGrace = Config.SHALLOWS_GRACE,
        snagUntil = 0,
        committed = false,
        part = nil,
        label = nil,
    }
    nextId += 1
    makeBody(bot)
    return bot
end

--- Bring the field up to `count` bots, or down to it. Called at the top of
--- every round with (field size - humans), so a player who joins mid-round
--- never evicts a bot that is already in play — the count is only corrected
--- when the slate is clean anyway.
function BotService.fill(count: number)
    count = math.max(0, math.floor(count))
    if not Config.BOTS_ENABLED then
        count = 0
    end
    while #bots > count do
        local b = table.remove(bots)
        if b then
            destroyBody(b)
        end
    end
    while #bots < count do
        table.insert(bots, newBot())
    end
end

function BotService.clear()
    for _, b in ipairs(bots) do
        destroyBody(b)
    end
    table.clear(bots)
end

function BotService.list(): { Bot }
    return bots
end

function BotService.count(): number
    return #bots
end

--- Alive bots only, which is what every caller outside this file actually
--- wants: a dead bot has no body, no position worth testing and no business
--- appearing on a leaderboard mid-respawn.
function BotService.living(): { Bot }
    local out = {}
    for _, b in ipairs(bots) do
        if b.respawnAt == 0 then
            table.insert(out, b)
        end
    end
    return out
end

--- Somebody ate this bot. It goes down and comes back, because a round that
--- empties out by minute two is the problem this module exists to solve.
function BotService.kill(bot: Bot, now: number)
    if bot.respawnAt ~= 0 then
        return
    end
    bot.respawnAt = now + RESPAWN_DELAY
    destroyBody(bot)
end

-- ── The brain ──────────────────────────────────────────────────────────────

local function clampToIsland(p: Vector3): Vector3
    local flat = Vector3.new(p.X, 0, p.Z)
    local r = flat.Magnitude
    local limit = Config.PELLET_OUTER
    if r > limit and r > 0 then
        flat = flat.Unit * limit
    end
    return Vector3.new(flat.X, p.Y, flat.Z)
end

-- Decide what this bot is doing for the next few hundred milliseconds.
--
-- Deliberately coarse. A bot that re-evaluates every frame with perfect
-- information is unloseable and reads as cheating rather than as skill; the
-- think interval is the gap a human plays through, and it is the main dial
-- between "dozy" and "feral".
local function think(bot: Bot, now: number, field: { Contender }, pelletAt: (Vector3, number) -> Vector3?)
    bot.nextThink = now + Config.BOT_THINK * bot.skill.think
    local sight = Config.BOT_SIGHT * bot.skill.sight

    local threat: Contender? = nil
    local threatDist = math.huge
    local prey: Contender? = nil
    local preyScore = -math.huge

    for _, c in ipairs(field) do
        local d = (Vector3.new(c.pos.X, 0, c.pos.Z) - Vector3.new(bot.pos.X, 0, bot.pos.Z)).Magnitude
        if d <= sight then
            -- Anything that can eat me, whether or not it has noticed me.
            if Blob.canEat(c.mass * Config.BOT_FEAR, bot.mass) then
                if d < threatDist then
                    threat, threatDist = c, d
                end
            elseif not c.safe and Blob.canEat(bot.mass * bot.skill.greed, c.mass) then
                -- Prefer the biggest meal that is also close. Mass over
                -- distance is the cheapest expression of "worth the walk".
                local score = c.mass / math.max(12, d)
                if score > preyScore then
                    prey, preyScore = c, score
                end
            end
        end
    end

    -- Fleeing wins over everything. A bot that trades a chase for its own life
    -- is a bot that is fun to bully, which is most of what a small player does.
    if threat then
        local away = Vector3.new(bot.pos.X - threat.pos.X, 0, bot.pos.Z - threat.pos.Z)
        if away.Magnitude < 1 then
            away = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
        end
        bot.mode = "flee"
        bot.goal = clampToIsland(bot.pos + away.Unit * 120)
        return
    end

    if prey then
        bot.mode = "hunt"
        bot.goal = Vector3.new(prey.pos.X, bot.pos.Y, prey.pos.Z)
        return
    end

    -- Nothing to chase and nothing to run from: eat. A bot that only ever
    -- wandered would finish every round at starting mass and the board would
    -- read as a joke.
    if rng:NextNumber() > Config.BOT_WANDER then
        local food = pelletAt(bot.pos, Config.BOT_PELLET_SIGHT * bot.skill.sight)
        if food then
            bot.mode = "feed"
            bot.goal = Vector3.new(food.X, bot.pos.Y, food.Z)
            return
        end
    end

    bot.mode = "wander"
    local a = rng:NextNumber(0, math.pi * 2)
    local d = rng:NextNumber(70, 220)
    bot.goal = clampToIsland(bot.pos + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d))
end

--- One step of every bot. `field` is every contender on the island INCLUDING
--- the bots themselves — a bot filters itself out by key, so callers never have
--- to build a different list per bot.
function BotService.step(dt: number, now: number, field: { Contender },
    pelletAt: (Vector3, number) -> Vector3?)

    for _, bot in ipairs(bots) do
        if bot.respawnAt ~= 0 then
            if now >= bot.respawnAt then
                bot.respawnAt = 0
                bot.mass = Config.STARTING_MASS
                bot.pos = spawnPos()
                bot.goal = bot.pos
                bot.mode = "wander"
                bot.nextThink = 0
                bot.rimGrace = Config.SHALLOWS_GRACE
                bot.snagUntil = 0
                bot.committed = false
                makeBody(bot)
            end
        else
            if not bot.part or not bot.part.Parent then
                makeBody(bot)
            end

            -- The same rim meter players carry, because a bot that could camp
            -- the shoreline forever would be the exploit this round's design
            -- just removed, played back at the player by the game itself.
            if not WorldBuilder.isSafe(bot.pos) then
                bot.committed = true
                if bot.rimGrace < Config.SHALLOWS_GRACE then
                    bot.rimGrace = math.min(Config.SHALLOWS_GRACE,
                        bot.rimGrace + dt / Config.SHALLOWS_RECHARGE)
                end
            elseif bot.committed then
                bot.rimGrace = math.max(0, bot.rimGrace - dt)
            end

            local mine = "bot:" .. bot.id
            if now >= bot.nextThink then
                local others = {}
                for _, c in ipairs(field) do
                    if c.key ~= mine then
                        table.insert(others, c)
                    end
                end
                think(bot, now, others, pelletAt)
            end

            local to = Vector3.new(bot.goal.X - bot.pos.X, 0, bot.goal.Z - bot.pos.Z)
            if to.Magnitude > 1 then
                -- Turn towards the goal rather than snapping to it. The lerp is
                -- what stops a bot pivoting 180 degrees in one frame, which is
                -- the single most obvious tell that a thing is not a player.
                bot.heading = (bot.heading:Lerp(to.Unit, math.clamp(dt * 4, 0, 1))).Unit
            end
            local speed = Blob.speed(bot.mass) * Config.BOT_SPEED_MULT
            -- Tethers slow bots exactly as they slow players. A fence the AI
            -- could walk through at full speed would make splitting useless in
            -- the games that are mostly bots, which is most games.
            if now < bot.snagUntil then
                speed *= Config.TETHER_SLOW
            end
            -- MOVE, THEN GET PUSHED OUT OF ANYTHING SOLID.
            --
            -- A kinematic body is not in the physics world, so CanCollide on a
            -- boulder means nothing to it — which is why bots walked straight
            -- through every rock and ramp on the island, the single most
            -- obvious tell that a thing is not a player. WorldBuilder keeps a
            -- footprint for every solid prop; this resolves against it.
            local wanted = clampToIsland(bot.pos + bot.heading * speed * dt)
            local r0 = Blob.radius(bot.mass)
            local resolved, blocked = WorldBuilder.pushOut(wanted, r0 * 0.9)
            bot.pos = clampToIsland(resolved)
            if blocked then
                -- Turn along the wall rather than grinding into it. Without
                -- this a bot that walked into a rock stayed pressed against it
                -- for the rest of its think interval, vibrating.
                local slide = Vector3.new(-bot.heading.Z, 0, bot.heading.X)
                bot.heading = (bot.heading * 0.35 + slide * 0.65).Unit
                bot.goal = bot.pos + bot.heading * 60
            end

            local r = Blob.radius(bot.mass)
            bot.pos = Vector3.new(bot.pos.X, 2 + r, bot.pos.Z)
            if bot.mass > bot.peak then
                bot.peak = bot.mass
            end
            local part = bot.part
            if part then
                part.Size = Vector3.new(1, 1, 1) * (r * 2)
                part.Position = bot.pos
                local tag = part:FindFirstChild("Tag")
                if tag and tag:IsA("BillboardGui") then
                    tag.StudsOffset = Vector3.new(0, r + 3, 0)
                end
            end
        end
    end
end

return BotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">CensusService</string><ProtectedString name="Source"><![CDATA[--!strict
-- CensusService.luau — how many of each thing still exist, worldwide.
--
-- WHY THIS IS THE MOST IMPORTANT SCREEN IN THE GAME:
-- the entire design rests on genuine scarcity, and until now that scarcity was
-- invisible. A player was told Secrets are rare and asked to take it on faith.
-- This counts them for real, across every server, and puts the number on a
-- monument you can roll up to and read.
--
-- ALIVE = CAUGHT − DESTROYED.
--
-- Things are destroyed by ASCENSION: a Goob consumed at the altar takes
-- everything in its belly with it. So the more people reach the endgame, the
-- rarer old Secrets genuinely become — the prestige loop feeds the scarcity
-- loop, and both are visible on the same wall.
--
-- WRITE DISCIPLINE: DataStore budgets are per-server and small. Counting on
-- every catch would blow through them within minutes of a busy server. Deltas
-- accumulate in memory and flush on an interval, and a failed flush is retried
-- rather than dropped.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game.ReplicatedStorage.GoobShared
local Feedstock = require(Shared.Feedstock)

local CensusService = {}

local store = DataStoreService:GetDataStore("GoobCensus_v1")

-- Only the tiers worth counting. Nobody cares how many Lost Socks exist, and
-- counting them would multiply the write volume for no payoff.
CensusService.TRACKED_RARITIES = {
    Legendary = true, Mythic = true, Secret = true,
}

CensusService.FLUSH_SECONDS = 60

local pendingCaught: { [string]: number } = {}
local pendingDestroyed: { [string]: number } = {}
local totals: { [string]: { caught: number, destroyed: number } } = {}
local enabled = true
local lastFlush = 0

CensusService.onUpdate = Instance.new("BindableEvent")

local function tracked(itemId: string): boolean
    local item = Feedstock.get(itemId)
    return item ~= nil and CensusService.TRACKED_RARITIES[item.rarity] == true
end

function CensusService.recordCaught(itemId: string, count: number?)
    if not tracked(itemId) then return end
    pendingCaught[itemId] = (pendingCaught[itemId] or 0) + (count or 1)
end

-- Called when a Goob is consumed at the altar: everything inside it is gone.
function CensusService.recordDestroyed(contents: { [string]: number }?)
    if not contents then return end
    for itemId, count in pairs(contents) do
        if tracked(itemId) then
            pendingDestroyed[itemId] = (pendingDestroyed[itemId] or 0) + count
        end
    end
end

local function applyLocally(itemId: string, caught: number, destroyed: number)
    local row = totals[itemId] or { caught = 0, destroyed = 0 }
    row.caught += caught
    row.destroyed += destroyed
    totals[itemId] = row
end

function CensusService.flush()
    local caughtBatch, destroyedBatch = pendingCaught, pendingDestroyed
    pendingCaught, pendingDestroyed = {}, {}

    local any = false
    for _ in pairs(caughtBatch) do any = true break end
    if not any then
        for _ in pairs(destroyedBatch) do any = true break end
    end
    if not any then return end

    -- Optimistically apply so the monument on THIS server is live even if the
    -- write is still in flight or the store is down.
    for id, n in pairs(caughtBatch) do applyLocally(id, n, 0) end
    for id, n in pairs(destroyedBatch) do applyLocally(id, 0, n) end
    CensusService.onUpdate:Fire(CensusService.snapshot())

    if not enabled or RunService:IsStudio() then return end

    for id, n in pairs(caughtBatch) do
        local ok = pcall(function()
            store:UpdateAsync("caught_" .. id, function(old)
                return (old or 0) + n
            end)
        end)
        if not ok then
            -- Put it back so the count is delayed rather than silently lost.
            pendingCaught[id] = (pendingCaught[id] or 0) + n
            enabled = false
            warn("[Goob/Census] store unavailable; counting locally only")
            break
        end
    end
    for id, n in pairs(destroyedBatch) do
        local ok = pcall(function()
            store:UpdateAsync("destroyed_" .. id, function(old)
                return (old or 0) + n
            end)
        end)
        if not ok then
            pendingDestroyed[id] = (pendingDestroyed[id] or 0) + n
            enabled = false
            break
        end
    end
end

-- Pull the authoritative worldwide numbers. Runs rarely; the monument is happy
-- being a minute stale and the read budget is not.
function CensusService.refresh()
    if not enabled or RunService:IsStudio() then return end
    for _, item in ipairs(Feedstock.ITEMS) do
        if CensusService.TRACKED_RARITIES[item.rarity] then
            local okC, caught = pcall(function() return store:GetAsync("caught_" .. item.id) end)
            local okD, destroyed = pcall(function() return store:GetAsync("destroyed_" .. item.id) end)
            if okC and okD then
                totals[item.id] = { caught = caught or 0, destroyed = destroyed or 0 }
            else
                enabled = false
                return
            end
        end
    end
    CensusService.onUpdate:Fire(CensusService.snapshot())
end

-- Rarest first, because that is the row people came to read.
function CensusService.snapshot()
    local rows = {}
    for _, item in ipairs(Feedstock.ITEMS) do
        if CensusService.TRACKED_RARITIES[item.rarity] then
            local row = totals[item.id] or { caught = 0, destroyed = 0 }
            table.insert(rows, {
                id = item.id,
                name = item.name,
                rarity = item.rarity,
                weight = item.weight,
                caught = row.caught,
                destroyed = row.destroyed,
                alive = math.max(0, row.caught - row.destroyed),
            })
        end
    end
    table.sort(rows, function(a, b)
        if a.weight ~= b.weight then return a.weight < b.weight end
        return a.name < b.name
    end)
    return rows
end

function CensusService.isEnabled(): boolean
    return enabled
end

function CensusService.start()
    task.spawn(function()
        CensusService.refresh()
        while true do
            task.wait(CensusService.FLUSH_SECONDS)
            CensusService.flush()
            lastFlush = os.clock()
        end
    end)
    -- Re-read far less often than we write: other servers' contributions can
    -- afford to arrive late, and read budget is the scarcer resource.
    task.spawn(function()
        while true do
            task.wait(CensusService.FLUSH_SECONDS * 5)
            CensusService.refresh()
        end
    end)
    game:BindToClose(function()
        CensusService.flush()
    end)
end

return CensusService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000022"><Properties><string name="Name">CrewStore</string><ProtectedString name="Source"><![CDATA[--!strict
-- CrewStore.luau — crews live in their own DataStore because they are shared
-- between players and between servers. A crew read here may have been written
-- by a different server thirty seconds ago, so every mutation goes through
-- UpdateAsync rather than get-modify-set, which would silently drop the other
-- server\'s changes.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Crew = require(game.ReplicatedStorage.GoobShared.Crew)

local CrewStore = {}

local store = DataStoreService:GetDataStore("GoobCrews_v1")
local memory: { [string]: any } = {}
local tagIndex: { [string]: string } = {}
local enabled = true

local function key(id: string): string
    return "crew_" .. id
end

local function fallback(): boolean
    return (not enabled) or RunService:IsStudio()
end

function CrewStore.get(id: string?): any
    if not id then return nil end
    if memory[id] then return memory[id] end
    if fallback() then return nil end
    local ok, res = pcall(function() return store:GetAsync(key(id)) end)
    if not ok then
        enabled = false
        warn("[Goob/Crew] store unavailable; running in memory")
        return nil
    end
    if res then memory[id] = res end
    return res
end

function CrewStore.findByTag(tag: string): any
    local id = tagIndex[tag]
    if id then return CrewStore.get(id) end
    for _, crew in pairs(memory) do
        if crew.tag == tag then return crew end
    end
    if fallback() then return nil end
    local ok, res = pcall(function() return store:GetAsync("tag_" .. tag) end)
    if ok and res then
        tagIndex[tag] = res
        return CrewStore.get(res)
    end
    return nil
end

function CrewStore.create(name: string, tag: string, ownerId: number, ownerName: string): any?
    if CrewStore.findByTag(tag) then return nil end
    local id = HttpService:GenerateGUID(false)
    local crew = Crew.blank(id, name, tag, ownerId, Crew.currentWeek())
    crew.members[tostring(ownerId)].name = ownerName
    memory[id] = crew
    tagIndex[tag] = id
    if not fallback() then
        pcall(function()
            store:SetAsync(key(id), crew)
            store:SetAsync("tag_" .. tag, id)
        end)
    end
    return crew
end

-- Mutate under UpdateAsync so two servers changing the same crew cannot clobber
-- each other. `mutator` receives the authoritative copy and returns it changed.
function CrewStore.update(id: string, mutator: (any) -> any?): any?
    local current = CrewStore.get(id)
    if not current then return nil end

    if fallback() then
        local changed = mutator(current)
        if changed then memory[id] = changed end
        return changed or current
    end

    local ok, res = pcall(function()
        return store:UpdateAsync(key(id), function(stored)
            local base = stored or current
            return mutator(base) or base
        end)
    end)
    if not ok then
        warn("[Goob/Crew] update failed for " .. id)
        return current
    end
    memory[id] = res
    return res
end

function CrewStore.isEnabled(): boolean
    return enabled
end

return CrewStore
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000023"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--!strict
-- Data.luau — profile persistence.
--
-- Uses DataStore with session locking, retry/backoff and a bind-to-close
-- flush. Roblox DataStores fail more often than new developers expect, and the
-- single fastest way to kill a trading game is to roll back someone's Goob
-- after a trade. So: never overwrite a profile we failed to load, and never
-- let a player act on a profile that isn't confirmed loaded.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Config = require(game.ReplicatedStorage.GoobShared.Config)
local Names = require(game.ReplicatedStorage.GoobShared.Names)
local Powers = require(game.ReplicatedStorage.GoobShared.Powers)
local Trinkets = require(game.ReplicatedStorage.GoobShared.Trinkets)
local Cosmetics = require(game.ReplicatedStorage.GoobShared.Cosmetics)
local Season = require(game.ReplicatedStorage.GoobShared.Season)

local Data = {}

local store = DataStoreService:GetDataStore(Config.DATASTORE_KEY)
local profiles: { [number]: any } = {}
local loading: { [number]: boolean } = {}

-- In Studio without API access, DataStore calls throw. We detect that once and
-- fall back to in-memory profiles so the game is fully playable in Studio.
local datastoreEnabled = true

local function newGoob(rng: Random)
    return {
        id = HttpService:GenerateGUID(false),
        nickname = Names.random(rng),
        hue = rng:NextNumber(),
        mass = Config.STARTING_MASS,
        stomach = {},
        bornAt = os.time(),
        inheritedAge = 0,
        lineage = {},
        contents = {},
    }
end

function Data.blankProfile(userId: number)
    local rng = Random.new(userId + os.time())
    return {
        version = 1,
        glob = Config.STARTING_GLOB,
        goobs = { newGoob(rng) },
        activeGoobId = nil :: string?,
        lastSeen = os.time(),
        stats = { caught = 0, gulps = 0, trades = 0, bestMass = Config.STARTING_MASS },
        discovered = {} :: { [string]: boolean },
        crests = 0,
        totalAscensions = 0,
        pitWins = 0,
        cosmeticsOwned = Cosmetics.starterOwned(),
        loadout = Cosmetics.starterLoadout(),
        season = Season.blank(),
        achievements = {} :: { [string]: boolean },
        crewId = nil :: string?,
        purchases = {} :: { [string]: boolean },

        -- ── Arena ──────────────────────────────────────────────────────────
        lifetimeBanked = 0,                        -- unlocks powers; never spent
        powerId = Powers.DEFAULT,
        trinketsOwned = {} :: { [string]: boolean },
        trinketSlots = {} :: { string },
        cratePity = {} :: { [string]: number },    -- rolls since this crate's floor
        bestBank = 0,
        -- Powers handed over by the season track rather than earned by
        -- banking. See Season.POWER_AT: free track only, by construction.
        powersGranted = {} :: { [string]: boolean },
        roundsPlayed = 0,                          -- earns eggs; never spent
        powerUses = {} :: { [string]: number },    -- mastery, per power
        streak = 0,
        streakDay = 0,
    }
end

Data.newGoob = newGoob

local function retry<T>(fn: () -> T, attempts: number): (boolean, any)
    local delayFor = 0.5
    for i = 1, attempts do
        local ok, res = pcall(fn)
        if ok then return true, res end
        if i == attempts then return false, res end
        task.wait(delayFor)
        delayFor *= 2
    end
    return false, nil
end

function Data.load(player: Player)
    local userId = player.UserId
    if profiles[userId] then return profiles[userId] end
    loading[userId] = true

    local profile
    if datastoreEnabled then
        local ok, res = retry(function()
            return store:GetAsync("u_" .. userId)
        end, 4)
        if ok then
            profile = res
        else
            -- Distinguish "no API access in Studio" from a real outage.
            if RunService:IsStudio() then
                datastoreEnabled = false
                warn("[Goob/Data] DataStores unavailable (Studio). Running in-memory.")
            else
                warn("[Goob/Data] Load failed for " .. userId .. ": " .. tostring(res))
                loading[userId] = nil
                -- Refuse to hand back a blank profile in live servers — that is
                -- how you wipe someone's year-old Goob. Kick instead.
                player:Kick("Couldn't load your Goobs. Please rejoin — nothing was lost.")
                return nil
            end
        end
    end

    if not profile then
        profile = Data.blankProfile(userId)
    end

    -- Forward-migrate older saves here as the schema grows.
    profile.stats = profile.stats or { caught = 0, gulps = 0, trades = 0, bestMass = 0 }
    profile.discovered = profile.discovered or {}
    profile.crests = profile.crests or 0
    profile.totalAscensions = profile.totalAscensions or 0
    profile.pitWins = profile.pitWins or 0
    profile.achievements = profile.achievements or {}
    profile.purchases = profile.purchases or {}

    -- Arena fields. A profile written before the arena existed keeps every
    -- Goob it had and simply starts the new progression at zero, which is the
    -- only migration that is safe without asking the player anything.
    profile.lifetimeBanked = profile.lifetimeBanked or 0
    profile.bestBank = profile.bestBank or 0
    profile.roundsPlayed = profile.roundsPlayed or 0
    profile.trinketsOwned = profile.trinketsOwned or {}
    profile.trinketSlots = profile.trinketSlots or {}
    profile.cratePity = profile.cratePity or {}
    profile.powerUses = profile.powerUses or {}
    profile.streak = profile.streak or 0
    profile.streakDay = profile.streakDay or 0
    profile.powersGranted = profile.powersGranted or {}
    if not Powers.isOwned(profile.powerId or "", profile.lifetimeBanked,
        profile.powersGranted) then
        profile.powerId = Powers.DEFAULT
    end
    -- Drop equipped trinkets the player does not actually own. This runs on
    -- every load on purpose: it is the one guard that survives a rollback, a
    -- bad merge, or an exploiter writing a slot they never earned.
    do
        local kept = {}
        for _, id in ipairs(profile.trinketSlots) do
            if profile.trinketsOwned[id] and #kept < Trinkets.SLOTS then
                table.insert(kept, id)
            end
        end
        profile.trinketSlots = kept
    end

    -- Cosmetics: always merge in the starters rather than replacing, so a
    -- profile written before a slot existed gains the new slot's default
    -- without losing anything it already owned.
    profile.cosmeticsOwned = profile.cosmeticsOwned or {}
    for id in pairs(Cosmetics.starterOwned()) do
        profile.cosmeticsOwned[id] = true
    end
    profile.loadout = Cosmetics.sanitise(profile.loadout, profile.cosmeticsOwned)

    profile.season = profile.season or Season.blank()
    Season.rollIfNeeded(profile.season)
    -- The first-run tutorial is gone, and so is the per-profile record it kept.
    -- `profile.tutorial` is simply dropped on load rather than migrated: it is
    -- a few bytes of dead weight in every saved profile and nothing reads it.
    profile.tutorial = nil
    if not profile.activeGoobId and profile.goobs[1] then
        profile.activeGoobId = profile.goobs[1].id
    end

    profiles[userId] = profile
    loading[userId] = nil
    return profile
end

function Data.get(player: Player)
    return profiles[player.UserId]
end

function Data.save(player: Player, release: boolean?)
    local userId = player.UserId
    local profile = profiles[userId]
    if not profile then return end
    profile.lastSeen = os.time()

    if datastoreEnabled then
        local ok, err = retry(function()
            return store:UpdateAsync("u_" .. userId, function()
                return profile
            end)
        end, 3)
        if not ok then
            warn("[Goob/Data] Save failed for " .. userId .. ": " .. tostring(err))
        end
    end

    if release then profiles[userId] = nil end
end

function Data.saveAll()
    for _, player in ipairs(Players:GetPlayers()) do
        task.spawn(Data.save, player, false)
    end
end

function Data.isEnabled(): boolean
    return datastoreEnabled
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000024"><Properties><string name="Name">GoobService</string><ProtectedString name="Source"><![CDATA[--!strict
-- GoobService.luau — spawns, renders and simulates the Goobs sitting on plots.
--
-- The visual gimmick of the whole game lives here: a Goob is a translucent
-- blob, and the things it has eaten are REAL PARTS suspended inside it. That
-- means two players with identical mass can look completely different, and you
-- can read someone's entire play history by walking up and looking at them.

local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Shared = game.ReplicatedStorage.GoobShared
local Config = require(Shared.Config)
local GoobMath = require(Shared.GoobMath)
local Feedstock = require(Shared.Feedstock)
local Format = require(Shared.Format)
local Ascension = require(Shared.Ascension)

local Data = require(script.Parent.Data)
local WorldBuilder = require(script.Parent.WorldBuilder)
local RollService = require(script.Parent.RollService)

local GoobService = {}

local models: { [number]: Model } = {}      -- userId -> rendered Goob model
local INTERIOR_MAX = 45                      -- cap on visible interior parts

-- ── Rendering ──────────────────────────────────────────────────────────────

local function shapeFor(name: string): (Enum.PartType?, string)
    if name == "Ball" then return Enum.PartType.Ball, "Part" end
    if name == "Cylinder" then return Enum.PartType.Cylinder, "Part" end
    if name == "Wedge" then return nil, "WedgePart" end
    return Enum.PartType.Block, "Part"
end

-- Build the parts visible inside the blob. We sample the contents table so a
-- Goob with 50,000 socks shows a representative handful, not 50,000 parts.
local function buildInterior(goob, model: Model, radius: number)
    local existing = model:FindFirstChild("Interior")
    if existing then existing:Destroy() end

    local interior = Instance.new("Folder")
    interior.Name = "Interior"

    -- Flatten contents into a weighted pick list, biased toward rarer items so
    -- your one Pocket Singularity is always visible among the socks.
    local picks = {}
    local totalCount = 0
    for id, count in pairs(goob.contents) do totalCount += count end
    if totalCount == 0 then
        interior.Parent = model
        return
    end

    for id, count in pairs(goob.contents) do
        local item = Feedstock.get(id)
        if item then
            local share = count / totalCount
            local rarityBoost = (item.mass >= 600) and 6 or 1
            local slots = math.max(1, math.round(share * INTERIOR_MAX * rarityBoost))
            for _ = 1, math.min(slots, INTERIOR_MAX) do
                table.insert(picks, item)
                if #picks >= INTERIOR_MAX then break end
            end
        end
        if #picks >= INTERIOR_MAX then break end
    end

    local rng = Random.new(#goob.id + math.floor(goob.bornAt))
    local root = model.PrimaryPart
    if not root then interior.Parent = model return end

    for i, item in ipairs(picks) do
        local partType, className = shapeFor(item.shape)
        local p = Instance.new(className) :: BasePart
        p.Name = item.id
        p.Anchored = false
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.Massless = true
        p.Material = Enum.Material.SmoothPlastic
        p.Color = item.color
        p.Size = item.scale * math.max(1, radius * 0.13)
        if partType and p:IsA("Part") then p.Shape = partType end

        -- Distribute inside the sphere using a cube-root radial so items fill
        -- the volume evenly instead of clumping at the centre.
        local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
        if dir.Magnitude < 0.001 then dir = Vector3.new(0, 1, 0) end
        dir = dir.Unit
        local dist = radius * 0.72 * (rng:NextNumber() ^ (1 / 3))
        p.CFrame = root.CFrame * CFrame.new(dir * dist) * CFrame.Angles(
            rng:NextNumber() * 6.28, rng:NextNumber() * 6.28, rng:NextNumber() * 6.28
        )

        -- Weld each item to the blob so it drifts with it as one body.
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = root
        weld.Part1 = p
        weld.Parent = p

        p.Parent = interior
    end

    interior.Parent = model
end

-- Place the eyes relative to the body for a given radius. Shared by the
-- initial build and every refresh so the face can never drift off the blob.
-- `tweenInfo` animates the move; pass nil to snap (used on first build).
local function layoutFeatures(model: Model, radius: number, tweenInfo: TweenInfo?)
    local body = model.PrimaryPart
    if not body then return end

    for _, side in ipairs({ { "L", -0.34 }, { "R", 0.34 } }) do
        local tag, sx = side[1] :: string, side[2] :: number
        local eye = model:FindFirstChild("Eye" .. tag) :: BasePart?
        local pupil = model:FindFirstChild("Pupil" .. tag) :: BasePart?
        if eye then
            local eyeSize = Vector3.new(radius * 0.34, radius * 0.34, radius * 0.34)
            local eyeCF = body.CFrame * CFrame.new(sx * radius, radius * 0.28, -radius * 0.92)
            if tweenInfo then
                TweenService:Create(eye, tweenInfo, { Size = eyeSize, CFrame = eyeCF }):Play()
            else
                eye.Size, eye.CFrame = eyeSize, eyeCF
            end
            if pupil then
                local pSize = eyeSize * 0.55
                local pCF = eyeCF * CFrame.new(0, 0, -eyeSize.X * 0.34)
                if tweenInfo then
                    TweenService:Create(pupil, tweenInfo, { Size = pSize, CFrame = pCF }):Play()
                else
                    pupil.Size, pupil.CFrame = pSize, pCF
                end
            end
        end
    end
end

local function buildModel(player: Player, goob): Model
    local plot = WorldBuilder.plotFor(player)
    local center = plot and plot.center or Vector3.new(0, 0, 0)
    local radius = GoobMath.size(goob)

    local model = Instance.new("Model")
    model.Name = "Goob_" .. player.UserId

    local body = Instance.new("Part")
    body.Name = "Body"
    body.Shape = Enum.PartType.Ball
    body.Size = Vector3.new(radius, radius, radius) * 2
    body.Position = center + Vector3.new(0, radius + 2, 0)
    body.Anchored = true
    body.CanCollide = false
    body.Material = Enum.Material.Glass
    body.Transparency = 0.55
    body.Color = Color3.fromHSV(goob.hue, 0.55, 1)
    body.Reflectance = 0.08
    body.Parent = model
    model.PrimaryPart = body

    -- Eyes. Two spheres — this is 90% of why it reads as a character instead
    -- of a ball, and it costs almost nothing.
    --
    -- They are anchored and laid out by `layoutFeatures`, which is called on
    -- build AND on every growth tween. An earlier version positioned them only
    -- at build time: the body then tweened to its new size and position on
    -- every feed and the eyes stayed behind, leaving them floating in space
    -- next to a bigger blob.
    for _, side in ipairs({ "L", "R" }) do
        local eye = Instance.new("Part")
        eye.Name = "Eye" .. side
        eye.Shape = Enum.PartType.Ball
        eye.Anchored = true
        eye.CanCollide = false
        eye.CanQuery = false
        eye.Material = Enum.Material.SmoothPlastic
        eye.Color = Color3.new(1, 1, 1)
        eye.Parent = model

        local pupil = Instance.new("Part")
        pupil.Name = "Pupil" .. side
        pupil.Shape = Enum.PartType.Ball
        pupil.Anchored = true
        pupil.CanCollide = false
        pupil.CanQuery = false
        pupil.Material = Enum.Material.SmoothPlastic
        pupil.Color = Color3.fromRGB(25, 25, 35)
        pupil.Parent = model
    end

    -- Nameplate: name, age tier, power. Everything a trader needs at a glance.
    local plate = Instance.new("BillboardGui")
    plate.Name = "Plate"
    plate.Size = UDim2.fromScale(16, 5)
    plate.StudsOffsetWorldSpace = Vector3.new(0, radius + 6, 0)
    plate.AlwaysOnTop = false
    plate.MaxDistance = 400
    plate.Parent = body

    local text = Instance.new("TextLabel")
    text.Name = "Info"
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.Font = Enum.Font.FredokaOne
    text.TextScaled = true
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeTransparency = 0.25
    text.Text = goob.nickname   -- never leave a TextLabel on its "Label" default
    text.Parent = plate

    layoutFeatures(model, radius, nil)
    buildInterior(goob, model, radius)
    model.Parent = Workspace.GoobWorld
    return model
end

-- Update an existing model in place rather than rebuilding it. Rebuilding
-- every frame would destroy performance and make the Goob visibly flicker.
local function refreshModel(player: Player, goob)
    local model = models[player.UserId]
    if not model or not model.PrimaryPart then return end
    local body = model.PrimaryPart
    local radius = GoobMath.size(goob)
    local targetSize = Vector3.new(radius, radius, radius) * 2

    if (body.Size - targetSize).Magnitude > 0.05 then
        local plot = WorldBuilder.plotFor(player)
        local center = plot and plot.center or Vector3.new(0, 0, 0)
        local newPos = center + Vector3.new(0, radius + 2, 0)
        local info = TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        TweenService:Create(body, info, { Size = targetSize, Position = newPos }):Play()

        -- Lay the face out against where the body is GOING, not where it is,
        -- so the two tweens land together instead of the eyes chasing.
        local saved = body.CFrame
        body.CFrame = CFrame.new(newPos)
        layoutFeatures(model, radius, info)
        body.CFrame = saved

        local plate = body:FindFirstChild("Plate") :: BillboardGui?
        if plate then plate.StudsOffsetWorldSpace = Vector3.new(0, radius + 6, 0) end
    end

    local tier = GoobMath.ageTier(goob)
    local plate = body:FindFirstChild("Plate")
    local info = plate and plate:FindFirstChild("Info") :: TextLabel?
    if info then
        info.Text = string.format(
            "%s\n%s %s · Gen %d\n⚡ %s",
            goob.nickname,
            tier.emoji, tier.name,
            GoobMath.generation(goob),
            Format.short(GoobMath.power(goob))
        )
        info.TextColor3 = tier.color
    end

    -- Colossal Goobs get a glow so you can spot one from across the map.
    if GoobMath.isColossal(goob) and not body:FindFirstChild("Colossal") then
        local light = Instance.new("PointLight")
        light.Name = "Colossal"
        light.Brightness = 4
        light.Range = 80
        light.Color = Color3.fromRGB(255, 220, 120)
        light.Parent = body
    end
end

-- Public refresh now goes through the rolling body.
function GoobService.refresh(player: Player, goob)
    RollService.refresh(player, goob)
end
GoobService.refreshModel = GoobService.refresh

function GoobService.activeGoob(profile)
    if not profile then return nil end
    for _, g in ipairs(profile.goobs) do
        if g.id == profile.activeGoobId then return g end
    end
    return profile.goobs[1]
end

function GoobService.spawnFor(player: Player)
    -- The active Goob is no longer a model parked on a pad — it is the player's
    -- body. RollService owns it; this stays as the entry point so every caller
    -- keeps working.
    local profile = Data.get(player)
    if not profile then return end
    local goob = GoobService.activeGoob(profile)
    if not goob then return end
    RollService.spawn(player, goob)
end

function GoobService.despawnFor(player: Player)
    RollService.despawn(player)
end

-- Add an item to the active Goob's stomach. Returns false if something's wrong
-- so the caller can stay silent rather than desyncing the client.
function GoobService.feed(player: Player, itemId: string): boolean
    local profile = Data.get(player)
    if not profile then return false end
    local goob = GoobService.activeGoob(profile)
    if not goob then return false end
    local item = Feedstock.get(itemId)
    if not item then return false end

    -- Crests earned by ascending permanently multiply the value of everything
    -- you eat. This is what makes the second run shorter than the first.
    local multiplier = Ascension.foodMultiplier(profile.crests or 0)
    table.insert(goob.stomach, { id = itemId, mass = item.mass * multiplier })
    goob.contents[itemId] = (goob.contents[itemId] or 0) + 1
    profile.discovered[itemId] = true
    profile.stats.caught += 1
    return true
end

-- Feed one of the player's own Goobs to another. This is THE sink: the eaten
-- Goob is gone from the world permanently, and only 75% of its mass survives.
function GoobService.gulp(player: Player, eaterId: string, eatenId: string): (boolean, string?)
    local profile = Data.get(player)
    if not profile then return false, "No profile." end

    local eater, eaten, eatenIndex
    for i, g in ipairs(profile.goobs) do
        if g.id == eaterId then eater = g end
        if g.id == eatenId then eaten = g; eatenIndex = i end
    end
    if not eater or not eaten then return false, "Goob not found." end
    if #profile.goobs <= 1 then return false, "You need to keep at least one Goob." end

    local ok, reason = GoobMath.canGulp(eater, eaten)
    if not ok then return false, reason end

    GoobMath.applyGulp(eater, eaten)
    table.remove(profile.goobs, eatenIndex)
    profile.stats.gulps += 1
    profile.stats.bestMass = math.max(profile.stats.bestMass, eater.mass)

    if profile.activeGoobId == eatenId then profile.activeGoobId = eater.id end
    if profile.activeGoobId == eater.id then
        GoobService.spawnFor(player) -- full rebuild: the interior changed a lot
    end
    return true
end

-- ── Simulation ─────────────────────────────────────────────────────────────
-- One heartbeat loop for every player. Digestion converts stomach -> mass,
-- and mass -> glob. Runs at 4Hz, not 60Hz: nothing here needs frame precision
-- and 4Hz keeps the server cheap with 30 players on it.

local accumulator = 0
local TICK = 0.25

function GoobService.start()
    RunService.Heartbeat:Connect(function(dt)
        accumulator += dt
        if accumulator < TICK then return end
        local step = accumulator
        accumulator = 0

        for _, player in ipairs(Players:GetPlayers()) do
            local profile = Data.get(player)
            if profile then
                local goob = GoobService.activeGoob(profile)
                if goob then
                    -- Digest
                    local converted = GoobMath.digestStep(goob, step)
                    if converted > 0 then
                        goob.mass += converted
                        local remaining = converted
                        while remaining > 0 and #goob.stomach > 0 do
                            local entry = goob.stomach[1]
                            if entry.mass <= remaining then
                                remaining -= entry.mass
                                table.remove(goob.stomach, 1)
                            else
                                entry.mass -= remaining
                                remaining = 0
                            end
                        end
                        profile.stats.bestMass = math.max(profile.stats.bestMass, goob.mass)
                        RollService.refresh(player, goob)
                    end

                    -- Earn
                    profile.glob += GoobMath.incomePerSecond(goob) * step
                end
            end
        end
    end)
end

-- Called once at login: pay out (capped, discounted) offline digestion.
function GoobService.applyOffline(player: Player)
    local profile = Data.get(player)
    if not profile then return 0 end
    local away = math.clamp(os.time() - (profile.lastSeen or os.time()), 0, Config.OFFLINE_CAP_SECONDS)
    if away < 30 then return 0 end

    local goob = GoobService.activeGoob(profile)
    if not goob then return 0 end

    -- Digest whatever was left in the stomach while away.
    local digested = 0
    local budget = away
    while budget > 0 and #goob.stomach > 0 do
        local converted = GoobMath.digestStep(goob, math.min(budget, 60))
        if converted <= 0 then break end
        goob.mass += converted
        digested += converted
        local remaining = converted
        while remaining > 0 and #goob.stomach > 0 do
            local entry = goob.stomach[1]
            if entry.mass <= remaining then
                remaining -= entry.mass
                table.remove(goob.stomach, 1)
            else
                entry.mass -= remaining
                remaining = 0
            end
        end
        budget -= 60
    end

    local earned = GoobMath.incomePerSecond(goob) * away * Config.OFFLINE_EFFICIENCY
    profile.glob += earned
    return earned
end

return GoobService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000025"><Properties><string name="Name">GoopService</string><ProtectedString name="Source"><![CDATA[--!strict
-- GoopService.luau — globlets, tethers and spore pods.
--
-- THE PART OF THIS GAME THAT IS NOT AGAR.IO.
--
-- Splitting is the genre's signature move, and copying it outright would make
-- this a worse agar with extra menus. So it is copied and then given one twist
-- that changes what the move is for.
--
-- A SPLIT throws three globlets forward. They are not a second body you steer
-- — that needs a second controller and a camera that can hold two things, and
-- it is most of why blob clones feel terrible on a phone. They fly out, hoover
-- pellets, and come home. You stay one blob, with one camera, on one thumb.
--
-- THE TETHER IS THE TWIST. Every globlet stays joined to you by a visible
-- strand of goo, and any blob that crosses a strand is deflated and slowed. A
-- split is therefore not only a lunge — it is three lines drawn across the
-- floor that everybody else has to go around. Split past someone and you have
-- fenced them in. Split while running and you have laid a wire behind you.
-- Split into a crowd and you hit all of it at once.
--
-- That turns "commit half of yourself to reach something" into "commit part of
-- yourself to CONTROL SPACE", which is a different decision, and one I cannot
-- find in any other blob game.
--
-- SPORE PODS are the hazard built on top of it. Touch one while you are big
-- and it bursts you into a whole web at once. You lose nothing to the pod
-- itself — the point is not a tax, it is that for a few seconds your tethers
-- are suddenly everywhere, which is dangerous for everyone nearby including
-- whoever herded you into it. Small blobs pass straight through, so a pod
-- field is somewhere the little ones can hide and the big ones cannot follow.
--
-- ── WHAT THIS MODULE OWNS ─────────────────────────────────────────────────
--
-- Positions and parts. It owns where a globlet is, where a pod is, and which
-- strands exist. It owns NO rule about mass: how much a tether takes, who it
-- may take from, and what happens to what it takes are all ArenaService's,
-- which resolves them for players and bots through the same code. The same
-- split that keeps BotService honest keeps this honest.

local Shared = game.ReplicatedStorage.GoobShared
local Config = require(Shared.Config)
local Blob = require(Shared.Blob)

local WorldBuilder = require(script.Parent.WorldBuilder)

local GoopService = {}

export type Globlet = {
    id: number,
    ownerId: number,       -- UserId, or a negative id for a bot
    mass: number,
    pos: Vector3,
    dir: Vector3,
    travelled: number,
    returning: boolean,
    bornAt: number,
    part: BasePart?,
    strand: BasePart?,
}

export type Pod = {
    id: number,
    pos: Vector3,
    readyAt: number,       -- 0 when standing; a timestamp while regrowing
    part: BasePart?,
}

local globlets: { Globlet } = {}
local pods: { Pod } = {}
local nextId = 1
local rng = Random.new(os.clock() * 1e6 // 1 + 31)
local folder: Folder?

-- Per (globlet, victim) so one strand cannot chain-hit the same blob every
-- tick. Keyed by globlet id and victim key; swept when a globlet dies.
local tetherHits: { [string]: number } = {}

-- ── Parts ──────────────────────────────────────────────────────────────────

local function ensureFolder(): Folder?
    if folder and folder.Parent then
        return folder
    end
    local arena = WorldBuilder.arenaFolder()
    local world = arena and arena.Parent
    if not world then
        return nil
    end
    local f = Instance.new("Folder")
    f.Name = "Goop"
    f.Parent = world
    folder = f
    return f
end

local function makeGlobletParts(g: Globlet, tint: Color3)
    local parent = ensureFolder()
    if not parent then
        return
    end
    local r = math.max(2, Blob.radius(g.mass) * 0.55)

    local p = Instance.new("Part")
    p.Name = "Globlet"
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(1, 1, 1) * (r * 2)
    p.Anchored = true
    -- Resolved by distance in ArenaService, never by a touch event. A globlet
    -- that could be physically shoved would be a second, contradictory answer
    -- to "what happens when we meet".
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Material = Enum.Material.Neon
    p.Color = tint
    p.Position = g.pos
    p.Parent = parent
    g.part = p

    -- THE STRAND. One thin neon box stretched between the body and the
    -- globlet, re-aimed every tick. A Beam would look better and cannot be
    -- used: the hit test has to agree with what the player sees, and a Beam's
    -- curve has no server-side geometry to test against. A straight box is
    -- exactly the segment the maths uses, so what looks like a wire IS the
    -- wire.
    local strand = Instance.new("Part")
    strand.Name = "Strand"
    strand.Anchored = true
    strand.CanCollide = false
    strand.CanTouch = false
    strand.CanQuery = false
    strand.Material = Enum.Material.Neon
    strand.Color = tint
    strand.Transparency = 0.25
    strand.Size = Vector3.new(1, 1, 1)
    strand.Parent = parent
    g.strand = strand
end

local function destroyGloblet(g: Globlet)
    if g.part then g.part:Destroy() end
    if g.strand then g.strand:Destroy() end
    g.part = nil
    g.strand = nil
    for key in pairs(tetherHits) do
        if key:sub(1, #tostring(g.id) + 1) == tostring(g.id) .. ":" then
            tetherHits[key] = nil
        end
    end
end

-- ── Globlets ───────────────────────────────────────────────────────────────

--- Throw `count` globlets out of a body. Returns the total mass committed, so
--- the caller — which owns mass — can take it off the thrower.
---
--- `spreadScale` widens the fan for a pod burst, which throws in every
--- direction rather than in a cone.
function GoopService.split(ownerId: number, from: Vector3, facing: Vector3,
    massEach: number, count: number, tint: Color3, fullCircle: boolean?): number

    if massEach <= 0 or count <= 0 then
        return 0
    end
    local flat = Vector3.new(facing.X, 0, facing.Z)
    flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, 1)

    local committed = 0
    for i = 1, count do
        local angle
        if fullCircle then
            angle = (math.pi * 2 / count) * (i - 1) + rng:NextNumber(-0.12, 0.12)
        else
            -- Centred fan. With three pieces that is one straight ahead and
            -- one to each side, which is the shape that both reaches furthest
            -- and draws the widest fence.
            local mid = (count + 1) / 2
            angle = (i - mid) * Config.SPLIT_SPREAD
        end
        local dir = Vector3.new(
            flat.X * math.cos(angle) - flat.Z * math.sin(angle), 0,
            flat.X * math.sin(angle) + flat.Z * math.cos(angle)).Unit

        local g: Globlet = {
            id = nextId,
            ownerId = ownerId,
            mass = massEach,
            pos = from + dir * 4,
            dir = dir,
            travelled = 0,
            returning = false,
            bornAt = os.clock(),
            part = nil,
            strand = nil,
        }
        nextId += 1
        makeGlobletParts(g, tint)
        table.insert(globlets, g)
        committed += massEach
    end
    return committed
end

function GoopService.list(): { Globlet }
    return globlets
end

function GoopService.countFor(ownerId: number): number
    local n = 0
    for _, g in ipairs(globlets) do
        if g.ownerId == ownerId then n += 1 end
    end
    return n
end

--- Drop every globlet belonging to one owner without paying anything back.
--- Used when its body dies: a tether with nothing on the end of it is a wire
--- to nowhere, and leaving them alive would let a dead player keep fencing.
function GoopService.clearOwner(ownerId: number)
    for i = #globlets, 1, -1 do
        if globlets[i].ownerId == ownerId then
            destroyGloblet(globlets[i])
            table.remove(globlets, i)
        end
    end
end

function GoopService.clear()
    for _, g in ipairs(globlets) do
        destroyGloblet(g)
    end
    table.clear(globlets)
    table.clear(tetherHits)
end

--- Has this strand already hit this victim recently?
function GoopService.canHit(g: Globlet, victimKey: string, now: number): boolean
    local key = g.id .. ":" .. victimKey
    if (tetherHits[key] or 0) > now then
        return false
    end
    tetherHits[key] = now + Config.TETHER_COOLDOWN
    return true
end

--- Distance from a point to the strand segment (body -> globlet), in the
--- ground plane. Height is ignored on purpose: a tether is a fence, and a
--- fence you could hop by being briefly airborne would be a fence nobody
--- respects.
function GoopService.distanceToStrand(g: Globlet, bodyPos: Vector3, at: Vector3): number
    local a = Vector2.new(bodyPos.X, bodyPos.Z)
    local b = Vector2.new(g.pos.X, g.pos.Z)
    local p = Vector2.new(at.X, at.Z)
    local ab = b - a
    local len2 = ab.X * ab.X + ab.Y * ab.Y
    if len2 < 1e-4 then
        return (p - a).Magnitude
    end
    local t = math.clamp(((p.X - a.X) * ab.X + (p.Y - a.Y) * ab.Y) / len2, 0, 1)
    local closest = a + ab * t
    return (p - closest).Magnitude
end

--- Advance every globlet. `bodyOf` hands back where a given owner's body is,
--- or nil if it no longer has one. Returns a list of globlets that came home,
--- so the caller can pay their mass back.
function GoopService.step(dt: number, now: number,
    bodyOf: (number) -> Vector3?): { Globlet }

    local returned = {}
    for i = #globlets, 1, -1 do
        local g = globlets[i]
        local home = bodyOf(g.ownerId)
        if not home then
            -- Its body is gone. The mass goes with it; ArenaService has
            -- already scattered whatever a death owes the floor.
            destroyGloblet(g)
            table.remove(globlets, i)
        else
            local speed = Config.SPLIT_SPEED
            if g.returning then
                local toHome = Vector3.new(home.X - g.pos.X, 0, home.Z - g.pos.Z)
                if toHome.Magnitude <= speed * dt + 4 then
                    table.insert(returned, g)
                    destroyGloblet(g)
                    table.remove(globlets, i)
                    continue
                end
                g.dir = toHome.Unit
            else
                g.travelled += speed * dt
                if g.travelled >= Config.SPLIT_RANGE then
                    g.returning = true
                end
            end

            local nextPos = g.pos + g.dir * speed * dt
            local flat = Vector3.new(nextPos.X, 0, nextPos.Z)
            -- Never off the island, and never through the Vault plinth.
            if flat.Magnitude > Config.PELLET_OUTER then
                flat = flat.Unit * Config.PELLET_OUTER
                g.returning = true
            end
            local r = math.max(2, Blob.radius(g.mass) * 0.55)
            g.pos = Vector3.new(flat.X, 2 + r, flat.Z)

            local part = g.part
            local strand = g.strand
            if part then
                part.Size = Vector3.new(1, 1, 1) * (r * 2)
                part.Position = g.pos
            end
            if strand then
                local mid = (home + g.pos) / 2
                local span = g.pos - home
                local len = span.Magnitude
                if len > 0.5 then
                    strand.Size = Vector3.new(Config.TETHER_WIDTH * 0.8, 1.2, len)
                    strand.CFrame = CFrame.lookAt(mid, g.pos)
                else
                    strand.Size = Vector3.new(0.1, 0.1, 0.1)
                end
            end
        end
    end
    return returned
end

-- ── Spore pods ─────────────────────────────────────────────────────────────

local function makePodPart(pod: Pod)
    local parent = ensureFolder()
    if not parent then
        return
    end
    local p = Instance.new("Part")
    p.Name = "SporePod"
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(1, 1, 1) * (Config.POD_RADIUS * 2)
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Material = Enum.Material.Neon
    -- WHITE, like everything else that is not a player. The island's palette
    -- is greyscale so that the blobs — which are the only saturated things in
    -- the world — read instantly against it.
    p.Color = Color3.fromRGB(238, 238, 240)
    p.Transparency = 0.15
    p.Position = pod.pos
    p.Parent = parent

    -- Spikes, so it reads as "do not touch" from across the island rather than
    -- as a big friendly pellet.
    for i = 1, 10 do
        local a = (math.pi * 2 / 10) * i
        local spike = Instance.new("Part")
        spike.Name = "Spike"
        spike.Size = Vector3.new(1.6, 1.6, Config.POD_RADIUS * 0.9)
        spike.Anchored = true
        spike.CanCollide = false
        spike.CanTouch = false
        spike.CanQuery = false
        spike.Material = Enum.Material.Neon
        spike.Color = Color3.fromRGB(238, 238, 240)
        spike.CFrame = CFrame.new(pod.pos)
            * CFrame.Angles(0, a, 0)
            * CFrame.new(0, 0, -Config.POD_RADIUS)
        spike.Parent = p
    end
    pod.part = p
end

function GoopService.seedPods()
    for _, pod in ipairs(pods) do
        if pod.part then pod.part:Destroy() end
    end
    table.clear(pods)
    for i = 1, Config.POD_COUNT do
        -- Well inside the Flats: a pod on the rim would be unreachable for the
        -- big blobs it exists to threaten, since their rim meter runs out.
        local pos = WorldBuilder.randomSurfacePoint(rng,
            Config.VAULT_RADIUS + 60, Config.SHALLOWS_INNER - 40)
        local pod: Pod = {
            id = i,
            pos = Vector3.new(pos.X, 2 + Config.POD_RADIUS, pos.Z),
            readyAt = 0,
            part = nil,
        }
        makePodPart(pod)
        table.insert(pods, pod)
    end
end

function GoopService.pods(): { Pod }
    return pods
end

--- Mark a pod as spent. It regrows in POD_RESPAWN seconds, in the same place:
--- a hazard that moved would be impossible to play around, and playing around
--- them is the whole point of putting them there.
function GoopService.spendPod(pod: Pod, now: number)
    pod.readyAt = now + Config.POD_RESPAWN
    if pod.part then
        pod.part:Destroy()
        pod.part = nil
    end
end

function GoopService.regrowPods(now: number)
    for _, pod in ipairs(pods) do
        if pod.readyAt > 0 and now >= pod.readyAt then
            pod.readyAt = 0
            makePodPart(pod)
        end
    end
end

function GoopService.clearPods()
    for _, pod in ipairs(pods) do
        if pod.part then pod.part:Destroy() end
        pod.part = nil
    end
    table.clear(pods)
end

return GoopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000026"><Properties><string name="Name">PitService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PitService.luau — runs Sumo Pit matches.
--
-- Server-authoritative on everything that decides money: who is in the ring,
-- who got shoved, who won, who pays. The client owns its ball's movement for
-- responsiveness, but it does not get a vote on the outcome of a staked match.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local Shared = game.ReplicatedStorage.GoobShared
local Pit = require(Shared.Pit)
local Movement = require(Shared.Movement)
local Format = require(Shared.Format)
local GoobMath = require(Shared.GoobMath)

local PitService = {}

PitService.onNotify = Instance.new("BindableEvent")
PitService.onSync = Instance.new("BindableEvent")
PitService.onResult = Instance.new("BindableEvent")   -- (winner, pot, entrants)

type Entrant = { player: Player, stake: number, alive: boolean }

local queue: { Entrant } = {}
local match: { entrants: { Entrant }, startedAt: number, pot: number }? = nil
local lobbyUntil = 0
local ringPart: BasePart? = nil

-- Injected by init.server so this module needs no knowledge of the others.
PitService.getProfile = function(_: Player): any return nil end
PitService.getGoob = function(_: Player): any return nil end
PitService.getBall = function(_: Player): BasePart? return nil end
-- Injected so the Pit can move fighters without the anti-cheat undoing it.
PitService.teleport = function(_: Player, _pos: Vector3) end
-- Cosmetic only; a dropped effect costs nothing.
PitService.onEffect = function(_: Player, _kind: string, _a: any, _b: any) end
PitService.awardXp = function(_: Player, _source: string) end

local function notify(player: Player, msg: string, kind: string?)
    PitService.onNotify:Fire(player, msg, kind or "info")
end

local function broadcastState()
    local names = {}
    for _, e in ipairs(match and match.entrants or queue) do
        if not match or e.alive then table.insert(names, e.player.DisplayName) end
    end
    PitService.onSync:Fire({
        inMatch = match ~= nil,
        queued = #queue,
        minPlayers = Pit.MIN_PLAYERS,
        maxPlayers = Pit.MAX_PLAYERS,
        lobbySeconds = match and 0 or math.max(0, math.ceil(lobbyUntil - os.clock())),
        elapsed = match and (os.clock() - match.startedAt) or 0,
        matchSeconds = Pit.MATCH_SECONDS,
        radius = match and Pit.radiusAt(os.clock() - match.startedAt) or Pit.START_RADIUS,
        alive = names,
        pot = match and match.pot or 0,
        potText = Format.short(match and match.pot or 0),
    })
end

local function inQueue(player: Player): number?
    for i, e in ipairs(queue) do
        if e.player == player then return i end
    end
    return nil
end

function PitService.isFighting(player: Player): boolean
    if not match then return false end
    for _, e in ipairs(match.entrants) do
        if e.player == player and e.alive then return true end
    end
    return false
end

function PitService.join(player: Player)
    if match then
        notify(player, "A match is already running — wait for the next one.", "warn")
        return
    end
    if inQueue(player) then return end
    if #queue >= Pit.MAX_PLAYERS then
        notify(player, "The Pit is full this round.", "warn")
        return
    end

    local profile = PitService.getProfile(player)
    local goob = PitService.getGoob(player)
    if not profile or not goob then return end

    local stake = Pit.stakeFor(profile.lifetimeBanked or 0, profile.glob or 0)
    if profile.glob < stake then
        notify(player, ("You need 💧%s to enter."):format(Format.short(stake)), "warn")
        return
    end

    table.insert(queue, { player = player, stake = stake, alive = true })
    notify(player, ("🥊 Entered the Pit. Stake 💧%s. %d/%d waiting.")
        :format(Format.short(stake), #queue, Pit.MIN_PLAYERS), "good")

    if #queue >= Pit.MIN_PLAYERS and lobbyUntil <= os.clock() then
        lobbyUntil = os.clock() + Pit.LOBBY_SECONDS
    end
    broadcastState()
end

function PitService.leave(player: Player)
    local i = inQueue(player)
    if i then
        table.remove(queue, i)
        notify(player, "Left the Pit queue.", "info")
        if #queue < Pit.MIN_PLAYERS then lobbyUntil = 0 end
        broadcastState()
    end
end

local function eliminate(entrant: Entrant, reason: string)
    if not entrant.alive then return end
    entrant.alive = false
    notify(entrant.player, "💀 Knocked out! " .. reason, "warn")
    PitService.teleport(entrant.player,
        Pit.CENTRE + Vector3.new(0, 8, Pit.START_RADIUS + 70))
end

local function startMatch()
    local entrants = {}
    local pot = 0

    -- EVERYONE STAKES THE SAME, and it is the smallest stake in the lobby.
    --
    -- The ring already normalises both fighters to identical mass, because the
    -- whole point is that the fight is steering and timing rather than whoever
    -- arrived biggest. A pot where one side risked ten times what the other
    -- did would put the unfairness straight back in through the wallet: the
    -- rich player wins pocket change, the new player loses a session. Levelling
    -- down rather than up means nobody is ever priced out of a match they
    -- already queued for.
    local level = math.huge
    for _, e in ipairs(queue) do
        level = math.min(level, e.stake)
    end
    if level < math.huge then
        for _, e in ipairs(queue) do
            e.stake = level
        end
    end

    for _, e in ipairs(queue) do
        local profile = PitService.getProfile(e.player)
        -- Re-check affordability: Glob may have been spent while queueing.
        if profile and profile.glob >= e.stake then
            profile.glob -= e.stake
            pot += e.stake
            e.alive = true
            table.insert(entrants, e)
            PitService.awardXp(e.player, "pitEnter")
        else
            notify(e.player, "You couldn't cover the stake — sat out.", "warn")
        end
    end
    queue = {}
    lobbyUntil = 0

    if #entrants < Pit.MIN_PLAYERS then
        -- Refund and abort rather than running a one-player match.
        for _, e in ipairs(entrants) do
            local profile = PitService.getProfile(e.player)
            if profile then profile.glob += e.stake end
            notify(e.player, "Not enough fighters — stake refunded.", "info")
        end
        broadcastState()
        return
    end

    match = { entrants = entrants, startedAt = os.clock(), pot = pot }

    for i, e in ipairs(entrants) do
        local a = (i - 1) / #entrants * math.pi * 2
        PitService.teleport(e.player, Pit.CENTRE
            + Vector3.new(math.cos(a) * (Pit.START_RADIUS * 0.6), 10,
                          math.sin(a) * (Pit.START_RADIUS * 0.6)))
        notify(e.player, ("🥊 FIGHT! Pot: 💧%s"):format(Format.short(pot)), "good")
    end
    broadcastState()
end

local function endMatch()
    if not match then return end
    local alive = {}
    for _, e in ipairs(match.entrants) do
        if e.alive then table.insert(alive, e) end
    end

    local winner = alive[1]
    if #alive > 1 then
        -- Timer ran out with several standing: biggest Goob takes it, which is
        -- the only tiebreak that cannot be gamed by hiding at the edge.
        table.sort(alive, function(a, b)
            local ga, gb = PitService.getGoob(a.player), PitService.getGoob(b.player)
            return (ga and ga.mass or 0) > (gb and gb.mass or 0)
        end)
        winner = alive[1]
    end

    local pot = Pit.payout({ match.pot })
    if winner then
        local profile = PitService.getProfile(winner.player)
        if profile then
            profile.glob += pot
            profile.pitWins = (profile.pitWins or 0) + 1
        end
        PitService.awardXp(winner.player, "pitWin")
        notify(winner.player, ("🥇 YOU WON THE PIT! +💧%s"):format(Format.short(pot)), "good")
        PitService.onResult:Fire(winner.player, pot, match.entrants)
    else
        -- Everyone fell out at once: split it back rather than eating it.
        local share = pot / math.max(1, #match.entrants)
        for _, e in ipairs(match.entrants) do
            local profile = PitService.getProfile(e.player)
            if profile then profile.glob += share end
            notify(e.player, "Everyone fell out — the pot was split back.", "info")
        end
    end

    match = nil
    broadcastState()
end

function PitService.start()
    -- The visible ring.
    task.spawn(function()
        local world = Workspace:WaitForChild("GoobWorld")
        ringPart = world:WaitForChild("PitRing") :: BasePart
    end)

    task.spawn(function()
        while true do
            task.wait(0.1)

            if not match then
                if #queue >= Pit.MIN_PLAYERS and lobbyUntil > 0 and os.clock() >= lobbyUntil then
                    startMatch()
                end
            else
                local elapsed = os.clock() - match.startedAt
                local radius = Pit.radiusAt(elapsed)

                if ringPart then
                    ringPart.Size = Vector3.new(1.5, radius * 2, radius * 2)
                end

                -- Eliminations.
                local aliveCount = 0
                for _, e in ipairs(match.entrants) do
                    if e.alive then
                        local ball = PitService.getBall(e.player)
                        if not ball or not ball.Parent or not e.player.Parent then
                            eliminate(e, "left the arena")
                        elseif not Pit.isInside(ball.Position, elapsed) then
                            eliminate(e, "out of the ring!")
                        else
                            aliveCount += 1
                        end
                    end
                end

                -- Shoves. O(n^2) over at most 8 entrants, ten times a second.
                for i = 1, #match.entrants do
                    for j = i + 1, #match.entrants do
                        local a, b = match.entrants[i], match.entrants[j]
                        if a.alive and b.alive then
                            local ba, bb = PitService.getBall(a.player), PitService.getBall(b.player)
                            local ga, gb = PitService.getGoob(a.player), PitService.getGoob(b.player)
                            if ba and bb and ga and gb then
                                local delta = bb.Position - ba.Position
                                local touching = (ba.Size.X + bb.Size.X) / 2 + 2
                                if delta.Magnitude < touching and delta.Magnitude > 0.01 then
                                    local dir = delta.Unit
                                    local shareA, shareB = Pit.shove(
                                        ga.mass, ba.AssemblyLinearVelocity,
                                        gb.mass, bb.AssemblyLinearVelocity)
                                    ba.AssemblyLinearVelocity = ba.AssemblyLinearVelocity
                                        - dir * (Pit.SHOVE_IMPULSE * shareA)
                                    bb.AssemblyLinearVelocity = bb.AssemblyLinearVelocity
                                        + dir * (Pit.SHOVE_IMPULSE * shareB)
                                    local contact = ba.Position + delta * 0.5
                                    PitService.onEffect(a.player, "shove", contact, shareA)
                                    PitService.onEffect(b.player, "shove", contact, shareB)
                                end
                            end
                        end
                    end
                end

                if aliveCount <= 1 or elapsed >= Pit.MATCH_SECONDS then
                    endMatch()
                end
            end
            broadcastState()
        end
    end)
end

function PitService.cleanup(player: Player)
    PitService.leave(player)
    if match then
        for _, e in ipairs(match.entrants) do
            if e.player == player then e.alive = false end
        end
    end
end

function PitService.state()
    return { inMatch = match ~= nil, queued = #queue }
end

return PitService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">RollService</string><ProtectedString name="Source"><![CDATA[--!strict
-- RollService.luau — you don't stand next to your Goob, you ARE your Goob.
--
-- This is the change the whole redesign hangs off. Previously the active Goob
-- sat on a plot like furniture while a default Roblox avatar ran around next to
-- it; the thing the game is named after was scenery. Now the active Goob is the
-- player's body, and mass becomes physics you feel rather than a number in a
-- corner.
--
-- OWNERSHIP AND CHEATING
-- The ball must be client-owned or it will feel like mud at any ping above
-- nothing. That means the client can teleport it. So the server samples the
-- ball's position and rejects moves faster than Movement.maxPlausibleSpeed,
-- snapping the offender back. Catching is ALSO still validated by distance
-- server-side, so a successful teleport still buys nothing.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game.ReplicatedStorage.GoobShared
local Config = require(Shared.Config)
local GoobMath = require(Shared.GoobMath)
local Movement = require(Shared.Movement)
local Feedstock = require(Shared.Feedstock)
local Cosmetics = require(Shared.Cosmetics)

local RollService = {}

local balls: { [number]: BasePart } = {}
local lastSeen: { [number]: { pos: Vector3, t: number } } = {}
local violations: { [number]: number } = {}

RollService.onShove = Instance.new("BindableEvent")

local INTERIOR_MAX = 30

-- Record where a welded child sits and how big it is, both expressed as a
-- FRACTION of the ball's radius. The arena changes a blob's mass several times
-- a second, so the body has to be rescalable in place; without these the only
-- way to resize it is to rebuild the whole model, which would respawn the
-- player's body out from under them mid-chase.
local function markRelative(child: BasePart, ball: BasePart, radius: number)
    local offset = child.Position - ball.Position
    child:SetAttribute("RelOffset", offset / radius)
    child:SetAttribute("RelSize", child.Size / radius)
end

local function buildBall(player: Player, goob): BasePart
    local radius = GoobMath.size(goob)

    local ball = Instance.new("Part")
    ball.Name = "GoobBall_" .. player.UserId
    ball.Shape = Enum.PartType.Ball
    ball.Size = Vector3.new(radius, radius, radius) * 2
    ball.Material = Enum.Material.Glass
    -- A fresh Goob is only 4 studs across. At 0.45 on Glass it was very nearly
    -- invisible against the sky, which is a bad first impression when it is
    -- also the thing you are supposed to be. Solid enough to read as a body,
    -- transparent enough to show what is inside it.
    ball.Transparency = 0.24
    ball.Color = Color3.fromHSV(goob.hue, 0.55, 1)
    ball.Reflectance = 0.06
    ball.CanCollide = true
    ball.Anchored = false
    ball.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.35, 0.25, 1, 1)
    ball.Parent = Workspace

    -- Face. Two eyes welded on, so it reads as a creature rather than a marble.
    for _, side in ipairs({ { "L", -0.34 }, { "R", 0.34 } }) do
        local tag, sx = side[1], side[2]
        local eye = Instance.new("Part")
        eye.Name = "Eye" .. tag
        eye.Shape = Enum.PartType.Ball
        eye.Size = Vector3.new(radius * 0.36, radius * 0.36, radius * 0.36)
        eye.Color = Color3.new(1, 1, 1)
        eye.Material = Enum.Material.SmoothPlastic
        eye.CanCollide = false
        eye.CanQuery = false
        eye.Massless = true
        eye.CFrame = ball.CFrame * CFrame.new(sx * radius, radius * 0.3, -radius * 0.9)
        eye.Parent = ball
        markRelative(eye, ball, radius)
        local w = Instance.new("WeldConstraint")
        w.Part0, w.Part1 = ball, eye
        w.Parent = eye

        local pupil = Instance.new("Part")
        pupil.Name = "Pupil" .. tag
        pupil.Shape = Enum.PartType.Ball
        pupil.Size = eye.Size * 0.55
        pupil.Color = Color3.fromRGB(25, 25, 35)
        pupil.Material = Enum.Material.SmoothPlastic
        pupil.CanCollide = false
        pupil.CanQuery = false
        pupil.Massless = true
        pupil.CFrame = eye.CFrame * CFrame.new(0, 0, -eye.Size.X * 0.35)
        pupil.Parent = ball
        markRelative(pupil, ball, radius)
        local w2 = Instance.new("WeldConstraint")
        w2.Part0, w2.Part1 = ball, pupil
        w2.Parent = pupil
    end

    -- The contents, visible through the shell. Same idea as before, but now it
    -- tumbles with you, so what you have eaten is on display everywhere you go.
    local rng = Random.new(#goob.id + math.floor(goob.bornAt))
    local picks = {}
    local total = 0
    for _, count in pairs(goob.contents) do total += count end
    if total > 0 then
        for id, count in pairs(goob.contents) do
            local item = Feedstock.get(id)
            if item then
                local boost = (item.mass >= 600) and 6 or 1
                local slots = math.max(1, math.round((count / total) * INTERIOR_MAX * boost))
                for _ = 1, math.min(slots, INTERIOR_MAX) do
                    table.insert(picks, item)
                    if #picks >= INTERIOR_MAX then break end
                end
            end
            if #picks >= INTERIOR_MAX then break end
        end
    end

    for _, item in ipairs(picks) do
        local p = Instance.new("Part")
        p.Name = item.id
        p.Size = item.scale * math.max(0.5, radius * 0.14)
        p.Color = item.color
        p.Material = Enum.Material.SmoothPlastic
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.Massless = true
        if item.shape == "Ball" then p.Shape = Enum.PartType.Ball
        elseif item.shape == "Cylinder" then p.Shape = Enum.PartType.Cylinder end

        local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
        if dir.Magnitude < 0.001 then dir = Vector3.new(0, 1, 0) end
        p.CFrame = ball.CFrame * CFrame.new(dir.Unit * (radius * 0.7 * rng:NextNumber() ^ (1 / 3)))
        p.Parent = ball
        markRelative(p, ball, radius)
        local w = Instance.new("WeldConstraint")
        w.Part0, w.Part1 = ball, p
        w.Parent = p
    end

    -- Nameplate travels with you: name, age tier, power, ascension crest.
    local plate = Instance.new("BillboardGui")
    plate.Name = "Plate"
    plate.Size = UDim2.fromScale(16, 5)
    plate.StudsOffsetWorldSpace = Vector3.new(0, radius + 5, 0)
    plate.MaxDistance = 500
    plate.Parent = ball

    local text = Instance.new("TextLabel")
    text.Name = "Info"
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.Font = Enum.Font.FredokaOne
    text.TextScaled = true
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeTransparency = 0.35
    -- MUST be set here. A TextLabel's default Text is the literal string
    -- "Label", and this plate is a TextScaled BillboardGui floating directly
    -- above the player's own camera subject — so leaving it for a later refresh
    -- put the word "Label" across the middle of the screen in metre-high
    -- letters until something happened to trigger one.
    text.Text = goob.nickname
    text.Parent = plate

    return ball
end

-- Cosmetics are applied to the live ball rather than baked in at build time,
-- so equipping something is instant instead of respawning the player's body
-- out from under them mid-roll.
function RollService.applyCosmetics(player: Player, loadout: { [string]: string }?)
    local ball = balls[player.UserId]
    if not ball or not loadout then return end

    local skin = Cosmetics.get(loadout.skin or "")
    if skin then
        if skin.material then ball.Material = skin.material end
        if skin.colour then ball.Color = skin.colour end
        -- The default skin keeps the Goob's own hue, which is its identity.
        ball:SetAttribute("Skin", skin.id)
    end

    -- ── PARTICLES, FOR THE RARE ONES ──────────────────────────────────────
    --
    -- Rebuilt rather than edited, for the same reason the trail below is: an
    -- emitter carries half a dozen sequences and changing one leaves the rest
    -- describing the previous skin.
    --
    -- WHY THESE EXIST AT ALL. A rare skin that is only a different colour is a
    -- rare skin nobody can tell you own — the difference between Common and
    -- Legendary has to be visible from across the island, in motion, without a
    -- menu. Only Rare and above get one: if everything sparkles, nothing does,
    -- and twelve emitting blobs on a phone is a framerate problem.
    local oldFx = ball:FindFirstChild("SkinFx")
    if oldFx then oldFx:Destroy() end
    if skin and skin.particle then
        local tint = skin.colour or ball.Color
        local fx = Instance.new("Attachment")
        fx.Name = "SkinFx"
        fx.Parent = ball

        local e = Instance.new("ParticleEmitter")
        e.Name = "Fx"
        e.Color = ColorSequence.new(tint)
        e.LightEmission = 1
        e.LightInfluence = 0
        e.Speed = NumberRange.new(2, 7)
        e.Lifetime = NumberRange.new(0.5, 1.1)
        e.Rate = 14
        e.SpreadAngle = Vector2.new(180, 180)
        e.Transparency = NumberSequence.new(0.15, 1)
        -- Emitted from a SHELL, not from the centre: EmissionDirection plus a
        -- wide spread on a ball attachment puts the whole cloud inside the
        -- body, where a translucent skin hides it entirely.
        e.EmissionDirection = Enum.NormalId.Top

        -- One shape per name. Deliberately a small vocabulary — four looks the
        -- player can learn to recognise — rather than a bespoke emitter per
        -- skin, which is how a cosmetic catalogue becomes unmaintainable.
        if skin.particle == "ember" then
            e.Size = NumberSequence.new(1.6, 0)
            e.Rate = 22
            e.Acceleration = Vector3.new(0, 14, 0)
        elseif skin.particle == "spark" then
            e.Size = NumberSequence.new(0.9, 0)
            e.Speed = NumberRange.new(10, 18)
            e.Lifetime = NumberRange.new(0.25, 0.5)
            e.Rate = 26
        elseif skin.particle == "grid" then
            e.Size = NumberSequence.new(2.4, 0)
            e.Speed = NumberRange.new(0.5, 2)
            e.Lifetime = NumberRange.new(0.8, 1.4)
            e.Rate = 10
        elseif skin.particle == "void" then
            e.Size = NumberSequence.new(0, 3.2)
            e.Speed = NumberRange.new(-9, -4)   -- inward: it falls into you
            e.Lifetime = NumberRange.new(0.6, 1.0)
            e.Rate = 18
        elseif skin.particle == "prism" then
            e.Size = NumberSequence.new(1.2, 0)
            e.Rate = 20
            -- The one place a colour ramp is allowed to be a rainbow, because
            -- the skin is literally called Prism.
            e.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 96, 96)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(96, 255, 200)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 120, 255)),
            })
        end
        e.Parent = fx
    end

    -- Trail. Rebuilt rather than tweaked because Trail needs two attachments
    -- and changing colour alone would leave a stale one behind.
    local old = ball:FindFirstChild("GoobTrail")
    if old then old:Destroy() end
    local trail = Cosmetics.get(loadout.trail or "")
    if trail and trail.id ~= "trail_none" and trail.colour then
        local r = ball.Size.X / 2
        local a0 = Instance.new("Attachment")
        a0.Name = "TrailA0"
        a0.Position = Vector3.new(-r * 0.5, 0, 0)
        a0.Parent = ball
        local a1 = Instance.new("Attachment")
        a1.Name = "TrailA1"
        a1.Position = Vector3.new(r * 0.5, 0, 0)
        a1.Parent = ball

        local t = Instance.new("Trail")
        t.Name = "GoobTrail"
        t.Attachment0 = a0
        t.Attachment1 = a1
        t.Lifetime = 0.8
        t.MinLength = 0.2
        t.LightEmission = 0.6
        t.Transparency = NumberSequence.new(0.25, 1)
        t.Color = ColorSequence.new(trail.colour)
        t.Parent = ball
    end

    -- Eyes and crown ride on the nameplate, which every other player can read
    -- from across the map. That is the entire point of a cosmetic.
    ball:SetAttribute("Eyes", loadout.eyes or "")
    ball:SetAttribute("Crown", loadout.crown or "")
    RollService.refreshPlate(player)
end

function RollService.ballFor(player: Player): BasePart?
    return balls[player.UserId]
end

-- Resize a live blob in place.
--
-- A WeldConstraint captures its offset when it is created and will not let go,
-- so growing the ball while the eyes stay welded buries them inside the body.
-- Every welded child therefore gets its weld dropped, is moved and scaled by
-- the stored fractions, and is welded again. That is more work than setting
-- one Size, but it is still far cheaper than rebuilding the model, and it is
-- the difference between a blob that grows and a blob that flickers.
--
-- Throttled by RESIZE_EPSILON: the arena calls this every tick, and a blob
-- gaining 0.3% is not worth thirty instance writes.
RollService.RESIZE_EPSILON = 0.02

function RollService.setRadius(player: Player, radius: number): boolean
    local ball = balls[player.UserId]
    if not ball or not ball.Parent then
        return false
    end
    radius = math.max(0.8, radius)
    local current = ball.Size.X / 2
    if math.abs(radius - current) <= current * RollService.RESIZE_EPSILON then
        return false
    end

    ball.Size = Vector3.new(radius, radius, radius) * 2

    for _, child in ipairs(ball:GetChildren()) do
        if child:IsA("BasePart") then
            local relOffset = child:GetAttribute("RelOffset")
            local relSize = child:GetAttribute("RelSize")
            if relOffset and relSize then
                for _, w in ipairs(child:GetChildren()) do
                    if w:IsA("WeldConstraint") then
                        w:Destroy()
                    end
                end
                child.Size = relSize * radius
                child.CFrame = ball.CFrame * CFrame.new(relOffset * radius)
                local weld = Instance.new("WeldConstraint")
                weld.Part0, weld.Part1 = ball, child
                weld.Parent = child
            end
        end
    end

    local plate = ball:FindFirstChild("Plate")
    if plate and plate:IsA("BillboardGui") then
        plate.StudsOffsetWorldSpace = Vector3.new(0, radius + 5, 0)
    end
    return true
end

function RollService.spawn(player: Player, goob, atPosition: Vector3?)
    RollService.despawn(player)
    if not goob then return end

    local ball = buildBall(player, goob)
    local radius = GoobMath.size(goob)
    local start = atPosition or Vector3.new(0, radius + 6, 40)
    ball.CFrame = CFrame.new(start)
    balls[player.UserId] = ball

    -- Hide the avatar and bind it to the ball. Keeping the character alive is
    -- deliberate: Humanoid.MoveDirection is how we read input, and it already
    -- handles keyboard, gamepad AND the mobile thumbstick for free. Writing a
    -- bespoke touch stick would have been the alternative.
    local char = player.Character
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Transparency = 1
                d.CanCollide = false
                d.Massless = true
            elseif d:IsA("Decal") then
                d.Transparency = 1
            end
        end
        local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            -- PlatformStand, NOT WalkSpeed = 0.
            --
            -- A Humanoid with WalkSpeed = 0 does not simply decline to move: it
            -- actively brakes its assembly to zero velocity every physics step.
            -- The ball is welded to that assembly, so the humanoid fought every
            -- frame of movement the controller applied and the player could not
            -- move at all. PlatformStand makes the humanoid stop controlling
            -- physics entirely, which is what we actually wanted.
            hum.PlatformStand = true
            hum.AutoRotate = false
        end
        if hrp then
            hrp.CFrame = ball.CFrame
            local weld = Instance.new("WeldConstraint")
            weld.Name = "GoobBallWeld"
            weld.Part0 = ball
            weld.Part1 = hrp
            weld.Parent = ball
        end
    end

    -- Client owns it or it feels like mud. The cost is policed below.
    local ok = pcall(function() ball:SetNetworkOwner(player) end)
    if not ok then warn("[Goob/Roll] could not hand ownership to " .. player.Name) end

    lastSeen[player.UserId] = { pos = ball.Position, t = os.clock() }
    violations[player.UserId] = 0

    -- Paint the real nameplate immediately rather than waiting for the first
    -- mass change to trigger a refresh.
    RollService.refresh(player, goob)
end

-- Move a ball somewhere the SERVER decided it should be.
--
-- This exists because the anti-cheat cannot tell the difference between a
-- client teleporting itself and the server placing a player in the arena. The
-- first version of the Sumo Pit started a match, dropped both fighters into the
-- ring, and then the sampler snapped them straight back out again and
-- eliminated them — every match ended instantly with the pot refunded. Any
-- legitimate reposition MUST go through here so the sampler is told about it.
function RollService.teleport(player: Player, position: Vector3)
    local ball = balls[player.UserId]
    if not ball then return end
    ball.CFrame = CFrame.new(position)
    ball.AssemblyLinearVelocity = Vector3.zero
    ball.AssemblyAngularVelocity = Vector3.zero
    local seen = lastSeen[player.UserId]
    if seen then
        seen.pos = position
        seen.t = os.clock()
    end
    violations[player.UserId] = 0
end

function RollService.despawn(player: Player)
    local ball = balls[player.UserId]
    if ball then ball:Destroy() end
    balls[player.UserId] = nil
    lastSeen[player.UserId] = nil
end

-- Rebuild only when the size has drifted enough to matter. Rebuilding on every
-- feed would yank the ball out from under the player mid-roll.
-- Split out so cosmetics can redraw the plate without needing the Goob record.
function RollService.refreshPlate(player: Player)
    local ball = balls[player.UserId]
    if not ball then return end
    local plate = ball:FindFirstChild("Plate")
    local info = plate and plate:FindFirstChild("Info") :: TextLabel?
    if info then
        local crown = Cosmetics.get(ball:GetAttribute("Crown") or "")
        local prefix = (crown and crown.emoji ~= "" and crown.emoji) and (crown.emoji .. " ") or ""
        info.Text = prefix .. info.Text:gsub("^[^%a%d👑]*", "")
    end
end

-- WHO OWNS THE BODY'S SIZE.
--
-- Once the arena is running, the answer is the arena: a run's mass changes
-- several times a second and setRadius reshapes the body in place to match.
-- RollService.refresh used to resize too, by respawning the whole model when
-- the size drifted 25% from the stored Goob's mass — which, against a live
-- arena, would have rebuilt the player's body out from under them every few
-- seconds, forever. Exactly one system may write Size, and this flag says
-- which. It is set by ArenaService.start.
RollService.sizeOwnedByArena = false

-- Where a player who fell out of the world should be put back. Set by
-- ArenaService, because the right answer depends on the phase: rescuing a
-- player to the island during a lobby drops them somewhere nothing can reach
-- them, and rescuing to the lobby mid-round removes them from the game.
RollService.rescuePoint = function(_player: Player): Vector3
    return Vector3.new(0, 30, 40)
end

function RollService.refresh(player: Player, goob)
    local ball = balls[player.UserId]
    if not ball or not goob then return end
    if not RollService.sizeOwnedByArena then
        local radius = GoobMath.size(goob)
        local want = Vector3.new(radius, radius, radius) * 2
        if (ball.Size - want).Magnitude > radius * 0.25 then
            RollService.spawn(player, goob, ball.Position + Vector3.new(0, 2, 0))
            return
        end
    end

    local plate = ball:FindFirstChild("Plate")
    local info = plate and plate:FindFirstChild("Info") :: TextLabel?
    if info then
        local tier = GoobMath.ageTier(goob)
        local crown = Cosmetics.get(ball:GetAttribute("Crown") or "")
        local hat = (crown and crown.emoji and crown.emoji ~= "") and (crown.emoji .. " ") or ""
        local crest = (goob.crests and goob.crests > 0)
            and ("👑" .. tostring(goob.crests) .. " ") or ""
        local tag = ball:GetAttribute("CrewTag")
        local crew = (tag and tag ~= "") and ("[" .. tag .. "] ") or ""
        info.Text = ("%s%s%s%s\n%s %s · Gen %d\n⚡ %s")
            :format(hat, crest, crew, goob.nickname, tier.emoji, tier.name,
                    #goob.lineage + 1, require(Shared.Format).short(GoobMath.power(goob)))
        info.TextColor3 = tier.color
    end
end

-- ── Anti-cheat ─────────────────────────────────────────────────────────────
-- Sampled, not per-frame: a 4Hz check is plenty to catch a teleport and costs
-- nothing with thirty players on a server.

function RollService.start(getGoob: (Player) -> any)
    task.spawn(function()
        while true do
            task.wait(0.25)
            local now = os.clock()
            for userId, ball in pairs(balls) do
                local player = Players:GetPlayerByUserId(userId)
                local prev = lastSeen[userId]
                if player and prev and ball.Parent then
                    local dt = math.max(0.05, now - prev.t)
                    local dist = (ball.Position - prev.pos).Magnitude
                    local speed = dist / dt
                    local goob = getGoob(player)
                    local ceiling = goob and Movement.maxPlausibleSpeed(goob.mass) or 200

                    if speed > ceiling then
                        violations[userId] = (violations[userId] or 0) + 1
                        -- One strike is network noise; three is a script.
                        if violations[userId] >= 3 then
                            ball.CFrame = CFrame.new(prev.pos)
                            ball.AssemblyLinearVelocity = Vector3.zero
                            violations[userId] = 0
                        end
                    else
                        violations[userId] = math.max(0, (violations[userId] or 0) - 1)
                        prev.pos = ball.Position
                    end
                    prev.t = now

                    -- Fell off the world. Recorded as a legitimate move, or the
                    -- next sample would read the rescue itself as a teleport.
                    if ball.Position.Y < -80 then
                        RollService.teleport(player, RollService.rescuePoint(player))
                    end
                end
            end
        end
    end)
end

return RollService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[--!strict
-- TradeService.luau — player-to-player Goob trading.
--
-- Trading is the reason this game has a community instead of a player count.
-- It is also the single most exploited system in every Roblox game, so the
-- rules here are deliberately paranoid:
--   1. The server owns every Goob. The client can only reference IDs it owns.
--   2. Confirming is a HOLD, not a click, and any change to either offer
--      resets both confirmations. This kills the classic "swap the item at the
--      last moment" scam outright.
--   3. Both players must be physically in the trade zone for the whole trade.
--   4. The swap itself is atomic — we validate everything, then move.

local Players = game:GetService("Players")

local Shared = game.ReplicatedStorage.GoobShared
local Config = require(Shared.Config)
local GoobMath = require(Shared.GoobMath)
local Format = require(Shared.Format)

local Data = require(script.Parent.Data)
local GoobService = require(script.Parent.GoobService)

local TradeService = {}

type Session = {
    a: Player, b: Player,
    offers: { [number]: { string } },   -- userId -> goob ids
    confirmed: { [number]: number? },   -- userId -> os.clock() when hold began
    open: boolean,
}

local sessions: { Session } = {}
local sessionOf: { [number]: Session } = {}
local pending: { [number]: number } = {}  -- targetUserId -> requesterUserId

TradeService.onSync = Instance.new("BindableEvent")
TradeService.onNotify = Instance.new("BindableEvent")

local function notify(player: Player, msg: string, kind: string?)
    TradeService.onNotify:Fire(player, msg, kind or "info")
end

local function inTradeZone(player: Player): boolean
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return false end
    local flat = Vector3.new(root.Position.X, 0, root.Position.Z)
    return flat.Magnitude <= Config.TRADE_RANGE
end

local function goobById(profile, id: string)
    for i, g in ipairs(profile.goobs) do
        if g.id == id then return g, i end
    end
    return nil
end

-- Serialise just enough for the other player to judge the deal. We send power
-- and age, NOT internal ids of things they don't own.
local function describe(goob)
    local tier = GoobMath.ageTier(goob)
    return {
        id = goob.id,
        nickname = goob.nickname,
        hue = goob.hue,
        mass = goob.mass,
        power = GoobMath.power(goob),
        powerText = Format.short(GoobMath.power(goob)),
        ageText = Format.duration(GoobMath.ageSeconds(goob)),
        ageTier = tier.name,
        ageEmoji = tier.emoji,
        generation = GoobMath.generation(goob),
        contents = goob.contents,
    }
end

local function sync(session: Session)
    for _, player in ipairs({ session.a, session.b }) do
        local other = if player == session.a then session.b else session.a
        local myProfile = Data.get(player)
        local otherProfile = Data.get(other)
        if myProfile and otherProfile then
            local function pack(profile, ids)
                local out = {}
                for _, id in ipairs(ids) do
                    local g = goobById(profile, id)
                    if g then table.insert(out, describe(g)) end
                end
                return out
            end
            TradeService.onSync:Fire(player, {
                open = session.open,
                partner = other.Name,
                partnerDisplay = other.DisplayName,
                myOffer = pack(myProfile, session.offers[player.UserId]),
                theirOffer = pack(otherProfile, session.offers[other.UserId]),
                myConfirmed = session.confirmed[player.UserId] ~= nil,
                theirConfirmed = session.confirmed[other.UserId] ~= nil,
                lockSeconds = Config.TRADE_CONFIRM_LOCK,
            })
        end
    end
end

-- Any change to the deal wipes both confirmations. Non-negotiable.
local function resetConfirms(session: Session)
    session.confirmed[session.a.UserId] = nil
    session.confirmed[session.b.UserId] = nil
end

function TradeService.request(from: Player, targetName: string)
    local target = Players:FindFirstChild(targetName) :: Player?
    if not target or target == from then return end
    if sessionOf[from.UserId] or sessionOf[target.UserId] then
        notify(from, "One of you is already trading.", "warn")
        return
    end
    if not inTradeZone(from) or not inTradeZone(target) then
        notify(from, "You both need to stand in the 🤝 TRADE ZONE.", "warn")
        return
    end
    pending[target.UserId] = from.UserId
    notify(target, from.DisplayName .. " wants to trade Goobs!", "trade")
    notify(from, "Trade request sent to " .. target.DisplayName .. ".", "info")
end

function TradeService.respond(target: Player, accept: boolean)
    local requesterId = pending[target.UserId]
    if not requesterId then return end
    pending[target.UserId] = nil
    local requester = Players:GetPlayerByUserId(requesterId)
    if not requester then return end
    if not accept then
        notify(requester, target.DisplayName .. " declined.", "warn")
        return
    end
    if sessionOf[target.UserId] or sessionOf[requesterId] then return end

    local session: Session = {
        a = requester, b = target,
        offers = { [requesterId] = {}, [target.UserId] = {} },
        confirmed = {},
        open = true,
    }
    table.insert(sessions, session)
    sessionOf[requesterId] = session
    sessionOf[target.UserId] = session
    sync(session)
end

function TradeService.offer(player: Player, goobId: string, add: boolean)
    local session = sessionOf[player.UserId]
    if not session or not session.open then return end
    local profile = Data.get(player)
    if not profile then return end

    local list = session.offers[player.UserId]
    if add then
        if #list >= Config.TRADE_MAX_SLOTS then return end
        if not goobById(profile, goobId) then return end
        -- You must always keep at least one Goob. Offering your last one is
        -- how new players get talked out of everything they own.
        if #list + 1 >= #profile.goobs then
            notify(player, "You have to keep at least one Goob.", "warn")
            return
        end
        for _, id in ipairs(list) do if id == goobId then return end end
        table.insert(list, goobId)
    else
        for i, id in ipairs(list) do
            if id == goobId then table.remove(list, i) break end
        end
    end
    resetConfirms(session)
    sync(session)
end

function TradeService.confirm(player: Player, holding: boolean)
    local session = sessionOf[player.UserId]
    if not session or not session.open then return end

    if not holding then
        session.confirmed[player.UserId] = nil
        sync(session)
        return
    end

    session.confirmed[player.UserId] = os.clock()
    sync(session)

    -- Wait out the hold, then re-check EVERYTHING. State can change during the
    -- three seconds and we must never trust the snapshot we took at the start.
    task.delay(Config.TRADE_CONFIRM_LOCK, function()
        if not session.open then return end
        local aOk = session.confirmed[session.a.UserId]
        local bOk = session.confirmed[session.b.UserId]
        if not aOk or not bOk then return end
        if os.clock() - aOk < Config.TRADE_CONFIRM_LOCK - 0.05 then return end
        if os.clock() - bOk < Config.TRADE_CONFIRM_LOCK - 0.05 then return end
        TradeService.execute(session)
    end)
end

function TradeService.execute(session: Session)
    local a, b = session.a, session.b
    local pa, pb = Data.get(a), Data.get(b)
    if not pa or not pb then TradeService.cancel(a) return end
    if not inTradeZone(a) or not inTradeZone(b) then
        notify(a, "Trade cancelled — someone left the trade zone.", "warn")
        notify(b, "Trade cancelled — someone left the trade zone.", "warn")
        TradeService.cancel(a)
        return
    end

    -- Validate both sides fully BEFORE mutating anything.
    local moveA, moveB = {}, {}
    for _, id in ipairs(session.offers[a.UserId]) do
        local g = goobById(pa, id)
        if not g then TradeService.cancel(a) return end
        table.insert(moveA, g)
    end
    for _, id in ipairs(session.offers[b.UserId]) do
        local g = goobById(pb, id)
        if not g then TradeService.cancel(a) return end
        table.insert(moveB, g)
    end
    if #moveA == 0 and #moveB == 0 then return end
    if #pa.goobs - #moveA + #moveB < 1 then TradeService.cancel(a) return end
    if #pb.goobs - #moveB + #moveA < 1 then TradeService.cancel(a) return end

    local function remove(profile, goob)
        for i, g in ipairs(profile.goobs) do
            if g.id == goob.id then table.remove(profile.goobs, i) return end
        end
    end

    for _, g in ipairs(moveA) do remove(pa, g); table.insert(pb.goobs, g) end
    for _, g in ipairs(moveB) do remove(pb, g); table.insert(pa.goobs, g) end

    -- If either player traded away the Goob they had on display, promote
    -- another one so their plot is never empty.
    if not goobById(pa, pa.activeGoobId or "") then pa.activeGoobId = pa.goobs[1].id end
    if not goobById(pb, pb.activeGoobId or "") then pb.activeGoobId = pb.goobs[1].id end

    pa.stats.trades += 1
    pb.stats.trades += 1

    session.open = false
    sessionOf[a.UserId] = nil
    sessionOf[b.UserId] = nil

    GoobService.spawnFor(a)
    GoobService.spawnFor(b)
    Data.save(a); Data.save(b)

    notify(a, "✅ Trade complete!", "good")
    notify(b, "✅ Trade complete!", "good")
    sync(session)
end

function TradeService.cancel(player: Player)
    local session = sessionOf[player.UserId]
    if not session then return end
    session.open = false
    sessionOf[session.a.UserId] = nil
    sessionOf[session.b.UserId] = nil
    sync(session)
    notify(session.a, "Trade cancelled.", "warn")
    notify(session.b, "Trade cancelled.", "warn")
end

function TradeService.cleanup(player: Player)
    pending[player.UserId] = nil
    for id, requester in pairs(pending) do
        if requester == player.UserId then pending[id] = nil end
    end
    TradeService.cancel(player)
end

return TradeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- WorldBuilder.luau — one island, generated at runtime from code.
--
-- WHY FROM CODE: a .rbxl is an opaque binary. Built from code, the whole game —
-- world included — is plain text in git: reviewable in a diff, mergeable
-- between two people, restorable after a bad save.
--
-- WHY ONE ISLAND: the previous map was four zones and a hub, and it was four
-- times the surface area with a quarter of the players on each. An arena game
-- needs density — the whole design rests on you constantly being able to see
-- somebody bigger and somebody smaller — so everything is now on one 300-stud
-- island and the four zones are gone as PLACES.
--
-- They are not gone as IDEAS. Each one survives as a patch on the island:
--
--   THE SLICK      near-frictionless. Fast lines, no brakes. Pellets x1.15.
--   THE SCRAPYARD  ramps and cover. Broken sightlines, the place to hide.
--   THE BASIN      sunken, richest pellets, one way in and out. x1.55.
--
-- That keeps every bit of terrain character the zones had, costs one map
-- instead of four, and leaves the server undivided.
--
-- WHAT IS NOT BUILT HERE: most of the island's shape. Lumps — the congealed
-- shells of popped blobs — are terrain, and they accumulate for the life of a
-- server. Two hours in, the interesting geometry is all player-made. That is
-- the design working as intended, not a gap.


local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Config = require(game.ReplicatedStorage.GoobShared.Config)
local Pit = require(game.ReplicatedStorage.GoobShared.Pit)

local WorldBuilder = {}

-- Three rings, concentric, on one disc. Everything else is a patch on top.
WorldBuilder.RINGS = {
    VAULT    = { name = "The Vault",    inner = 0,   outer = Config.VAULT_RADIUS },
    FLATS    = { name = "The Flats",    inner = Config.VAULT_RADIUS, outer = Config.SHALLOWS_INNER },
    SHALLOWS = { name = "The Shallows", inner = Config.SHALLOWS_INNER, outer = Config.ISLAND_RADIUS },
}

-- Kept so that anything still asking "where is the middle of the world" gets a
-- sensible answer. There is exactly one place now, so this is a constant.
WorldBuilder.ZONES = {
    ISLAND = { name = "The Island", centre = Vector3.new(0, 0, 0), radius = Config.ISLAND_RADIUS },
}

-- ── OBSTACLES, AND WHY BOTS WALKED THROUGH THEM ───────────────────────────
--
-- Bot movement is kinematic: a position integrated by hand, not a physics
-- body. That is the right call — twelve unanchored balls network-owned by the
-- server is a real cost, and a bot does not need momentum to be convincing —
-- but it has one consequence nobody accounted for. A kinematic body is not in
-- the physics world, so `CanCollide` on a rock means nothing to it. Bots
-- walked through every boulder, ramp and signpost on the island, which is the
-- single most obvious way a thing announces that it is not a player.
--
-- The fix is a list. Every solid, standing prop registers its footprint here
-- as a circle, and BotService resolves against it. A circle rather than the
-- real shape because it is one distance test, the props are all roughly round
-- in plan, and being twenty percent too generous costs a bot a slightly wider
-- berth — where being wrong the other way costs the illusion.
WorldBuilder.OBSTACLES = {} :: { { pos: Vector3, radius: number } }

-- A PROP IS SMALL. Anything huge is ground.
--
-- The first version filtered only on height — "flat things are floors" — and
-- the island disc is SIX studs thick, which is not flat. So the island itself
-- registered as a 480-stud obstacle centred on the origin, and every bot was
-- shoved to the shoreline on the first tick of every round. Nothing errored;
-- the bots simply stopped being anywhere near the game, and four separate
-- assertions failed with symptoms that pointed at eating, at SLAM and at
-- tethers rather than at this.
--
-- Two gates now, and the upper one is the load-bearing one: a thing you walk
-- around is a rock or a ramp or a signpost, and none of those are sixty studs
-- wide. Anything bigger is terrain the bot is meant to be standing on.
local OBSTACLE_MIN_RADIUS = 2
local OBSTACLE_MAX_RADIUS = 60
local OBSTACLE_MIN_HEIGHT = 6

local function noteObstacle(p: BasePart)
    -- Flat things are floors, not walls. A bot standing ON something is fine;
    -- it is standing IN something that looks wrong.
    if p.Size.Y < OBSTACLE_MIN_HEIGHT then
        return
    end
    -- Radius from the wider footprint axis, so a long ramp is covered along
    -- its length rather than only at its centre.
    local r = math.max(p.Size.X, p.Size.Z) * 0.5
    if r < OBSTACLE_MIN_RADIUS or r > OBSTACLE_MAX_RADIUS then
        return
    end
    table.insert(WorldBuilder.OBSTACLES, { pos = p.Position, radius = r })
end

local function part(props: { [string]: any }): BasePart
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = true
    p.Material = Enum.Material.SmoothPlastic
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    for k, v in pairs(props) do (p :: any)[k] = v end
    -- Registered from the ONE constructor every prop goes through, rather than
    -- from a list maintained by hand. A hand-maintained list is a list that is
    -- missing whatever was added last.
    if p.CanCollide then
        noteObstacle(p)
    end
    return p
end

local function wedge(props: { [string]: any }): BasePart
    local p = Instance.new("WedgePart")
    p.Anchored = true
    p.CanCollide = true
    p.Material = Enum.Material.SmoothPlastic
    for k, v in pairs(props) do (p :: any)[k] = v end
    if p.CanCollide then
        noteObstacle(p)
    end
    return p
end

-- A big floating icon + label. The old map told you nothing about what anything
-- was; a nine-year-old should be able to read the whole world at a glance.
local function signpost(parent: Instance, position: Vector3, icon: string, title: string,
                        subtitle: string?, tint: Color3?)
    local post = part({
        Name = "Sign_" .. title,
        Size = Vector3.new(2, 14, 2),
        Position = position + Vector3.new(0, 7, 0),
        Color = Color3.fromRGB(70, 62, 58),
        Material = Enum.Material.Wood,
    })
    post.Parent = parent

    local board = part({
        Name = "Board",
        Size = Vector3.new(0.6, 0.6, 0.6),
        Position = position + Vector3.new(0, 16, 0),
        Transparency = 1,
        CanCollide = false,
    })
    board.Parent = post

    local gui = Instance.new("BillboardGui")
    gui.Size = UDim2.fromScale(22, 11)
    gui.AlwaysOnTop = false
    gui.MaxDistance = 700
    gui.Parent = board

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(44, 46, 50)
    frame.BackgroundTransparency = 0.1
    frame.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 18)
    corner.Parent = frame
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 3
    stroke.Color = tint or Color3.fromRGB(198, 174, 118)
    stroke.Parent = frame

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.fromScale(1, 0.5)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Font = Enum.Font.FredokaOne
    iconLabel.TextScaled = true
    iconLabel.Text = icon
    iconLabel.Parent = frame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Position = UDim2.fromScale(0, 0.48)
    titleLabel.Size = UDim2.fromScale(1, 0.3)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.FredokaOne
    titleLabel.TextScaled = true
    titleLabel.TextColor3 = tint or Color3.fromRGB(198, 174, 118)
    titleLabel.Text = title
    titleLabel.Parent = frame

    if subtitle then
        local sub = Instance.new("TextLabel")
        sub.Position = UDim2.fromScale(0.05, 0.76)
        sub.Size = UDim2.fromScale(0.9, 0.2)
        sub.BackgroundTransparency = 1
        sub.Font = Enum.Font.FredokaOne
        sub.TextScaled = true
        sub.TextColor3 = Color3.fromRGB(176, 178, 176)
        sub.Text = subtitle
        sub.Parent = frame
    end
    return post
end
WorldBuilder.signpost = signpost

-- A ramp you can hit at speed. Angle is gentle on purpose: steep ramps stop a
-- heavy Goob dead, which punishes exactly the players who earned their mass.
local function ramp(parent: Instance, position: Vector3, size: Vector3, yaw: number, color: Color3)
    local w = wedge({
        Name = "Ramp",
        Size = size,
        CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(yaw), 0),
        Color = color,
        Material = Enum.Material.Metal,
    })
    w.Parent = parent
    return w
end

local function disc(parent: Instance, centre: Vector3, radius: number, thickness: number,
                    color: Color3, material: Enum.Material, name: string): BasePart
    local d = part({
        Name = name,
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(thickness, radius * 2, radius * 2),
        CFrame = CFrame.new(centre) * CFrame.Angles(0, 0, math.rad(90)),
        Color = color,
        Material = material,
    })
    d.Parent = parent
    return d
end

WorldBuilder.plots = {} :: { { index: number, center: Vector3, owner: Player? } }

local function buildAmbience()
    Lighting.Ambient = Color3.fromRGB(126, 126, 128)
    Lighting.OutdoorAmbient = Color3.fromRGB(138, 142, 150)
    Lighting.Brightness = 2.0
    Lighting.ClockTime = 16.4
    Lighting.GeographicLatitude = 14
    Lighting.FogEnd = 2200
    Lighting.FogColor = Color3.fromRGB(196, 202, 200)
    Lighting.EnvironmentDiffuseScale = 0.45

    local atmo = Instance.new("Atmosphere")
    atmo.Density = 0.28
    atmo.Haze = 1.1
    atmo.Glare = 0.05
    atmo.Color = Color3.fromRGB(212, 214, 210)
    atmo.Decay = Color3.fromRGB(158, 166, 168)
    atmo.Parent = Lighting

    local bloom = Instance.new("BloomEffect")
    bloom.Intensity = 0.22
    bloom.Threshold = 0.95
    bloom.Size = 16
    bloom.Parent = Lighting

    local sky = Instance.new("Sky")
    sky.Name = "GoobSky"
    sky.Parent = Lighting

    local clouds = Instance.new("Clouds")
    clouds.Cover = 0.36
    clouds.Density = 0.42
    clouds.Color = Color3.fromRGB(238, 238, 236)
    clouds.Parent = Workspace.Terrain
end


-- ── Construction ───────────────────────────────────────────────────────────

-- Scatter props in a ring, skipping anything too near a landmark. Used for
-- every piece of set dressing, because "a bit of variety, but never in the
-- way" is the same problem every time.
local function scatter(world: Instance, count: number, inner: number, outer: number,
                       rng: Random, make: (Vector3, number) -> ())
    for i = 1, count do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = math.sqrt(rng:NextNumber(inner * inner, outer * outer))
        local pos = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
        -- Never inside the Vault approach, and NEVER within reach of a spawn
        -- point. A rock placed on a spawn is a player who materialises inside
        -- it and cannot move, which is exactly what happened in the first
        -- play-test: the scatter band ran 407-466 and the spawns sat at 438.
        local clear = pos.Magnitude > Config.VAULT_RADIUS + 60
        if clear then
            for k = 1, Config.SPAWN_POINTS do
                local a = math.rad(k * (360 / Config.SPAWN_POINTS))
                local spawnAt = Vector3.new(
                    math.cos(a) * Config.SPAWN_RING, 0, math.sin(a) * Config.SPAWN_RING)
                if (pos - spawnAt).Magnitude < Config.SPAWN_CLEARANCE then
                    clear = false
                    break
                end
            end
        end
        if clear then
            make(pos, i)
        end
    end
end


-- The lobby platform. Between rounds everyone stands here: nothing can eat
-- anybody, the shops are open, and the boards are somewhere people are
-- actually still enough to read them.
-- A readable standing board: a slab with a big text panel on the front. Every
-- board in the world is one of these, so "where does information live" has a
-- single answer instead of several bespoke props.
--
-- DECLARED ABOVE buildLobby, which uses it. This helper was accidentally
-- deleted along with the Shack when that block was cut out, and the result was
-- not a compile error — `board(...)` simply became a call to a nil GLOBAL and
-- the server died on boot. Same trap, fourth time.
-- IT TAKES A POINT TO LOOK AT, NOT AN ANGLE.
--
-- It used to take a yaw in degrees, and both boards in the waiting room were
-- given one that pointed their text AWAY from the floor players stand on — you
-- walked up to two blank slate slabs and read the leaderboard by walking off
-- the edge behind them. That is the bug reported as "the leaderboards are on
-- the wrong way", and it was not a typo so much as an interface that made the
-- mistake easy: nothing about the number 24 says which way a face ends up
-- pointing, so the only way to get it right was to build it and look.
--
-- `lookAt` makes it impossible to state wrongly. CFrame.lookAt aims a part's
-- -Z at the target, and SurfaceGui's Front face IS -Z, so a board built to
-- look at the middle of the room has its text facing the middle of the room,
-- by construction rather than by arithmetic.
local function board(parent: Instance, name: string, position: Vector3, lookAt: Vector3,
                    size: Vector2, tint: Color3)
    -- Levelled: lookAt with a target at a different height would tip the slab
    -- back, and a leaderboard leaning over the room reads as damaged.
    local target = Vector3.new(lookAt.X, position.Y, lookAt.Z)
    local slab = part({
        Name = name,
        Size = Vector3.new(size.X, size.Y, 3),
        CFrame = CFrame.lookAt(position, target),
        Color = Color3.fromRGB(24, 24, 27),
        Material = Enum.Material.Slate,
    })
    slab.Parent = parent

    local surface = Instance.new("SurfaceGui")
    surface.Name = "Board"
    surface.Face = Enum.NormalId.Front
    surface.CanvasSize = Vector2.new(size.X * 26, size.Y * 26)
    surface.LightInfluence = 0
    surface.Parent = slab

    local pad = Instance.new("Frame")
    pad.Size = UDim2.fromScale(1, 1)
    pad.BackgroundColor3 = Color3.fromRGB(14, 14, 16)
    pad.BorderSizePixel = 0
    pad.ZIndex = 1
    pad.Parent = surface
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 6
    stroke.Color = tint
    stroke.Parent = pad

    local entries = Instance.new("TextLabel")
    entries.Name = "Entries"
    entries.Position = UDim2.fromScale(0.05, 0.05)
    entries.Size = UDim2.fromScale(0.9, 0.9)
    entries.BackgroundTransparency = 1
    entries.Font = Enum.Font.FredokaOne
    entries.TextSize = 34
    entries.TextWrapped = true
    entries.TextXAlignment = Enum.TextXAlignment.Left
    entries.TextYAlignment = Enum.TextYAlignment.Top
    entries.TextColor3 = Color3.fromRGB(242, 242, 244)
    -- Set here, not at first refresh: a TextLabel's default Text is the
    -- literal string "Label", and an empty board reading "Label" in half-metre
    -- letters is how that bug shipped once already.
    entries.Text = name .. "\nloading…"
    -- Parented to the SurfaceGui, NOT the backing frame: every consumer looks
    -- it up as Board -> Entries, and burying it deeper is a WaitForChild that
    -- never returns.
    entries.ZIndex = 2
    entries.Parent = surface

    return slab
end

-- ── THE WAITING ROOM ──────────────────────────────────────────────────────
--
-- Thirty-five seconds between rounds, spent somewhere nothing can eat you.
-- It used to be a grey disc, a rail, and two boards facing the wrong way, and
-- it read as a holding pen — which is a waste of the one moment in the loop
-- where the player is standing still and willing to look at something.
--
-- MONOCHROME, BY RULE. Black, grey and white, the same palette as the
-- interface, and for the same reason: the blobs are the only saturated things
-- in this game, and everything else being greyscale is what makes a neon skin
-- land. A player walking in wearing Ultraviolet should be the brightest thing
-- in the room by a mile.
--
-- Built out of a few shapes repeated with rhythm rather than a lot of
-- different props: concentric rings, a ribbed colonnade, a stepped dais, and
-- floor bands that point at the middle. Repetition with variation is what
-- reads as designed; a scatter of unrelated objects reads as clutter, and I
-- am not going to out-detail a real artist so the answer is to out-order one.
local function buildLobby(world: Instance)
    local c = Config.LOBBY_CENTRE
    local R = Config.LOBBY_RADIUS

    local floor = disc(world, c, R, 6,
        Color3.fromRGB(26, 26, 29), Enum.Material.Concrete, "LobbyFloor")
    floor.Name = "LobbyFloor"

    -- Two inlaid rings, lighter toward the middle, so the eye is walked
    -- inward to the dais instead of out to the rail.
    local ring1 = disc(world, c + Vector3.new(0, 3.2, 0), R - 16, 1,
        Color3.fromRGB(38, 38, 42), Enum.Material.Marble, "LobbyRingOuter")
    ring1.CanCollide = false
    local ring2 = disc(world, c + Vector3.new(0, 3.4, 0), R - 52, 1,
        Color3.fromRGB(52, 52, 57), Enum.Material.Marble, "LobbyRingInner")
    ring2.CanCollide = false

    -- Floor bands radiating from the centre. Thin, white, and flush — the
    -- cheapest possible thing that makes a flat disc look composed.
    for i = 0, 23 do
        local a = math.rad(i * 15)
        local bandLen = R - 20
        local band = part({
            Name = "LobbyBand",
            Size = Vector3.new(1.6, 0.4, bandLen),
            CFrame = CFrame.new(c + Vector3.new(
                math.cos(a) * (bandLen / 2 + 14), 3.6, math.sin(a) * (bandLen / 2 + 14)))
                * CFrame.Angles(0, -a + math.pi / 2, 0),
            Color = Color3.fromRGB(86, 86, 92),
            Material = Enum.Material.Neon,
        })
        band.CanCollide = false
        band.Parent = world
    end

    -- A stepped dais in the middle. Somewhere to stand, something to orbit,
    -- and the thing the floor bands point at.
    for step = 1, 3 do
        local d = disc(world, c + Vector3.new(0, 3.6 + (step - 1) * 2.4, 0),
            34 - (step - 1) * 9, 2.4,
            Color3.fromRGB(30 + step * 10, 30 + step * 10, 34 + step * 10),
            Enum.Material.Concrete, "Dais" .. step)
        d.CanCollide = false
    end

    -- A colonnade: tall ribs around the inner ring, alternating heights so the
    -- silhouette has a rhythm instead of a fence's flat line.
    for i = 0, 17 do
        local a = math.rad(i * 20)
        local tall = (i % 2 == 0)
        local h = tall and 46 or 30
        local rib = part({
            Name = "LobbyRib",
            Size = Vector3.new(5, h, 5),
            CFrame = CFrame.new(c + Vector3.new(
                math.cos(a) * (R - 34), 4 + h / 2, math.sin(a) * (R - 34)))
                * CFrame.Angles(0, -a, 0),
            Color = tall and Color3.fromRGB(18, 18, 21) or Color3.fromRGB(46, 46, 51),
            Material = Enum.Material.Slate,
        })
        rib.CanCollide = false
        rib.Parent = world

        -- A white cap on the tall ones. One bright accent per rib, at the same
        -- height all the way round, is what turns a ring of posts into a room.
        if tall then
            local cap = part({
                Name = "LobbyRibCap",
                Size = Vector3.new(6.5, 1.2, 6.5),
                CFrame = CFrame.new(c + Vector3.new(
                    math.cos(a) * (R - 34), 4 + h + 0.6, math.sin(a) * (R - 34))),
                Color = Color3.fromRGB(236, 236, 240),
                Material = Enum.Material.Neon,
            })
            cap.CanCollide = false
            cap.Parent = world
        end
    end

    -- The rail. Falling off a lobby while waiting for a round is pure
    -- frustration: nothing is gained by making this floor dangerous.
    for i = 0, 47 do
        local a = math.rad(i * 7.5)
        local post = part({
            Name = "LobbyRail",
            Size = Vector3.new(7, 11, 4),
            CFrame = CFrame.new(c + Vector3.new(
                math.cos(a) * (R + 2), 6, math.sin(a) * (R + 2)))
                * CFrame.Angles(0, -a, 0),
            Color = Color3.fromRGB(16, 16, 19),
            Material = Enum.Material.Metal,
        })
        post.Parent = world
    end

    -- ── The boards ────────────────────────────────────────────────────────
    --
    -- Flanking the dais and FACING IT — which is to say, facing the middle of
    -- the floor, where players actually stand. They are given a point to look
    -- at rather than an angle, because the previous pair were given angles and
    -- both ended up pointing their text off the edge of the world.
    local eye = c + Vector3.new(0, 22, 0)
    board(world, "Leaderboard", c + Vector3.new(-64, 22, -46), eye,
        Vector2.new(52, 30), Color3.fromRGB(236, 236, 240))
    board(world, "Archive", c + Vector3.new(64, 22, -46), eye,
        Vector2.new(52, 30), Color3.fromRGB(236, 236, 240))

    signpost(world, c + Vector3.new(0, 12, 26), "\u{1F6CB}\u{FE0F}", "THE WAITING ROOM",
        "trade, dress up, pick your third power", Color3.fromRGB(236, 236, 240))
end

function WorldBuilder.build()
    -- Rebuilt from scratch, not appended to. The harness boots the world more
    -- than once in a single process and a growing obstacle list would make
    -- bots progressively more claustrophobic across a test run.
    table.clear(WorldBuilder.OBSTACLES)
    buildAmbience()

    local rng = Random.new(20260913)

    local world = Instance.new("Folder")
    world.Name = "GoobWorld"
    world.Parent = Workspace

    -- ── THE SEA ────────────────────────────────────────────────────────────
    -- Not decoration: it is the floor under everything, so that no bug, no
    -- knockback and no Slam can ever drop a player out of the world. An arena
    -- game with a hole in it loses players to the hole.
    local sea = part({
        Name = "Sea",
        Size = Vector3.new(6000, 8, 6000),
        Position = Vector3.new(0, -34, 0),
        Color = Color3.fromRGB(96, 122, 128),
        Material = Enum.Material.Glass,
        Transparency = 0.42,
        Reflectance = 0.25,
    })
    sea.Parent = world

    -- ── THE ISLAND ─────────────────────────────────────────────────────────
    -- CONCRETE, NOT GRASS. A field reads as somewhere nothing happens; a poured
    -- floor reads as somewhere built for the thing you are about to do. It
    -- also gives the painted markings below something to sit on, which is what
    -- actually makes a flat plane look designed rather than empty.
    local island = disc(world, Vector3.new(0, -3, 0), Config.ISLAND_RADIUS, 10,
        Color3.fromRGB(118, 120, 126), Enum.Material.Concrete, "Island")
    island.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.4, 0.35, 1, 1)

    -- A skirt below the island so it reads as land sitting IN water rather
    -- than a coin floating above it. Purely visual; no collision.
    local skirt = disc(world, Vector3.new(0, -18, 0), Config.ISLAND_RADIUS - 22, 26,
        Color3.fromRGB(104, 96, 84), Enum.Material.Rock, "Skirt")
    skirt.CanCollide = false

    -- The Shallows read as a distinct rim rather than a line on a map, because
    -- "am I safe right now" has to be answerable at a glance while being
    -- chased. Sand, a shade lighter, very slightly lower.
    local shallows = disc(world, Vector3.new(0, -2.2, 0), Config.ISLAND_RADIUS, 1.4,
        Color3.fromRGB(168, 166, 158), Enum.Material.Pavement, "Shallows")
    shallows.CanCollide = false

    -- A wet band where the sand meets the water. One extra disc, and it is the
    -- difference between an island and a cylinder.
    local surf = disc(world, Vector3.new(0, -2.0, 0), Config.ISLAND_RADIUS + 16, 1.0,
        Color3.fromRGB(126, 146, 150), Enum.Material.Slate, "Surf")
    surf.CanCollide = false
    surf.Transparency = 0.25

    -- The contested ground is a shade darker than the safe rim, so "am I in the
    -- danger zone" is answerable from the floor colour alone at any speed.
    local flats = disc(world, Vector3.new(0, -1.6, 0), Config.SHALLOWS_INNER, 1.4,
        Color3.fromRGB(96, 100, 108), Enum.Material.Asphalt, "Flats")
    flats.CanCollide = false

    -- The boundary between safe and not safe is a LINE YOU CAN SEE. It was a
    -- colour change before, which is invisible at speed while something is
    -- chasing you — and "am I safe" is the most urgent question in the game.
    local edge = disc(world, Vector3.new(0, -1.2, 0), Config.SHALLOWS_INNER + 3, 1.2,
        Color3.fromRGB(206, 186, 132), Enum.Material.Neon, "SafeLine")
    edge.CanCollide = false
    edge.Transparency = 0.45

    -- ── THE VAULT ──────────────────────────────────────────────────────────
    -- Raised, central, and visible from the whole island on purpose: a player
    -- must always be able to see where their mass is safe, and everyone else
    -- must always be able to see who is running for it. On a 480-stud island
    -- that means it has to be tall enough to read from the rim, so it is a
    -- structure now rather than a step.
    local vaultBase = disc(world, Vector3.new(0, Config.VAULT_HEIGHT / 2 - 1, 0),
        Config.VAULT_RADIUS + 14, Config.VAULT_HEIGHT + 2,
        Color3.fromRGB(116, 110, 102), Enum.Material.Concrete, "VaultBase")
    vaultBase.Name = "VaultBase"

    local dish = disc(world, Vector3.new(0, Config.VAULT_HEIGHT, 0), Config.VAULT_RADIUS, 1.6,
        Color3.fromRGB(180, 160, 116), Enum.Material.Foil, "VaultDish")
    local vaultTag = Instance.new("StringValue")
    vaultTag.Name = "VaultMarker"
    vaultTag.Parent = dish

    -- Eight pillars and a floating cap. This is the landmark the entire map
    -- orients on, so it is the one thing allowed to be tall.
    for i = 0, 7 do
        local a = math.rad(i * 45)
        local pillar = part({
            Name = "VaultPillar",
            Size = Vector3.new(7, 58, 7),
            Position = Vector3.new(math.cos(a) * (Config.VAULT_RADIUS - 5), 30,
                                   math.sin(a) * (Config.VAULT_RADIUS - 5)),
            Color = Color3.fromRGB(138, 130, 118),
            Material = Enum.Material.Marble,
        })
        pillar.CanCollide = false   -- never a wall between a player and banking
        pillar.Parent = world
    end

    local cap = disc(world, Vector3.new(0, 62, 0), Config.VAULT_RADIUS + 6, 5,
        Color3.fromRGB(152, 142, 128), Enum.Material.Marble, "VaultCap")
    cap.CanCollide = false

    -- A beacon, so the Vault is findable from the rim and from inside the
    -- Basin, which is the one place on the island you cannot see out of.
    local beacon = part({
        Name = "VaultBeacon",
        Shape = Enum.PartType.Ball,
        Size = Vector3.new(16, 16, 16),
        Position = Vector3.new(0, 76, 0),
        Color = Color3.fromRGB(206, 184, 126),
        Material = Enum.Material.Neon,
        Transparency = 0.25,
        CanCollide = false,
    })
    beacon.Parent = world
    local glow = Instance.new("PointLight")
    glow.Brightness = 2.4
    glow.Range = 160
    glow.Color = Color3.fromRGB(224, 200, 140)
    glow.Parent = beacon

    -- Four ramps, one per approach. A heavy blob cannot climb a step, and the
    -- Vault has to be reachable at exactly the moment you are heaviest.
    for i = 0, 3 do
        local a = math.rad(i * 90 + 45)
        local dir = Vector3.new(math.cos(a), 0, math.sin(a))
        ramp(world, dir * (Config.VAULT_RADIUS + 30) + Vector3.new(0, Config.VAULT_HEIGHT / 2 - 1, 0),
            Vector3.new(44, Config.VAULT_HEIGHT + 2, 44), math.deg(a) + 90,
            Color3.fromRGB(126, 120, 110))
    end

    signpost(world, Vector3.new(0, Config.VAULT_HEIGHT, -(Config.VAULT_RADIUS + 26)),
        "🏦", "THE VAULT", "roll in and hold still", Color3.fromRGB(198, 174, 118))

    -- ── THE PATCHES ────────────────────────────────────────────────────────
    -- Data-driven over Config.BIOMES. The previous version indexed [1], [2]
    -- and [3] by hand, so adding a fourth biome to the config built four
    -- signposts and three patches — a zone you could read about and never
    -- stand on.
    local LOOK = {
        slick = { tint = Color3.fromRGB(150, 168, 178), mat = Enum.Material.Ice,          icon = "🧊" },
        scrap = { tint = Color3.fromRGB(134, 124, 112), mat = Enum.Material.CorrodedMetal,icon = "🔩" },
        basin = { tint = Color3.fromRGB(100, 116, 108), mat = Enum.Material.Mud,          icon = "🕳️" },
        bloom = { tint = Color3.fromRGB(146, 162, 126), mat = Enum.Material.LeafyGrass,   icon = "🌾" },
        ash   = { tint = Color3.fromRGB(122, 116, 116), mat = Enum.Material.Basalt,       icon = "🌋" },
    }

    for _, biome in ipairs(Config.BIOMES) do
        local look = LOOK[biome.id] or { tint = Color3.fromRGB(140, 140, 140),
            mat = Enum.Material.Sand, icon = "•" }
        local sunken = biome.centre.Y < 0
        -- `ground`, not `surface`: apicheck tracks instance classes by variable
        -- name across the file, and board() already binds `surface` to a
        -- SurfaceGui.
        local ground = disc(world, biome.centre + Vector3.new(0, sunken and 0 or 0.35, 0),
            biome.radius, sunken and 1.6 or 1.2, look.tint, look.mat, "Biome_" .. biome.id)
        ground.CustomPhysicalProperties =
            PhysicalProperties.new(0.7, biome.friction, 0.35, 1, 1)
        local tag = Instance.new("StringValue")
        tag.Name = "BiomeId"
        tag.Value = biome.id
        tag.Parent = ground

        signpost(world, biome.centre + Vector3.new(0, sunken and 8 or 0, biome.radius + 16),
            look.icon, biome.name, ("pellets x%.2f"):format(biome.pelletMult),
            Color3.fromRGB(158, 166, 172))
    end

    -- The Basin is the only patch with real elevation. From inside it you
    -- cannot see who is coming, and leaving while heavy is genuinely slow.
    -- That is what the x1.55 pellets are paying for.
    local basin = Config.BIOMES[3]
    for i = 0, 15 do
        local a = math.rad(i * 22.5)
        -- One gap in the wall, north. A basin you cannot leave is a trap, and
        -- a trap is not a risk-reward decision.
        if i ~= 0 and i ~= 15 then
            local w = part({
                Name = "BasinWall",
                Size = Vector3.new(28, 15, 10),
                CFrame = CFrame.new(basin.centre + Vector3.new(
                    math.cos(a) * (basin.radius + 3), 6, math.sin(a) * (basin.radius + 3)))
                    * CFrame.Angles(0, -a, 0),
                Color = Color3.fromRGB(112, 106, 94),
                Material = Enum.Material.Rock,
            })
            w.Parent = world
        end
    end
    ramp(world, basin.centre + Vector3.new(0, 0, -(basin.radius + 20)),
        Vector3.new(44, 14, 42), 180, Color3.fromRGB(120, 114, 102))

    -- Scrapyard furniture: cover, ramps, broken sightlines. Hiding has to be
    -- possible or the smallest blob on the island has no play except running
    -- in a straight line.
    local scrap = Config.BIOMES[2]
    for i = 0, 13 do
        local a = math.rad(i * 26 + 12)
        local r = scrap.radius * (0.3 + (i % 4) * 0.18)
        local pos = scrap.centre + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
        if i % 3 == 0 then
            ramp(world, pos + Vector3.new(0, 4, 0), Vector3.new(26, 9, 32),
                math.deg(a), Color3.fromRGB(130, 122, 110))
        else
            local block = part({
                Name = "Scrap",
                Size = Vector3.new(14 + (i % 5) * 5, 12 + (i % 3) * 8, 11 + (i % 4) * 5),
                CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)) * CFrame.Angles(0, a, 0),
                Color = Color3.fromRGB(118, 110, 102),
                Material = Enum.Material.CorrodedMetal,
            })
            block.Parent = world
        end
    end

    -- Ashfield: open ground with tall thin spires. They break a sniper's line
    -- without giving anyone a place to sit, which is why the Ashfield is the
    -- most dangerous good ground on the island.
    local ash = Config.BIOMES[5]
    for i = 0, 8 do
        local a = math.rad(i * 40 + 7)
        local r = ash.radius * (0.25 + (i % 3) * 0.25)
        local spire = part({
            Name = "Spire",
            Size = Vector3.new(6 + (i % 3) * 3, 34 + (i % 4) * 14, 6 + (i % 3) * 3),
            CFrame = CFrame.new(ash.centre
                + Vector3.new(math.cos(a) * r, 18, math.sin(a) * r))
                * CFrame.Angles(0, a, math.rad((i % 3) * 4 - 4)),
            Color = Color3.fromRGB(104, 100, 100),
            Material = Enum.Material.Basalt,
        })
        spire.Parent = world
    end

    -- Bloom: soft cover you can roll straight through. Visual variety that
    -- never becomes a wall, which is the whole brief for decoration in a game
    -- about momentum.
    local bloom = Config.BIOMES[4]
    for i = 1, 26 do
        local a = rng:NextNumber(0, math.pi * 2)
        local r = math.sqrt(rng:NextNumber(0, bloom.radius * bloom.radius))
        local tuft = part({
            Name = "Bloom",
            Shape = Enum.PartType.Ball,
            Size = Vector3.new(1, 1, 1) * rng:NextNumber(7, 16),
            Position = bloom.centre + Vector3.new(math.cos(a) * r, 3, math.sin(a) * r),
            Color = Color3.fromRGB(158, 172, 132),
            Material = Enum.Material.LeafyGrass,
            Transparency = 0.15,
        })
        tuft.CanCollide = false
        tuft.Parent = world
    end

    -- ── MARKINGS ───────────────────────────────────────────────────────────
    -- Painted rings on the floor. They cost nothing, they collide with nothing,
    -- and they are most of the difference between "a flat plane" and "a place":
    -- they give the eye something to measure distance and speed against, which
    -- a featureless floor cannot do at any resolution.
    for _, ring in ipairs({
        { r = 120, w = 2.5, c = Color3.fromRGB(176, 168, 132) },
        { r = 200, w = 2.0, c = Color3.fromRGB(150, 154, 160) },
        { r = 290, w = 2.0, c = Color3.fromRGB(150, 154, 160) },
    }) do
        local outer = disc(world, Vector3.new(0, -1.0, 0), ring.r, 0.6,
            ring.c, Enum.Material.SmoothPlastic, "Marking")
        outer.CanCollide = false
        outer.Transparency = 0.25
        local inner = disc(world, Vector3.new(0, -0.9, 0), ring.r - ring.w, 0.7,
            Color3.fromRGB(96, 100, 108), Enum.Material.Asphalt, "MarkingCut")
        inner.CanCollide = false
    end

    -- Spokes out from the middle, so the plaza reads as a hub.
    for i = 0, 7 do
        local a = math.rad(i * 45)
        local lane = part({
            Name = "Marking",
            Size = Vector3.new(5, 0.6, 220),
            CFrame = CFrame.new(Vector3.new(math.cos(a) * 180, -1.0, math.sin(a) * 180))
                * CFrame.Angles(0, -a + math.pi / 2, 0),
            Color = Color3.fromRGB(142, 146, 152),
            Material = Enum.Material.SmoothPlastic,
            Transparency = 0.35,
        })
        lane.CanCollide = false
        lane.Parent = world
    end

    -- ── STRUCTURES ─────────────────────────────────────────────────────────
    -- Places, not decoration. Every one of these is something a blob can use:
    -- climb it, hide behind it, drop off it, or lose a pursuer around it. An
    -- arena with nothing in it is a running track.
    local function plinth(at: Vector3, w: number, h: number, tint: Color3)
        local base = part({
            Name = "Plinth",
            Size = Vector3.new(w, h, w),
            Position = at + Vector3.new(0, h / 2 - 1, 0),
            Color = tint,
            Material = Enum.Material.Concrete,
        })
        base.Parent = world
        local cap = part({
            Name = "PlinthCap",
            Size = Vector3.new(w + 4, 1.2, w + 4),
            Position = at + Vector3.new(0, h - 1, 0),
            Color = Color3.fromRGB(154, 150, 140),
            Material = Enum.Material.Marble,
        })
        cap.Parent = world
        -- A ramp on one side, or it is a wall rather than a place.
        ramp(world, at + Vector3.new(0, h / 2 - 1, w / 2 + h * 0.9),
            Vector3.new(w * 0.8, h, h * 1.8), 0, tint)
    end

    -- Four raised platforms on the inner ring, and four taller ones further
    -- out, so there is always something to break line of sight.
    for i = 0, 3 do
        local a = math.rad(i * 90 + 45)
        plinth(Vector3.new(math.cos(a) * 150, 0, math.sin(a) * 150), 46, 16,
            Color3.fromRGB(112, 114, 120))
    end
    for i = 0, 3 do
        local a = math.rad(i * 90)
        plinth(Vector3.new(math.cos(a) * 268, 0, math.sin(a) * 268), 58, 26,
            Color3.fromRGB(104, 106, 112))
    end

    -- Pipe arches you can roll under. Cover that does not become a dead end.
    for i = 0, 5 do
        local a = math.rad(i * 60 + 30)
        local at = Vector3.new(math.cos(a) * 215, 0, math.sin(a) * 215)
        for side = -1, 1, 2 do
            local leg = part({
                Name = "ArchLeg",
                Size = Vector3.new(8, 34, 8),
                CFrame = CFrame.new(at + Vector3.new(math.cos(a + math.pi / 2) * 26 * side,
                    16, math.sin(a + math.pi / 2) * 26 * side)) * CFrame.Angles(0, -a, 0),
                Color = Color3.fromRGB(126, 122, 114),
                Material = Enum.Material.Metal,
            })
            leg.Parent = world
        end
        local span = part({
            Name = "ArchSpan",
            Size = Vector3.new(62, 7, 12),
            CFrame = CFrame.new(at + Vector3.new(0, 36, 0)) * CFrame.Angles(0, -a, 0),
            Color = Color3.fromRGB(134, 130, 120),
            Material = Enum.Material.Metal,
        })
        span.Parent = world
    end

    -- Low walls in broken arcs: something to corner around at speed, which is
    -- where the momentum in this game actually gets used.
    for i = 0, 11 do
        local a = math.rad(i * 30 + 15)
        if i % 3 ~= 0 then
            local wall = part({
                Name = "Baffle",
                Size = Vector3.new(46, 13, 6),
                CFrame = CFrame.new(Vector3.new(math.cos(a) * 330, 4, math.sin(a) * 330))
                    * CFrame.Angles(0, -a + math.pi / 2, 0),
                Color = Color3.fromRGB(110, 112, 118),
                Material = Enum.Material.Concrete,
            })
            wall.Parent = world
        end
    end

    -- ── SCENERY ────────────────────────────────────────────────────────────
    -- Rocks on the rim and a few boulders inland. Anchored, collidable, and
    -- deliberately sparse: this is an arena, and every prop is somewhere a
    -- player cannot be.
    scatter(world, 34, Config.SHALLOWS_INNER + 12, Config.ISLAND_RADIUS - 14, rng,
        function(pos, i)
            local rock = part({
                Name = "Rock",
                Size = Vector3.new(rng:NextNumber(10, 26), rng:NextNumber(8, 22),
                                   rng:NextNumber(10, 26)),
                CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                    * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6),
                                    rng:NextNumber(-0.2, 0.2)),
                Color = Color3.fromRGB(122, 120, 116),
                Material = Enum.Material.Slate,
            })
            rock.Parent = world
        end)

    scatter(world, 18, Config.VAULT_RADIUS + 90, Config.SHALLOWS_INNER - 40, rng,
        function(pos)
            local boulder = part({
                Name = "Boulder",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(1, 1, 1) * rng:NextNumber(14, 30),
                Position = pos + Vector3.new(0, 3, 0),
                Color = Color3.fromRGB(114, 114, 118),
                Material = Enum.Material.Concrete,
            })
            boulder.Parent = world
        end)

    -- No plot pads either. They were the last remnant of the display-your-Goob
    -- layer, and on a round-based island they are eight concrete discs nobody
    -- has a reason to stand on. The list stays, empty, because GoobService
    -- still asks for a plot and expects nil to mean "no pad".
    WorldBuilder.plots = {}

    -- ── THE STANDOFF RING ──────────────────────────────────────────────────
    -- Off the island, across a causeway, and raised. A 1v1 anyone can roll
    -- into is not a 1v1.
    local ringFloor = disc(world, Pit.CENTRE - Vector3.new(0, 4, 0), Pit.START_RADIUS + 14, 10,
        Color3.fromRGB(124, 116, 106), Enum.Material.Concrete, "PitFloor")
    ringFloor.Name = "PitFloor"

    local span = Pit.CENTRE.Z - Config.ISLAND_RADIUS
    local causeway = part({
        Name = "Causeway",
        Size = Vector3.new(40, 5, span + 40),
        Position = Vector3.new(0, Pit.CENTRE.Y - 6,
            (Pit.CENTRE.Z + Config.ISLAND_RADIUS) / 2),
        Color = Color3.fromRGB(138, 132, 120),
        Material = Enum.Material.Concrete,
    })
    causeway.Parent = world

    local ring = disc(world, Pit.CENTRE, Pit.START_RADIUS, 1.5,
        Color3.fromRGB(178, 150, 150), Enum.Material.SmoothPlastic, "PitRing")
    ring.Name = "PitRing"
    ring.CanCollide = false

    for i = 0, 11 do
        local a = math.rad(i * 30)
        local torch = part({
            Name = "RingTorch",
            Size = Vector3.new(4, 22, 4),
            Position = Pit.CENTRE + Vector3.new(
                math.cos(a) * (Pit.START_RADIUS + 20), 7, math.sin(a) * (Pit.START_RADIUS + 20)),
            Color = Color3.fromRGB(96, 90, 84),
            Material = Enum.Material.Slate,
        })
        torch.Parent = world
    end

    signpost(world, Pit.CENTRE + Vector3.new(0, -4, Pit.START_RADIUS + 40), "🥊",
        "THE STANDOFF", "equal mass. pure steering.", Color3.fromRGB(190, 150, 150))

    local joinPad = disc(world, Vector3.new(0, 1.4, Config.ISLAND_RADIUS - 30), 22, 2,
        Color3.fromRGB(178, 150, 150), Enum.Material.Neon, "PitJoinPad")
    joinPad.Name = "PitJoinPad"
    joinPad.CanCollide = false

    -- ── THE LOBBY ──────────────────────────────────────────────────────────
    -- A floor, a rail and two boards. Not a building: there is no roof, no
    -- door and no interior, because "I want there to be no buildings" was the
    -- note and a lobby you walk INTO would be the same mistake in a new place.
    buildLobby(world)

    -- ── SPAWNS ─────────────────────────────────────────────────────────────
    -- PLACED LAST, AND CHECKED. Every previous attempt at this picked a radius
    -- by hand and hoped: the first put spawns at 438 with rocks scattered
    -- across 407-466, and a play-tester materialised inside a boulder before
    -- touching a control. Moving them inboard traded rocks for basin walls,
    -- ramps and signposts.
    --
    -- So they are not picked, they are SEARCHED. Each spawn starts at its even
    -- angle on the ring and steps outward until it finds a spot with nothing
    -- solid within SPAWN_CLEARANCE. Add scenery later and the spawns move out
    -- of its way on the next build instead of swallowing a player.
    local solid = {}
    for _, d in ipairs(world:GetChildren()) do
        if d:IsA("BasePart") and d.CanCollide
            and d.Name ~= "Island" and d.Name ~= "Sea" and d.Name ~= "Skirt"
            and d.Name ~= "Causeway" and d.Name ~= "PitFloor"
            and d.Name ~= "LobbyFloor" then
            table.insert(solid, d)
        end
    end

    local function clearAt(pos: Vector3): boolean
        for _, d in ipairs(solid) do
            local flat = Vector3.new(d.Position.X - pos.X, 0, d.Position.Z - pos.Z)
            if flat.Magnitude < Config.SPAWN_CLEARANCE + math.max(d.Size.X, d.Size.Z) / 2 then
                return false
            end
        end
        return true
    end

    WorldBuilder.spawns = {}
    for i = 1, Config.SPAWN_POINTS do
        local a = math.rad(i * (360 / Config.SPAWN_POINTS))
        local chosen
        -- Walk the radius out to the shoreline, then back in, before giving up.
        for _, r in ipairs({ Config.SPAWN_RING, Config.SPAWN_RING + 14,
                             Config.SPAWN_RING + 28, Config.SPAWN_RING - 14,
                             Config.SPAWN_RING - 28, Config.SPAWN_RING + 40 }) do
            local candidate = Vector3.new(math.cos(a) * r, 8, math.sin(a) * r)
            if clearAt(candidate) then
                chosen = candidate
                break
            end
        end
        -- If every radius on this spoke is blocked, rotate off the spoke
        -- rather than dropping the spawn: fewer spawns means a full server
        -- stacks up on the ones that are left.
        if not chosen then
            for step = 1, 24 do
                local a2 = a + math.rad(step * 3)
                local candidate = Vector3.new(
                    math.cos(a2) * Config.SPAWN_RING, 8, math.sin(a2) * Config.SPAWN_RING)
                if clearAt(candidate) then
                    chosen = candidate
                    break
                end
            end
        end
        chosen = chosen or Vector3.new(math.cos(a) * Config.SPAWN_RING, 8, math.sin(a) * Config.SPAWN_RING)
        table.insert(WorldBuilder.spawns, chosen)

        local spawn = Instance.new("SpawnLocation")
        spawn.Name = "Spawn" .. i
        spawn.Anchored = true
        spawn.CanCollide = false
        spawn.Size = Vector3.new(16, 1, 16)
        spawn.Position = Vector3.new(chosen.X, 1.4, chosen.Z)
        spawn.Color = Color3.fromRGB(186, 190, 176)
        spawn.Material = Enum.Material.SmoothPlastic
        spawn.Transparency = 0.75
        spawn.Neutral = true
        spawn.Parent = world
    end

    local live = Instance.new("Folder")
    live.Name = "Arena"
    live.Parent = world

    return world
end

-- ── Queries ────────────────────────────────────────────────────────────────

function WorldBuilder.lobbyPoint(index: number): Vector3
    -- Spread around the rail rather than stacked on the middle, so a full
    -- server in the lobby is a crowd and not a single pile of blobs.
    local a = math.rad((index % 24) * 15)
    local r = Config.LOBBY_RADIUS - 34
    return Config.LOBBY_CENTRE
        + Vector3.new(math.cos(a) * r, 8, math.sin(a) * r)
end

function WorldBuilder.isInLobby(position: Vector3): boolean
    local d = position - Config.LOBBY_CENTRE
    return math.abs(d.Y) < 60
        and Vector3.new(d.X, 0, d.Z).Magnitude < Config.LOBBY_RADIUS + 20
end

-- The searched positions, not the ideal ring. Teleporting a player to the
-- nominal angle would undo the whole clearance search and drop them back into
-- whatever the build step moved them away from.
WorldBuilder.spawns = {} :: { Vector3 }

function WorldBuilder.spawnPoint(index: number): Vector3
    local n = #WorldBuilder.spawns
    if n == 0 then
        return Vector3.new(0, 8, Config.SPAWN_RING)
    end
    return WorldBuilder.spawns[(index % n) + 1]
end

function WorldBuilder.vaultPosition(): Vector3
    return Vector3.new(0, Config.VAULT_HEIGHT, 0)
end

-- Which ring a point is in. Used by the arena to decide whether PvP applies,
-- which is the single most important question on the island.
function WorldBuilder.ringAt(position: Vector3): string
    local r = Vector3.new(position.X, 0, position.Z).Magnitude
    if r <= Config.VAULT_RADIUS then
        return "VAULT"
    elseif r <= Config.SHALLOWS_INNER then
        return "FLATS"
    end
    return "SHALLOWS"
end

function WorldBuilder.isSafe(position: Vector3): boolean
    return WorldBuilder.ringAt(position) == "SHALLOWS"
end

-- Which biome a point is over, or nil for open Flats. Returns the whole entry
-- so callers read `.pelletMult` instead of re-deriving it from an id.
function WorldBuilder.biomeAt(position: Vector3)
    for _, b in ipairs(Config.BIOMES) do
        local flat = Vector3.new(position.X - b.centre.X, 0, position.Z - b.centre.Z)
        if flat.Magnitude <= b.radius then
            return b
        end
    end
    return nil
end

-- A point on the island suitable for dropping something loose. Uniform by
-- AREA, not by radius: sampling radius uniformly piles everything into the
-- middle, which would put most of the island's food inside the Vault.
function WorldBuilder.randomSurfacePoint(rng: Random, innerR: number?, outerR: number?): Vector3
    local lo = innerR or (Config.VAULT_RADIUS + 14)
    -- OUT TO THE SHORELINE. This used to stop at SHALLOWS_INNER - 8 so that
    -- nothing grew in the no-PvP rim, which left a 93-stud bare band around the
    -- whole island — a third of its area with no reason to be there.
    --
    -- The rim no longer protects you indefinitely (Config.SHALLOWS_GRACE is a
    -- spendable meter, not a property of the ground), so there is nothing left
    -- to exploit by farming out here: you get about twelve seconds before the
    -- edge is the most dangerous place on the map. Food therefore goes all the
    -- way out, and the sampling stays uniform BY AREA — sqrt of a uniform draw
    -- between the squared radii — so the outer ring is not thinner per square
    -- stud than the middle. A naive uniform draw on r would have piled food in
    -- the centre and looked exactly like the bug this replaces.
    local hi = outerR or Config.PELLET_OUTER
    local r = math.sqrt(rng:NextNumber(lo * lo, hi * hi))
    local a = rng:NextNumber(0, math.pi * 2)
    local pos = Vector3.new(math.cos(a) * r, 2, math.sin(a) * r)
    local b = WorldBuilder.biomeAt(pos)
    if b then
        pos = Vector3.new(pos.X, b.centre.Y + 2, pos.Z)
    end
    return pos
end

--- Push a point out of any obstacle it is standing inside. Returns the
--- corrected point and whether anything moved.
---
--- Used by the kinematic movers — bots — which are not in the physics world
--- and so get nothing from CanCollide. Only props ON THE ISLAND count: the
--- lobby is 420 studs up with its own floor and rail, and nothing kinematic
--- moves around up there.
function WorldBuilder.pushOut(at: Vector3, bodyRadius: number): (Vector3, boolean)
    local moved = false
    local x, z = at.X, at.Z
    for _, o in ipairs(WorldBuilder.OBSTACLES) do
        if math.abs(o.pos.Y - Config.LOBBY_CENTRE.Y) > 120 then
            local dx, dz = x - o.pos.X, z - o.pos.Z
            local d = math.sqrt(dx * dx + dz * dz)
            local need = o.radius + bodyRadius
            if d < need then
                if d < 0.01 then
                    -- Dead centre. Any direction will do; a fixed one would
                    -- make every bot that clipped this prop leave it the same
                    -- way, which looks like a conveyor belt.
                    dx, dz, d = 1, 0, 1
                end
                x = o.pos.X + (dx / d) * need
                z = o.pos.Z + (dz / d) * need
                moved = true
            end
        end
    end
    return Vector3.new(x, at.Y, z), moved
end

function WorldBuilder.arenaFolder(): Folder
    local world = Workspace:FindFirstChild("GoobWorld")
    return (world and world:FindFirstChild("Arena")) :: Folder
end

function WorldBuilder.claimPlot(player: Player)
    for _, plot in ipairs(WorldBuilder.plots) do
        if plot.owner == nil then
            plot.owner = player
            return plot
        end
    end
    return nil
end

function WorldBuilder.releasePlot(player: Player)
    for _, plot in ipairs(WorldBuilder.plots) do
        if plot.owner == player then
            plot.owner = nil
            return
        end
    end
end

function WorldBuilder.plotFor(player: Player)
    for _, plot in ipairs(WorldBuilder.plots) do
        if plot.owner == player then return plot end
    end
    return nil
end

-- Ascension happens at the Vault now. There is one landmark in this game and
-- everything ceremonial belongs on it.
function WorldBuilder.altarPosition(): Vector3
    return WorldBuilder.vaultPosition()
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX000046"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000045"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX000040"><Properties><string name="Name">GoobClient</string><ProtectedString name="Source"><![CDATA[--!strict
-- init.client.luau — client entry point.
--
-- Everything the client does falls into one of three jobs:
--   1. Draw the UI from server snapshots (it never computes authoritative state)
--   2. Detect what the player is standing near and ASK the server about it
--   3. Play feedback (toasts, sounds, camera pops)
--
-- Note job 2: the client never says "I caught a Mythic". It says "I touched
-- this part", and the server decides. Every exploit in this genre comes from
-- getting that backwards.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

local Shared = game.ReplicatedStorage:WaitForChild("GoobShared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Format = require(Shared.Format)
local Movement = require(Shared.Movement)
local Pit = require(Shared.Pit)

local Theme = require(script.Theme)
local Layout = require(script.Layout)
local Hud = require(script.Hud)
local TradeUi = require(script.TradeUi)
local Roll = require(script.Roll)
local Panels = require(script.Panels)
local ArenaHud = require(script.ArenaHud)
local Stick = require(script.Stick)
local Juice = require(script.Juice)

local player = Players.LocalPlayer
local gui = Hud.build()
TradeUi.build(gui)

-- ArenaHud takes over the persistent chrome. Hud keeps toasts, the drawer and
-- the coach; it stops drawing its own stat panel, age line and drawer button,
-- which is where most of the old overlap came from.
ArenaHud.build()

-- Sound and every other feel effect now live in Juice, which reads its ids
-- from Config and stays silent when they are unset. This file used to keep a
-- second copy of the same asset ids, which meant fixing a bad one in one place
-- left it broken in the other.
-- ── Catching ───────────────────────────────────────────────────────────────
--
-- There was a Heartbeat loop here that watched a "Critters" folder and fired
-- CatchCritter at anything the player brushed past. Both the folder and the
-- remote are gone: critters were the active loop of the collecting game that
-- the arena replaced, and they were still spawning labelled junk into live
-- rounds — the "RARE Anvil" bobbing past mid-chase.
--
-- Note what the loop opened with: `Workspace:WaitForChild("Critters")`, with no
-- timeout, at module scope. Everything below it in this file — the arena sync,
-- the input bindings, the HUD wiring — would simply never have run if the
-- server had stopped creating that folder. Deleting the server half without
-- deleting this would not have produced an error; it would have produced a
-- client that boots to a working camera and an unresponsive game.

-- ── Server -> client ───────────────────────────────────────────────────────

Net.get("StateSync").OnClientEvent:Connect(function(snap)
    Hud.update(snap)
    -- ArenaHud has to be fed the same snapshot. Without this line its profile
    -- stays nil forever, which is not a visible error — it is a UI that draws
    -- perfectly and is entirely inert: Glob reads 0, the season tier reads 0,
    -- and every crate, trinket, power, skin and Goob renders locked or absent
    -- because the code behind each tab is reading fields off nothing.
    ArenaHud.setProfile(snap)
end)

Net.get("Notify").OnClientEvent:Connect(function(message: string, kind: string?)
    Hud.toast(message, kind)
    if kind == "secret" then
        Juice.play("rare")
    elseif kind == "good" then
        Juice.play("catch", 0.2)
    end
end)

Net.get("TradeSync").OnClientEvent:Connect(function(state)
    TradeUi.sync(state)
    Hud.setTradeOpen(state ~= nil and state.open == true)
end)

-- ── Client -> server actions ───────────────────────────────────────────────

Hud.onSetActive = function(goobId: string)
    Net.get("SetActiveGoob"):FireServer(goobId)
end

Hud.onOffer = function(goobId: string)
    Net.get("TradeOffer"):FireServer(goobId, true)
end

-- Gulping is irreversible, so it gets a real two-step confirmation with the
-- consequence spelled out in words a child will actually read.
local pendingGulp: string? = nil
local confirmFrame: Frame
local tradeStrip: Frame

local function buildGulpConfirm()
    confirmFrame = Instance.new("Frame")
    confirmFrame.Name = "GulpConfirm"
    confirmFrame.BackgroundColor3 = Theme.BG
    confirmFrame.Visible = false
    confirmFrame.Parent = gui
    Theme.corner(confirmFrame, 18)
    Theme.stroke(confirmFrame, Theme.BAD, 4)

    local title = Theme.label({
        Position = UDim2.fromOffset(20, 16), Size = UDim2.new(1, -40, 0, 30),
        Text = "😋 GULP THIS GOOB?", TextSize = 26, TextColor3 = Theme.BAD,
    })
    title.Parent = confirmFrame

    local body = Theme.label({
        Name = "Body",
        Position = UDim2.fromOffset(20, 52), Size = UDim2.new(1, -40, 0, 92),
        Text = "", TextSize = 17, TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Theme.TEXT_DIM,
    })
    body.Parent = confirmFrame

    local yes = Theme.button("😋 GULP IT", Theme.BAD, UDim2.fromOffset(170, 44))
    yes.Name = "GulpYes"
    yes.Parent = confirmFrame
    yes.Activated:Connect(function()
        local state = Hud.getState()
        if pendingGulp and state then
            local activeId = state.activeGoobId
            Net.get("GulpGoob"):FireServer(activeId, pendingGulp)
            Juice.play("gulp")
        end
        pendingGulp = nil
        confirmFrame.Visible = false
    end)

    local no = Theme.button("✖ KEEP IT", Theme.ACCENT, UDim2.fromOffset(170, 44))
    no.Name = "GulpNo"
    no.Parent = confirmFrame
    no.Activated:Connect(function()
        pendingGulp = nil
        confirmFrame.Visible = false
    end)
end
buildGulpConfirm()

Hud.onGulp = function(goobId: string)
    local state = Hud.getState()
    if not state then return end
    local target, active
    for _, g in ipairs(state.goobs) do
        if g.id == goobId then target = g end
        if g.isActive then active = g end
    end
    if not target or not active then return end

    pendingGulp = goobId
    local body = confirmFrame:FindFirstChild("Body") :: TextLabel
    body.Text = string.format(
        "%s (⚡%s, %s old) will be GONE FOREVER.\n\n%s will gain about ⚡%s and %s of its age.\n\nThis cannot be undone.",
        target.nickname, target.powerText, target.ageText,
        active.nickname,
        Format.short(target.mass * Config.GULP_MASS_TRANSFER * active.ageMult),
        Format.duration(target.ageSeconds * Config.GULP_AGE_TRANSFER)
    )
    confirmFrame.Visible = true
end

-- Rename: a tiny inline prompt rather than a modal, because renaming is a
-- low-stakes action and a modal for it would be annoying.
local renameFrame: Frame
local renameBox: TextBox
local renameTarget: string? = nil

do
    renameFrame = Instance.new("Frame")
    renameFrame.Name = "RenameDialog"
    renameFrame.BackgroundColor3 = Theme.BG
    renameFrame.Visible = false
    renameFrame.Parent = gui
    Theme.corner(renameFrame, 18)
    Theme.stroke(renameFrame, Theme.GOLD, 4)

    local title = Theme.label({
        Position = UDim2.fromOffset(20, 14), Size = UDim2.new(1, -40, 0, 28),
        Text = "✏️ NAME YOUR GOOB", TextSize = 24, TextColor3 = Theme.GOLD,
    })
    title.Parent = renameFrame

    renameBox = Instance.new("TextBox")
    renameBox.Position = UDim2.fromOffset(20, 52)
    renameBox.Size = UDim2.new(1, -40, 0, 42)
    renameBox.BackgroundColor3 = Theme.BG_SOFT
    renameBox.Font = Theme.FONT
    renameBox.TextSize = 20
    renameBox.TextColor3 = Theme.TEXT
    renameBox.PlaceholderText = "2–22 letters…"
    renameBox.ClearTextOnFocus = false
    renameBox.Text = ""
    renameBox.Parent = renameFrame
    Theme.corner(renameBox, 10)

    local ok = Theme.button("SAVE", Theme.GOOD, UDim2.fromOffset(160, 38))
    ok.Name = "RenameSave"
    ok.Parent = renameFrame
    ok.Activated:Connect(function()
        if renameTarget and #renameBox.Text >= 2 then
            Net.get("RenameGoob"):FireServer(renameTarget, renameBox.Text)
        end
        renameFrame.Visible = false
        renameTarget = nil
    end)

    local cancel = Theme.button("CANCEL", Theme.BAD, UDim2.fromOffset(160, 38))
    cancel.Name = "RenameCancel"
    cancel.Parent = renameFrame
    cancel.Activated:Connect(function()
        renameFrame.Visible = false
        renameTarget = nil
    end)
end

Hud.onRename = function(goobId: string)
    renameTarget = goobId
    renameBox.Text = ""
    renameFrame.Visible = true
    renameBox:CaptureFocus()
end

-- ── Trade initiation ───────────────────────────────────────────────────────
-- Walking into the trade zone next to someone shows a single button. No chat
-- commands, no typing a username — both of which are where younger players get
-- socially engineered.

local tradePrompt: TextButton
do
    tradePrompt = Theme.button("🤝 TRADE", Theme.GOLD, UDim2.fromOffset(220, 54))
    tradePrompt.Name = "TradePrompt"
    tradePrompt.TextSize = 22
    tradePrompt.Visible = false
    tradePrompt.Parent = gui
end

local nearestPartner: Player? = nil

RunService.Heartbeat:Connect(function()
    if TradeUi.isOpen() then
        tradePrompt.Visible = false
        return
    end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then tradePrompt.Visible = false return end

    local flat = Vector3.new(root.Position.X, 0, root.Position.Z)
    if flat.Magnitude > Config.TRADE_RANGE then
        tradePrompt.Visible = false
        nearestPartner = nil
        return
    end

    local best, bestDist = nil, math.huge
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local oc = other.Character
            local orr = oc and oc:FindFirstChild("HumanoidRootPart") :: BasePart?
            if orr then
                local oflat = Vector3.new(orr.Position.X, 0, orr.Position.Z)
                if oflat.Magnitude <= Config.TRADE_RANGE then
                    local d = (orr.Position - root.Position).Magnitude
                    if d < bestDist then best, bestDist = other, d end
                end
            end
        end
    end

    nearestPartner = best
    tradePrompt.Visible = best ~= nil
    if best then tradePrompt.Text = "🤝 TRADE WITH " .. string.upper(best.DisplayName) end
end)

tradePrompt.Activated:Connect(function()
    if nearestPartner then
        Net.get("TradeRequest"):FireServer(nearestPartner.Name)
    end
end)

-- Incoming trade request: accept/decline strip.
do
    local strip = Instance.new("Frame")
    strip.Name = "TradeRequestStrip"
    strip.BackgroundColor3 = Theme.BG
    strip.Visible = false
    strip.Parent = gui
    Theme.corner(strip, 14)
    Theme.stroke(strip, Theme.GOLD, 3)

    local accept = Theme.button("✅ ACCEPT", Theme.GOOD, UDim2.fromOffset(160, 42))
    accept.Name = "TradeAccept"
    accept.Parent = strip
    local decline = Theme.button("✖ NO", Theme.BAD, UDim2.fromOffset(160, 42))
    decline.Name = "TradeDecline"
    decline.Parent = strip
    tradeStrip = strip

    accept.Activated:Connect(function()
        Net.get("TradeRespond"):FireServer(true)
        strip.Visible = false
    end)
    decline.Activated:Connect(function()
        Net.get("TradeRespond"):FireServer(false)
        strip.Visible = false
    end)

    Net.get("Notify").OnClientEvent:Connect(function(_: string, kind: string?)
        if kind == "trade" then
            strip.Visible = true
            task.delay(12, function() strip.Visible = false end)
        end
    end)
end

-- ── Responsive pass for the dialogs ────────────────────────────────────────
-- Each of these was a hardcoded pixel box centred with a hardcoded half-offset,
-- which put all four of them partly off a phone screen.

local function layoutDialogs()
    local compact = Layout.isCompact()
    local u = Layout.usable()
    local pad = compact and 12 or 20
    local btnH = compact and Layout.MIN_TAP or 44

    -- Gulp confirmation.
    local cSize = Layout.panel(420, compact and 250 or 210)
    confirmFrame.Size = cSize
    confirmFrame.Position = Layout.centre(cSize)
    local cw, ch = cSize.X.Offset, cSize.Y.Offset
    local body = confirmFrame:FindFirstChild("Body") :: TextLabel?
    if body then
        body.Position = UDim2.fromOffset(pad, compact and 44 or 52)
        body.Size = UDim2.new(1, -pad * 2, 0, ch - (compact and 44 or 52) - btnH - 20)
        body.TextSize = compact and 15 or 17
    end
    local yes = confirmFrame:FindFirstChild("GulpYes") :: TextButton?
    local no = confirmFrame:FindFirstChild("GulpNo") :: TextButton?
    local halfW = math.floor((cw - pad * 3) / 2)
    if yes then
        yes.Size = UDim2.fromOffset(halfW, btnH)
        yes.Position = UDim2.fromOffset(pad, ch - btnH - pad)
    end
    if no then
        no.Size = UDim2.fromOffset(halfW, btnH)
        no.Position = UDim2.fromOffset(pad * 2 + halfW, ch - btnH - pad)
    end

    -- Rename dialog.
    local rSize = Layout.panel(400, compact and 180 or 150)
    renameFrame.Size = rSize
    renameFrame.Position = Layout.centre(rSize)
    local rw, rh = rSize.X.Offset, rSize.Y.Offset
    renameBox.Position = UDim2.fromOffset(pad, compact and 44 or 52)
    renameBox.Size = UDim2.new(1, -pad * 2, 0, compact and btnH or 42)
    local rsave = renameFrame:FindFirstChild("RenameSave") :: TextButton?
    local rcancel = renameFrame:FindFirstChild("RenameCancel") :: TextButton?
    local rHalf = math.floor((rw - pad * 3) / 2)
    if rsave then
        rsave.Size = UDim2.fromOffset(rHalf, btnH)
        rsave.Position = UDim2.fromOffset(pad, rh - btnH - pad)
    end
    if rcancel then
        rcancel.Size = UDim2.fromOffset(rHalf, btnH)
        rcancel.Position = UDim2.fromOffset(pad * 2 + rHalf, rh - btnH - pad)
    end

    -- Incoming trade request strip, pinned under the top bar.
    if tradeStrip then
        local sSize = Layout.panel(360, compact and 56 or 60, compact and 40 or 24, 8)
        tradeStrip.Size = sSize
        tradeStrip.Position = UDim2.fromOffset(
            math.floor((u.X - sSize.X.Offset) / 2), compact and 74 or 90)
        local sw = sSize.X.Offset
        local sHalf = math.floor((sw - 36) / 2)
        local acc = tradeStrip:FindFirstChild("TradeAccept") :: TextButton?
        local dec = tradeStrip:FindFirstChild("TradeDecline") :: TextButton?
        local sh = sSize.Y.Offset
        if acc then
            acc.Size = UDim2.fromOffset(sHalf, sh - 16)
            acc.Position = UDim2.fromOffset(12, 8)
        end
        if dec then
            dec.Size = UDim2.fromOffset(sHalf, sh - 16)
            dec.Position = UDim2.fromOffset(sw - sHalf - 12, 8)
        end
    end

    -- The "trade with X" prompt has to clear the touch controls too, so it
    -- rides just above the drawer button rather than at a fixed offset.
    if tradePrompt then
        local pw = compact and math.min(230, u.X - 40) or 220
        local ph = compact and Layout.MIN_TAP or 54
        tradePrompt.Size = UDim2.fromOffset(pw, ph)
        local y = compact and (u.Y - ph - Layout.MIN_TAP - 26) or (u.Y - 140)
        tradePrompt.Position = UDim2.fromOffset(math.floor((u.X - pw) / 2), y)
        tradePrompt.TextSize = compact and 17 or 22
    end
end

layoutDialogs()
Layout.changed.Event:Connect(layoutDialogs)

-- ── Rolling ────────────────────────────────────────────────────────────────
-- Find our ball whenever the server (re)creates it, point the camera at it, and
-- drive the controller every frame.

local currentBall: BasePart? = nil

local function findBall(): BasePart?
    return Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
end

-- The mass the controller steers with. It is the ARENA run's mass, not the
-- stored Goob's: handling is derived from how big you are RIGHT NOW, and the
-- stored Goob has nothing to do with a round.
local liveMass = 10

local function bindBall(ball: BasePart?)
    currentBall = ball
    Roll.setBall(ball, liveMass)
    local camera = Workspace.CurrentCamera
    if camera and ball then
        camera.CameraSubject = ball
        camera.CameraType = Enum.CameraType.Custom
    end
end

Workspace.ChildAdded:Connect(function(child)
    if child.Name == "GoobBall_" .. player.UserId then
        task.wait(0.1)
        bindBall(child :: BasePart)
    end
end)

task.spawn(function()
    -- The ball may already exist before this script finishes loading.
    for _ = 1, 60 do
        local b = findBall()
        if b then bindBall(b) break end
        task.wait(0.25)
    end
end)

Juice.start()

Net.get("Effect").OnClientEvent:Connect(function(kind, a, b)
    if kind == "catch" then Juice.onCatch(a)
    elseif kind == "gulp" then Juice.onGulp()
    elseif kind == "ascend" then Juice.onAscend()
    elseif kind == "shove" then Juice.onShove(a, b or 0.5)
    elseif kind == "runEnd" then ArenaHud.runEnded(a)
    elseif kind == "pop" then Juice.onPop(a and a.mass)
    elseif kind == "bank" then Juice.onBank(a and a.glob)
    elseif kind == "power" then Juice.onPower(a and a.id, a)
    elseif kind == "slam" then Juice.shakeCamera(1.4)
    elseif kind == "split" then Juice.shakeCamera(0.35)
    elseif kind == "snagged" then Juice.shakeCamera(0.5)
    elseif kind == "podBurst" then Juice.shakeCamera(1.8)
    elseif kind == "hook" then Juice.play("slam", 0.3)
    elseif kind == "siphon" then Juice.play("drip", 0.3)
    elseif kind == "siphoned" then Juice.onSiphoned(a and a.by, a and a.amount)
    elseif kind == "deflated" then Juice.onSiphoned(nil, a and a.amount)
    elseif kind == "roundEnd" then ArenaHud.roundEnded(a) end
end)

Roll.bindInput()
-- The touch thumbstick has to be BUILT, not just bound. Stick.build draws it
-- into the HUD; without this call a phone player has keyboard handlers
-- connected and no on-screen control to use them with.
Stick.build(gui)
Roll.onDash = function()
    Net.get("Dashed"):FireServer()
    Juice.play("catch", 0.6)
end

-- BIND WHATEVER IS ALREADY THERE, then keep looking until something is.
--
-- THE BUG THIS FIXES: the ball was bound from Workspace.ChildAdded alone. The
-- server creates it on join, the client boots at roughly the same moment, and
-- if the ball won the race the event had already fired before this script
-- connected — so currentBall stayed nil forever. The old guard only re-bound
-- when currentBall EXISTED and had been removed, so nil was a permanent state,
-- Roll.step returned on its first line every frame, and the player could not
-- move at all. Powers still worked, because those are server-side, which is
-- exactly the shape the play-test reported.
bindBall(findBall())

RunService.RenderStepped:Connect(function(dt)
    if not currentBall or not currentBall.Parent then
        bindBall(findBall())
    end
    Roll.step(dt)
end)

-- Jump is Roblox's OWN jump button and Space bar. The default controls are
-- deliberately left enabled: Humanoid.MoveDirection gives us keyboard, gamepad
-- and the mobile thumbstick for free, and Humanoid.Jumping gives us the jump
-- button for free. Disabling them to draw our own would have cost the
-- thumbstick, and adding a second jump button on top of Roblox's would have put
-- an unreachable control under a real one.
do
    local function bindJump(character)
        local hum = character:WaitForChild("Humanoid", 5)
        if not hum then return end
        hum.Jumping:Connect(function(active)
            if active then Roll.jump() end
        end)
    end
    if player.Character then bindJump(player.Character) end
    player.CharacterAdded:Connect(bindJump)
end

-- Dash is the one verb Roblox has no button for, so it gets ours — stacked in
-- the gap between the thumbstick and the jump button, the only reachable part
-- of a phone's bottom edge.
do
    local Layout = require(script.Layout)

    -- No on-screen dash button. ArenaHud's power button sits in the same
    -- thumb gap, and two round buttons fighting for the one reachable part of
    -- a phone's bottom edge is the overlap problem in miniature. Dash is still
    -- on the keyboard and the gamepad, and DASH is also a carryable power.
    local dashBtn = Instance.new("TextButton")
    dashBtn.Name = "DashButton"
    dashBtn.Visible = false
    dashBtn.Text = ""
    dashBtn.Parent = gui

    -- A charge meter, because a dash you cannot count is a dash you cannot plan.
    local meter = Instance.new("Frame")
    meter.Name = "DashMeter"
    meter.BackgroundTransparency = 1
    -- Hidden with the dash button it belonged to. The power button carries its
    -- own cooldown sweep, and a second charge meter in the same corner is the
    -- overlap complaint wearing a different hat.
    meter.Visible = false
    meter.Parent = gui
    local pips = {}
    for i = 1, Movement.DASH_CHARGES do
        local pip = Instance.new("Frame")
        pip.Name = "Pip" .. i
        pip.BackgroundColor3 = Theme.ACCENT
        pip.Parent = meter
        Theme.corner(pip, 6)
        Theme.stroke(pip, Color3.fromRGB(16, 18, 30), 2)
        table.insert(pips, pip)
    end

    local function layoutRoll()
        local compact = Layout.isCompact()
        local touch = Layout.isTouch()
        local u = Layout.usable()
        local size = touch and (Layout.MIN_TAP + 20) or 56

        dashBtn.Visible = false   -- superseded by ArenaHud's power button
        dashBtn.Size = UDim2.fromOffset(size, size)

        -- Sit directly above the drawer button, both inside the safe gap.
        local gapL, gapR = Layout.bottomGap()
        local cx = (gapL + gapR) / 2
        if gapR - gapL < size + 16 then cx = gapL + size / 2 + 8 end
        dashBtn.Position = UDim2.fromOffset(
            Layout.fit(cx - size / 2, 8, u.X - size - 8),
            u.Y - size * 2 - 26)

        local pw, ph, gap = compact and 24 or 34, compact and 8 or 10, 5
        meter.Size = UDim2.fromOffset(Movement.DASH_CHARGES * (pw + gap), ph)
        meter.Position = UDim2.fromOffset(
            touch and Layout.fit(cx - meter.Size.X.Offset / 2, 8, u.X - meter.Size.X.Offset - 8)
                  or math.floor((u.X - meter.Size.X.Offset) / 2),
            touch and (u.Y - size * 2 - 40) or (u.Y - 34))
        for i, pip in ipairs(pips) do
            pip.Size = UDim2.fromOffset(pw, ph)
            pip.Position = UDim2.fromOffset((i - 1) * (pw + gap), 0)
        end
    end
    layoutRoll()
    Layout.changed.Event:Connect(layoutRoll)

    RunService.RenderStepped:Connect(function()
        local have = Roll.charges()
        for i, pip in ipairs(pips) do
            if i <= have then
                pip.BackgroundColor3 = Theme.ACCENT
                pip.BackgroundTransparency = 0
            elseif i == have + 1 then
                pip.BackgroundColor3 = Theme.ACCENT
                pip.BackgroundTransparency = 1 - Roll.refillProgress() * 0.75
            else
                pip.BackgroundColor3 = Theme.BG_SOFT
                pip.BackgroundTransparency = 0.35
            end
        end
    end)
end

-- ── Panels: wardrobe, season, crew ─────────────────────────────────────────


-- ── The arena ──────────────────────────────────────────────────────────────

-- Where the power is pointed. Where you are STEERING beats where the camera
-- happens to face: a player mid-turn is looking at where they want to go, and
-- firing a dash at the camera instead would feel like the game ignoring them.
local function aimVector(): Vector3?
    local move = Stick.moveVector()
    if move.Magnitude > 0.15 then
        return move.Unit
    end
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local look = camera.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    return flat.Magnitude > 0.01 and flat.Unit or nil
end

local UsePower = Net.get("UsePower")
local lastPower = { 0, 0, 0 }

--- Press one hotbar slot. 1 = DASH, 2 = SPLIT, 3 = whatever you brought.
local function firePower(slot: number?)
    local index = math.clamp(math.floor(slot or 1), 1, 3)
    -- Client-side rate limit, PER SLOT. It used to be one timer for the whole
    -- blob, which was right when there was one button and is wrong now:
    -- tapping DASH would have swallowed a SPLIT pressed a tenth of a second
    -- later, and the player would have seen a dead button rather than a
    -- cooldown. The server still enforces the real cooldowns; this only stops
    -- a held key filling the remote queue.
    local now = os.clock()
    if now - lastPower[index] < 0.15 then return end
    lastPower[index] = now
    UsePower:FireServer(index, aimVector())
end

ArenaHud.on.usePower = function(slot) firePower(slot) end
ArenaHud.on.setPower = function(id) Net.get("SetPower"):FireServer(id) end
ArenaHud.on.equipTrinket = function(id, slot) Net.get("EquipTrinket"):FireServer(id, slot) end
ArenaHud.on.openCrate = function(id) Net.get("OpenCrate"):FireServer(id) end

-- The menu's delegated tabs. They close the sheet before opening, and
-- "close" shuts everything — so there is still never more than one panel up.
ArenaHud.on.equipCosmetic = function(kind, id) Net.get("EquipCosmetic"):FireServer(kind, id) end
ArenaHud.on.setActiveGoob = function(id) Net.get("SetActiveGoob"):FireServer(id) end

-- The season track and the crew screen still RENDER through Panels, but they
-- render inside ArenaHud's own sheet now. There is no second screen to hand
-- off to: `openLegacy` and the drawer it opened are both gone, along with the
-- Snack Stand that the drawer used to reparent on top of the season list.
--
-- The live trade WINDOW stays as it is — rebuilding TradeUi would mean
-- rebuilding the anti-scam confirmation reset, which is the most
-- safety-critical UI in the game and is already proven. The menu's trade row
-- explains the rules and lists what you can offer; the window itself still
-- opens when another player rolls up.
ArenaHud.on.gulpGoob = function(id) Hud.onGulp(id) end
ArenaHud.on.joinPit = function() Net.get("PitJoin"):FireServer() end
ArenaHud.on.leavePit = function() Net.get("PitLeave"):FireServer() end

Net.get("ArenaSync").OnClientEvent:Connect(function(state)
    ArenaHud.setArena(state)
    if state and state.mass then
        liveMass = state.mass
        Roll.setMass(liveMass)
    end
    -- The server decides whether a tether has you; the client owns this ball's
    -- physics, so the client is the only thing that can act on it.
    if state then
        Roll.setSnagged(state.snagged == true)
    end
end)

Net.get("CrateResult").OnClientEvent:Connect(function(result)
    ArenaHud.crateResult(result)
    -- A Legendary and a Common must not sound alike. The whole point of a
    -- crate is the half-second before you know which you got.
    local r = result and result.reward and result.reward.rarity
    Juice.play((r == "Legendary" or r == "Mythic" or r == "Epic") and "rare" or "unlock")
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    -- THREE SLOTS, THREE KEYS, and the digits as well.
    --
    -- Q/E/R sit under the fingers already on WASD, which is where a key you
    -- press mid-chase has to be. 1/2/3 are there because every player who has
    -- touched a game with a hotbar tries them first, and a control that does
    -- nothing on the obvious key is a control the player decides is broken.
    local k = input.KeyCode
    if k == Enum.KeyCode.Q or k == Enum.KeyCode.One or k == Enum.KeyCode.ButtonX then
        firePower(1)
    elseif k == Enum.KeyCode.E or k == Enum.KeyCode.Two or k == Enum.KeyCode.ButtonY then
        firePower(2)
    elseif k == Enum.KeyCode.R or k == Enum.KeyCode.Three or k == Enum.KeyCode.ButtonB then
        firePower(3)
    elseif input.KeyCode == Enum.KeyCode.Escape then
        ArenaHud.closeSheet()
    end
end)

Panels.onEquip = function(kind, id) Net.get("EquipCosmetic"):FireServer(kind, id) end
Panels.onClaimSeason = function(tier, premium) Net.get("ClaimSeason"):FireServer(tier, premium) end
Panels.onCrewCreate = function(name, tag) Net.get("CrewCreate"):FireServer(name, tag) end
Panels.onCrewJoin = function(tag) Net.get("CrewJoin"):FireServer(tag) end
Panels.onCrewLeave = function() Net.get("CrewLeave"):FireServer() end
Panels.onCrewClaim = function() Net.get("CrewClaim"):FireServer() end
Panels.onBuy = function(id)
    -- MarketplaceService prompts live client-side. The server is told so it can
    -- say plainly when something is not on sale yet, rather than the prompt
    -- failing silently and reading as a broken shop.
    Net.get("BuyProduct"):FireServer(id)
end

Net.get("CrewSync").OnClientEvent:Connect(function(data)
    Panels.setCrew(data)
    local snap = Hud.getState()
    if snap then Hud.update(snap) end
end)

-- ── The Sumo Pit ───────────────────────────────────────────────────────────
-- A small always-on strip rather than a menu: the Pit is a place you roll to,
-- and what matters is knowing whether a match is forming while you are moving.
do
    local Layout = require(script.Layout)

    local strip = Instance.new("Frame")
    strip.Name = "PitStrip"
    strip.BackgroundColor3 = Theme.BG
    strip.BackgroundTransparency = 0.1
    strip.Visible = false
    strip.Parent = gui
    Theme.corner(strip, 14)
    Theme.stroke(strip, Color3.fromRGB(184, 128, 122), 3)

    local line = Theme.label({ Name = "Line", Text = "", TextSize = 15 })
    line.Parent = strip
    local sub = Theme.label({ Name = "Sub", Text = "", TextSize = 12,
        TextColor3 = Theme.TEXT_DIM })
    sub.Parent = strip

    local joinBtn = Theme.button("🥊 ENTER", Theme.BAD, UDim2.fromOffset(110, 36))
    joinBtn.Name = "PitJoin"
    joinBtn.TextSize = 15
    joinBtn.Parent = strip
    local queued = false
    joinBtn.Activated:Connect(function()
        if queued then Net.get("PitLeave"):FireServer()
        else Net.get("PitJoin"):FireServer() end
    end)

    local function layoutPit()
        local compact = Layout.isCompact()
        local touch = Layout.isTouch()
        local u = Layout.usable()
        local w = compact and math.min(300, u.X - 24) or 340
        local h = compact and 60 or 66
        strip.Size = UDim2.fromOffset(w, h)
        -- CENTRED IN THE GAP, clear of both columns. The stat column runs down
        -- the left and the menu down the right, so this is placed between them
        -- and below the status strip rather than at a fixed y that happened to
        -- be free when the menu was a strip across the top.
        local menuX = Layout.menuLeft()
        local left = (compact and 8 or 14) * 2 + (compact and 116 or 220)
        local x = math.floor((left + menuX) / 2 - w / 2)
        strip.Position = UDim2.fromOffset(
            Layout.fit(x, 8, math.max(8, u.X - w - 8)), compact and 150 or 190)
        line.Position = UDim2.fromOffset(12, 6)
        line.Size = UDim2.new(1, -140, 0, 20)
        sub.Position = UDim2.fromOffset(12, 28)
        sub.Size = UDim2.new(1, -140, 0, 18)
        local bh = touch and Layout.MIN_TAP or 36
        joinBtn.Size = UDim2.fromOffset(110, bh)
        joinBtn.Position = UDim2.fromOffset(w - 122, math.floor((h - bh) / 2))
    end
    layoutPit()
    Layout.changed.Event:Connect(layoutPit)

    local nearPit = false
    RunService.Heartbeat:Connect(function()
        local ball = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
        if not ball then strip.Visible = false return end
        local d = (ball.Position - Pit.CENTRE).Magnitude
        nearPit = d < Pit.START_RADIUS + 140
        -- Compact screens use the menu's Standoff row instead. On a 320px-tall
        -- phone there is no row left for a third banner that does not land on
        -- the hotbar, and a duplicate entry point is not worth an overlap.
        strip.Visible = nearPit and not Layout.isCompact()
    end)

    Net.get("PitSync").OnClientEvent:Connect(function(state)
        if not state then return end
        ArenaHud.setPit(state)
        local mine = false
        for _, n in ipairs(state.alive or {}) do
            if n == player.DisplayName then mine = true end
        end
        queued = mine and not state.inMatch

        if state.inMatch then
            line.Text = ("🥊 FIGHT  ·  %d left"):format(#(state.alive or {}))
            sub.Text = ("ring %.0f  ·  pot 💧%s  ·  %ds")
                :format(state.radius or 0, state.potText or "0",
                        math.max(0, math.ceil((state.matchSeconds or 0) - (state.elapsed or 0))))
            joinBtn.Text = mine and "FIGHTING" or "WATCHING"
            joinBtn.BackgroundColor3 = Theme.BG_SOFT
        else
            line.Text = ("🥊 SUMO PIT  ·  %d/%d waiting"):format(state.queued or 0, state.minPlayers or 2)
            sub.Text = (state.lobbySeconds or 0) > 0
                and ("starting in %ds"):format(state.lobbySeconds)
                or "stake 💧 · last one in the ring wins the pot"
            joinBtn.Text = queued and "✖ LEAVE" or "🥊 ENTER"
            joinBtn.BackgroundColor3 = queued and Theme.WARN or Theme.BAD
        end
    end)
end

-- ── Ascension prompt ───────────────────────────────────────────────────────
do
    local Layout = require(script.Layout)
    local prompt = Theme.button("👑 ASCEND", Theme.GOLD, UDim2.fromOffset(240, 60))
    prompt.Name = "AscendPrompt"
    prompt.TextSize = 24
    prompt.Visible = false
    prompt.Parent = gui

    local confirm = Instance.new("Frame")
    confirm.Name = "AscendConfirm"
    confirm.BackgroundColor3 = Theme.BG
    confirm.Visible = false
    confirm.ZIndex = 30
    confirm.Parent = gui
    Theme.corner(confirm, 18)
    Theme.stroke(confirm, Theme.GOLD, 4)

    local title = Theme.label({ Text = "👑 ASCEND?", TextSize = 28,
        TextColor3 = Theme.GOLD, ZIndex = 31 })
    title.Parent = confirm
    local body = Theme.label({ Name = "Body", Text = "", TextSize = 16,
        TextWrapped = true, TextColor3 = Theme.TEXT_DIM, ZIndex = 31,
        TextYAlignment = Enum.TextYAlignment.Top })
    body.Parent = confirm

    local yes = Theme.button("👑 DO IT", Theme.GOLD, UDim2.fromOffset(160, 44))
    yes.Name = "AscendYes"; yes.ZIndex = 31; yes.Parent = confirm
    local no = Theme.button("✖ NOT YET", Theme.ACCENT, UDim2.fromOffset(160, 44))
    no.Name = "AscendNo"; no.ZIndex = 31; no.Parent = confirm

    local function layoutAscend()
        local compact = Layout.isCompact()
        local u = Layout.usable()
        local pw = compact and math.min(220, u.X - 40) or 240
        local ph = compact and Layout.MIN_TAP or 60
        prompt.Size = UDim2.fromOffset(pw, ph)
        prompt.Position = UDim2.fromOffset(math.floor((u.X - pw) / 2), math.floor(u.Y * 0.62))
        prompt.TextSize = compact and 18 or 24

        local size = Layout.panel(440, compact and 270 or 240)
        confirm.Size = size
        confirm.Position = Layout.centre(size)
        local cw, ch = size.X.Offset, size.Y.Offset
        local pad = compact and 12 or 20
        title.Position = UDim2.fromOffset(pad, 14)
        title.Size = UDim2.new(1, -pad * 2, 0, 30)
        body.Position = UDim2.fromOffset(pad, 50)
        body.Size = UDim2.new(1, -pad * 2, 0, ch - 50 - (compact and 52 or 60) - pad)
        local bh = compact and Layout.MIN_TAP or 44
        local half = math.floor((cw - pad * 3) / 2)
        yes.Size = UDim2.fromOffset(half, bh)
        yes.Position = UDim2.fromOffset(pad, ch - bh - pad)
        no.Size = UDim2.fromOffset(half, bh)
        no.Position = UDim2.fromOffset(pad * 2 + half, ch - bh - pad)
    end
    layoutAscend()
    Layout.changed.Event:Connect(layoutAscend)

    prompt.Activated:Connect(function()
        local snap = Hud.getState()
        local p = snap and snap.ascendPreview
        if not p then return end
        body.Text = ("%s will be DESTROYED forever.\n\n⚡ %s of mass and %s of age, gone.\n\nYou keep Crest %d — every bite of food becomes worth %.0f%% instead of %.0f%%, permanently, for every Goob you ever raise.")
            :format(p.losing, Format.short(p.losingMass), Format.duration(p.losingAge),
                    p.crestsAfter, p.multiplierAfter * 100, p.multiplierBefore * 100)
        confirm.Visible = true
    end)
    yes.Activated:Connect(function()
        Net.get("Ascend"):FireServer()
        confirm.Visible = false
    end)
    no.Activated:Connect(function() confirm.Visible = false end)

    Net.get("StateSync").OnClientEvent:Connect(function(snap)
        prompt.Visible = snap.canAscend == true and not confirm.Visible
    end)
end

-- ── Boot ───────────────────────────────────────────────────────────────────

task.spawn(function()
    local snap = Net.get("RequestProfile"):InvokeServer()
    if snap then Hud.update(snap) end
end)

print("[GULP A GOOB] client ready")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">ArenaHud</string><ProtectedString name="Source"><![CDATA[--!strict
-- ArenaHud.luau — the screen, rebuilt.
--
-- THE COMPLAINT THIS FILE EXISTS TO FIX: "everything gets in the way of
-- everything". It was true. The old HUD had a stat panel, an age line, a
-- drawer button, a drawer, dash pips, toasts, a trade window and four panels,
-- any number of which could be on screen at once, several of them overlapping,
-- and none of them aware of the others.
--
-- The fix is structural, not cosmetic: THERE IS ONE SHEET, AND ONLY ONE.
-- Every service in the game is a tab on it. Opening any tab closes whatever
-- was open. Two things cannot overlap if only one thing can exist.
--
-- The screen is then divided into four regions that never intersect:
--
--   top-left      the stat column: mass, what it is worth, Glob, season tier
--   top-centre    the status strip — round clock, where you are, are you safe
--   top-right     the ☰ MENU button, and the tab list it drops
--   bottom-centre the three-slot hotbar, inside the only part of the bottom
--                 edge a phone player can actually reach
--
-- ── WHY THE MENU IS A NAMED VERTICAL LIST ON THE RIGHT ────────────────────
--
-- It was a horizontal strip of nine unlabelled icons across the top, and that
-- is two problems at once. A row of pictograms is a memory test — nobody knows
-- what 🔧 opens until they have opened it — and the top strip is the most
-- contested space on the screen, wanted by the clock, the stat card and the
-- Glob readout at the same time.
--
-- Down the right-hand edge every row carries its ICON AND ITS NAME, the list
-- reads top-to-bottom like a menu, and it grows downward instead of squeezing
-- everything else sideways. It is a DROPDOWN rather than a permanent rail
-- because a menu covering a third of a 568-wide phone the moment you spawn is
-- a menu the player closes before reading it: closed by default on touch, open
-- by default where there is room.
--
-- On touch the list opens to the LEFT of its button rather than under it.
-- Roblox reserves the bottom-right 160x160 for the jump button, which on a
-- landscape phone is the entire right-hand column below y=160 — a list that
-- dropped straight down would put most of its rows somewhere a thumb cannot
-- reach. See Layout.menuMetrics.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game.ReplicatedStorage.GoobShared
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Powers = require(Shared.Powers)
local Trinkets = require(Shared.Trinkets)
local Crates = require(Shared.Crates)
local Cosmetics = require(Shared.Cosmetics)

-- NOTE: no GoobMath here, deliberately.
--
-- The client never sees a raw Goob. What arrives over StateSync is a
-- SERIALISED one — nickname, mass, power, ageTier, ageText and so on, already
-- computed server-side — and it carries no bornAt, no inheritedAge and no
-- lineage table of the shape GoobMath expects. Calling GoobMath.ageSeconds()
-- on it subtracts nil and takes the whole panel down with it, which is exactly
-- what this file used to do. If a number is needed here, it is sent; if it is
-- not sent, it gets added to the snapshot rather than recomputed from parts
-- the client does not have.

-- Where a locked item comes from. A padlock with no explanation is the most
-- annoying thing a wardrobe can show you.
local SOURCE_TEXT = {
    starter     = "Starter",
    season      = "Beta Season reward",
    shop        = "Shop",
    ascend      = "Earned by ascending",
    achievement = "Achievement",
    crate_goop  = "Found in Goop Crates",
    crate_deep  = "Found in Deep Crates",
    beta        = "BETA SEASON ONLY — never printed again",
}

local Theme = require(script.Parent.Theme)
local Layout = require(script.Parent.Layout)
local Panels = require(script.Parent.Panels)

local player = Players.LocalPlayer

local ArenaHud = {}

-- Filled in by init.client. Declared up front so every handler below closes
-- over the table rather than over a local that may not exist yet — the
-- `local function` scoping trap that took down two earlier builds.
ArenaHud.on = {
    usePower = function(_slot: number, _aim: Vector3?) end,
    setPower = function(_id: string) end,
    equipTrinket = function(_id: string?, _slot: number) end,
    openCrate = function(_id: string) end,
    equipCosmetic = function(_kind: string, _id: string) end,
    setActiveGoob = function(_id: string) end,
    -- Irreversible, so it goes through init.client's two-step confirmation
    -- rather than firing the remote from a card.
    gulpGoob = function(_id: string) end,
    joinPit = function() end,
    leavePit = function() end,
}

local gui: ScreenGui
local statCard: Frame
local massLabel: TextLabel
local worthLabel: TextLabel
local meltLabel: TextLabel
local globLabel: TextLabel
local seasonLabel: TextLabel
local statusStrip: Frame
local statusLabel: TextLabel
local bankBar: Frame
local bankFill: Frame
local menu: Frame          -- the header button's frame
local menuHeader: TextButton
local menuList: ScrollingFrame
local menuOpen = false

-- THREE SLOTS, NOT ONE BUTTON.
--
-- The game used to carry exactly one power, on the argument that a nine-year-
-- old has one thumb free. That argument still holds for the CHOSEN power — but
-- two of the three are not choices. DASH and SPLIT are verbs the game is built
-- out of: you cannot play agar-shaped without a lunge and a way to throw part
-- of yourself at something. Making them compete for the one slot meant every
-- player picked the same two and the "choice" was a formality.
--
-- So: slot 1 is DASH, slot 2 is SPLIT, slot 3 is yours. Fixed order, fixed
-- position, every round — muscle memory is worth more than flexibility on a
-- control you press under pressure.
type Slot = { button: TextButton, sweep: Frame, cost: TextLabel, name: TextLabel }
local slots: { Slot } = {}
local sheet: Frame
local sheetTitle: TextLabel
local sheetBody: ScrollingFrame
-- A plain frame beside sheetBody, for the two tabs whose renderers live in
-- Panels and bring their own scroller. Nesting a ScrollingFrame inside another
-- one traps the drag on a phone: the inner list eats the gesture and the outer
-- panel never moves, which is a bug you only find on hardware.
local sheetHost: ScrollingFrame

local menuButtons: { [string]: TextButton } = {}
local openTab: string? = nil
local latest: any = nil
local profile: any = nil
local pit: any = nil

local TABS = {
    { id = "crates",    icon = "🎁", name = "CRATES" },
    { id = "wear",      icon = "👕", name = "WARDROBE" },
    { id = "trinkets",  icon = "🔧", name = "TRINKETS" },
    { id = "powers",    icon = "⚡", name = "POWERS" },
    { id = "inventory", icon = "🫧", name = "YOUR GOOBS" },
    { id = "trade",     icon = "🤝", name = "TRADE" },
    { id = "season",    icon = "⭐", name = "BETA SEASON" },
    { id = "crew",      icon = "🛡️", name = "YOUR CREW" },
    { id = "standoff",  icon = "🥊", name = "THE STANDOFF" },
}

-- Tabs whose body is drawn by Panels rather than by this file. They render
-- into sheetHost; everything else renders into sheetBody.
local DELEGATED = { season = true, crew = true }

-- One card shape for every ownable thing in the game — a skin, a trinket, a
-- power, a Goob. Rarity is a stroke colour and nothing else, so the eye learns
-- one rule instead of four. The previous UI drew Goobs, cosmetics and season
-- rewards three different ways, which is most of why the screen felt like
-- several games stapled together.
local function card(parent: Instance, order: number, height: number, rarity: string?): Frame
    local f = Instance.new("Frame")
    f.Name = "Card"
    f.Size = UDim2.new(1, 0, 0, height)
    f.BackgroundColor3 = Theme.BG_SOFT
    f.BackgroundTransparency = 0.2
    f.BorderSizePixel = 0
    f.LayoutOrder = order
    f.Parent = parent
    Theme.corner(f, 12)
    if rarity then
        Theme.stroke(f, Cosmetics.RARITY_COLOUR[rarity] or Theme.TEXT_DIM, 2)
    end
    return f
end

-- A skin is a material and a hue on a ball seen across an arena, so the
-- preview is exactly that: a swatch in the item's own colour. Showing a name
-- alone asks the player to buy something they cannot picture.
local function swatch(parent: Instance, item: any, size: number)
    local sw = Instance.new("Frame")
    sw.Name = "Swatch"
    sw.Size = UDim2.fromOffset(size, size)
    sw.Position = UDim2.fromOffset(10, 10)
    sw.BackgroundColor3 = item.colour or Color3.fromRGB(150, 160, 170)
    sw.BorderSizePixel = 0
    sw.Parent = parent
    Theme.corner(sw, 999)
    Theme.stroke(sw, Cosmetics.RARITY_COLOUR[item.rarity] or Theme.TEXT_DIM, 2)
    if item.emoji and item.emoji ~= "" then
        local e = Theme.label({
            Size = UDim2.fromScale(1, 1), Text = item.emoji,
            TextSize = math.floor(size * 0.6),
            TextXAlignment = Enum.TextXAlignment.Center,
        })
        e.Parent = sw
    end
    return sw
end

-- ── Small builders ─────────────────────────────────────────────────────────

local function row(parent: Instance, height: number, order: number): Frame
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, height)
    f.BackgroundColor3 = Theme.BG_SOFT
    f.BackgroundTransparency = 0.25
    f.BorderSizePixel = 0
    f.LayoutOrder = order
    f.Parent = parent
    Theme.corner(f, 12)
    return f
end

local function actionButton(parent: Instance, text: string, colour: Color3,
    width: number, rightOffset: number?): TextButton
    local b = Theme.button(text, colour, UDim2.fromOffset(width, Layout.MIN_TAP))
    b.TextSize = 18
    b.AnchorPoint = Vector2.new(1, 0.5)
    b.Position = UDim2.new(1, -(rightOffset or 10), 0.5, 0)
    b.Parent = parent
    return b
end

-- ── The sheet ──────────────────────────────────────────────────────────────

local function clearSheet()
    for _, child in ipairs(sheetHost:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    for _, child in ipairs(sheetBody:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
end

local function renderCrates()
    for i, crate in ipairs(Crates.LIST) do
        local r = row(sheetBody, 84, i)
        local name = Theme.label({
            Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -160, 0, 26),
            Text = crate.name, TextSize = 22, TextColor3 = Theme.GOLD,
        })
        name.Parent = r
        local blurb = Theme.label({
            Position = UDim2.fromOffset(14, 34), Size = UDim2.new(1, -160, 0, 20),
            Text = crate.blurb, TextSize = 14, TextColor3 = Theme.TEXT_DIM,
            TextWrapped = true,
        })
        blurb.Parent = r

        -- The pity counter is shown, always. A gacha whose cliff is invisible
        -- is a gacha that farms the player; one that says "three more and it
        -- is guaranteed" is a gacha the player is choosing to play.
        local pity = (profile and profile.cratePity and profile.cratePity[crate.id]) or 0
        local left = Crates.rollsUntilPity(crate.id, pity)
        local meter = Theme.label({
            Position = UDim2.fromOffset(14, 56), Size = UDim2.new(1, -160, 0, 18),
            Text = crate.price > 0
                and ("💧%s   ·   %d more until a guaranteed %s")
                    :format(Format.short(crate.price), left, crate.pityFloor)
                or "earned from Beta Season tiers",
            TextSize = 13, TextColor3 = Theme.ACCENT,
        })
        meter.Parent = r

        if crate.price > 0 then
            local afford = profile and (profile.glob or 0) >= crate.price
            local btn = actionButton(r, afford and "OPEN" or "NEED 💧",
                afford and Theme.GOOD or Theme.BG_SOFT, 116)
            btn.Active = afford == true
            btn.Activated:Connect(function()
                if afford then ArenaHud.on.openCrate(crate.id) end
            end)
        end
    end
end

local function renderTrinkets()
    local owned = (profile and profile.trinketsOwned) or {}
    local slots = (profile and profile.trinketSlots) or {}
    local equipped: { [string]: number } = {}
    for i, id in ipairs(slots) do equipped[id] = i end

    local header = row(sheetBody, 56, 0)
    local resolved = Trinkets.resolve(slots)
    local summary = Theme.label({
        Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -24, 0, 44),
        Text = ("%d / %d slots  ·  melt x%.2f  ·  pellets x%.2f  ·  bank %+.0f%%")
            :format(#slots, Trinkets.SLOTS, resolved.leakMult, resolved.pelletMult,
                    resolved.bankHaste * 100),
        TextSize = 15, TextColor3 = Theme.TEXT_DIM, TextWrapped = true,
    })
    summary.Parent = header

    for i, t in ipairs(Trinkets.LIST) do
        local have = owned[t.id] == true
        local slot = equipped[t.id]
        local r = row(sheetBody, 66, i)
        local name = Theme.label({
            Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -150, 0, 24),
            Text = have and t.name or ("🔒 " .. t.name),
            TextSize = 19,
            TextColor3 = slot and Theme.GOOD or (have and Theme.TEXT or Theme.TEXT_DIM),
        })
        name.Parent = r
        local blurb = Theme.label({
            Position = UDim2.fromOffset(14, 32), Size = UDim2.new(1, -150, 0, 22),
            Text = have and t.blurb or ("Found in Deep Crates  ·  " .. t.rarity),
            TextSize = 13, TextColor3 = Theme.TEXT_DIM, TextWrapped = true,
        })
        blurb.Parent = r

        if have then
            local full = #slots >= Trinkets.SLOTS and not slot
            local btn = actionButton(r,
                slot and "REMOVE" or (full and "FULL" or "EQUIP"),
                slot and Theme.BAD or (full and Theme.BG_SOFT or Theme.ACCENT), 108)
            btn.Active = not full
            btn.Activated:Connect(function()
                if slot then
                    ArenaHud.on.equipTrinket(nil, slot)
                elseif not full then
                    ArenaHud.on.equipTrinket(t.id, #slots + 1)
                end
            end)
        end
    end
end

-- The Standoff is reachable from the menu, from anywhere on the island. There
-- is a sign and a join pad out by the ring as well, because a physical thing
-- you can roll onto is how a seven-year-old finds out a mode exists — but
-- nobody should have to cross the map to press a button they can see.
local function renderStandoff()
    local intro = row(sheetBody, 92, 0)
    local text = Theme.label({
        Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -24, 0, 76),
        Text = "Two blobs, the same mass, one ring.\n\n"
            .. "Whatever you arrived with is taken away — both fighters are set "
            .. "to the same size, so it is steering and power timing and nothing "
            .. "else. Last one in the ring takes the pot.",
        TextSize = 15, TextColor3 = Theme.TEXT_DIM, TextWrapped = true,
    })
    text.Parent = intro

    local status = row(sheetBody, 68, 1)
    local queued = false
    for _, n in ipairs((pit and pit.alive) or {}) do
        if n == player.DisplayName then queued = true end
    end
    local inMatch = pit and pit.inMatch

    local line = Theme.label({
        Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -150, 0, 24),
        Text = inMatch and ("FIGHT IN PROGRESS · %d left"):format(#((pit and pit.alive) or {}))
            or ("%d / %d waiting"):format((pit and pit.queued) or 0, (pit and pit.minPlayers) or 2),
        TextSize = 19, TextColor3 = inMatch and Theme.BAD or Theme.TEXT,
    })
    line.Parent = status
    local sub = Theme.label({
        Position = UDim2.fromOffset(14, 34), Size = UDim2.new(1, -150, 0, 20),
        Text = (pit and (pit.lobbySeconds or 0) > 0)
            and ("starting in %ds"):format(pit.lobbySeconds)
            or "your stake is a slice of your income, never a Goob",
        TextSize = 13, TextColor3 = Theme.TEXT_DIM, TextWrapped = true,
    })
    sub.Parent = status

    if not inMatch then
        local btn = actionButton(status, queued and "LEAVE" or "ENTER",
            queued and Theme.BG_SOFT or Theme.BAD, 116)
        btn.Activated:Connect(function()
            if queued then ArenaHud.on.leavePit() else ArenaHud.on.joinPit() end
        end)
    end
end

local function renderPowers()
    local banked = (profile and profile.lifetimeBanked) or 0
    local current = (profile and profile.powerId) or Powers.DEFAULT
    local uses = (profile and profile.powerUses) or {}
    local granted = (profile and profile.powersGranted) or {}

    -- ── THE TWO YOU ALWAYS HAVE ───────────────────────────────────────────
    --
    -- Listed first and marked as fixed, because a player who cannot see DASH
    -- and SPLIT anywhere in this panel reasonably concludes they are not
    -- powers — and then wonders why two of their three buttons are missing
    -- from the list of powers.
    local head = card(sheetBody, 0, 62)
    local hl = Theme.label({
        Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -24, 0, 46),
        Text = "Slot 1 is DASH and slot 2 is SPLIT — always, for everyone."
            .. "\nThis list is slot 3.",
        TextSize = 14, TextColor3 = Theme.TEXT, TextWrapped = true,
    })
    hl.Parent = head

    local nextPower, gap = Powers.nextLocked(banked)
    local head2 = card(sheetBody, 1, 44)
    local hl2 = Theme.label({
        Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -24, 0, 28),
        Text = nextPower
            and ("Next: %s at 💧%s  —  %s to go"):format(nextPower.name,
                Format.short(nextPower.unlockBanked), Format.short(gap))
            or "Every power on the banking ladder is unlocked.",
        TextSize = 14, TextColor3 = Theme.TEXT_DIM, TextWrapped = true,
    })
    hl2.Parent = head2

    -- The season powers are in here too, locked, on purpose: a prize nobody
    -- knows exists is not a prize. Powers.catalogue is the one list that holds
    -- both pools so this panel cannot drift out of step with the server.
    for idx, p in ipairs(Powers.catalogue()) do
        local i = idx + 1
        local unlocked = granted[p.id] == true or banked >= p.unlockBanked
        local mine = uses[p.id] or 0
        local tier = Powers.masteryTier(mine)
        local r = card(sheetBody, i, 86, unlocked and "Common" or nil)
        local name = Theme.label({
            Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -150, 0, 24),
            Text = unlocked and p.name or ("🔒 " .. p.name),
            TextSize = 20,
            TextColor3 = (p.id == current) and Theme.GOOD or (unlocked and p.color or Theme.TEXT_DIM),
        })
        name.Parent = r
        local blurb = Theme.label({
            Position = UDim2.fromOffset(14, 32), Size = UDim2.new(1, -150, 0, 30),
            Text = unlocked
                and ("%s   ·   costs %d%% of you   ·   %ds"):format(p.blurb, p.cost * 100, p.cooldown)
                -- A season power says so rather than quoting an unreachable
                -- price. It is not on the banking ladder at any number, and
                -- printing "unlocks at 💧inf" would be both wrong and cruel.
                or (p.season
                    and "⭐ BETA SEASON reward — earned on the free track. Cannot be bought."
                    or ("Unlocks at 💧%s banked  (you have 💧%s)")
                        :format(Format.short(p.unlockBanked), Format.short(banked))),
            TextSize = 13, TextColor3 = Theme.TEXT_DIM, TextWrapped = true,
        })
        blurb.Parent = r

        if unlocked then
            local nextTier, toGo = Powers.masteryNext(mine)
            local stars = string.rep("★", tier) .. string.rep("☆", Powers.MASTERY_MAX_TIER - tier)
            local mastery = Theme.label({
                Position = UDim2.fromOffset(14, 62), Size = UDim2.new(1, -150, 0, 20),
                Text = nextTier
                    and ("%s  %d uses  ·  %d more for mastery %d"):format(stars, mine, toGo, nextTier)
                    or ("%s  mastered — %d%% quicker, %d%% cheaper"):format(stars,
                        Powers.MASTERY_MAX_TIER * Powers.MASTERY_COOLDOWN_PER_TIER * 100,
                        Powers.MASTERY_MAX_TIER * Powers.MASTERY_COST_PER_TIER * 100),
                TextSize = 12,
                TextColor3 = tier > 0 and Theme.GOLD or Theme.TEXT_DIM,
            })
            mastery.Parent = r
        end

        if unlocked and p.id ~= current then
            local btn = actionButton(r, "CARRY", Theme.ACCENT, 108)
            btn.Activated:Connect(function() ArenaHud.on.setPower(p.id) end)
        end
    end
end

local KINDS = {
    { id = "skin",  label = "BODY" },
    { id = "trail", label = "TRAIL" },
    { id = "eyes",  label = "EYES" },
    { id = "crown", label = "HAT" },
}
local wearKind = "skin"

local function renderWear()
    local owned = (profile and profile.cosmeticsOwned) or {}
    local worn = (profile and profile.loadout) or {}

    -- Kind switcher. Four slots is too many to scroll past every time you want
    -- a hat, and a tab strip is cheaper to read than four headings.
    local strip = card(sheetBody, 0, 50)
    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.Padding = UDim.new(0, 6)
    layout.Parent = strip
    for i, k in ipairs(KINDS) do
        local b = Theme.button(k.label,
            wearKind == k.id and Theme.ACCENT or Theme.BG,
            UDim2.fromOffset(Layout.isCompact() and 66 or 92, Layout.MIN_TAP - 6))
        b.Name = "Kind_" .. k.id
        b.TextSize = Layout.isCompact() and 13 or 15
        b.LayoutOrder = i
        b.Parent = strip
        b.Activated:Connect(function()
            wearKind = k.id
            ArenaHud.refreshSheet()
        end)
    end

    local items = Cosmetics.ofKind(wearKind)
    local ownedCount, order = 0, 1
    for _, item in ipairs(items) do
        local have = owned[item.id] == true
        if have then ownedCount += 1 end
        order += 1
        local isWorn = worn[wearKind] == item.id
        local c = card(sheetBody, order, 62, have and item.rarity or nil)
        swatch(c, item, 42)

        local name = Theme.label({
            Position = UDim2.fromOffset(62, 8), Size = UDim2.new(1, -190, 0, 24),
            Text = have and item.name or ("🔒 " .. item.name),
            TextSize = 18,
            TextColor3 = isWorn and Theme.GOOD
                or (have and (Cosmetics.RARITY_COLOUR[item.rarity] or Theme.TEXT) or Theme.TEXT_DIM),
        })
        name.Parent = c

        local sub = Theme.label({
            Position = UDim2.fromOffset(62, 32), Size = UDim2.new(1, -190, 0, 20),
            Text = have and (isWorn and ("WORN  ·  " .. item.rarity) or item.rarity)
                or SOURCE_TEXT[item.source] or item.rarity,
            TextSize = 13, TextColor3 = Theme.TEXT_DIM,
        })
        sub.Parent = c

        if have and not isWorn then
            local b = actionButton(c, "WEAR", Theme.ACCENT, 104)
            b.Activated:Connect(function()
                ArenaHud.on.equipCosmetic(wearKind, item.id)
            end)
        end
    end

    sheetTitle.Text = ("👕  WARDROBE   %d / %d"):format(ownedCount, #items)
end

local function renderInventory()
    local goobs = (profile and profile.goobs) or {}
    local activeId = profile and profile.activeGoobId

    local header = card(sheetBody, 0, 74)
    local sum = Theme.label({
        Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -24, 0, 40),
        Text = ("%d Goob%s  ·  age never resets and cannot be farmed, which is the only reason it is worth anything")
            :format(#goobs, #goobs == 1 and "" or "s"),
        TextSize = 14, TextColor3 = Theme.TEXT_DIM, TextWrapped = true,
    })
    sum.Parent = header

    -- WHERE GOOBS AND THEIR FOOD COME FROM NOW. There used to be a Snack Stand
    -- and an Egg Stand for this, both of which sold progress for idle income
    -- and neither of which had anything to do with the game being played. Both
    -- are gone; finishing a round feeds your Goob and every fifth round hatches
    -- one. This line is the whole explanation, and it has to be here, because a
    -- player who cannot see where the next egg comes from assumes there is not
    -- one.
    local toEgg = profile and profile.roundsToEgg or 0
    local eggLine = Theme.label({
        Position = UDim2.fromOffset(14, 46), Size = UDim2.new(1, -24, 0, 22),
        Text = (profile and profile.eggCapped)
            and ("🥚 Stable full — %d / %d"):format(#goobs, (profile and profile.maxGoobs) or 8)
            or ("🥚 Next egg in %d round%s  ·  finishing a round also feeds your Goob")
                :format(toEgg, toEgg == 1 and "" or "s"),
        TextSize = 13, TextColor3 = Theme.GOLD,
    })
    eggLine.Parent = header

    for i, goob in ipairs(goobs) do
        local tint = goob.ageColor or Theme.TEXT_DIM
        local c = card(sheetBody, i, 74)
        Theme.stroke(c, tint, 2)

        local dot = Instance.new("Frame")
        dot.Name = "GoobDot"
        dot.Size = UDim2.fromOffset(44, 44)
        dot.Position = UDim2.fromOffset(10, 14)
        dot.BackgroundColor3 = Color3.fromHSV(goob.hue or 0.5, 0.42, 0.8)
        dot.BorderSizePixel = 0
        dot.Parent = c
        Theme.corner(dot, 999)
        Theme.stroke(dot, tint, 2)

        local name = Theme.label({
            Position = UDim2.fromOffset(64, 8), Size = UDim2.new(1, -190, 0, 24),
            Text = (goob.id == activeId and "★ " or "") .. tostring(goob.nickname),
            TextSize = 19,
            TextColor3 = goob.id == activeId and Theme.GOOD or Theme.TEXT,
        })
        name.Parent = c

        local stats = Theme.label({
            Position = UDim2.fromOffset(64, 32), Size = UDim2.new(1, -190, 0, 20),
            Text = ("%s %s  ·  ⚡%s  ·  x%.2f power"):format(
                goob.ageEmoji or "", goob.ageTier or "?",
                goob.powerText or "0", goob.ageMult or 1),
            TextSize = 14, TextColor3 = tint,
        })
        stats.Parent = c

        local age = Theme.label({
            Position = UDim2.fromOffset(64, 52), Size = UDim2.new(1, -190, 0, 18),
            Text = ("%s old  ·  gen %d"):format(goob.ageText or "new", goob.generation or 1),
            TextSize = 12, TextColor3 = Theme.TEXT_DIM,
        })
        age.Parent = c

        if goob.id ~= activeId then
            local b = actionButton(c, "CARRY", Theme.ACCENT, 96)
            b.Activated:Connect(function() ArenaHud.on.setActiveGoob(goob.id) end)

            -- GULP: feed this one to the Goob you are carrying. It is the mass
            -- sink the entire economy rests on — the ONLY way a Goob ever
            -- leaves the world — and until now the only button for it lived in
            -- the drawer that has just been deleted. Removing that screen
            -- without putting this somewhere would have left the world's total
            -- mass with no exit at all, which is the quiet kind of breakage
            -- that takes a month of live data to notice.
            --
            -- Irreversible, so it does not fire the remote: it calls through
            -- to init.client's two-step confirmation, which spells out exactly
            -- what is destroyed and what is gained before anything happens.
            local g = actionButton(c, "GULP", Theme.WARN, 88, 114)
            g.Activated:Connect(function() ArenaHud.on.gulpGoob(goob.id) end)
        end
    end

    sheetTitle.Text = ("🫧  YOUR GOOBS   %d"):format(#goobs)
end

local function renderTrade()
    local intro = card(sheetBody, 0, 118)
    local text = Theme.label({
        Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -24, 0, 98),
        Text = "Roll up to another player and a trade request appears for both of you.\n\n"
            .. "Goobs are the only thing that can be traded, and the only way one ever "
            .. "leaves the world is by being eaten. Nothing here is ever destroyed by "
            .. "accident: if either side changes an offer after confirming, BOTH "
            .. "confirmations reset.",
        TextSize = 14, TextColor3 = Theme.TEXT_DIM, TextWrapped = true,
    })
    text.Parent = intro

    local goobs = (profile and profile.goobs) or {}
    local head = card(sheetBody, 1, 44)
    local h = Theme.label({
        Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -24, 0, 28),
        Text = ("You have %d Goob%s to offer"):format(#goobs, #goobs == 1 and "" or "s"),
        TextSize = 17, TextColor3 = Theme.GOLD,
    })
    h.Parent = head

    for i, goob in ipairs(goobs) do
        local tint = goob.ageColor or Theme.TEXT_DIM
        local c = card(sheetBody, i + 1, 56)
        Theme.stroke(c, tint, 2)
        local name = Theme.label({
            Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24),
            Text = tostring(goob.nickname), TextSize = 18, TextColor3 = Theme.TEXT,
        })
        name.Parent = c
        local sub = Theme.label({
            Position = UDim2.fromOffset(14, 30), Size = UDim2.new(1, -28, 0, 20),
            Text = ("%s %s  ·  ⚡%s"):format(goob.ageEmoji or "",
                goob.ageTier or "?", goob.powerText or "0"),
            TextSize = 13, TextColor3 = tint,
        })
        sub.Parent = c
    end
end

--- Open or close the tab list. Closed by default on a phone, where the screen
--- is the scarce thing; open by default anywhere with room for it.
function ArenaHud.setMenuOpen(open: boolean)
    menuOpen = open
    if menuHeader then
        menuHeader.Text = open and "\u{2715}  MENU" or "\u{2630}  MENU"
    end
    ArenaHud.applyLayout()
end

function ArenaHud.closeSheet()
    openTab = nil
    sheet.Visible = false
    for _, b in pairs(menuButtons) do
        Theme.setButtonActive(b, false)
    end
end

function ArenaHud.openSheet(tab: string)
    -- THE SHEET IS THE ONLY PANEL. The season tab used to hand off to a second
    -- screen entirely (`on.openLegacy`), which opened the old Goob drawer and
    -- drew the season track inside it — with the Snack Stand reparented on top
    -- of the track, because that drawer moved the stand into itself whenever
    -- arena mode was on. Two panels, one screen, and the season list unreadable
    -- underneath a shop for a system that no longer existed.
    --
    -- Now there is nowhere to hand off TO. Every tab renders here, and the two
    -- whose renderers still live in Panels render into sheetHost, inside this
    -- same sheet, under this same title bar and close button.
    if openTab == tab then
        ArenaHud.closeSheet()
        return
    end

    openTab = tab
    clearSheet()
    -- The selected row INVERTS: white surface, black label. Setting only the
    -- background left near-white text on a near-white fill — unreadable, and
    -- the one row the player most needs to read. In a greyscale palette
    -- brightness is the only emphasis axis there is, so it has to be used
    -- properly rather than half-applied.
    for id, b in pairs(menuButtons) do
        Theme.setButtonActive(b, id == tab)
    end

    for _, entry in ipairs(TABS) do
        if entry.id == tab then
            sheetTitle.Text = entry.icon .. "  " .. entry.name
        end
    end

    sheetBody.Visible = not DELEGATED[tab]
    sheetHost.Visible = DELEGATED[tab] == true

    if DELEGATED[tab] then
        Panels.render(tab, sheetHost, profile)
    elseif tab == "crates" then renderCrates()
    elseif tab == "trinkets" then renderTrinkets()
    elseif tab == "powers" then renderPowers()
    elseif tab == "wear" then renderWear()
    elseif tab == "inventory" then renderInventory()
    elseif tab == "standoff" then renderStandoff()
    elseif tab == "trade" then renderTrade() end

    sheet.Visible = true
    ArenaHud.applyLayout()
end

-- Re-render whatever is open, after the profile changes underneath it.
function ArenaHud.refreshSheet()
    if openTab then
        local tab = openTab
        openTab = nil
        ArenaHud.openSheet(tab)
    end
end

-- ── Layout ─────────────────────────────────────────────────────────────────

function ArenaHud.applyLayout()
    if not gui then return end
    local u = Layout.usable()
    local compact = Layout.isCompact()
    local pad = compact and 8 or 14

    -- ── The menu ──────────────────────────────────────────────────────────
    Layout.setMenuTabs(#TABS)
    local m = Layout.menuMetrics(#TABS)
    local menuX = Layout.menuLeft(#TABS)

    menu.Size = UDim2.fromOffset(m.width, m.headerH)
    menu.Position = UDim2.fromOffset(menuX, m.top)
    menuHeader.Size = UDim2.fromOffset(m.width, m.headerH)
    menuHeader.Position = UDim2.fromOffset(menuX, m.top)
    menuHeader.TextSize = compact and 14 or 16

    menuList.Size = UDim2.fromOffset(m.width, m.listH)
    menuList.Position = UDim2.fromOffset(u.X - m.width - m.listRight, m.listTop)
    menuList.Visible = menuOpen
    menuList.ScrollingEnabled = m.scrolls
    for _, entry in ipairs(TABS) do
        local b = menuButtons[entry.id]
        if b then
            b.Size = UDim2.new(1, 0, 0, m.rowH)
            b.TextSize = compact and 13 or 15
        end
    end

    -- Stat card: top-left, and never allowed to reach the rail.
    local cardW = Layout.fit(compact and 116 or 220, 96, menuX - pad * 2)
    statCard.Size = UDim2.fromOffset(cardW, compact and 64 or 88)
    statCard.Position = UDim2.fromOffset(pad, m.top)
    massLabel.TextSize = compact and 24 or 34
    worthLabel.TextSize = compact and 13 or 17
    meltLabel.TextSize = compact and 11 or 14

    -- Glob + season: under the stat card, same column. They used to sit
    -- top-right, which is exactly where the rail now lives.
    -- Stacked with real gaps between them. The first pass put Glob at +66 with
    -- a height of 20 and the season line at +84, which overlap by two pixels —
    -- invisible to the eye and caught immediately by the geometry audit, which
    -- is exactly the kind of thing that audit is for.
    local cardH = statCard.Size.Y.Offset
    local globY = m.top + cardH + (compact and 6 or 8)
    local globH = compact and 20 or 26
    globLabel.Position = UDim2.fromOffset(pad + 4, globY)
    globLabel.Size = UDim2.fromOffset(cardW, globH)
    globLabel.TextSize = compact and 15 or 20
    seasonLabel.Position = UDim2.fromOffset(pad + 4, globY + globH + (compact and 2 or 4))
    seasonLabel.Size = UDim2.fromOffset(cardW, compact and 16 or 20)
    seasonLabel.TextSize = compact and 11 or 14

    -- Status strip: top-centre, in the gap between the stat column and the
    -- rail. Centred on that gap rather than on the screen, so it cannot drift
    -- under either of them as the rail changes width.
    local gapL = pad + cardW + pad
    local gapR = menuX - pad
    local stripW = math.max(140, math.min(compact and 260 or 420, gapR - gapL))
    statusStrip.Visible = true
    statusStrip.Size = UDim2.fromOffset(stripW, compact and 28 or 34)
    statusStrip.Position = UDim2.fromOffset(
        Layout.fit(math.floor((gapL + gapR) / 2 - stripW / 2), gapL, math.max(gapL, gapR - stripW)),
        m.top)
    statusLabel.TextSize = compact and 13 or 17

    -- ── The hotbar: three slots, bottom-centre ────────────────────────────
    --
    -- In the band between the thumbstick and the jump button, which is the
    -- only part of the bottom edge a phone player's thumb can reach. Three
    -- buttons share it: DASH, SPLIT and whatever you chose to bring.
    -- SIZED TO THE BAND, not to a nice round number. Three 62px buttons plus
    -- gaps is 198px and the gap between the thumbstick and the jump button on
    -- a 568-wide phone is 178 — so the outer two slots landed under the touch
    -- controls, where a thumb cannot reach them. The width is derived from the
    -- band so it cannot be wrong again.
    local left, right = Layout.bottomGap()
    local slotGap = compact and 5 or 10
    local band = math.max(120, right - left - 12)
    local slotW = math.min(compact and 62 or 84,
        math.floor((band - slotGap * (#slots - 1)) / #slots))
    local barW = #slots * slotW + (#slots - 1) * slotGap
    local barX = math.floor((left + right) / 2 - barW / 2)
    barX = Layout.fit(barX, 8, math.max(8, u.X - barW - 8))
    for i, slot in ipairs(slots) do
        slot.button.Size = UDim2.fromOffset(slotW, slotW)
        slot.button.Position = UDim2.fromOffset(
            barX + (i - 1) * (slotW + slotGap), u.Y - slotW - (compact and 12 or 24))
        slot.button.TextSize = compact and 12 or 15
        slot.sweep.Size = UDim2.fromScale(1, 0)
    end

    -- ── The sheet ─────────────────────────────────────────────────────────
    --
    -- Anchored to the LEFT of the rail rather than centred, so opening a panel
    -- never covers the menu you opened it from — you can see what is selected
    -- and switch straight to the next tab without closing anything.
    local sheetTop = m.top + (compact and 34 or 42)
    local sheetW = math.max(200, (u.X - m.width - m.listRight) - pad * 2)
    local sheetH = math.max(140, u.Y - sheetTop - (compact and 88 or 118))
    if not compact then
        sheetW = math.min(sheetW, 660)
        sheetH = math.min(sheetH, 520)
    end
    sheet.Size = UDim2.fromOffset(sheetW, sheetH)
    sheet.Position = UDim2.fromOffset(math.max(pad, menuX - pad - sheetW), sheetTop)
    if sheetHost then
        sheetHost.Position = sheetBody.Position
        sheetHost.Size = sheetBody.Size
    end
end

-- ── Build ──────────────────────────────────────────────────────────────────

function ArenaHud.build(): ScreenGui
    gui = Instance.new("ScreenGui")
    gui.Name = "ArenaHud"
    gui.ResetOnSpawn = false
    -- false: with IgnoreGuiInset on, Roblox's top bar covers the first ~36px,
    -- which is exactly where the stat card and the menu button are.
    gui.IgnoreGuiInset = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 12
    gui.Parent = player:WaitForChild("PlayerGui")

    -- Stat card.
    statCard = Instance.new("Frame")
    statCard.Name = "StatCard"
    statCard.BackgroundColor3 = Theme.BG
    statCard.BackgroundTransparency = 0.12
    statCard.BorderSizePixel = 0
    statCard.Parent = gui
    Theme.corner(statCard, 14)
    Theme.stroke(statCard, Color3.fromRGB(18, 20, 26), 2)

    -- NAMED, all three. An unnamed label is findable only by its own text,
    -- which means the only test anybody can write for it is "does some label
    -- somewhere contain this string" — and that passes just as happily on a
    -- panel wired to nothing as on a working one. These three are the stat
    -- card's entire contract with the server push, so they get to be findable.
    massLabel = Theme.label({
        Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -18, 0, 34),
        Text = "0", TextSize = 32, TextColor3 = Theme.GOLD,
    })
    massLabel.Name = "Mass"
    massLabel.Parent = statCard

    worthLabel = Theme.label({
        Position = UDim2.fromOffset(12, 38), Size = UDim2.new(1, -18, 0, 22),
        Text = "worth 💧0", TextSize = 18, TextColor3 = Theme.ACCENT,
    })
    worthLabel.Name = "Worth"
    worthLabel.Parent = statCard

    meltLabel = Theme.label({
        Position = UDim2.fromOffset(12, 60), Size = UDim2.new(1, -18, 0, 18),
        Text = "not melting yet", TextSize = 14, TextColor3 = Theme.TEXT_DIM,
    })
    meltLabel.Name = "Melt"
    meltLabel.Parent = statCard

    globLabel = Theme.label({
        Text = "💧0", TextSize = 24, TextColor3 = Theme.ACCENT,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    globLabel.Name = "Glob"
    globLabel.Parent = gui

    seasonLabel = Theme.label({
        Text = "BETA SEASON", TextSize = 15, TextColor3 = Theme.GOLD,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    seasonLabel.Name = "Season"
    seasonLabel.Parent = gui

    -- ── The menu ──────────────────────────────────────────────────────────
    --
    -- A header button top-right, and a vertical list of named tabs that drops
    -- out of it. Closed by default on a phone so the world keeps the screen;
    -- open by default on a desktop, where there is room for it to just live
    -- there.
    menu = Instance.new("Frame")
    menu.Name = "Menu"
    menu.BackgroundTransparency = 1
    menu.BorderSizePixel = 0
    menu.Parent = gui

    menuHeader = Instance.new("TextButton")
    menuHeader.Name = "MenuButton"
    menuHeader.Text = "\u{2630}  MENU"
    menuHeader.Font = Theme.FONT
    menuHeader.TextSize = 16
    menuHeader.TextColor3 = Theme.TEXT
    menuHeader.BackgroundColor3 = Theme.BG
    menuHeader.BackgroundTransparency = 0.05
    menuHeader.AutoButtonColor = true
    menuHeader.BorderSizePixel = 0
    menuHeader.Parent = gui
    Theme.corner(menuHeader, 10)
    Theme.stroke(menuHeader, Theme.LINE, 1)
    menuHeader.Activated:Connect(function() ArenaHud.setMenuOpen(not menuOpen) end)

    -- SCROLLING, because eight rows do not always fit above the jump button.
    -- A list that silently clipped its last three tabs would make CREW and THE
    -- STANDOFF unreachable on a phone with no error anywhere.
    menuList = Instance.new("ScrollingFrame")
    menuList.Name = "MenuList"
    menuList.BackgroundColor3 = Theme.BG
    menuList.BackgroundTransparency = 0.05
    menuList.BorderSizePixel = 0
    menuList.ScrollBarThickness = 3
    menuList.ScrollBarImageColor3 = Theme.LINE
    menuList.AutomaticCanvasSize = Enum.AutomaticSize.Y
    menuList.CanvasSize = UDim2.new()
    menuList.Visible = false
    menuList.Parent = gui
    Theme.corner(menuList, 10)
    Theme.stroke(menuList, Theme.LINE, 1)

    local listLayout = Instance.new("UIListLayout")
    listLayout.FillDirection = Enum.FillDirection.Vertical
    listLayout.Padding = UDim.new(0, 3)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = menuList

    local listPad = Instance.new("UIPadding")
    listPad.PaddingTop = UDim.new(0, 6)
    listPad.PaddingBottom = UDim.new(0, 6)
    listPad.PaddingLeft = UDim.new(0, 6)
    listPad.PaddingRight = UDim.new(0, 6)
    listPad.Parent = menuList

    for i, entry in ipairs(TABS) do
        local b = Instance.new("TextButton")
        -- Name kept as Dock_<id>: the mobile geometry audit walks the screen
        -- for this prefix to open every panel in turn, and renaming it would
        -- silently stop it auditing any of them.
        b.Name = "Dock_" .. entry.id
        b.Text = "  " .. entry.icon .. "   " .. entry.name
        b.Font = Theme.FONT
        b.TextSize = 15
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.TextColor3 = Theme.TEXT
        b.BackgroundColor3 = Theme.BG_SOFT
        b.AutoButtonColor = true
        b.BorderSizePixel = 0
        b.LayoutOrder = i
        b.Size = UDim2.new(1, 0, 0, Layout.MIN_TAP)
        b.Parent = menuList
        Theme.corner(b, 8)
        Theme.stroke(b, Theme.LINE, 1)
        menuButtons[entry.id] = b
        b.Activated:Connect(function() ArenaHud.openSheet(entry.id) end)
    end

    -- Status strip + bank bar.
    statusStrip = Instance.new("Frame")
    statusStrip.Name = "Status"
    statusStrip.BackgroundColor3 = Theme.BG
    statusStrip.BackgroundTransparency = 0.25
    statusStrip.BorderSizePixel = 0
    statusStrip.Parent = gui
    Theme.corner(statusStrip, 10)

    statusLabel = Theme.label({
        Size = UDim2.fromScale(1, 1), Text = "SAFE  ·  the Shallows",
        TextSize = 16, TextColor3 = Theme.GOOD,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    statusLabel.Parent = statusStrip

    bankBar = Instance.new("Frame")
    bankBar.Name = "BankBar"
    bankBar.AnchorPoint = Vector2.new(0, 1)
    bankBar.Position = UDim2.new(0, 0, 1, 0)
    bankBar.Size = UDim2.new(1, 0, 0, 4)
    bankBar.BackgroundColor3 = Color3.fromRGB(24, 26, 30)
    bankBar.BorderSizePixel = 0
    bankBar.Visible = false
    bankBar.Parent = statusStrip

    bankFill = Instance.new("Frame")
    bankFill.Size = UDim2.fromScale(0, 1)
    bankFill.BackgroundColor3 = Theme.GOLD
    bankFill.BorderSizePixel = 0
    bankFill.Parent = bankBar

    -- ── The hotbar ────────────────────────────────────────────────────────
    --
    -- One button per slot, built from the same shape so the three read as a
    -- set. The cooldown sweep fills from the bottom BEHIND the label, so the
    -- name stays readable while it recharges — a button you cannot read is a
    -- button you stop looking at.
    for i = 1, 3 do
        local b = Instance.new("TextButton")
        b.Name = "Slot" .. i
        b.Text = ""
        b.Font = Theme.FONT
        b.TextSize = 14
        b.TextColor3 = Theme.TEXT
        b.BackgroundColor3 = Theme.BG
        b.BackgroundTransparency = 0.08
        b.AutoButtonColor = true
        b.BorderSizePixel = 0
        b.ClipsDescendants = true
        b.Parent = gui
        Theme.corner(b, 14)
        Theme.stroke(b, Theme.LINE, 2)

        local sweep = Instance.new("Frame")
        sweep.Name = "Sweep"
        sweep.AnchorPoint = Vector2.new(0, 1)
        sweep.Position = UDim2.new(0, 0, 1, 0)
        sweep.Size = UDim2.fromScale(1, 0)
        sweep.BackgroundColor3 = Theme.TEXT
        sweep.BackgroundTransparency = 0.82
        sweep.BorderSizePixel = 0
        sweep.ZIndex = 0
        sweep.Parent = b

        local nameLabel = Theme.label({
            Name = "Label",
            AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.new(1, -8, 0, 34),
            Text = "", TextSize = 14, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Center,
        })
        nameLabel.ZIndex = 2
        nameLabel.Parent = b

        local cost = Theme.label({
            Name = "Cost",
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.new(1, -8, 0, 16),
            Text = "", TextSize = 12, TextColor3 = Theme.TEXT_DIM,
            TextXAlignment = Enum.TextXAlignment.Center,
        })
        cost.ZIndex = 2
        cost.Parent = b

        local index = i
        b.Activated:Connect(function() ArenaHud.on.usePower(index, nil) end)
        table.insert(slots, { button = b, sweep = sweep, cost = cost, name = nameLabel })
    end

    -- The sheet.
    sheet = Instance.new("Frame")
    sheet.Name = "Sheet"
    sheet.BackgroundColor3 = Theme.BG
    sheet.BackgroundTransparency = 0.04
    sheet.BorderSizePixel = 0
    -- Parked AND invisible. Parking a closed panel off-screen without also
    -- clearing Visible is how a "hidden" drawer kept showing up in the
    -- geometry audit as 300 visible pixels of overflow.
    sheet.Visible = false
    sheet.Parent = gui
    Theme.corner(sheet, 18)
    Theme.stroke(sheet, Color3.fromRGB(18, 20, 26), 3)

    sheetTitle = Theme.label({
        Position = UDim2.fromOffset(18, 12), Size = UDim2.new(1, -84, 0, 30),
        Text = "CRATES", TextSize = 24, TextColor3 = Theme.GOLD,
    })
    sheetTitle.Parent = sheet

    local close = Theme.button("✕", Theme.BG_SOFT, UDim2.fromOffset(Layout.MIN_TAP, Layout.MIN_TAP))
    close.AnchorPoint = Vector2.new(1, 0)
    close.Position = UDim2.new(1, -12, 0, 10)
    close.TextSize = 20
    close.Parent = sheet
    close.Activated:Connect(function() ArenaHud.closeSheet() end)

    sheetBody = Instance.new("ScrollingFrame")
    sheetBody.Name = "Body"
    sheetBody.Position = UDim2.fromOffset(12, 56)
    sheetBody.Size = UDim2.new(1, -24, 1, -68)
    sheetBody.BackgroundTransparency = 1
    sheetBody.BorderSizePixel = 0
    sheetBody.ScrollBarThickness = 5
    sheetBody.AutomaticCanvasSize = Enum.AutomaticSize.Y
    sheetBody.CanvasSize = UDim2.new()
    sheetBody.Parent = sheet

    local bodyLayout = Instance.new("UIListLayout")
    bodyLayout.Padding = UDim.new(0, 8)
    bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bodyLayout.Parent = sheetBody

    -- A SCROLLING host, not a plain frame.
    --
    -- Panels' crew screen lays its rows out at absolute offsets and runs about
    -- 230px tall. On a landscape phone the sheet's body is barely 60px, so
    -- every control below the first ran off the bottom — the audit reported
    -- five elements "off by 144". A fixed-height host cannot hold a panel it
    -- does not control the height of, and Panels is shared with the season
    -- track, which brings its own scroller and fills this exactly.
    sheetHost = Instance.new("ScrollingFrame")
    sheetHost.Name = "Host"
    sheetHost.Position = sheetBody.Position
    sheetHost.Size = sheetBody.Size
    sheetHost.BackgroundTransparency = 1
    sheetHost.BorderSizePixel = 0
    sheetHost.ScrollBarThickness = 5
    sheetHost.ScrollBarImageColor3 = Theme.ACCENT
    sheetHost.AutomaticCanvasSize = Enum.AutomaticSize.Y
    sheetHost.CanvasSize = UDim2.new()
    sheetHost.Visible = false
    sheetHost.Parent = sheet

    -- Open on a desktop, closed on a phone. A menu that covers a third of a
    -- 568-wide screen the moment you spawn is a menu the player closes before
    -- they have read it.
    menuOpen = not Layout.isCompact()
    ArenaHud.setMenuOpen(menuOpen)
    Layout.changed.Event:Connect(ArenaHud.applyLayout)
    return gui
end

-- ── Live update ────────────────────────────────────────────────────────────

function ArenaHud.setProfile(snap: any)
    profile = snap
    if not gui then return end
    globLabel.Text = "💧" .. Format.short(snap.glob or 0)
    local tier = (snap.season and snap.season.tier) or 0
    seasonLabel.Text = ("BETA SEASON · %d"):format(tier)
    ArenaHud.refreshSheet()
end

function ArenaHud.setArena(state: any)
    latest = state
    if not gui or not state then return end
    -- The arena syncs twelve times a second, so without this guard the run
    -- summary is overwritten roughly 83 milliseconds after it appears.
    local showingSummary = (ArenaHud._summaryUntil or 0) > os.clock()

    massLabel.Text = Format.short(state.mass)
    worthLabel.Text = "worth 💧" .. Format.short(state.worth)

    -- The melt readout is the game's one piece of teaching, and it has to say
    -- what is HAPPENING rather than what the number is. "-8/s" means nothing
    -- to a nine-year-old; "melting fast — bank it" is an instruction.
    -- BEACON is the one power whose whole point is that everybody can see it,
    -- so the HUD says so out loud rather than letting the player forget they
    -- are lit up and wonder why three people are converging on them.
    if state.lit then
        meltLabel.Text = "LIT UP — food +45%, everyone sees you"
        meltLabel.TextColor3 = Theme.GOLD
    elseif state.leak <= 0 then
        -- Leak is off in round mode, so "not melting yet" would be a permanent
        -- and meaningless line. Peak size is what a player actually wants back
        -- from this row: it is the number the round is scored on.
        meltLabel.Text = "best this round " .. Format.short(state.peak or state.mass)
        meltLabel.TextColor3 = Theme.TEXT_DIM
    elseif state.leak < state.harvest * 0.5 then
        meltLabel.Text = ("melting -%s/s"):format(Format.short(state.leak))
        meltLabel.TextColor3 = Theme.WARN
    else
        meltLabel.Text = ("MELTING FAST -%s/s"):format(Format.short(state.leak))
        meltLabel.TextColor3 = Theme.BAD
    end

    -- The phase clock owns the status strip whenever the round is not running.
    -- A player in the lobby needs to know how long they have to shop far more
    -- than they need to know which patch of ground they are standing on.
    local phase = state.phase or "PLAYING"
    local left = math.max(0, math.floor(state.phaseLeft or 0))
    local clock = ("%d:%02d"):format(math.floor(left / 60), left % 60)

    local where = state.biome or (state.ring == "VAULT" and "the Vault"
        or state.ring == "SHALLOWS" and "the Shallows" or "the Flats")
    if phase == "LOBBY" then
        -- The field size is announced, and the bot count with it. A player who
        -- works out for themselves that most of the island is bots feels
        -- tricked; a player who was told feels like the game is full. The
        -- honest version is also the one that reads better.
        local who = (state.bots or 0) > 0
            and ("  ·  %d in, %d bots"):format(state.field or 0, state.bots)
            or ""
        statusLabel.Text = ("WAITING ROOM  ·  round %d in %s%s")
            :format((state.round or 0) + 1, clock, who)
        statusLabel.TextColor3 = Theme.ACCENT
    elseif phase == "RESULTS" then
        statusLabel.Text = "ROUND OVER"
        statusLabel.TextColor3 = Theme.GOLD
    elseif showingSummary then
        -- leave the summary up
    elseif state.banking > 0 then
        statusLabel.Text = "BANKING — hold still"
        statusLabel.TextColor3 = Theme.GOLD
    elseif state.safe and state.onRim then
        -- THE METER, COUNTING DOWN, IN SECONDS. Safety on the rim is spendable
        -- now, and a meter the player cannot see is not a mechanic — it is an
        -- ambush. Showing the number is what turns "I got eaten in the safe
        -- zone" into "I stayed out there too long", which is a lesson rather
        -- than a bug report.
        local left2 = math.max(0, math.floor((state.rimGrace or 0) + 0.5))
        statusLabel.Text = ("%s  ·  SAFE %ds  ·  %s"):format(clock, left2, where)
        statusLabel.TextColor3 = left2 <= 4 and Theme.WARN or Theme.GOOD
    elseif state.safe then
        statusLabel.Text = ("%s  ·  SAFE  ·  %s"):format(clock, where)
        statusLabel.TextColor3 = Theme.GOOD
    elseif state.onRim then
        -- Out on the rim with the meter spent. Worth saying explicitly: the
        -- ground looks identical to the ground that was protecting you a
        -- moment ago.
        statusLabel.Text = ("%s  ·  EXPOSED  ·  %s"):format(clock, where)
        statusLabel.TextColor3 = Theme.BAD
    else
        statusLabel.Text = ("%s  ·  DANGER  ·  %s"):format(clock, where)
        statusLabel.TextColor3 = Theme.BAD
    end

    bankBar.Visible = state.banking > 0
    bankFill.Size = UDim2.fromScale(
        math.clamp(state.banking / math.max(0.01, state.bankNeeds), 0, 1), 1)

    -- ── The hotbar, live ──────────────────────────────────────────────────
    --
    -- Driven entirely off `state.slots`, which the server sends. The client
    -- never decides what is in a slot, what it costs, or whether it is ready —
    -- the third slot depends on what the player owns, and "the button said I
    -- could and the server said I could not" is the worst failure a control
    -- can have.
    for i, slot in ipairs(slots) do
        local info = (state.slots or {})[i]
        if info then
            slot.button.Visible = true
            slot.name.Text = (info.name or "—")
                .. ((info.mastery or 0) > 0 and ("\n" .. string.rep("*", info.mastery)) or "")
            if (info.cooldown or 0) > 0.05 then
                slot.cost.Text = ("%.1fs"):format(info.cooldown)
                slot.sweep.Size = UDim2.fromScale(1,
                    math.clamp(info.cooldown / math.max(0.1, info.cooldownMax or 1), 0, 1))
                slot.name.TextColor3 = Theme.TEXT_DIM
            elseif info.locked then
                slot.cost.Text = "LOCKED"
                slot.sweep.Size = UDim2.fromScale(1, 1)
                slot.name.TextColor3 = Theme.TEXT_DIM
            else
                slot.cost.Text = "-" .. Format.short(info.cost or 0)
                slot.sweep.Size = UDim2.fromScale(1, 0)
                slot.name.TextColor3 = Theme.TEXT
            end
            local st = slot.button:FindFirstChildOfClass("UIStroke")
            if st then
                -- Mastery tints a slot WHITE, not a colour: brightness is the
                -- palette's one emphasis axis.
                st.Color = (info.mastery or 0) > 0 and Theme.TEXT or Theme.LINE
            end
        else
            slot.button.Visible = false
        end
    end
end

function ArenaHud.crateResult(result: any)
    if not gui then return end
    -- The reveal reuses the sheet rather than opening a window over it, which
    -- is the same rule as everything else here: one thing at a time.
    ArenaHud.openSheet("crates")
    local banner = Instance.new("Frame")
    banner.Size = UDim2.new(1, 0, 0, 76)
    banner.LayoutOrder = -1
    banner.BackgroundColor3 = Theme.BG_SOFT
    banner.BorderSizePixel = 0
    banner.Parent = sheetBody
    Theme.corner(banner, 12)
    Theme.stroke(banner, Cosmetics.RARITY_COLOUR[result.reward.rarity] or Theme.GOLD, 3)

    local text = Theme.label({
        Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -24, 0, 30),
        Text = ("%s  (%s)"):format(result.reward.name, result.reward.rarity),
        TextSize = 22, TextColor3 = Cosmetics.RARITY_COLOUR[result.reward.rarity] or Theme.GOLD,
    })
    text.Parent = banner

    local sub = Theme.label({
        Position = UDim2.fromOffset(14, 40), Size = UDim2.new(1, -24, 0, 26),
        Text = result.duplicate
            and ("already owned — refunded 💧%s"):format(Format.short(result.refund))
            or "NEW!",
        TextSize = 15, TextColor3 = result.duplicate and Theme.TEXT_DIM or Theme.GOOD,
    })
    sub.Parent = banner

    TweenService:Create(banner, TweenInfo.new(0.25, Enum.EasingStyle.Back,
        Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 76) }):Play()
end

function ArenaHud.setPit(state: any)
    pit = state
    if openTab == "standoff" then
        ArenaHud.refreshSheet()
    end
end

-- A run ended. A loop this short has to CLOSE, or a run simply stops and the
-- player is left reconstructing what happened from a number that has already
-- changed. Deliberately a banner on the status strip rather than a panel: it
-- must not interrupt the next run, which starts the same second.
-- The round results board, shown on the sheet so it cannot cover the game.
function ArenaHud.roundEnded(data: any)
    if not gui or not data or not data.board then return end
    openTab = "results"
    clearSheet()
    sheetTitle.Text = ("🏁  ROUND %d RESULTS"):format(data.round or 0)
    for i, row in ipairs(data.board) do
        local c = card(sheetBody, i, 52, i == 1 and "Legendary" or nil)
        local name = Theme.label({
            Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 24),
            Text = ("#%d  %s"):format(row.place, row.name),
            TextSize = 18,
            TextColor3 = i == 1 and Theme.GOLD or Theme.TEXT,
        })
        name.Parent = c
        local sub = Theme.label({
            Position = UDim2.fromOffset(14, 28), Size = UDim2.new(1, -28, 0, 20),
            Text = ("%s mass  ·  peak %s  ·  💧%s"):format(
                Format.short(row.mass), Format.short(row.peak), Format.short(row.payout)),
            TextSize = 13, TextColor3 = Theme.TEXT_DIM,
        })
        sub.Parent = c
    end
    sheet.Visible = true
    ArenaHud.applyLayout()
end

function ArenaHud.runEnded(s: any)
    if not gui or not s then return end
    local banked = s.ended == "banked"
    statusLabel.Text = banked
        and ("BANKED 💧%s  ·  peak %s  ·  %ds"):format(
            Format.short(s.payout), Format.short(s.peak), math.floor(s.seconds))
        or ("POPPED  ·  peak %s  ·  %ds  ·  %d eaten"):format(
            Format.short(s.peak), math.floor(s.seconds), s.ate or 0)
    statusLabel.TextColor3 = banked and Theme.GOLD or Theme.BAD
    ArenaHud._summaryUntil = os.clock() + 3.5

    -- Hand the strip back to the live readout after a beat. Without this the
    -- summary sticks and the player loses the safe/danger indicator, which is
    -- the most urgent thing on the screen.
    local token = (ArenaHud._summaryToken or 0) + 1
    ArenaHud._summaryToken = token
    task.delay(3.5, function()
        if ArenaHud._summaryToken == token and latest then
            ArenaHud.setArena(latest)
        end
    end)
end

--- The hotbar buttons, for anything that needs to point at them.
function ArenaHud.slotButtons(): { TextButton }
    local out = {}
    for _, slot in ipairs(slots) do
        table.insert(out, slot.button)
    end
    return out
end

function ArenaHud.isSheetOpen(): boolean
    return openTab ~= nil
end

return ArenaHud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--!strict
-- Hud.luau — toasts, and the client's copy of the profile.
--
-- THIS FILE KEEPS SHRINKING, AND THAT IS THE POINT.
--
-- It was 912 lines: a stat panel, a Snack Stand, an egg button, a sliding "MY
-- GOOBS" drawer and a four-tab strip inside it — the entire screen of the
-- collection game the arena replaced. That went when the shops did. What was
-- left was toasts and a first-run tutorial coach; the coach has now gone too.
--
-- WHY THE COACH WENT. It was five steps in a banner across the top of the
-- screen, and on a landscape phone it competed for the one free horizontal
-- band with the round clock — the two took turns hiding each other, which is
-- what the player saw as "the tutorial is overlapping weirdly". The deeper
-- problem is that it was explaining a game that explains itself: eat the small
-- ones, run from the big ones, biggest at the buzzer wins. A player learns
-- that from one round. A banner that teaches what the first thirty seconds
-- teach anyway is pure cost.
--
-- What is left is the one thing that was never duplicated anywhere else:
--
--   * TOASTS — the notification column.
--   * THE STATE — one client-side copy of the last profile push, which
--     ArenaHud, TradeUi and the gulp confirmation all read.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game.ReplicatedStorage.GoobShared
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Layout = require(script.Parent.Layout)

local player = Players.LocalPlayer
local Hud = {}

local gui: ScreenGui
local toastHolder: Frame

local state: any = nil

-- ── Toasts ─────────────────────────────────────────────────────────────────

local TOAST_COLOR = {
    info = Theme.ACCENT, good = Theme.GOOD, warn = Theme.WARN, bad = Theme.BAD,
    trade = Theme.GOLD, secret = Theme.TEXT,
}

-- How many toasts may be stacked at once.
--
-- The holder is a fixed-height column with a list layout, so nothing stopped
-- the stack growing past the bottom of the screen — and on a 568x320 phone
-- three toasts ran 200px off it. Oldest goes when a new one arrives, which is
-- also the right behaviour: the newest message is the one you need.
Hud.MAX_TOASTS = 3

function Hud.toast(message: string, kind: string?)
    local color = TOAST_COLOR[kind or "info"] or Theme.ACCENT

    if toastHolder then
        local live = {}
        for _, child in ipairs(toastHolder:GetChildren()) do
            if child:IsA("Frame") then table.insert(live, child) end
        end
        local allowed = Layout.isCompact() and 2 or Hud.MAX_TOASTS
        while #live >= allowed do
            local oldest = table.remove(live, 1)
            if oldest then oldest:Destroy() end
        end
    end

    local compact = Layout.isCompact()
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, compact and 34 or 46)
    frame.BackgroundColor3 = Theme.PANEL
    frame.BackgroundTransparency = 0.02
    Theme.corner(frame, 10)
    Theme.stroke(frame, color, 2)

    local text = Theme.label({
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        Text = message,
        TextColor3 = color,
        TextSize = compact and 15 or 19,
        TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Center,
    })
    text.Parent = frame
    frame.Parent = toastHolder

    frame.Position = UDim2.new(1, 40, 0, 0)
    TweenService:Create(frame, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0),
    }):Play()

    local hold = (kind == "secret") and 6 or 3.2
    task.delay(hold, function()
        if not frame.Parent then return end
        local out = TweenService:Create(frame, TweenInfo.new(0.3), {
            Position = UDim2.new(1, 60, 0, 0), BackgroundTransparency = 1,
        })
        out.Completed:Connect(function() frame:Destroy() end)
        out:Play()
    end)
end

-- ── Layout ─────────────────────────────────────────────────────────────────
--
-- One thing to place now. The toast column hangs under the top-left stat card,
-- on the OPPOSITE side of the screen from ArenaHud's menu — which lives down
-- the right-hand edge — so the two can never collide however many tabs the
-- menu grows or however long a notification is.

function Hud.applyLayout()
    if not gui then return end
    local u = Layout.usable()
    local compact = Layout.isCompact()
    local pad = compact and 8 or 14

    local toastW = compact and math.min(230, math.floor(u.X * 0.42)) or 330
    local toastH = compact and 80 or 200
    toastHolder.Size = UDim2.fromOffset(toastW, toastH)
    toastHolder.Position = UDim2.fromOffset(pad, Layout.belowStatCard())
end

-- ── Build ──────────────────────────────────────────────────────────────────

function Hud.build(): ScreenGui
    gui = Instance.new("ScreenGui")
    gui.Name = "GoobHud"
    gui.ResetOnSpawn = false
    -- false, NOT true: with IgnoreGuiInset = true the ScreenGui draws from the
    -- true top of the screen and the Roblox top bar covers the first ~36px.
    gui.IgnoreGuiInset = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    -- Above Roblox's own touch-control ScreenGui, so a dialog button placed
    -- over the jump button receives the tap instead of the jump button.
    gui.DisplayOrder = 10
    gui.Parent = player:WaitForChild("PlayerGui")

    toastHolder = Instance.new("Frame")
    toastHolder.Name = "Toasts"
    toastHolder.BackgroundTransparency = 1
    toastHolder.Parent = gui

    local toastLayout = Instance.new("UIListLayout")
    toastLayout.Padding = UDim.new(0, 6)
    toastLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    toastLayout.Parent = toastHolder

    Layout.start()
    Hud.applyLayout()
    Layout.changed.Event:Connect(Hud.applyLayout)

    return gui
end

-- ── Live update ────────────────────────────────────────────────────────────

function Hud.update(snap: any)
    state = snap
end

--- Formatted Glob, for anything that wants to print it without re-deriving the
--- format.
function Hud.globText(): string
    return state and Format.short(state.glob) or "0"
end

-- ── Wired up by init.client ────────────────────────────────────────────────

Hud.tradeOpen = false
Hud.onGulp = function(_: string) end
Hud.onOffer = function(_: string) end
Hud.onRename = function(_: string) end
Hud.onSetActive = function(_: string) end

function Hud.getState() return state end

function Hud.setTradeOpen(open: boolean)
    Hud.tradeOpen = open
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">Juice</string><ProtectedString name="Source"><![CDATA[--!strict
-- Juice.luau — the feedback that makes a world feel inhabited.
--
-- The play-test note was "the area is so bland, needs to feel more alive".
-- Half of that was structural and got fixed by rolling and the zones. The other
-- half is this: things that pop, flash, rattle and react. None of it changes a
-- single number; all of it changes whether the game feels responsive.
--
-- Everything here is CLIENT-side and cosmetic. A dropped effect costs nothing,
-- so nothing here is ever allowed to error out of a gameplay path.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")

local Shared = game.ReplicatedStorage:WaitForChild("GoobShared")
local Feedstock = require(Shared.Feedstock)
local Config = require(Shared.Config)

local player = Players.LocalPlayer
local Juice = {}

local RARITY_BURST = {
    Common = 6, Uncommon = 10, Rare = 16, Epic = 26,
    Legendary = 40, Mythic = 60, Secret = 110,
}

-- ── Camera shake ───────────────────────────────────────────────────────────
-- Applied as an offset to the camera's own CFrame each frame and decayed, so it
-- never fights the default camera controller for ownership.

local shake = 0

function Juice.shakeCamera(amount: number)
    shake = math.min(3.5, shake + amount)
end

-- ── Particle bursts ────────────────────────────────────────────────────────

local function burst(position: Vector3, colour: Color3, count: number, size: number)
    local anchor = Instance.new("Part")
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanQuery = false
    anchor.Transparency = 1
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.Position = position
    anchor.Parent = Workspace

    local attach = Instance.new("Attachment")
    attach.Parent = anchor

    local emitter = Instance.new("ParticleEmitter")
    emitter.Color = ColorSequence.new(colour)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, size),
        NumberSequenceKeypoint.new(1, 0),
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1),
    })
    emitter.Lifetime = NumberRange.new(0.35, 0.8)
    emitter.Speed = NumberRange.new(12, 30)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Rate = 0
    emitter.LightEmission = 0.7
    emitter.Parent = attach
    emitter:Emit(count)

    Debris:AddItem(anchor, 2)
end

Juice.burst = burst

-- ── Sounds ─────────────────────────────────────────────────────────────────

-- Ids live in Config and default to empty. An unset id creates no Sound at
-- all, so a game with no audio configured is silent rather than noisy with
-- load failures.
local VOLUMES = {
    catch = 0.22, rare = 0.55, bank = 0.50, unlock = 0.45,
    gulp = 0.55, pop = 0.60, thud = 0.45,
    whoosh = 0.35, slam = 0.45, shield = 0.32, drip = 0.34, click = 0.25,
}

-- Driven off Config.SOUNDS, not off VOLUMES. Keying the loop on the volume
-- table meant a sound added to the config with no volume entry was created
-- nowhere and never played, silently — the config would look configured and
-- the game would stay quiet.
local DEFAULT_VOLUME = 0.35

local sfx: { [string]: Sound } = {}
local missingVolume: { string } = {}

for name, id in pairs(Config.SOUNDS or {}) do
    if type(id) == "string" and id ~= "" then
        local s = Instance.new("Sound")
        s.Name = "Goob_" .. name
        s.SoundId = id
        s.Volume = VOLUMES[name] or DEFAULT_VOLUME
        s.Parent = SoundService
        sfx[name] = s
        if not VOLUMES[name] then
            table.insert(missingVolume, name)
        end
    end
end
if #missingVolume > 0 then
    warn("[Goob/Juice] no volume set for: " .. table.concat(missingVolume, ", "))
end

-- Report a dead sound id ONCE, after giving it a fair chance to load.
--
-- THE FIRST VERSION OF THIS CRIED WOLF. It checked IsLoaded inside a
-- task.defer — one frame after creating the Sound — and audio cannot possibly
-- have loaded by then, so it listed EVERY sound as dead on a completely
-- healthy client. A warning that is always wrong is worse than no warning:
-- it trains you to ignore the console.
--
-- It now waits, polls, and listens for the Loaded event, and only complains
-- about what is still not there after a real timeout.
local SOUND_LOAD_TIMEOUT = 12

task.spawn(function()
    local pending = {}
    for name, sound in pairs(sfx) do
        pending[name] = sound
        -- Guarded: polling IsLoaded below is the real mechanism, and the event
        -- is only an early-out. Assuming a signal exists on an instance is how
        -- a cosmetic nicety takes down the whole client.
        local loaded = (sound :: any).Loaded
        if loaded and type(loaded) == "table" and loaded.Connect then
            loaded:Connect(function()
                pending[name] = nil
            end)
        end
    end

    local deadline = os.clock() + SOUND_LOAD_TIMEOUT
    while os.clock() < deadline do
        local left = 0
        for name, sound in pairs(pending) do
            if sound.IsLoaded then
                pending[name] = nil
            else
                left += 1
            end
        end
        if left == 0 then
            return
        end
        task.wait(0.5)
    end

    local dead = {}
    for name, sound in pairs(pending) do
        table.insert(dead, name .. " (" .. tostring(sound.SoundId) .. ")")
    end
    if #dead > 0 then
        table.sort(dead)
        warn(("[Goob/Juice] %d sound(s) still not loaded after %ds: %s")
            :format(#dead, SOUND_LOAD_TIMEOUT, table.concat(dead, ", ")))
    end
end)

Juice.sounds = sfx

function Juice.play(name: string, pitchJitter: number?)
    local s = sfx[name]
    if not s then return end   -- unconfigured: silent, never an error
    if pitchJitter then
        s.PlaybackSpeed = 1 + (math.random() - 0.5) * pitchJitter
    end
    pcall(function() s:Play() end)
end

-- ── Public effects ─────────────────────────────────────────────────────────

function Juice.onCatch(itemId: string, position: Vector3?)
    local item = Feedstock.get(itemId)
    if not item then return end
    local pos = position
    if not pos then
        local ball = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
        pos = ball and ball.Position or nil
    end
    if not pos then return end

    burst(pos, item.color, RARITY_BURST[item.rarity] or 8,
        item.rarity == "Secret" and 3 or 1.4)

    if item.rarity == "Secret" or item.rarity == "Mythic" then
        Juice.play("rare")
        Juice.shakeCamera(item.rarity == "Secret" and 2.4 or 1.2)
    elseif item.rarity == "Legendary" or item.rarity == "Epic" then
        Juice.play("catch", 0.35)
        Juice.shakeCamera(0.4)
    else
        Juice.play("catch", 0.5)
    end
end

function Juice.onGulp(position: Vector3?)
    local ball = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
    local pos = position or (ball and ball.Position)
    if pos then burst(pos, Color3.fromRGB(255, 120, 150), 70, 3) end
    Juice.play("gulp")
    Juice.shakeCamera(1.8)
end

function Juice.onAscend(position: Vector3?)
    local ball = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
    local pos = position or (ball and ball.Position)
    if pos then
        burst(pos, Color3.fromRGB(255, 240, 170), 160, 5)
        burst(pos + Vector3.new(0, 14, 0), Color3.fromRGB(255, 255, 255), 90, 3)
    end
    Juice.play("rare")
    Juice.shakeCamera(3.5)
end

function Juice.onShove(position: Vector3, force: number)
    burst(position, Color3.fromRGB(255, 200, 120), math.clamp(force * 20, 10, 60), 2)
    Juice.play("thud", 0.3)
    Juice.shakeCamera(math.clamp(force * 2, 0.3, 2.2))
end

-- ── Powers ─────────────────────────────────────────────────────────────────
-- Every power gets a shape you can read in a quarter of a second, from across
-- an arena, on a phone. That constraint rules out anything detailed: what
-- survives is silhouette, colour and motion. A ring means area, a streak means
-- direction, a shell means protection.

local function ring(position: Vector3, colour: Color3, from: number, to: number, seconds: number)
    local r = Instance.new("Part")
    r.Name = "FX_Ring"
    r.Shape = Enum.PartType.Cylinder
    r.Anchored = true
    r.CanCollide = false
    r.CanQuery = false
    r.CanTouch = false
    r.Material = Enum.Material.Neon
    r.Color = colour
    r.Transparency = 0.25
    -- Rotated onto its side so the cylinder reads as a flat disc on the ground.
    r.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
    r.Size = Vector3.new(1, from, from)
    r.Parent = Workspace

    TweenService:Create(r, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(1, to, to),
        Transparency = 1,
    }):Play()
    Debris:AddItem(r, seconds + 0.2)
end

local function streak(from: Vector3, to: Vector3, colour: Color3, thickness: number)
    local delta = to - from
    local len = delta.Magnitude
    if len < 0.5 then return end
    local p = Instance.new("Part")
    p.Name = "FX_Streak"
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Material = Enum.Material.Neon
    p.Color = colour
    p.Transparency = 0.3
    p.Size = Vector3.new(thickness, thickness, len)
    p.CFrame = CFrame.new(from + delta / 2, to)
    p.Parent = Workspace
    TweenService:Create(p, TweenInfo.new(0.35), { Transparency = 1, Size = Vector3.new(0.1, 0.1, len) }):Play()
    Debris:AddItem(p, 0.6)
end

local function shell(host: BasePart, colour: Color3, seconds: number)
    local sh = Instance.new("Part")
    sh.Name = "FX_Shell"
    sh.Shape = Enum.PartType.Ball
    sh.Anchored = false
    sh.CanCollide = false
    sh.CanQuery = false
    sh.CanTouch = false
    sh.Massless = true
    sh.Material = Enum.Material.ForceField
    sh.Color = colour
    sh.Transparency = 0.35
    sh.Size = host.Size * 1.25
    sh.CFrame = host.CFrame
    sh.Parent = Workspace
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1 = host, sh
    weld.Parent = sh
    TweenService:Create(sh, TweenInfo.new(seconds), { Transparency = 1 }):Play()
    Debris:AddItem(sh, seconds + 0.2)
end

-- A quick squash-and-stretch on the body itself. It is the cheapest possible
-- "that did something" signal and it works even when everything else is off
-- screen, because the thing it animates is the thing the camera is following.
local function pulse(ball: BasePart, scale: number, seconds: number)
    local base = ball.Size
    local t = TweenService:Create(ball, TweenInfo.new(seconds * 0.4, Enum.EasingStyle.Back,
        Enum.EasingDirection.Out), { Size = base * scale })
    t:Play()
    task.delay(seconds * 0.4, function()
        if ball.Parent then
            -- Tween back to whatever the size is NOW, not to the size we
            -- captured: the arena resizes the body constantly, and snapping
            -- back to a stale value would undo real growth.
            TweenService:Create(ball, TweenInfo.new(seconds * 0.6), { Size = ball.Size / scale }):Play()
        end
    end)
end

local POWER_COLOUR = {
    dash   = Color3.fromRGB(150, 205, 225), blink  = Color3.fromRGB(186, 170, 206),
    split  = Color3.fromRGB(195, 165, 195), slam   = Color3.fromRGB(205, 170, 140),
    hook   = Color3.fromRGB(190, 180, 145), bubble = Color3.fromRGB(175, 200, 200),
    spike  = Color3.fromRGB(205, 150, 155), slick  = Color3.fromRGB(160, 175, 150),
    decoy  = Color3.fromRGB(180, 176, 190), siphon = Color3.fromRGB(160, 190, 172),
    magnet = Color3.fromRGB(170, 190, 215), beacon = Color3.fromRGB(206, 186, 132),
}

function Juice.onPower(id: string, data: any)
    local ball = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
    if not ball then return end
    local pos = ball.Position
    local colour = POWER_COLOUR[id] or Color3.fromRGB(190, 190, 190)
    local r = ball.Size.X / 2

    Juice.play((Config.POWER_SOUND or {})[id] or "whoosh", 0.25)

    if id == "dash" then
        pulse(ball, 0.82, 0.3)
        burst(pos, colour, 14, 2)
        Juice.shakeCamera(0.3)

    elseif id == "blink" then
        -- Both ends, joined. A teleport with no visible origin reads as a
        -- rubber-band desync rather than as something you did on purpose.
        burst(pos, colour, 30, 2.4)
        task.delay(0.05, function()
            local now = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
            if now then
                streak(pos, now.Position, colour, math.max(2, r * 0.7))
                burst(now.Position, colour, 30, 2.4)
            end
        end)
        Juice.shakeCamera(0.5)

    elseif id == "split" then
        pulse(ball, 0.7, 0.45)
        streak(pos, pos + ball.AssemblyLinearVelocity.Unit * (r * 6), colour, r * 0.8)
        burst(pos, colour, 26, 3)
        Juice.shakeCamera(0.6)

    elseif id == "slam" then
        pulse(ball, 1.18, 0.5)
        -- The ring is fired on the WAY UP as a telegraph. Everyone nearby gets
        -- most of a second to move, which is what makes dodging a slam a skill
        -- rather than a coin flip.
        ring(pos - Vector3.new(0, r, 0), colour, r * 2, 92, 0.85)
        Juice.shakeCamera(0.8)

    elseif id == "hook" then
        burst(pos, colour, 16, 2)
        Juice.shakeCamera(0.4)

    elseif id == "bubble" then
        shell(ball, colour, 3)
        ring(pos - Vector3.new(0, r, 0), colour, r * 2, r * 5, 0.5)

    elseif id == "spike" then
        shell(ball, colour, 3)
        burst(pos, colour, 34, 2.6)
        Juice.shakeCamera(0.5)

    elseif id == "beacon" then
        shell(ball, colour, 8)
        ring(pos - Vector3.new(0, r, 0), colour, r * 2, 120, 1.2)
        -- A pillar, because BEACON's entire bargain is that the whole island
        -- can see you. If it were subtle it would be a free damage buff.
        local beam = Instance.new("Part")
        beam.Name = "FX_Beacon"
        beam.Anchored = false
        beam.CanCollide = false
        beam.CanQuery = false
        beam.CanTouch = false
        beam.Massless = true
        beam.Material = Enum.Material.Neon
        beam.Color = colour
        beam.Transparency = 0.55
        beam.Size = Vector3.new(r * 0.8, 200, r * 0.8)
        beam.CFrame = ball.CFrame * CFrame.new(0, 100, 0)
        beam.Parent = Workspace
        local w = Instance.new("WeldConstraint")
        w.Part0, w.Part1 = ball, beam
        w.Parent = beam
        TweenService:Create(beam, TweenInfo.new(8), { Transparency = 1 }):Play()
        Debris:AddItem(beam, 8.2)

    elseif id == "slick" then
        ring(pos - Vector3.new(0, r, 0), colour, r, r * 4, 0.6)
        burst(pos, colour, 12, 2)

    elseif id == "decoy" then
        pulse(ball, 1.1, 0.3)
        burst(pos, colour, 18, 2.2)

    elseif id == "siphon" then
        burst(pos, colour, 22, 2)
        Juice.shakeCamera(0.35)

    elseif id == "magnet" then
        ring(pos - Vector3.new(0, r, 0), colour, 80, r * 2, 0.7)
    end
end

-- Somebody drained you. Fired on the victim, who otherwise just watches their
-- number fall with no idea why.
function Juice.onSiphoned(from: string?, amount: number?)
    local ball = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
    if ball then
        burst(ball.Position, Color3.fromRGB(190, 120, 120), 26, 2.4)
    end
    Juice.play("drip", 0.3)
    Juice.shakeCamera(0.8)
end

function Juice.onBank(glob: number?)
    local ball = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
    if ball then
        local r = ball.Size.X / 2
        ring(ball.Position - Vector3.new(0, r, 0), Color3.fromRGB(206, 184, 126), r * 2, 70, 0.9)
        burst(ball.Position, Color3.fromRGB(206, 184, 126), 44, 3)
    end
    Juice.play("bank")
    Juice.shakeCamera(0.6)
end

function Juice.onPop(mass: number?)
    local ball = Workspace:FindFirstChild("GoobBall_" .. player.UserId) :: BasePart?
    if ball then
        burst(ball.Position, Color3.fromRGB(190, 124, 112), 80, 3.4)
        ring(ball.Position, Color3.fromRGB(190, 124, 112), 4, 80, 0.7)
    end
    Juice.play("pop")
    Juice.shakeCamera(2.2)
end

-- ── Living world ───────────────────────────────────────────────────────────
--
-- This used to make roaming "critters" flinch away from you. The critters are
-- gone — they belonged to a collecting game that the arena replaced, and they
-- were still spawning junk into live rounds.
--
-- The line worth keeping from the deletion is this: the flinch loop began with
-- `Workspace:WaitForChild("Critters")`, an INFINITE wait. Had the folder ever
-- failed to appear, Juice.start would have hung forever and taken camera
-- shake, hit feedback and every other piece of game feel down with it, with no
-- error in the output to say why. A client that waits unconditionally on
-- something a server might not build is a client that can be bricked by a
-- server-side deletion — which is exactly the deletion that just happened.

function Juice.start()
    RunService.RenderStepped:Connect(function(dt)
        -- Camera shake, decayed.
        local camera = Workspace.CurrentCamera
        if camera and shake > 0.01 then
            local o = shake
            camera.CFrame = camera.CFrame * CFrame.new(
                (math.random() - 0.5) * o,
                (math.random() - 0.5) * o,
                0)
            shake = shake * math.max(0, 1 - dt * 7)
        else
            shake = 0
        end

    end)
end

return Juice
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">Layout</string><ProtectedString name="Source"><![CDATA[--!strict
-- Layout.luau — one place that knows how big the screen is and what that means.
--
-- MEASURED, NOT GUESSED. Before this existed, at 568x320 (iPhone SE landscape)
-- the HUD covered 233% of the screen, 25 elements hung off the edges, tap
-- targets were 28px, and buttons sat underneath the thumbstick and jump button
-- where a thumb can never reach them.
--
-- Roblox reserves real estate for touch controls that no API will tell you
-- about: a movement thumbstick bottom-left and a jump button bottom-right.
-- Anything drawn there is simply unreachable on a phone, so the compact layout
-- puts its one action button in the gap between them.

local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Workspace = game:GetService("Workspace")

local Layout = {}

-- Reserved by the Roblox touch controls. Generous on purpose: being 20px too
-- cautious costs nothing, being 20px too bold makes a button untappable.
Layout.THUMBSTICK = Vector2.new(230, 190)
Layout.JUMP_BUTTON = Vector2.new(160, 160)

-- Apple's guidance is 44pt; 34 is the floor we enforce and 44 is what we aim
-- for on anything a player presses repeatedly.
Layout.MIN_TAP = 44

Layout.changed = Instance.new("BindableEvent")

local current = {
    viewport = Vector2.new(1280, 720),
    compact = false,
    touch = false,
    inset = 0,
}

function Layout.get()
    return current
end

function Layout.isCompact(): boolean
    return current.compact
end

-- Deliberately separate from isCompact. An iPad is touch but not small: it
-- wants finger-sized tap targets and must keep the persistent HUD clear of the
-- thumbstick, while still having room for the roomy two-column layout.
-- Conflating the two left iPad with 28px buttons under the joystick.
function Layout.isTouch(): boolean
    return current.touch
end

function Layout.viewport(): Vector2
    return current.viewport
end

-- Usable height once the Roblox top bar is accounted for.
function Layout.usable(): Vector2
    -- Floored well above zero. ViewportSize is (0, 0) for the first frames
    -- before the camera initialises, and every layout function subtracts button
    -- widths from it — which produced math.clamp(x, 8, -76), a hard error that
    -- aborted the whole layout pass and left the HUD half-placed.
    return Vector2.new(
        math.max(320, current.viewport.X),
        math.max(240, current.viewport.Y - current.inset))
end

-- A clamp that cannot throw. Roblox's math.clamp errors when max < min, which
-- is correct for maths and useless for layout: a screen too narrow for a button
-- is something to survive, not something to crash on.
function Layout.fit(value: number, low: number, high: number): number
    if high < low then return low end
    return math.clamp(value, low, high)
end

-- Clamp a desired pixel size so it always fits with a margin. This is what
-- stops a 640x480 trade window from being drawn on a 568x320 screen.
function Layout.panel(wantW: number, wantH: number, marginX: number?, marginY: number?): UDim2
    local u = Layout.usable()
    local mx = marginX or (current.compact and 12 or 24)
    local my = marginY or (current.compact and 12 or 24)
    return UDim2.fromOffset(
        math.min(wantW, u.X - mx * 2),
        math.min(wantH, u.Y - my * 2)
    )
end

-- Centre a panel of a given resolved size.
function Layout.centre(size: UDim2): UDim2
    local u = Layout.usable()
    return UDim2.fromOffset(
        math.floor((u.X - size.X.Offset) / 2),
        math.floor((u.Y - size.Y.Offset) / 2)
    )
end

-- ── The menu rail, and everything that has to stay clear of it ────────────
--
-- ONE OWNER FOR NUMBERS TWO FILES BOTH NEED.
--
-- ArenaHud draws the menu. Hud draws the toast column and has to stay out of
-- its way. Duplicating the arithmetic leaves two copies to drift the moment a
-- tab is added; having Hud require ArenaHud points the small module at the big
-- one for a couple of integers. So it lives here, where both already look.
--
-- WHY THE MENU IS A VERTICAL RAIL ON THE RIGHT.
--
-- It was a horizontal strip of nine unlabelled icons across the top, and two
-- things were wrong with that. A row of pictograms is a memory test — 🔧 and
-- 🎁 and 🛡️ mean nothing until you have opened each one — and across the top
-- it was competing with the round clock, the stat card and the Glob readout
-- for the most valuable strip of screen there is. Down the right-hand edge
-- there is room for the ICON AND ITS NAME on every row, the list reads
-- top-to-bottom like a menu should, and it grows downward without pushing
-- anything sideways.
local menuTabs = 8

function Layout.setMenuTabs(n: number)
    if n == menuTabs then return end
    menuTabs = n
    Layout.changed:Fire(current)
end

--- Geometry of the right-hand menu: a header button, and the list it drops.
---
--- ── WHY THE LIST DOES NOT SIT UNDER THE BUTTON ON A PHONE ────────────────
---
--- Roblox reserves the bottom-right 160x160 of a touch screen for the jump
--- button. On a 568x320 landscape phone that is the entire right-hand column
--- below y=160 — which is exactly where a right-anchored dropdown wants to go.
--- Eight labelled rows need about 400px of height and there are only ~120
--- above the jump zone, so a list that dropped straight down would put six of
--- its eight rows somewhere a thumb physically cannot reach.
---
--- So on touch the list opens to the LEFT of its button, into the middle of
--- the screen, which is the one large region nothing else claims. The button
--- stays top-right where the request put it, the list is still a vertical
--- column of names, and every row is reachable. On a desktop there are no
--- reserved zones and it simply drops underneath.
function Layout.menuMetrics(tabCount: number?)
    local count = tabCount or menuTabs
    local compact = current.compact
    local touch = current.touch
    local u = Layout.usable()

    local rowH = compact and 34 or 42
    local gap = compact and 3 or 5
    local pad = compact and 6 or 9
    local width = math.min(compact and 158 or 210, math.floor(u.X * 0.36))
    local headerH = Layout.MIN_TAP
    local top = compact and 6 or 12
    local right = compact and 6 or 12

    -- Where the list may start, and how much room it has.
    local listTop = top + headerH + (compact and 4 or 6)
    local listRight = right
    if touch then
        -- Clear of the jump column entirely.
        listRight = math.max(right, Layout.JUMP_BUTTON.X + 10)
    end
    -- STOPS ABOVE THE HOTBAR. The three power buttons live on the bottom edge
    -- and are the controls a player is actually holding; a dropdown that ran
    -- over them would cover the game to show a menu.
    local hotbarBand = (compact and 62 or 84) + (compact and 12 or 24) + 10
    local avail = u.Y - listTop - hotbarBand
    if touch and not compact then
        -- An iPad: the thumbstick and jump button are still reserved, but
        -- there is height to spare, so the list drops normally and simply
        -- stops above the jump zone.
        avail = math.min(avail, u.Y - Layout.JUMP_BUTTON.Y - listTop - 10)
    end
    local wanted = count * rowH + (count - 1) * gap + pad * 2
    local listH = math.max(rowH * 2, math.min(wanted, avail))

    return {
        rowH = rowH,
        gap = gap,
        pad = pad,
        width = width,
        headerH = headerH,
        top = top,
        right = right,
        listTop = listTop,
        listRight = listRight,
        listH = listH,
        -- True when the list had to be shortened, so it needs to scroll.
        scrolls = wanted > listH + 1,
    }
end

--- X of the first pixel the menu HEADER occupies. Nothing persistent may be
--- drawn at or past it.
function Layout.menuLeft(tabCount: number?): number
    local m = Layout.menuMetrics(tabCount)
    return Layout.usable().X - m.width - m.right
end

--- Y of the first free pixel under the top-left stat column — the stat card,
--- the Glob readout and the season line, which stack there.
function Layout.belowStatCard(): number
    return current.compact and 118 or 162
end

-- The horizontal band between the thumbstick and the jump button — the only
-- part of the bottom edge a phone player can actually press.
function Layout.bottomGap(): (number, number)
    local w = current.viewport.X
    local left = Layout.THUMBSTICK.X
    local right = w - Layout.JUMP_BUTTON.X
    return left, right
end

function Layout.recompute()
    local camera = Workspace.CurrentCamera
    local vp = camera and camera.ViewportSize or Vector2.new(1280, 720)
    local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled

    local insetTop = 0
    local ok, top = pcall(function()
        return (GuiService:GetGuiInset())
    end)
    if ok and top then insetTop = top.Y end

    -- Compact is about available room, not about being a phone: a small window
    -- on a desktop has exactly the same problem.
    -- Ignore the degenerate viewport the camera reports before it is ready.
    if vp.X < 64 or vp.Y < 64 then return end

    local compact = vp.X < 900 or vp.Y < 500

    local changed = compact ~= current.compact
        or vp ~= current.viewport
        or touch ~= current.touch

    current.viewport = vp
    current.compact = compact
    current.touch = touch
    current.inset = insetTop

    if changed then
        Layout.changed:Fire(current)
    end
end

function Layout.start()
    Layout.recompute()
    -- The camera can take several frames to report a real size. Keep asking
    -- until it does, then stop.
    task.spawn(function()
        for _ = 1, 120 do
            local cam = Workspace.CurrentCamera
            if cam and cam.ViewportSize.X > 64 then
                Layout.recompute()
                break
            end
            task.wait(0.1)
        end
    end)
    local camera = Workspace.CurrentCamera
    if camera then
        camera:GetPropertyChangedSignal("ViewportSize"):Connect(Layout.recompute)
    end
    Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        Layout.recompute()
        local cam = Workspace.CurrentCamera
        if cam then
            cam:GetPropertyChangedSignal("ViewportSize"):Connect(Layout.recompute)
        end
    end)
end

return Layout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[--!strict
-- Panels.luau — the wardrobe, season pass and crew screens.
--
-- All three live as TABS inside the drawer that already exists rather than
-- behind new buttons. A phone screen has room for roughly one persistent
-- control, and every extra floating button is one more thing competing with
-- the thumbstick for a thumb.

local Players = game:GetService("Players")

local Shared = game.ReplicatedStorage:WaitForChild("GoobShared")
local Cosmetics = require(Shared.Cosmetics)
local Season = require(Shared.Season)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Layout = require(script.Parent.Layout)

local Panels = {}

Panels.onEquip = function(_kind: string, _id: string) end
Panels.onClaimSeason = function(_tier: number, _premium: boolean) end
Panels.onCrewCreate = function(_name: string, _tag: string) end
Panels.onCrewJoin = function(_tag: string) end
Panels.onCrewLeave = function() end
Panels.onCrewClaim = function() end
Panels.onBuy = function(_id: string) end

local function clear(frame: Instance)
    for _, c in ipairs(frame:GetChildren()) do
        if c:IsA("GuiObject") then c:Destroy() end
    end
end

local function scroller(parent: GuiObject): ScrollingFrame
    local sf = Instance.new("ScrollingFrame")
    sf.Size = UDim2.fromScale(1, 1)
    sf.BackgroundTransparency = 1
    sf.BorderSizePixel = 0
    sf.ScrollBarThickness = 6
    sf.ScrollBarImageColor3 = Theme.ACCENT
    sf.Parent = parent
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = sf
    return sf
end

-- ── Wardrobe ───────────────────────────────────────────────────────────────

local function wardrobe(container: GuiObject, state: any)
    local touch = Layout.isTouch()
    local sf = scroller(container)
    local order = 0
    local rowH = touch and 52 or 42

    for _, kind in ipairs(Cosmetics.KINDS) do
        local header = Theme.label({
            Size = UDim2.new(1, -10, 0, 24),
            Text = ({ skin = "🎨 SKIN", trail = "💫 TRAIL",
                      eyes = "👀 EYES", crown = "👑 CROWN" })[kind] or kind,
            TextSize = 16, TextColor3 = Theme.GOLD,
        })
        order += 1; header.LayoutOrder = order; header.Parent = sf

        for _, item in ipairs(Cosmetics.ofKind(kind)) do
            local ownsIt = (state.cosmeticsOwned or {})[item.id] == true
            local worn = (state.loadout or {})[kind] == item.id

            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, -10, 0, rowH)
            row.BackgroundColor3 = worn and Theme.BG_SOFT or Theme.PANEL
            row.Text = ""
            row.AutoButtonColor = ownsIt
            Theme.corner(row, 10)
            Theme.stroke(row, worn and Theme.ACCENT
                or (Cosmetics.RARITY_COLOUR[item.rarity] or Theme.PANEL), worn and 3 or 2)
            order += 1; row.LayoutOrder = order; row.Parent = sf

            local swatch = Instance.new("Frame")
            swatch.Size = UDim2.fromOffset(rowH - 16, rowH - 16)
            swatch.Position = UDim2.fromOffset(8, 8)
            swatch.BackgroundColor3 = item.colour or Cosmetics.RARITY_COLOUR[item.rarity]
            swatch.Parent = row
            Theme.corner(swatch, (rowH - 16) / 2)

            if item.emoji and item.emoji ~= "" then
                local e = Theme.label({ Size = UDim2.fromScale(1, 1), Text = item.emoji,
                    TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center })
                e.Parent = swatch
            end

            local name = Theme.label({
                Position = UDim2.fromOffset(rowH + 2, 4),
                Size = UDim2.new(1, -rowH - 90, 0, 20),
                Text = item.name, TextSize = 15,
                TextColor3 = ownsIt and Theme.TEXT or Theme.TEXT_DIM,
            })
            name.Parent = row

            local sub = Theme.label({
                Position = UDim2.fromOffset(rowH + 2, rowH - 26),
                Size = UDim2.new(1, -rowH - 90, 0, 18),
                Text = ownsIt and (worn and "equipped" or "tap to wear")
                    or ({ season = "season tier " .. tostring(item.tier or "?"),
                          shop = "in the shop", ascend = "ascension reward",
                          achievement = "achievement", starter = "" })[item.source] or "locked",
                TextSize = 12,
                TextColor3 = ownsIt and Theme.TEXT_DIM
                    or (Cosmetics.RARITY_COLOUR[item.rarity] or Theme.TEXT_DIM),
            })
            sub.Parent = row

            local badge = Theme.label({
                Position = UDim2.new(1, -84, 0, 4),
                Size = UDim2.fromOffset(78, rowH - 8),
                Text = ownsIt and (worn and "✓" or "") or "🔒",
                TextSize = 18, TextXAlignment = Enum.TextXAlignment.Right,
                TextColor3 = worn and Theme.GOOD or Theme.TEXT_DIM,
            })
            badge.Parent = row

            if ownsIt then
                row.Activated:Connect(function() Panels.onEquip(kind, item.id) end)
            end
        end
    end
    sf.CanvasSize = UDim2.new(0, 0, 0, order * (rowH + 6) + 20)
end

-- ── Season pass ────────────────────────────────────────────────────────────

local function season(container: GuiObject, state: any)
    local s = state.season
    if not s then return end
    local touch = Layout.isTouch()

    local head = Instance.new("Frame")
    head.Size = UDim2.new(1, -10, 0, 66)
    head.BackgroundColor3 = Theme.PANEL
    head.Parent = container
    Theme.corner(head, 12)

    local title = Theme.label({
        Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 22),
        Text = ("⭐ %s"):format(s.name or "Season"), TextSize = 17, TextColor3 = Theme.GOLD,
    })
    title.Parent = head

    local tierLabel = Theme.label({
        Position = UDim2.fromOffset(12, 28), Size = UDim2.new(1, -24, 0, 18),
        Text = ("Tier %d / %d   ·   %s / %s xp today")
            :format(s.tier, s.tiers, Format.comma(s.dailyXp or 0), Format.comma(s.dailyCap or 0)),
        TextSize = 13, TextColor3 = Theme.TEXT_DIM,
    })
    tierLabel.Parent = head

    local barBg = Instance.new("Frame")
    barBg.Position = UDim2.fromOffset(12, 48)
    barBg.Size = UDim2.new(1, -24, 0, 10)
    barBg.BackgroundColor3 = Theme.BG
    barBg.Parent = head
    Theme.corner(barBg, 5)
    local bar = Instance.new("Frame")
    bar.Size = UDim2.fromScale(math.clamp(s.progress or 0, 0, 1), 1)
    bar.BackgroundColor3 = Theme.GOLD
    bar.Parent = barBg
    Theme.corner(bar, 5)

    local body = Instance.new("Frame")
    body.Position = UDim2.fromOffset(0, 72)
    body.Size = UDim2.new(1, 0, 1, -72)
    body.BackgroundTransparency = 1
    body.Parent = container
    local sf = scroller(body)

    local order = 0
    if not s.premium then
        local buy = Theme.button("💎 GET PREMIUM — unlock the second column",
            Theme.GOLD, UDim2.new(1, -10, 0, touch and 48 or 38))
        buy.TextSize = 14
        order += 1; buy.LayoutOrder = order; buy.Parent = sf
        buy.Activated:Connect(function() Panels.onBuy("premium_pass") end)
    end

    local claimable = s.claimable or {}
    if #claimable == 0 then
        local none = Theme.label({
            Size = UDim2.new(1, -10, 0, 30),
            Text = "Nothing to claim — keep playing to earn tiers.",
            TextSize = 13, TextColor3 = Theme.TEXT_DIM,
        })
        order += 1; none.LayoutOrder = order; none.Parent = sf
    end

    for _, entry in ipairs(claimable) do
        local item = Cosmetics.get(entry.cosmetic)
        local row = Theme.button(
            ("🎁 Tier %d%s — %s"):format(entry.tier, entry.premium and " 💎" or "",
                item and item.name or entry.cosmetic),
            entry.premium and Theme.GOLD or Theme.GOOD,
            UDim2.new(1, -10, 0, touch and 48 or 38))
        row.TextSize = 14
        order += 1; row.LayoutOrder = order; row.Parent = sf
        row.Activated:Connect(function() Panels.onClaimSeason(entry.tier, entry.premium) end)
    end

    -- The rest of the track, so the reason to keep playing is visible.
    local rewards = Season.rewards()
    for t = 1, Season.TIERS do
        local row = rewards[t]
        if row.free or row.premium then
            local names = {}
            if row.free then
                local i = Cosmetics.get(row.free); table.insert(names, i and i.name or row.free)
            end
            if row.premium then
                local i = Cosmetics.get(row.premium)
                table.insert(names, "💎 " .. (i and i.name or row.premium))
            end
            local done = t <= s.tier
            local line = Theme.label({
                Size = UDim2.new(1, -10, 0, 22),
                Text = ("%s Tier %-2d  %s"):format(done and "✓" or "·", t, table.concat(names, "  ·  ")),
                TextSize = 13,
                TextColor3 = done and Theme.TEXT or Theme.TEXT_DIM,
            })
            order += 1; line.LayoutOrder = order; line.Parent = sf
        end
    end
    sf.CanvasSize = UDim2.new(0, 0, 0, order * 34 + 20)
end

-- ── Crew ───────────────────────────────────────────────────────────────────

local crewState: any = nil
function Panels.setCrew(data: any) crewState = data end
function Panels.crew() return crewState end

local function crew(container: GuiObject, _state: any)
    local touch = Layout.isTouch()
    local btnH = touch and 48 or 38

    if not crewState then
        local blurb = Theme.label({
            Position = UDim2.fromOffset(6, 0), Size = UDim2.new(1, -12, 0, 54),
            Text = "Crews share a weekly goal. Nobody hits it alone — and everyone who helps gets paid.",
            TextSize = 14, TextWrapped = true, TextColor3 = Theme.TEXT_DIM,
        })
        blurb.Parent = container

        local nameBox = Instance.new("TextBox")
        nameBox.Position = UDim2.fromOffset(6, 60)
        nameBox.Size = UDim2.new(1, -12, 0, btnH)
        nameBox.BackgroundColor3 = Theme.BG_SOFT
        nameBox.Font = Theme.FONT
        nameBox.TextSize = 15
        nameBox.TextColor3 = Theme.TEXT
        nameBox.PlaceholderText = "Crew name (3–20 letters)"
        nameBox.Text = ""
        nameBox.ClearTextOnFocus = false
        nameBox.Parent = container
        Theme.corner(nameBox, 10)

        local tagBox = Instance.new("TextBox")
        tagBox.Position = UDim2.fromOffset(6, 60 + btnH + 8)
        tagBox.Size = UDim2.new(0.45, -12, 0, btnH)
        tagBox.BackgroundColor3 = Theme.BG_SOFT
        tagBox.Font = Theme.FONT
        tagBox.TextSize = 15
        tagBox.TextColor3 = Theme.TEXT
        tagBox.PlaceholderText = "TAG"
        tagBox.Text = ""
        tagBox.ClearTextOnFocus = false
        tagBox.Parent = container
        Theme.corner(tagBox, 10)

        local create = Theme.button("🛡️ FOUND CREW", Theme.GOOD,
            UDim2.new(0.55, -12, 0, btnH))
        create.Position = UDim2.new(0.45, 6, 0, 60 + btnH + 8)
        create.TextSize = 14
        create.Parent = container
        create.Activated:Connect(function()
            Panels.onCrewCreate(nameBox.Text, tagBox.Text)
        end)

        local joinBox = Instance.new("TextBox")
        joinBox.Position = UDim2.fromOffset(6, 60 + (btnH + 8) * 2 + 8)
        joinBox.Size = UDim2.new(0.45, -12, 0, btnH)
        joinBox.BackgroundColor3 = Theme.BG_SOFT
        joinBox.Font = Theme.FONT
        joinBox.TextSize = 15
        joinBox.TextColor3 = Theme.TEXT
        joinBox.PlaceholderText = "Join by TAG"
        joinBox.Text = ""
        joinBox.ClearTextOnFocus = false
        joinBox.Parent = container
        Theme.corner(joinBox, 10)

        local join = Theme.button("JOIN", Theme.ACCENT, UDim2.new(0.55, -12, 0, btnH))
        join.Position = UDim2.new(0.45, 6, 0, 60 + (btnH + 8) * 2 + 8)
        join.TextSize = 14
        join.Parent = container
        join.Activated:Connect(function() Panels.onCrewJoin(joinBox.Text) end)
        return
    end

    local head = Theme.label({
        Position = UDim2.fromOffset(6, 0), Size = UDim2.new(1, -12, 0, 26),
        Text = ("🛡️ [%s] %s"):format(crewState.tag, crewState.name),
        TextSize = 19, TextColor3 = Theme.GOLD,
    })
    head.Parent = container

    local goal = Theme.label({
        Position = UDim2.fromOffset(6, 28), Size = UDim2.new(1, -12, 0, 20),
        Text = ("%s  —  %s / %s"):format(crewState.goalLabel,
            Format.comma(crewState.progress), Format.comma(crewState.target)),
        TextSize = 14,
    })
    goal.Parent = container

    local barBg = Instance.new("Frame")
    barBg.Position = UDim2.fromOffset(6, 50)
    barBg.Size = UDim2.new(1, -12, 0, 12)
    barBg.BackgroundColor3 = Theme.BG
    barBg.Parent = container
    Theme.corner(barBg, 6)
    local bar = Instance.new("Frame")
    bar.Size = UDim2.fromScale(math.clamp(crewState.progress / math.max(1, crewState.target), 0, 1), 1)
    bar.BackgroundColor3 = crewState.complete and Theme.GOOD or Theme.ACCENT
    bar.Parent = barBg
    Theme.corner(bar, 6)

    local y = 68
    if crewState.complete and not crewState.claimed then
        local claim = Theme.button("🎁 CLAIM WEEKLY REWARD", Theme.GOOD,
            UDim2.new(1, -12, 0, btnH))
        claim.Position = UDim2.fromOffset(6, y)
        claim.TextSize = 14
        claim.Parent = container
        claim.Activated:Connect(function() Panels.onCrewClaim() end)
        y += btnH + 8
    end

    local listHolder = Instance.new("Frame")
    listHolder.Position = UDim2.fromOffset(6, y)
    listHolder.Size = UDim2.new(1, -12, 1, -y - btnH - 14)
    listHolder.BackgroundTransparency = 1
    listHolder.Parent = container
    local sf = scroller(listHolder)

    for i, m in ipairs(crewState.members or {}) do
        local row = Theme.label({
            Size = UDim2.new(1, -8, 0, 22),
            Text = ("%d. %s%s  —  %s"):format(i, m.name,
                m.owner and " 👑" or "", Format.comma(m.contributed)),
            TextSize = 13,
        })
        row.LayoutOrder = i
        row.Parent = sf
    end
    sf.CanvasSize = UDim2.new(0, 0, 0, #(crewState.members or {}) * 28 + 10)

    local leave = Theme.button("LEAVE CREW", Theme.BAD, UDim2.new(1, -12, 0, btnH))
    leave.Position = UDim2.new(0, 6, 1, -btnH - 6)
    leave.TextSize = 14
    leave.Parent = container
    leave.Activated:Connect(function() Panels.onCrewLeave() end)
end

-- ── Entry point ────────────────────────────────────────────────────────────

-- `container` is a GuiObject, not a Frame: since the legacy drawer was
-- deleted these render into ArenaHud's sheet host, which is a ScrollingFrame
-- so that a panel taller than the sheet can still be reached on a phone.
function Panels.render(tab: string, container: GuiObject, state: any)
    clear(container)
    if not state then return end
    if tab == "wear" then wardrobe(container, state)
    elseif tab == "season" then season(container, state)
    elseif tab == "crew" then crew(container, state) end
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">Roll</string><ProtectedString name="Source"><![CDATA[--!strict
-- Roll.luau — the controller.
--
-- Direct velocity control rather than forces. Forces are more "physical" and
-- much worse to play: with friction and mass in the loop the response changes
-- with every surface, and a nine-year-old reads that as the game being broken.
-- We set velocity toward a target and derive the visual spin ourselves, so the
-- ball always LOOKS like it is rolling even though we are driving it directly.
--
-- Input comes from Humanoid.MoveDirection, which already fuses keyboard,
-- gamepad and the mobile thumbstick. Writing a bespoke touch stick would have
-- been days of work and worse on every device.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game.ReplicatedStorage:WaitForChild("GoobShared")
local Movement = require(Shared.Movement)
local Config = require(Shared.Config)
local Stick = require(script.Parent.Stick)

local player = Players.LocalPlayer
local Roll = {}

local ball: BasePart? = nil
local mass = 10

local dashCharges = Movement.DASH_CHARGES
local dashRefillClock = 0
local dashUntil = 0
local dashDir = Vector3.zero
local airDashesLeft = Movement.AIR_DASHES
local grounded = false
local jumpQueued = false

Roll.onDash = nil :: ((charges: number) -> ())?

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Update the mass the handling curves read without rebinding the body. Called
-- on every arena sync, which is twelve times a second, so it must stay this
-- cheap.
-- What the controller is currently steering, or nil if it has not found a body.
--
-- Exposed because nil here is the single most consequential state in the
-- client: Roll.step returns on its first line when it is nil, so the player
-- cannot move and nothing anywhere reports a problem. It has been nil for a
-- whole play-test twice now. A test can assert on it; a player cannot.
function Roll.boundBall(): BasePart?
    return ball
end

function Roll.setMass(newMass: number)
    mass = newMass
end

-- ── SNAGGED ON SOMEBODY'S TETHER ──────────────────────────────────────────
--
-- The server decides WHETHER you are snagged; the client has to be the one
-- that acts on it, because the client owns this ball's physics. That split was
-- the bug: the server set the flag, the tests asserted the flag was set, and
-- nothing anywhere actually slowed the player down. Bots were slowed correctly
-- because the server moves those itself, so the mechanic worked against
-- everything except the people it was aimed at.
local snagged = false

function Roll.setSnagged(on: boolean)
    snagged = on
end

function Roll.isSnagged(): boolean
    return snagged
end

function Roll.setBall(newBall: BasePart?, newMass: number)
    ball = newBall
    mass = math.max(1, newMass)
    if newBall then
        rayParams.FilterDescendantsInstances = { newBall, player.Character }
    end
end

function Roll.charges(): number
    return dashCharges
end

function Roll.maxCharges(): number
    return Movement.DASH_CHARGES
end

-- Fraction of the way to the next charge, for the HUD meter.
function Roll.refillProgress(): number
    if dashCharges >= Movement.DASH_CHARGES then return 1 end
    return math.clamp(dashRefillClock / Movement.DASH_REFILL, 0, 1)
end

-- Input comes entirely from Stick: keyboard, gamepad and our own thumbstick.
-- Reading Humanoid.MoveDirection was the original approach and it did not work
-- (see the note at the top of Stick.luau).
local function moveInput(): Vector3
    return Stick.moveVector()
end

local function checkGrounded(b: BasePart): boolean
    local radius = b.Size.X / 2
    local hit = Workspace:Raycast(b.Position, Vector3.new(0, -(radius + 3), 0), rayParams)
    return hit ~= nil
end

function Roll.dash()
    if not ball then return end
    if dashCharges <= 0 then return end
    if not grounded and airDashesLeft <= 0 then return end

    local dir = moveInput()
    if dir.Magnitude < 0.05 then
        local v = ball.AssemblyLinearVelocity
        dir = Vector3.new(v.X, 0, v.Z)
        if dir.Magnitude < 0.05 then
            local cam = Workspace.CurrentCamera
            dir = cam and Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z) or Vector3.new(0, 0, -1)
        end
        dir = dir.Unit
    end

    dashCharges -= 1
    dashDir = dir
    dashUntil = os.clock() + Movement.DASH_TIME
    if not grounded then airDashesLeft -= 1 end
    if Roll.onDash then Roll.onDash(dashCharges) end
end

function Roll.jump()
    jumpQueued = true
end

function Roll.step(dt: number)
    local b = ball
    if not b or not b.Parent then return end

    local wasGrounded = grounded
    grounded = checkGrounded(b)
    if grounded and not wasGrounded then
        airDashesLeft = Movement.AIR_DASHES
    end

    -- Dash charges refill on a timer, one at a time.
    if dashCharges < Movement.DASH_CHARGES then
        dashRefillClock += dt
        if dashRefillClock >= Movement.DASH_REFILL then
            dashRefillClock = 0
            dashCharges += 1
        end
    else
        dashRefillClock = 0
    end

    local vel = b.AssemblyLinearVelocity
    local flat = Vector3.new(vel.X, 0, vel.Z)
    local dashing = os.clock() < dashUntil

    local target: Vector3
    if dashing then
        target = dashDir * Movement.DASH_SPEED
    else
        local input = moveInput()
        local top = Movement.topSpeed(mass)
        if snagged then
            top *= Config.TETHER_SLOW
        end
        if input.Magnitude > 0.05 then
            local accel = Movement.acceleration(mass)
            target = flat + input * accel * dt
            if target.Magnitude > top then target = target.Unit * top end
        else
            -- Coasting. Braking scales down with mass, which is what makes a
            -- big Goob feel like a truck.
            local brake = Movement.braking(mass) * dt
            if flat.Magnitude <= brake then
                target = Vector3.zero
            else
                target = flat - flat.Unit * brake
            end
        end
    end

    local newY = vel.Y
    if jumpQueued then
        jumpQueued = false
        if grounded then newY = Movement.jumpSpeed(mass) end
    end
    if not grounded then
        newY -= (Workspace.Gravity * (Movement.GRAVITY_BOOST - 1)) * dt
    end

    b.AssemblyLinearVelocity = Vector3.new(target.X, newY, target.Z)

    -- Derive the spin from the motion so it always looks like rolling, whatever
    -- the friction under it happens to be.
    local radius = math.max(0.5, b.Size.X / 2)
    local speed = Vector3.new(target.X, 0, target.Z).Magnitude
    if speed > 0.1 then
        local axis = Vector3.new(0, 1, 0):Cross(Vector3.new(target.X, 0, target.Z).Unit)
        b.AssemblyAngularVelocity = axis * (speed / radius)
    else
        b.AssemblyAngularVelocity = b.AssemblyAngularVelocity * 0.85
    end
end

function Roll.bindInput()
    Stick.onJump = Roll.jump
    Stick.onDash = Roll.dash
end

return Roll
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">Stick</string><ProtectedString name="Source"><![CDATA[--!strict
-- Stick.luau — our own input, because borrowing Roblox's did not work.
--
-- THE BUG THIS EXISTS TO FIX: the first version set Humanoid.WalkSpeed = 0 to
-- stop the avatar walking, and read Humanoid.MoveDirection for input. Both
-- halves of that were wrong:
--
--   1. A Humanoid with WalkSpeed = 0 does not merely decline to move — it
--      actively brakes its assembly to zero velocity every physics step. The
--      ball was welded to that assembly, so the humanoid fought every frame of
--      movement the controller applied.
--   2. MoveDirection is zero when WalkSpeed is zero, so the input read was dead
--      as well. The keyboard fallback was carrying the whole thing.
--
-- So: the humanoid is put into PlatformStand (it stops controlling physics
-- entirely) and input comes from here — keyboard, gamepad, and a thumbstick we
-- draw ourselves. No dependency on the default control module at all.

local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)

local player = Players.LocalPlayer
local Stick = {}

local keys = { W = false, A = false, S = false, D = false }
local gamepad = Vector2.new(0, 0)
local touchVector = Vector2.new(0, 0)

Stick.onJump = function() end
Stick.onDash = function() end

-- ── Camera-relative movement vector, from whichever device is in use ───────

function Stick.moveVector(): Vector3
    local camera = Workspace.CurrentCamera
    if not camera then return Vector3.zero end

    local look = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector
    local fwd = Vector3.new(look.X, 0, look.Z)
    local side = Vector3.new(right.X, 0, right.Z)
    if fwd.Magnitude < 0.001 then return Vector3.zero end
    fwd, side = fwd.Unit, side.Unit

    local x, z = 0, 0
    if keys.W then z += 1 end
    if keys.S then z -= 1 end
    if keys.D then x += 1 end
    if keys.A then x -= 1 end

    -- Analogue sources win over digital when they are actually deflected, so a
    -- thumb resting on a stick doesn't get overridden by a stuck key.
    if math.abs(gamepad.X) > 0.15 or math.abs(gamepad.Y) > 0.15 then
        x, z = gamepad.X, gamepad.Y
    end
    if touchVector.Magnitude > 0.12 then
        x, z = touchVector.X, touchVector.Y
    end

    local v = side * x + fwd * z
    if v.Magnitude < 0.05 then return Vector3.zero end
    return (v.Magnitude > 1 and v.Unit or v)
end

-- ── Keyboard and gamepad ───────────────────────────────────────────────────

local KEYMAP = {
    [Enum.KeyCode.W] = "W", [Enum.KeyCode.Up] = "W",
    [Enum.KeyCode.S] = "S", [Enum.KeyCode.Down] = "S",
    [Enum.KeyCode.A] = "A", [Enum.KeyCode.Left] = "A",
    [Enum.KeyCode.D] = "D", [Enum.KeyCode.Right] = "D",
}

local bound = false

local function bindHardware()
    if bound then
        return
    end
    bound = true
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        local k = KEYMAP[input.KeyCode]
        if k then keys[k] = true return end
        if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
            Stick.onJump()
        elseif input.KeyCode == Enum.KeyCode.LeftShift
            or input.KeyCode == Enum.KeyCode.Q
            or input.KeyCode == Enum.KeyCode.ButtonR2
            or input.KeyCode == Enum.KeyCode.ButtonB then
            Stick.onDash()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        local k = KEYMAP[input.KeyCode]
        if k then keys[k] = false end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Thumbstick1 then
            local p = input.Position
            gamepad = Vector2.new(p.X, p.Y)
        end
    end)

    -- Keys can stick if focus is lost mid-press.
    UserInputService.WindowFocusReleased:Connect(function()
        for k in pairs(keys) do keys[k] = false end
        gamepad = Vector2.new(0, 0)
    end)
end

-- ── The touch thumbstick we draw ourselves ─────────────────────────────────

local base: Frame? = nil
local knob: Frame? = nil
local activeTouch: InputObject? = nil
local centre = Vector2.new(0, 0)
local RADIUS = 62

function Stick.build(gui: ScreenGui)
    local b = Instance.new("Frame")
    b.Name = "MoveStick"
    b.Size = UDim2.fromOffset(RADIUS * 2, RADIUS * 2)
    b.BackgroundColor3 = Theme.BG
    b.BackgroundTransparency = 0.55
    b.Visible = false
    b.Parent = gui
    Theme.corner(b, RADIUS)
    Theme.stroke(b, Theme.TEXT_DIM, 2)
    base = b

    local k = Instance.new("Frame")
    k.Name = "Knob"
    k.Size = UDim2.fromOffset(56, 56)
    k.Position = UDim2.new(0.5, -28, 0.5, -28)
    k.BackgroundColor3 = Theme.ACCENT
    k.BackgroundTransparency = 0.2
    k.Parent = b
    Theme.corner(k, 28)
    Theme.stroke(k, Theme.BG, 2)
    knob = k

    bindHardware()

    -- Drag anywhere in the lower-left quadrant, not just on the stick: a thumb
    -- rarely lands exactly on a circle, and re-centring the stick where the
    -- thumb actually touched is the difference between responsive and fiddly.
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or input.UserInputType ~= Enum.UserInputType.Touch then return end
        local cam = Workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local p = input.Position
        if p.X > vp.X * 0.45 or p.Y < vp.Y * 0.35 then return end

        activeTouch = input
        centre = Vector2.new(p.X, p.Y)
        b.Position = UDim2.fromOffset(centre.X - RADIUS, centre.Y - RADIUS)
        b.Visible = true
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input ~= activeTouch then return end
        local p = Vector2.new(input.Position.X, input.Position.Y)
        local delta = p - centre
        local mag = math.min(delta.Magnitude, RADIUS)
        local dir = delta.Magnitude > 0.001 and delta.Unit or Vector2.new(0, 0)
        local offset = dir * mag
        if knob then
            knob.Position = UDim2.new(0.5, offset.X - 28, 0.5, offset.Y - 28)
        end
        -- Screen Y grows downward; forward is negative Y.
        touchVector = Vector2.new(offset.X / RADIUS, -offset.Y / RADIUS)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input ~= activeTouch then return end
        activeTouch = nil
        touchVector = Vector2.new(0, 0)
        if knob then knob.Position = UDim2.new(0.5, -28, 0.5, -28) end
        if base then base.Visible = false end
    end)
end

function Stick.setTouchEnabled(on: boolean)
    if base and not on then
        base.Visible = false
        touchVector = Vector2.new(0, 0)
    end
end

-- WIRE IT UP. THIS LINE IS THE WHOLE MODULE.
--
-- bindHardware() connects the keyboard, gamepad and touch handlers that fill
-- the `keys`, `gamepad` and `touchVector` values moveVector() reads. Without
-- it every one of those stays at its initial zero, moveVector returns
-- Vector3.zero on every frame, and Roll.step brakes the blob to a standstill —
-- so the player cannot move AT ALL, while everything else works perfectly.
--
-- It was never called. The module was written, compiled, type-checked, listed
-- in the build and imported by the controller, and none of its input handlers
-- had ever run. Two play-tests reported "I can't move" because of this exact
-- omission, and the second one came AFTER a commit whose message claimed to
-- have fixed the first.
--
-- Calling it at require time is deliberate: there is no state to wait for, and
-- an explicit start() is one more thing a caller can forget, which is the
-- mistake this comment exists to stop repeating.
bindHardware()

-- True once the hardware handlers are connected. Exposed so a test can assert
-- the wiring exists rather than trusting that somebody remembered.
function Stick.isBound(): boolean
    return bound
end

return Stick
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
-- Theme.luau — one place for every colour, corner radius and font in the UI.
-- Chunky, high-contrast, oversized text: the target player is nine and may be
-- on a phone, so nothing here is subtle.

local Theme = {}

Theme.FONT = Enum.Font.GothamBold
Theme.FONT_BODY = Enum.Font.Gotham

-- ── MONOCHROME. Black, grey, white, and nothing else. ─────────────────────
--
-- Two earlier passes over this palette: the first was neon (electric cyan on
-- near-black), which read as loud; the second pulled everything down to muted
-- slate-blues and sages, which read as muddy. Both were trying to make the UI
-- itself interesting, and the UI is not the interesting part — the blobs are.
--
-- So the interface is now greyscale by rule: every panel, every label, every
-- border is black, grey or white. The ONLY chroma anywhere on screen is
-- meaning: a rarity stroke on a card, a red warning, a green confirmation. A
-- neon skin has nothing to compete with, which is the point — this is a game
-- whose whole visual promise is a glowing blob, and a grey frame around it is
-- what makes it glow.
--
-- The greys are very slightly warm (R and G a shade above B). Perfectly
-- neutral greys read as blue-ish on most phone panels; two or three points of
-- warmth reads as black rather than as a colour.
Theme.BLACK     = Color3.fromRGB(10, 10, 11)
Theme.BG        = Color3.fromRGB(20, 20, 22)
Theme.PANEL     = Color3.fromRGB(28, 28, 31)
Theme.BG_SOFT   = Color3.fromRGB(42, 42, 46)
Theme.LINE      = Color3.fromRGB(62, 62, 68)
Theme.TEXT      = Color3.fromRGB(245, 245, 246)
Theme.TEXT_DIM  = Color3.fromRGB(158, 158, 164)

-- "Accent" is white. Where the old palette used a colour to mean "this is the
-- live one", the monochrome answer is brightness: selected rows are white on
-- black, everything else is grey on near-black. That is a stronger signal than
-- hue on a small screen and it survives being colourblind.
Theme.ACCENT    = Color3.fromRGB(245, 245, 246)
Theme.GOLD      = Color3.fromRGB(226, 226, 228)

-- The three exceptions, kept as desaturated as they can be while still
-- reading instantly. These are STATE, not decoration: something worked,
-- something is about to go wrong, something is dangerous.
Theme.GOOD      = Color3.fromRGB(126, 214, 150)
Theme.WARN      = Color3.fromRGB(226, 186, 104)
Theme.BAD       = Color3.fromRGB(226, 106, 106)

function Theme.corner(parent: Instance, radius: number?)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 14)
    c.Parent = parent
    return c
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.LINE
    s.Thickness = thickness or 2
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

function Theme.pad(parent: Instance, px: number)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, px)
    p.PaddingBottom = UDim.new(0, px)
    p.PaddingLeft = UDim.new(0, px)
    p.PaddingRight = UDim.new(0, px)
    p.Parent = parent
    return p
end

function Theme.label(props: { [string]: any }): TextLabel
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Font = Theme.FONT
    t.TextColor3 = Theme.TEXT
    t.TextScaled = false
    t.TextSize = 18
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Text = ""   -- a TextLabel defaults to the literal string "Label"
    for k, v in pairs(props) do (t :: any)[k] = v end
    return t
end

-- A button reads as a SURFACE with a bright label, not as a slab of colour.
--
-- The old style filled the button with the accent colour and printed dark text
-- on it, which in a monochrome palette means a white rectangle — the loudest
-- thing on the screen, on every button at once. Inverting it puts the emphasis
-- on the text: dark surface, near-white label, and `color` becomes the BORDER,
-- which is where the one permitted piece of chroma (a rarity, a warning) can
-- live without shouting.
function Theme.button(text: string, color: Color3, size: UDim2): TextButton
    local b = Instance.new("TextButton")
    b.Text = text
    b.Size = size
    b.BackgroundColor3 = Theme.BG_SOFT
    b.Font = Theme.FONT
    b.TextColor3 = Theme.TEXT
    b.TextSize = 18
    b.AutoButtonColor = true
    Theme.corner(b, 10)
    Theme.stroke(b, color, 2)
    return b
end

--- A button that is currently ON. White surface, black label — the only place
--- in the interface that inverts, which is what makes "this one is live"
--- unmissable without using a colour to say it.
function Theme.setButtonActive(b: TextButton, on: boolean)
    b.BackgroundColor3 = on and Theme.TEXT or Theme.BG_SOFT
    b.TextColor3 = on and Theme.BLACK or Theme.TEXT
    local st = b:FindFirstChildOfClass("UIStroke")
    if st then
        st.Color = on and Theme.TEXT or Theme.LINE
    end
end

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">TradeUi</string><ProtectedString name="Source"><![CDATA[--!strict
-- TradeUi.luau — the trade window.
--
-- The whole design goal is SCAM RESISTANCE made visible. A young player cannot
-- be expected to notice a swapped item, so the UI does the noticing for them:
-- both offers are shown at identical size, confirming is a hold-to-fill bar,
-- and any change to either side visibly snaps both bars back to empty.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Shared = game.ReplicatedStorage.GoobShared
local Net = require(Shared.Net)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Layout = require(script.Parent.Layout)

local player = Players.LocalPlayer
local TradeUi = {}

local root: Frame
local myList: Frame
local theirList: Frame
local statusLabel: TextLabel
local confirmBtn: TextButton
local fillBar: Frame
local partnerLabel: TextLabel

local holding = false
local holdStart = 0
local lockSeconds = 3
local current: any = nil

local function clear(frame: Frame)
    for _, c in ipairs(frame:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
end

local function offerCard(goob: any, mine: boolean): Frame
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 74)
    card.BackgroundColor3 = Theme.PANEL
    Theme.corner(card, 12)
    Theme.stroke(card, Color3.fromRGB(16, 18, 30), 2)

    local chip = Instance.new("Frame")
    chip.Size = UDim2.fromOffset(50, 50)
    chip.Position = UDim2.fromOffset(10, 12)
    chip.BackgroundColor3 = Color3.fromHSV(goob.hue, 0.55, 1)
    chip.Parent = card
    Theme.corner(chip, 25)
    Theme.stroke(chip, Color3.fromRGB(16, 18, 30), 2)

    local name = Theme.label({
        Position = UDim2.fromOffset(70, 8), Size = UDim2.new(1, -80, 0, 22),
        Text = goob.nickname, TextSize = 18, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    name.Parent = card

    -- Age is shown as loudly as power. It is the stat new traders undervalue,
    -- and the one they get talked out of.
    local stat = Theme.label({
        Position = UDim2.fromOffset(70, 30), Size = UDim2.new(1, -80, 0, 20),
        Text = ("⚡ %s   Gen %d"):format(goob.powerText, goob.generation),
        TextSize = 15, TextColor3 = Theme.GOLD,
    })
    stat.Parent = card

    local age = Theme.label({
        Position = UDim2.fromOffset(70, 50), Size = UDim2.new(1, -80, 0, 18),
        Text = ("%s %s · %s old"):format(goob.ageEmoji, goob.ageTier, goob.ageText),
        TextSize = 14, TextColor3 = Theme.ACCENT,
    })
    age.Parent = card

    if mine then
        local remove = Theme.button("✖", Theme.BAD, UDim2.fromOffset(30, 30))
        remove.Position = UDim2.new(1, -38, 0, 8)
        remove.TextSize = 16
        remove.Parent = card
        remove.Activated:Connect(function()
            Net.get("TradeOffer"):FireServer(goob.id, false)
        end)
    end

    return card
end

local function column(parent: Frame, title: string, x: UDim2): Frame
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(0.5, -14, 1, -164)
    holder.Position = x
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local head = Theme.label({
        Size = UDim2.new(1, 0, 0, 26), Text = title, TextSize = 20,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    head.Name = "Head"
    head.Parent = holder

    local list = Instance.new("Frame")
    list.Name = "List"
    list.Position = UDim2.fromOffset(0, 32)
    list.Size = UDim2.new(1, 0, 1, -32)
    list.BackgroundColor3 = Theme.BG_SOFT
    list.BackgroundTransparency = 0.35
    list.Parent = holder
    Theme.corner(list, 12)
    Theme.pad(list, 8)

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = list

    return list
end

function TradeUi.build(gui: ScreenGui)
    root = Instance.new("Frame")
    root.Name = "TradeWindow"
    root.BackgroundColor3 = Theme.BG
    root.Visible = false
    root.Parent = gui
    Theme.corner(root, 18)
    Theme.stroke(root, Theme.GOLD, 4)

    local title = Theme.label({
        Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -40, 0, 30),
        Text = "🤝 TRADE", TextSize = 28, TextColor3 = Theme.GOLD,
    })
    title.Parent = root

    partnerLabel = Theme.label({
        Position = UDim2.fromOffset(20, 44), Size = UDim2.new(1, -40, 0, 22),
        Text = "", TextSize = 17, TextColor3 = Theme.TEXT_DIM,
    })
    partnerLabel.Parent = root

    myList = column(root, "YOU GIVE", UDim2.fromOffset(14, 76))
    theirList = column(root, "YOU GET", UDim2.new(0.5, 0, 0, 76))

    statusLabel = Theme.label({
        Position = UDim2.new(0, 20, 1, -84), Size = UDim2.new(1, -40, 0, 22),
        Text = "Add Goobs from your drawer, then hold CONFIRM.",
        TextSize = 15, TextColor3 = Theme.TEXT_DIM,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    statusLabel.Parent = root

    confirmBtn = Theme.button("HOLD TO CONFIRM", Theme.GOOD, UDim2.fromOffset(300, 46))
    confirmBtn.Name = "HoldToConfirm"
    confirmBtn.TextSize = 20
    confirmBtn.Parent = root

    -- The fill bar lives *inside* the button and grows left to right. It is
    -- the entire anti-scam affordance: you physically cannot confirm by
    -- reflex, and the bar emptying is impossible to miss.
    --
    -- ZIndex MUST be above the button, not below it. The ScreenGui runs in
    -- Sibling ZIndexBehavior, so a child at ZIndex 0 renders behind its
    -- parent's opaque background — which made the one piece of UI protecting
    -- nine-year-olds from trade scams completely invisible.
    fillBar = Instance.new("Frame")
    fillBar.Name = "HoldFill"
    fillBar.Size = UDim2.fromScale(0, 1)
    fillBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    fillBar.BackgroundTransparency = 0.62
    fillBar.BorderSizePixel = 0
    fillBar.ZIndex = confirmBtn.ZIndex + 1
    fillBar.Parent = confirmBtn
    Theme.corner(fillBar, 12)

    -- Keep the label readable on top of the fill.
    confirmBtn.ZIndex = 2
    fillBar.ZIndex = 3

    local cancel = Theme.button("✖ CANCEL", Theme.BAD, UDim2.fromOffset(120, 46))
    cancel.Position = UDim2.new(0.5, 152, 1, -58)
    cancel.TextSize = 17
    cancel.Parent = root
    cancel.Name = "CancelTrade"
    cancel.Activated:Connect(function()
        Net.get("TradeCancel"):FireServer()
    end)

    local function beginHold()
        if not current or not current.open then return end
        holding = true
        holdStart = os.clock()
        Net.get("TradeConfirm"):FireServer(true)
    end
    local function endHold()
        if not holding then return end
        holding = false
        fillBar.Size = UDim2.fromScale(0, 1)
        Net.get("TradeConfirm"):FireServer(false)
    end

    confirmBtn.MouseButton1Down:Connect(beginHold)
    confirmBtn.MouseButton1Up:Connect(endHold)
    confirmBtn.MouseLeave:Connect(endHold)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            endHold()
        end
    end)

    TradeUi.applyLayout()
    Layout.changed.Event:Connect(TradeUi.applyLayout)

    RunService.RenderStepped:Connect(function()
        if holding then
            local pct = math.clamp((os.clock() - holdStart) / lockSeconds, 0, 1)
            fillBar.Size = UDim2.fromScale(pct, 1)
        end
    end)
end

-- Resize and re-place the window for the current screen. The desktop layout
-- puts the two offers side by side; a phone is too narrow for that, so the
-- confirm/cancel row stacks and the columns get every pixel that is left.
function TradeUi.applyLayout()
    if not root then return end
    local compact = Layout.isCompact()
    local size = Layout.panel(640, 480)
    root.Size = size
    root.Position = Layout.centre(size)

    local w, h = size.X.Offset, size.Y.Offset
    local pad = compact and 10 or 14
    local headerH = compact and 54 or 76
    local footerH = compact and 96 or 84

    partnerLabel.Position = UDim2.fromOffset(pad + 6, compact and 30 or 44)
    partnerLabel.Size = UDim2.new(1, -(pad + 6) * 2, 0, 22)
    partnerLabel.TextSize = compact and 14 or 17

    for _, holder in ipairs({ myList.Parent, theirList.Parent }) do
        if holder then
            holder.Size = UDim2.new(0.5, -pad - 4, 1, -(headerH + footerH))
        end
    end
    if myList.Parent then myList.Parent.Position = UDim2.fromOffset(pad, headerH) end
    if theirList.Parent then theirList.Parent.Position = UDim2.new(0.5, 4, 0, headerH) end

    statusLabel.Position = UDim2.fromOffset(pad, h - footerH + (compact and 2 or 6))
    statusLabel.Size = UDim2.new(1, -pad * 2, 0, 20)
    statusLabel.TextSize = compact and 13 or 15

    -- Confirm is the important control, so it keeps full width on a phone and
    -- Cancel drops onto its own row underneath rather than shrinking.
    local btnH = compact and Layout.MIN_TAP or 46
    local cancelBtn = root:FindFirstChild("CancelTrade")
    if compact then
        confirmBtn.Size = UDim2.new(1, -pad * 2, 0, btnH)
        confirmBtn.Position = UDim2.fromOffset(pad, h - btnH * 2 - 12)
        if cancelBtn then
            cancelBtn.Size = UDim2.new(1, -pad * 2, 0, btnH - 8)
            cancelBtn.Position = UDim2.fromOffset(pad, h - btnH + 2)
        end
    else
        confirmBtn.Size = UDim2.fromOffset(300, btnH)
        confirmBtn.Position = UDim2.fromOffset(math.floor(w / 2) - 160, h - btnH - 12)
        if cancelBtn then
            cancelBtn.Size = UDim2.fromOffset(120, btnH)
            cancelBtn.Position = UDim2.fromOffset(math.floor(w / 2) + 152, h - btnH - 12)
        end
    end
    confirmBtn.TextSize = compact and 17 or 20
end

function TradeUi.sync(stateIn: any)
    current = stateIn
    if not stateIn or not stateIn.open then
        root.Visible = false
        holding = false
        fillBar.Size = UDim2.fromScale(0, 1)
        return
    end
    root.Visible = true
    lockSeconds = stateIn.lockSeconds or 3
    partnerLabel.Text = "Trading with " .. (stateIn.partnerDisplay or stateIn.partner)

    clear(myList)
    clear(theirList)
    for _, goob in ipairs(stateIn.myOffer) do offerCard(goob, true).Parent = myList end
    for _, goob in ipairs(stateIn.theirOffer) do offerCard(goob, false).Parent = theirList end

    -- If either offer changed, the server already reset both confirmations.
    -- Reflecting that instantly is the point.
    if not stateIn.myConfirmed and holding then
        holding = false
        fillBar.Size = UDim2.fromScale(0, 1)
    end

    if stateIn.theirConfirmed and stateIn.myConfirmed then
        statusLabel.Text = "Both confirmed — finishing…"
        statusLabel.TextColor3 = Theme.GOOD
    elseif stateIn.theirConfirmed then
        statusLabel.Text = "⚠️ They confirmed. Check the deal, then hold CONFIRM."
        statusLabel.TextColor3 = Theme.WARN
    else
        statusLabel.Text = "Add Goobs from your drawer, then hold CONFIRM."
        statusLabel.TextColor3 = Theme.TEXT_DIM
    end
end

function TradeUi.isOpen(): boolean
    return current ~= nil and current.open == true
end

return TradeUi
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>