    {"id": "generic.roblox-exploit", "name": "Roblox exploit naming", "target": "file_name", "pattern": "re:roblox.{0,12}(exploit|executor|inject|cheat|hack)", "severity": "high", "description": "File name pairs 'roblox' with exploit terminology.", "category": "generic"},
    {"id": "generic.exploit-word", "name": "Exploit terminology", "target": "file_name", "pattern": "re:^(exploit|executor|injector|cheatengine|dll[ _-]?injector)[^\\\\/]*\\.(exe|dll)$", "severity": "medium", "description": "File is named after its function as an exploit or injector.", "category": "generic"},
    {"id": "generic.injector-proc", "name": "Injector process", "target": "process_name", "pattern": "re:(dll)?[ _-]?inject(or|ion)?\\.exe$", "severity": "medium", "description": "Process name indicates a DLL injector.", "category": "generic"},
    {"id": "generic.bypass", "name": "Anti-cheat bypass", "target": "file_name", "pattern": "re:(byfron|hyperion|anticheat|anti[ _-]cheat)[^\\\\/]*(bypass|patch|kill)", "severity": "high", "description": "File name claims to bypass or patch Roblox anti-cheat (Byfron/Hyperion).", "category": "generic"},
    {"id": "generic.temp-exe", "name": "Executable in Temp with random name", "target": "file_path", "pattern": "re:[\\\\/]temp[\\\\/][a-z0-9]{8,}\\.(exe|dll|scr)$", "severity": "low", "description": "Randomly named executable dropped into %TEMP% — common for loaders, also common for installers.", "category": "generic"},
    {"id": "generic.double-ext", "name": "Double extension", "target": "file_name", "pattern": "re:\\.(txt|jpg|png|pdf|doc|lua|mp4)\\.(exe|scr|bat|cmd|pif)$", "severity": "high", "description": "File disguises an executable behind a document extension.", "category": "generic"},
    {"id": "generic.rat-names", "name": "Common stealer/loader name", "target": "file_name", "pattern": "re:^(setup|update|launcher|loader|crack|keygen|patch)[ _-]?(v?[0-9._]+)?\\.exe$", "severity": "info", "description": "Generic name favoured by droppers. Informational only — installers look identical.", "category": "generic"},

    {"id": "inject.module.generic", "name": "Injected module with exploit name", "target": "module_name", "pattern": "re:(exploit|executor|inject|cheat|hack|bypass|sploit)", "severity": "critical", "description": "A DLL whose name references exploitation is loaded inside a protected Roblox process.", "category": "injection"},
    {"id": "inject.module.known", "name": "Known executor module", "target": "module_name", "pattern": "re:^(krnl|synapse|fluxus|oxygen|hydrogen|xeno|solara|delta|wave|trigon|sirhurt|evon)", "severity": "critical", "description": "A DLL named after a known executor is loaded inside a protected Roblox process.", "category": "injection"},

    {"id": "tamper.defender.ps", "name": "Defender disabled via PowerShell", "target": "cmdline", "pattern": "re:set-mppreference\\s+.*disable(realtimemonitoring|behaviormonitoring|ioavprotection|scriptscanning)\\s+\\$?true", "severity": "critical", "description": "Command line disables Microsoft Defender real-time protection.", "category": "tamper"},
    {"id": "tamper.defender.exclusion", "name": "Defender exclusion added", "target": "cmdline", "pattern": "re:add-mppreference\\s+-exclusionpath", "severity": "high", "description": "Command line adds a Microsoft Defender exclusion path.", "category": "tamper"},
    {"id": "tamper.service.stop", "name": "Security service stopped", "target": "cmdline", "pattern": "re:(sc(\\.exe)?\\s+(stop|config|delete)|net\\s+stop)\\s+.*(windefend|wdnissvc|sense|wscsvc|securityhealthservice|mpssvc)", "severity": "critical", "description": "Command line stops or disables a Windows security service.", "category": "tamper"},
    {"id": "tamper.taskkill.av", "name": "Antivirus process killed", "target": "cmdline", "pattern": "re:taskkill.*(msmpeng|securityhealth|avastui|avgui|mbam|bdagent|ekrn|nortonsecurity|execguard)", "severity": "critical", "description": "Command line terminates an antivirus or security process.", "category": "tamper"},
    {"id": "tamper.firewall.off", "name": "Windows Firewall disabled", "target": "cmdline", "pattern": "re:netsh\\s+advfirewall\\s+set\\s+.*state\\s+off", "severity": "critical", "description": "Command line turns the Windows Firewall off.", "category": "tamper"},
    {"id": "tamper.bcdedit", "name": "Boot integrity weakened", "target": "cmdline", "pattern": "re:bcdedit.*(testsigning\\s+on|nointegritychecks\\s+on|disable(dynamicticktick)?integritychecks)", "severity": "critical", "description": "Command line disables driver signature enforcement — used to load unsigned executor drivers.", "category": "tamper"},
    {"id": "tamper.amsi", "name": "AMSI bypass", "target": "cmdline", "pattern": "re:(amsiinitfailed|amsiscanbuffer|amsi\\.dll.*patch)", "severity": "critical", "description": "Command line contains a well-known AMSI bypass string.", "category": "tamper"},
    {"id": "tamper.enc-powershell", "name": "Encoded PowerShell", "target": "cmdline", "pattern": "re:powershell(\\.exe)?\\s+.*-(e|ec|enc|encodedcommand)\\s+[a-z0-9+/=]{40,}", "severity": "high", "description": "Base64-encoded PowerShell command — used to hide what is being run.", "category": "tamper"},
    {"id": "tamper.download-exec", "name": "Download and execute", "target": "cmdline", "pattern": "re:(invoke-webrequest|downloadstring|downloadfile|curl|certutil.*-urlcache).{0,120}(iex|invoke-expression|start-process|\\.exe)", "severity": "high", "description": "Command line downloads and immediately runs a payload.", "category": "tamper"}
